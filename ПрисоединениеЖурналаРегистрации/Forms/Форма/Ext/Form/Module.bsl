// Поля записи .lgp (1-based), которые ссылаются на словарь .lgf.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПоляСсылокЗаписиLgp()
	
	Результат = Новый Массив;
	ДобавитьПолеСсылкиLgp(Результат, 4, ТипОбъектаПользователи(), Ложь);
	ДобавитьПолеСсылкиLgp(Результат, 5, ТипОбъектаКомпьютеры(), Ложь);
	ДобавитьПолеСсылкиLgp(Результат, 6, ТипОбъектаПриложения(), Ложь);
	ДобавитьПолеСсылкиLgp(Результат, 8, ТипОбъектаСобытия(), Ложь);
	ДобавитьПолеСсылкиLgp(Результат, 11, ТипОбъектаМетаданные(), Истина);
	ДобавитьПолеСсылкиLgp(Результат, 14, ТипОбъектаСерверы(), Ложь);
	ДобавитьПолеСсылкиLgp(Результат, 15, ТипОбъектаГлавныеПорты(), Ложь);
	ДобавитьПолеСсылкиLgp(Результат, 16, ТипОбъектаДопПорты(), Ложь);
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьПолеСсылкиLgp(Коллекция, ИндексПоля, ТипОбъекта, Составное)
	
	Описание = Новый Структура("ИндексПоля, ТипОбъекта, Составное", ИндексПоля, ТипОбъекта, Составное);
	Коллекция.Добавить(Описание);
	
КонецПроцедуры

#КонецОбласти

#Область ДиалогиИПути

&НаСервере
Процедура ЗаполнитьСписокРежимовКонфликта()
	
	Элементы.РежимКонфликта.СписокВыбора.Очистить();
	Элементы.РежимКонфликта.СписокВыбора.Добавить(РежимКонфликтаОбъединить(), "Объединить записи");
	Элементы.РежимКонфликта.СписокВыбора.Добавить(РежимКонфликтаПропустить(), "Пропустить (оставить текущий)");
	Элементы.РежимКонфликта.СписокВыбора.Добавить(РежимКонфликтаЗаменить(), "Заменить текущий файлом из старого ЖР");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКаталогЖР(ИмяРеквизита, ЗаголовокДиалога)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = ЗаголовокДиалога;
	Диалог.МножественныйВыбор = Ложь;
	Диалог.ПроверятьСуществованиеФайла = Истина;
	Диалог.Каталог = ЭтотОбъект[ИмяРеквизита];
	
	ДополнительныеПараметры = Новый Структура("ИмяРеквизита, Диалог", ИмяРеквизита, Диалог);
	Оповещение = Новый ОписаниеОповещения("ВыбратьКаталогЖРЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКаталогЖРЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранныйКаталог = "";
	Если ДополнительныеПараметры.Свойство("Диалог") Тогда
		ВыбранныйКаталог = ДополнительныеПараметры.Диалог.Каталог;
	КонецЕсли;
	Если ПустаяСтрока(ВыбранныйКаталог) Тогда
		ВыбранныйКаталог = ПервыйПутьИзРезультатаДиалога(ВыбранныеФайлы);
	КонецЕсли;
	Если ПустаяСтрока(ВыбранныйКаталог) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект[ДополнительныеПараметры.ИмяРеквизита] = НормализоватьКаталогЖР(ВыбранныйКаталог);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлыЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПервыйПуть = ПервыйПутьИзРезультатаДиалога(ВыбранныеФайлы);
	Если ПустаяСтрока(ПервыйПуть) Тогда
		Возврат;
	КонецЕсли;
	
	ПервыйФайл = Новый Файл(ПервыйПуть);
	КаталогИсточника = НормализоватьКаталогЖР(ПервыйФайл.Путь);
	
	ТекстПротокола = "";
	Если Не ВыполнитьАнализБезопасно(Ложь) Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранныеИмена = Новый Соответствие;
	Для Каждого ПолноеИмя Из ВыбранныеФайлы Цикл
		ФайлНаДиске = Новый Файл(ПолноеИмя);
		ВыбранныеИмена.Вставить(НРег(ФайлНаДиске.Имя), Истина);
	КонецЦикла;
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		СтрокаФайла.Пометка = (ВыбранныеИмена.Получить(НРег(СтрокаФайла.ИмяФайла)) = Истина);
	КонецЦикла;
	
	ДобавитьВПротокол("Отмечены выбранные вручную файлы: " + Формат(ВыбранныеФайлы.Количество(), "ЧГ=0"));
	
КонецПроцедуры

&НаКлиенте
Функция ПервыйПутьИзРезультатаДиалога(ВыбранныеФайлы)
	
	Если ТипЗнч(ВыбранныеФайлы) = Тип("Строка") Тогда
		Возврат СокрЛП(ВыбранныеФайлы);
	КонецЕсли;
	
	Для Каждого Элемент Из ВыбранныеФайлы Цикл
		Если ТипЗнч(Элемент) = Тип("Строка") Тогда
			Возврат СокрЛП(Элемент);
		КонецЕсли;
		Возврат СокрЛП(Строка(Элемент));
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

&НаКлиенте
Функция НормализоватьКаталогЖР(Знач Каталог)
	
	Каталог = СокрЛП(Каталог);
	Если ПустаяСтрока(Каталог) Тогда
		Возврат Каталог;
	КонецЕсли;
	
	Если ФайлСуществует(ПутьКСловарюЖР(Каталог)) Тогда
		Возврат Каталог;
	КонецЕсли;
	
	КаталогLog = ОбъединитьПуть(Каталог, ИмяКаталогаЖР());
	Если ФайлСуществует(ПутьКСловарюЖР(КаталогLog)) Тогда
		Возврат КаталогLog;
	КонецЕсли;
	
	Возврат Каталог;
	
КонецФункции

&НаКлиенте
Функция КаталогЖРФайловойБазы()
	
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	Маркер = "File=";
	Позиция = СтрНайти(ВРег(СтрокаСоединения), ВРег(Маркер));
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Остаток = Сред(СтрокаСоединения, Позиция + СтрДлина(Маркер));
	Если СтрНачинаетсяС(Остаток, """") Тогда
		Остаток = Сред(Остаток, 2);
		ПозицияКонца = СтрНайти(Остаток, """");
	Иначе
		ПозицияКонца = СтрНайти(Остаток, ";");
	КонецЕсли;
	
	Если ПозицияКонца > 0 Тогда
		ПутьБазы = Лев(Остаток, ПозицияКонца - 1);
	Иначе
		ПутьБазы = Остаток;
	КонецЕсли;
	
	Возврат ОбъединитьПуть(СокрЛП(ПутьБазы), ИмяКаталогаЖР());
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПутьКСловарюЖР(КаталогЖР)
	
	Возврат ОбъединитьПуть(КаталогЖР, ИмяФайлаСловаряЖР());
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОбъединитьПуть(Путь1, Путь2)
	
	#Если Клиент Тогда
		Разделитель = ПолучитьРазделительПутиКлиента();
	#Иначе
		Разделитель = ПолучитьРазделительПутиСервера();
	#КонецЕсли
	
	Если СтрЗаканчиваетсяНа(Путь1, Разделитель) Или СтрЗаканчиваетсяНа(Путь1, "/") Или СтрЗаканчиваетсяНа(Путь1, "\") Тогда
		Возврат Путь1 + Путь2;
	КонецЕсли;
	
	Возврат Путь1 + Разделитель + Путь2;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФайлСуществует(ПолноеИмя)
	
	ФайлНаДиске = Новый Файл(ПолноеИмя);
	Возврат ФайлНаДиске.Существует();
	
КонецФункции

#КонецОбласти

#Область АнализИПрисоединение

&НаКлиенте
Функция ВыполнитьАнализБезопасно(ПисатьОшибкуВПротокол)
	
	Попытка
		ВыполнитьАнализ();
		Возврат Истина;
	Исключение
		Информация = ИнформацияОбОшибке();
		Если ПисатьОшибкуВПротокол Тогда
			ДобавитьВПротокол("Ошибка анализа: " + КраткоеПредставлениеОшибки(Информация));
		КонецЕсли;
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(Информация));
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьАнализ()
	
	КаталогИсточника = НормализоватьКаталогЖР(КаталогИсточника);
	КаталогПриемника = НормализоватьКаталогЖР(КаталогПриемника);
	ПроверитьКаталоги();
	
	СловарьИсточника = ПрочитатьСловарьLgf(ПутьКСловарюЖР(КаталогИсточника));
	СловарьПриемника = ПрочитатьСловарьLgf(ПутьКСловарюЖР(КаталогПриемника));
	РезультатКарт = ПостроитьКартыПеренумерации(СловарьИсточника, СловарьПриемника);
	
	НужнаПеренумерация = РезультатКарт.НужнаПеренумерация;
	ЗаполнитьТаблицуФайловЖурнала();
	ЗаписатьПротоколАнализа(СловарьИсточника, СловарьПриемника, РезультатКарт);
	
	Если ФайлыЖурнала.Количество() = 0 Тогда
		ВызватьИсключение "В каталоге источника нет файлов .lgp.";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуФайловЖурнала()
	
	ФайлыЖурнала.Очистить();
	НайденныеФайлы = НайтиФайлы(КаталогИсточника, "*.lgp", Ложь);
	
	Для Каждого ФайлИсточника Из НайденныеФайлы Цикл
		
		СтрокаФайла = ФайлыЖурнала.Добавить();
		СтрокаФайла.Пометка = Истина;
		СтрокаФайла.ИмяФайла = ФайлИсточника.Имя;
		СтрокаФайла.ПолныйПутьИсточника = ФайлИсточника.ПолноеИмя;
		СтрокаФайла.ПолныйПутьПриемника = ОбъединитьПуть(КаталогПриемника, ФайлИсточника.Имя);
		СтрокаФайла.РазмерИсточника = ПредставлениеРазмера(ФайлИсточника.Размер());
		
		ФайлПриемника = Новый Файл(СтрокаФайла.ПолныйПутьПриемника);
		Если ФайлПриемника.Существует() Тогда
			СтрокаФайла.РазмерПриемника = ПредставлениеРазмера(ФайлПриемника.Размер());
			СтрокаФайла.Действие = РежимКонфликта;
		Иначе
			СтрокаФайла.РазмерПриемника = "-";
			СтрокаФайла.Действие = ДействиеСкопировать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПротоколАнализа(СловарьИсточника, СловарьПриемника, РезультатКарт)
	
	ДобавитьВПротокол("Источник: " + КаталогИсточника);
	ДобавитьВПротокол("Приёмник: " + КаталогПриемника);
	ДобавитьВПротокол("Записей словаря источника: " + ФорматЧислаПротокола(СловарьИсточника.Количество));
	ДобавитьВПротокол("Записей словаря приёмника: " + ФорматЧислаПротокола(СловарьПриемника.Количество));
	ДобавитьВПротокол("Новых записей в словарь приёмника: "
		+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	
	Если НужнаПеренумерация Тогда
		ДобавитьВПротокол("Номера объектов в .lgp не совпадают - будет выполнена перенумерация.");
	Иначе
		ДобавитьВПротокол("Номера объектов совпадают - файлы .lgp можно копировать без перенумерации.");
	КонецЕсли;
	
	ДобавитьВПротокол("Найдено файлов .lgp: " + ФорматЧислаПротокола(ФайлыЖурнала.Количество()));
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКаталоги()
	
	Если ПустаяСтрока(КаталогИсточника) Тогда
		ВызватьИсключение "Укажите каталог старого журнала регистрации.";
	КонецЕсли;
	Если ПустаяСтрока(КаталогПриемника) Тогда
		ВызватьИсключение "Укажите каталог текущего журнала регистрации.";
	КонецЕсли;
	
	ПроверитьЧтоКаталогСуществует(КаталогИсточника, "Каталог источника не найден: ");
	ПроверитьЧтоКаталогСуществует(КаталогПриемника, "Каталог приёмника не найден: ");
	
	Если ВРег(СокрЛП(КаталогИсточника)) = ВРег(СокрЛП(КаталогПриемника)) Тогда
		ВызватьИсключение "Каталоги источника и приёмника совпадают.";
	КонецЕсли;
	
	Если Не ФайлСуществует(ПутьКСловарюЖР(КаталогИсточника)) Тогда
		ВызватьИсключение "В каталоге источника нет 1Cv8.lgf. Укажите папку 1Cv8Log старого кластера.";
	КонецЕсли;
	Если Не ФайлСуществует(ПутьКСловарюЖР(КаталогПриемника)) Тогда
		ВызватьИсключение "В каталоге приёмника нет 1Cv8.lgf. Укажите папку 1Cv8Log текущего кластера.";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЧтоКаталогСуществует(ПутьКаталога, ПрефиксОшибки)
	
	КаталогФайл = Новый Файл(ПутьКаталога);
	Если Не КаталогФайл.Существует() Тогда
		ВызватьИсключение ПрефиксОшибки + ПутьКаталога;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрисоединитьПослеПодтверждения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТекстПротокола = "";
	
	Попытка
		ВыполнитьПрисоединение();
		ПоказатьПредупреждение(, "Присоединение завершено. См. протокол.");
	Исключение
		Информация = ИнформацияОбОшибке();
		ДобавитьВПротокол("Ошибка: " + ПодробноеПредставлениеОшибки(Информация));
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(Информация));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПрисоединение()
	
	ПроверитьКаталоги();
	
	ПутьLgfИсточника = ПутьКСловарюЖР(КаталогИсточника);
	ПутьLgfПриемника = ПутьКСловарюЖР(КаталогПриемника);
	
	СловарьИсточника = ПрочитатьСловарьLgf(ПутьLgfИсточника);
	СловарьПриемника = ПрочитатьСловарьLgf(ПутьLgfПриемника);
	РезультатКарт = ПостроитьКартыПеренумерации(СловарьИсточника, СловарьПриемника);
	НужнаПеренумерация = РезультатКарт.НужнаПеренумерация;
	
	Если СоздаватьРезервнуюКопию Тогда
		ПутьКопии = ПутьLgfПриемника + ".bak_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss");
		КопироватьФайл(ПутьLgfПриемника, ПутьКопии);
		ДобавитьВПротокол("Резервная копия словаря: " + ПутьКопии);
	КонецЕсли;
	
	Если РезультатКарт.ДобавленныеСтроки.Количество() > 0 Тогда
		ДописатьСтрокиВLgf(ПутьLgfПриемника, РезультатКарт.ДобавленныеСтроки);
		ДобавитьВПротокол("В 1Cv8.lgf добавлено записей: "
			+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	Иначе
		ДобавитьВПротокол("Словарь приёмника уже содержит все объекты источника.");
	КонецЕсли;
	
	Обработано = 0;
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		
		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		ОбработкаПрерыванияПользователя();
		Состояние("Присоединение " + СтрокаФайла.ИмяФайла);
		
		Если СтрокаФайла.Действие = РежимКонфликтаПропустить()
			И ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
			ДобавитьВПротокол("Пропущен (уже есть): " + СтрокаФайла.ИмяФайла);
			Продолжить;
		КонецЕсли;
		
		Объединять = (СтрокаФайла.Действие = РежимКонфликтаОбъединить()
			И ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника));
		
		ПрисоединитьФайлLgp(
			СтрокаФайла.ПолныйПутьИсточника,
			СтрокаФайла.ПолныйПутьПриемника,
			СловарьПриемника,
			РезультатКарт.Карты,
			Объединять);
		
		Если Объединять Тогда
			ДобавитьВПротокол("Объединён: " + СтрокаФайла.ИмяФайла);
		Иначе
			ДобавитьВПротокол("Скопирован: " + СтрокаФайла.ИмяФайла);
		КонецЕсли;
		
		Обработано = Обработано + 1;
		
	КонецЦикла;
	
	УдалитьИндексыЖурнала(КаталогПриемника);
	ДобавитьВПротокол("Обработано файлов: " + ФорматЧислаПротокола(Обработано));
	ДобавитьВПротокол("Индексы *.lgx удалены - платформа построит их заново при открытии ЖР.");
	ДобавитьВПротокол("Готово. Если работали с копией, остановите кластер и подмените каталог 1Cv8Log.");
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИндексыЖурнала(КаталогЖР)
	
	ФайлыИндекса = НайтиФайлы(КаталогЖР, "*.lgx", Ложь);
	Для Каждого ФайлИндекса Из ФайлыИндекса Цикл
		Попытка
			УдалитьФайлы(ФайлИндекса.ПолноеИмя);
		Исключение
			ДобавитьВПротокол("Не удалось удалить индекс " + ФайлИндекса.Имя + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция КоличествоОтмеченныхФайлов()
	
	Результат = 0;
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		Если СтрокаФайла.Пометка Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПометкиФайлов(Пометка)
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		СтрокаФайла.Пометка = Пометка;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СловарьLgf

&НаКлиенте
Функция ПрочитатьСловарьLgf(ПутьКФайлу)
	
	Результат = НовыйСловарьLgf();
	Чтение = ОткрытьЧтениеЖурнала(ПутьКФайлу);
	
	НомерСтроки = 0;
	Пока Истина Цикл
		
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		Если НомерСтроки = 1 Тогда
			Результат.Версия = СокрЛП(СтрокаФайла);
			Продолжить;
		ИначеЕсли НомерСтроки = 2 Тогда
			Результат.GUID = СокрЛП(СтрокаФайла);
			Продолжить;
		КонецЕсли;
		
		ДобавитьЗаписьСловаряИзСтроки(Результат, СтрокаФайла);
		
	КонецЦикла;
	
	Чтение.Закрыть();
	
	Если СтрНайти(Результат.Версия, МаркерФорматаЖР()) = 0 Тогда
		ВызватьИсключение "Файл не похож на словарь журнала регистрации: " + ПутьКФайлу;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НовыйСловарьLgf()
	
	Результат = Новый Структура;
	Результат.Вставить("Версия", "");
	Результат.Вставить("GUID", "");
	Результат.Вставить("ПоНомеру", Новый Соответствие);
	Результат.Вставить("ПоКлючу", Новый Соответствие);
	Результат.Вставить("МаксНомер", Новый Соответствие);
	Результат.Вставить("Количество", 0);
	
	Для ТипОбъекта = 1 По МаксимальныйТипОбъектаСловаря() Цикл
		Результат.ПоНомеру.Вставить(ТипОбъекта, Новый Соответствие);
		Результат.ПоКлючу.Вставить(ТипОбъекта, Новый Соответствие);
		Результат.МаксНомер.Вставить(ТипОбъекта, 0);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьЗаписьСловаряИзСтроки(Словарь, Знач СтрокаФайла)
	
	СтрокаФайла = УбратьХвостовуюЗапятую(СокрЛП(СтрокаФайла));
	Если Не ЭтоСкобочнаяЗапись(СтрокаФайла) Тогда
		Возврат;
	КонецЕсли;
	
	Токены = Токенизировать(ТелоСкобочнойЗаписи(СтрокаФайла));
	Если Токены.Количество() < 3 Тогда
		Возврат;
	КонецЕсли;
	
	ТипОбъекта = ЧислоИзТокена(Токены[1]);
	Номер = ЧислоИзТокена(Токены[Токены.ВГраница()]);
	Если ТипОбъекта < 1 Или ТипОбъекта > МаксимальныйТипОбъектаСловаря() Или Номер <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	Описание = Новый Структура("ТипОбъекта,Номер,Имя,UUID,Ключ", ТипОбъекта, Номер, "", "", "");
	Если ЭтоТипСUUID(ТипОбъекта) И Токены.Количество() >= 4 Тогда
		Описание.UUID = СнятьКавычки(Токены[2]);
		Описание.Имя = СнятьКавычки(Токены[3]);
		Описание.Ключ = НРег(Описание.UUID);
		Если ПустаяСтрока(Описание.Ключ) Тогда
			Описание.Ключ = НРег(Описание.Имя);
		КонецЕсли;
	Иначе
		Описание.Имя = СнятьКавычки(Токены[2]);
		Описание.Ключ = НРег(Описание.Имя);
	КонецЕсли;
	
	Если ПустаяСтрока(Описание.Ключ) Тогда
		Возврат;
	КонецЕсли;
	
	Словарь.ПоНомеру.Получить(ТипОбъекта).Вставить(Номер, Описание);
	Словарь.ПоКлючу.Получить(ТипОбъекта).Вставить(Описание.Ключ, Номер);
	Если Номер > Словарь.МаксНомер.Получить(ТипОбъекта) Тогда
		Словарь.МаксНомер.Вставить(ТипОбъекта, Номер);
	КонецЕсли;
	Словарь.Количество = Словарь.Количество + 1;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПостроитьКартыПеренумерации(СловарьИсточника, СловарьПриемника)
	
	Карты = Новый Соответствие;
	ДобавленныеСтроки = Новый Массив;
	НужнаПеренумерация = Ложь;
	
	Для ТипОбъекта = 1 По МаксимальныйТипОбъектаСловаря() Цикл
		
		Карта = Новый Соответствие;
		Карты.Вставить(ТипОбъекта, Карта);
		МаксНомер = СловарьПриемника.МаксНомер.Получить(ТипОбъекта);
		ИсточникПоНомеру = СловарьИсточника.ПоНомеру.Получить(ТипОбъекта);
		ПриемникПоКлючу = СловарьПриемника.ПоКлючу.Получить(ТипОбъекта);
		
		Для Каждого Пара Из ИсточникПоНомеру Цикл
			
			СтарыйНомер = Пара.Ключ;
			Описание = Пара.Значение;
			НовыйНомер = ПриемникПоКлючу.Получить(Описание.Ключ);
			
			Если НовыйНомер = Неопределено Тогда
				МаксНомер = МаксНомер + 1;
				НовыйНомер = МаксНомер;
				ДобавленныеСтроки.Добавить(СформироватьСтрокуСловаря(Описание, НовыйНомер));
				ПриемникПоКлючу.Вставить(Описание.Ключ, НовыйНомер);
			КонецЕсли;
			
			Карта.Вставить(СтарыйНомер, НовыйНомер);
			Если НовыйНомер <> СтарыйНомер Тогда
				НужнаПеренумерация = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		СловарьПриемника.МаксНомер.Вставить(ТипОбъекта, МаксНомер);
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("Карты", Карты);
	Результат.Вставить("ДобавленныеСтроки", ДобавленныеСтроки);
	Результат.Вставить("НужнаПеренумерация", НужнаПеренумерация);
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьСтрокуСловаря(Описание, Номер)
	
	НомерСтрокой = ФорматЧислаПротокола(Номер);
	ТипСтрокой = ФорматЧислаПротокола(Описание.ТипОбъекта);
	
	Если ЭтоТипСUUID(Описание.ТипОбъекта) Тогда
		Возврат "{" + ТипСтрокой + ",""" + ЭкранироватьКавычки(Описание.UUID) + ""","""
			+ ЭкранироватьКавычки(Описание.Имя) + """," + НомерСтрокой + "},";
	КонецЕсли;
	
	Возврат "{" + ТипСтрокой + ",""" + ЭкранироватьКавычки(Описание.Имя) + """," + НомерСтрокой + "},";
	
КонецФункции

&НаКлиенте
Процедура ДописатьСтрокиВLgf(ПутьКФайлу, ДобавленныеСтроки)
	
	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(ПутьКФайлу, КодировкаТекста.UTF8);
	
	КоличествоСтрок = Текст.КоличествоСтрок();
	Пока КоличествоСтрок > 0 И ПустаяСтрока(СокрЛП(Текст.ПолучитьСтроку(КоличествоСтрок))) Цикл
		Текст.УдалитьСтроку(КоличествоСтрок);
		КоличествоСтрок = Текст.КоличествоСтрок();
	КонецЦикла;
	
	Если КоличествоСтрок > 0 Тогда
		Последняя = СокрЛП(Текст.ПолучитьСтроку(КоличествоСтрок));
		Если Не ПустаяСтрока(Последняя) И Не СтрЗаканчиваетсяНа(Последняя, ",") Тогда
			Текст.ЗаменитьСтроку(КоличествоСтрок, Текст.ПолучитьСтроку(КоличествоСтрок) + ",");
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого СтрокаСловаря Из ДобавленныеСтроки Цикл
		Текст.ДобавитьСтроку(СтрокаСловаря);
	КонецЦикла;
	
	Текст.Записать(ПутьКФайлу, КодировкаТекста.UTF8);
	
КонецПроцедуры

#КонецОбласти

#Область ФайлыLgp

&НаКлиенте
Процедура ПрисоединитьФайлLgp(ПутьИсточника, ПутьПриемника, СловарьПриемника, Карты, Объединять)
	
	Если Не Объединять И Не НужнаПеренумерация Тогда
		КопироватьФайлСЗаменой(ПутьИсточника, ПутьПриемника);
		Возврат;
	КонецЕсли;
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("lgp");
	Запись = Новый ЗаписьТекста(ВременныйФайл, КодировкаТекста.UTF8);
	
	Если Объединять И ФайлСуществует(ПутьПриемника) Тогда
		СкопироватьПриемникСЗапятой(ПутьПриемника, Запись);
	Иначе
		Запись.ЗаписатьСтроку(СловарьПриемника.Версия);
		Запись.ЗаписатьСтроку(СловарьПриемника.GUID);
	КонецЕсли;
	
	ВыгрузитьЗаписиLgp(ПутьИсточника, Запись, Карты, НужнаПеренумерация);
	Запись.Закрыть();
	
	КопироватьФайлСЗаменой(ВременныйФайл, ПутьПриемника);
	УдалитьФайлы(ВременныйФайл);
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьПриемникСЗапятой(ПутьПриемника, Запись)
	
	Чтение = ОткрытьЧтениеЖурнала(ПутьПриемника);
	ПоследняяЗначимая = "";
	
	Пока Истина Цикл
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если ПоследняяЗначимая <> "" Тогда
			Запись.ЗаписатьСтроку(ПоследняяЗначимая);
		КонецЕсли;
		ПоследняяЗначимая = СтрокаФайла;
	КонецЦикла;
	
	Чтение.Закрыть();
	
	Если ПоследняяЗначимая <> "" Тогда
		ПоследняяЗначимая = ОбеспечитьХвостовуюЗапятую(ПоследняяЗначимая);
		Запись.ЗаписатьСтроку(ПоследняяЗначимая);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьЗаписиLgp(ПутьИсточника, Запись, Карты, Перенумеровывать)
	
	Чтение = ОткрытьЧтениеЖурнала(ПутьИсточника);
	
	НомерСтроки = 0;
	БуферЗаписи = "";
	Глубина = 0;
	ВКавычках = Ложь;
	СчетчикЗаписей = 0;
	
	Пока Истина Цикл
		
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		Если НомерСтроки <= 2 И Глубина = 0 И ПустаяСтрока(БуферЗаписи) Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках);
		
		Если Глубина = 0 И Не ПустаяСтрока(БуферЗаписи) Тогда
			ТекстЗаписи = ПодготовитьТекстЗаписиLgp(БуферЗаписи, Карты, Перенумеровывать);
			БуферЗаписи = "";
			Если ПустаяСтрока(ТекстЗаписи) Тогда
				Продолжить;
			КонецЕсли;
			
			Запись.ЗаписатьСтроку(ТекстЗаписи);
			СчетчикЗаписей = СчетчикЗаписей + 1;
			Если СчетчикЗаписей % 2000 = 0 Тогда
				ОбработкаПрерыванияПользователя();
				Состояние("Перенумерация записей: " + Формат(СчетчикЗаписей, "ЧГ=0"));
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Чтение.Закрыть();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПодготовитьТекстЗаписиLgp(БуферЗаписи, Карты, Перенумеровывать)
	
	ТекстЗаписи = СокрЛП(БуферЗаписи);
	Если ТекстЗаписи = "" Или ТекстЗаписи = "," Тогда
		Возврат "";
	КонецЕсли;
	
	Если СтрНачинаетсяС(ТекстЗаписи, ",") Тогда
		ТекстЗаписи = СокрЛП(Сред(ТекстЗаписи, 2));
	КонецЕсли;
	Если Перенумеровывать Тогда
		ТекстЗаписи = ПеренумероватьЗаписьLgp(ТекстЗаписи, Карты);
	КонецЕсли;
	
	Возврат ОбеспечитьХвостовуюЗапятую(ТекстЗаписи);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках)
	
	Если Не ПустаяСтрока(БуферЗаписи) Тогда
		БуферЗаписи = БуферЗаписи + Символы.ПС;
	КонецЕсли;
	БуферЗаписи = БуферЗаписи + СтрокаФайла;
	
	ОбновитьСостояниеСкобокИКавычек(СтрокаФайла, Глубина, ВКавычках);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьСостояниеСкобокИКавычек(СтрокаФайла, Глубина, ВКавычках)
	
	Индекс = 1;
	Длина = СтрДлина(СтрокаФайла);
	Пока Индекс <= Длина Цикл
		Символ = Сред(СтрокаФайла, Индекс, 1);
		Если ВКавычках Тогда
			Если Символ = """" Тогда
				Если Сред(СтрокаФайла, Индекс + 1, 1) = """" Тогда
					Индекс = Индекс + 2;
					Продолжить;
				КонецЕсли;
				ВКавычках = Ложь;
			КонецЕсли;
		ИначеЕсли Символ = """" Тогда
			ВКавычках = Истина;
		ИначеЕсли Символ = "{" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = "}" Тогда
			Глубина = Глубина - 1;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПеренумероватьЗаписьLgp(ТекстЗаписи, Карты)
	
	Сжатая = СокрЛП(ТекстЗаписи);
	ХвостоваяЗапятая = СтрЗаканчиваетсяНа(Сжатая, ",");
	Если ХвостоваяЗапятая Тогда
		Сжатая = Лев(Сжатая, СтрДлина(Сжатая) - 1);
	КонецЕсли;
	Если Не ЭтоСкобочнаяЗапись(Сжатая) Тогда
		Возврат ТекстЗаписи;
	КонецЕсли;
	
	Токены = Токенизировать(ТелоСкобочнойЗаписи(Сжатая));
	КоличествоТокенов = Токены.Количество();
	
	Для Каждого ПолеСсылки Из ПоляСсылокЗаписиLgp() Цикл
		Если КоличествоТокенов < ПолеСсылки.ИндексПоля Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПолеСсылки.Составное Тогда
			Токены[ПолеСсылки.ИндексПоля] = ПеренумероватьСоставноеПоле(
				Токены[ПолеСсылки.ИндексПоля],
				Карты.Получить(ПолеСсылки.ТипОбъекта));
		Иначе
			Токены[ПолеСсылки.ИндексПоля] = ЗаменитьНомерПоТипу(
				Токены[ПолеСсылки.ИндексПоля],
				Карты,
				ПолеСсылки.ТипОбъекта);
		КонецЕсли;
	КонецЦикла;
	
	Результат = "{" + СтрСоединить(Токены, ",") + "}";
	Если ХвостоваяЗапятая Тогда
		Результат = Результат + ",";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаменитьНомерПоТипу(Токен, Карты, ТипОбъекта)
	
	Карта = Карты.Получить(ТипОбъекта);
	Если Карта = Неопределено Тогда
		Возврат Токен;
	КонецЕсли;
	
	Возврат ЗаменитьНомер(Токен, Карта);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаменитьНомер(Токен, Карта)
	
	Значение = СокрЛП(Токен);
	Номер = ЧислоИзТокена(Значение);
	Если Номер <= 0 Тогда
		Возврат Токен;
	КонецЕсли;
	
	НовыйНомер = Карта.Получить(Номер);
	Если НовыйНомер = Неопределено Тогда
		Возврат Токен;
	КонецЕсли;
	
	Возврат ФорматЧислаПротокола(НовыйНомер);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПеренумероватьСоставноеПоле(Токен, Карта)
	
	Если Карта = Неопределено Тогда
		Возврат Токен;
	КонецЕсли;
	
	Значение = СокрЛП(Токен);
	Если Не СтрНачинаетсяС(Значение, "{") Тогда
		Возврат ЗаменитьНомер(Токен, Карта);
	КонецЕсли;
	Если Не СтрЗаканчиваетсяНа(Значение, "}") Тогда
		Возврат Токен;
	КонецЕсли;
	
	Части = Токенизировать(ТелоСкобочнойЗаписи(Значение));
	Для Индекс = 1 По Части.Количество() Цикл
		Части[Индекс] = ЗаменитьНомер(Части[Индекс], Карта);
	КонецЦикла;
	
	Возврат "{" + СтрСоединить(Части, ",") + "}";
	
КонецФункции

&НаКлиенте
Процедура КопироватьФайлСЗаменой(Источник, Приемник)
	
	Если ФайлСуществует(Приемник) Тогда
		УдалитьФайлы(Приемник);
	КонецЕсли;
	КопироватьФайл(Источник, Приемник);
	
КонецПроцедуры

#КонецОбласти

#Область РазборТекста

&НаКлиенте
Функция ОткрытьЧтениеЖурнала(ПутьКФайлу)
	
	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ПерваяСтрока = Чтение.ПрочитатьСтроку();
	Чтение.Закрыть();
	
	Кодировка = КодировкаТекста.UTF8;
	Если ПерваяСтрока <> Неопределено И СтрНайти(ПерваяСтрока, МаркерФорматаЖР()) = 0 Тогда
		Кодировка = КодировкаТекста.UTF16;
	КонецЕсли;
	
	Возврат Новый ЧтениеТекста(ПутьКФайлу, Кодировка);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция Токенизировать(Знач Текст)
	
	Токены = Новый Массив;
	Текущий = "";
	Глубина = 0;
	ВКавычках = Ложь;
	Индекс = 1;
	Длина = СтрДлина(Текст);
	
	Пока Индекс <= Длина Цикл
		
		Символ = Сред(Текст, Индекс, 1);
		
		Если ВКавычках Тогда
			Текущий = Текущий + Символ;
			Если Символ = """" Тогда
				Если Сред(Текст, Индекс + 1, 1) = """" Тогда
					Текущий = Текущий + """";
					Индекс = Индекс + 2;
					Продолжить;
				КонецЕсли;
				ВКавычках = Ложь;
			КонецЕсли;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		
		Если Символ = """" Тогда
			ВКавычках = Истина;
			Текущий = Текущий + Символ;
		ИначеЕсли Символ = "{" Тогда
			Глубина = Глубина + 1;
			Текущий = Текущий + Символ;
		ИначеЕсли Символ = "}" Тогда
			Глубина = Глубина - 1;
			Текущий = Текущий + Символ;
		ИначеЕсли Символ = "," И Глубина = 0 Тогда
			Токены.Добавить(СокрЛП(Текущий));
			Текущий = "";
		Иначе
			Текущий = Текущий + Символ;
		КонецЕсли;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	Если Не ПустаяСтрока(Текущий) Или Длина > 0 Тогда
		Токены.Добавить(СокрЛП(Текущий));
	КонецЕсли;
	
	Возврат Токены;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоСкобочнаяЗапись(Знач Значение)
	
	Возврат СтрНачинаетсяС(Значение, "{") И СтрЗаканчиваетсяНа(Значение, "}");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТелоСкобочнойЗаписи(Знач Значение)
	
	Возврат Сред(Значение, 2, СтрДлина(Значение) - 2);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция УбратьХвостовуюЗапятую(Знач Значение)
	
	Если СтрЗаканчиваетсяНа(Значение, ",") Тогда
		Возврат Лев(Значение, СтрДлина(Значение) - 1);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОбеспечитьХвостовуюЗапятую(Знач Значение)
	
	Если ПустаяСтрока(СокрЛП(Значение)) Тогда
		Возврат Значение;
	КонецЕсли;
	Если Не СтрЗаканчиваетсяНа(СокрЛП(Значение), ",") Тогда
		Возврат Значение + ",";
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СнятьКавычки(Знач Значение)
	
	Значение = СокрЛП(Значение);
	Если СтрДлина(Значение) >= 2 И СтрНачинаетсяС(Значение, """") И СтрЗаканчиваетсяНа(Значение, """") Тогда
		Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
		Значение = СтрЗаменить(Значение, """""", """");
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭкранироватьКавычки(Знач Значение)
	
	Возврат СтрЗаменить(Строка(Значение), """", """""");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЧислоИзТокена(Знач Значение)
	
	Значение = СокрЛП(Значение);
	Если ПустаяСтрока(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Индекс);
		Если Код < 48 Или Код > 57 Тогда
			Возврат 0;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Число(Значение);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФорматЧислаПротокола(Значение)
	
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеРазмера(Размер)
	
	Если Размер < 1024 Тогда
		Возврат ФорматЧислаПротокола(Размер) + " Б";
	ИначеЕсли Размер < 1024 * 1024 Тогда
		Возврат Формат(Размер / 1024, "ЧДЦ=1; ЧН=0") + " КБ";
	ИначеЕсли Размер < 1024 * 1024 * 1024 Тогда
		Возврат Формат(Размер / 1024 / 1024, "ЧДЦ=1; ЧН=0") + " МБ";
	КонецЕсли;
	
	Возврат Формат(Размер / 1024 / 1024 / 1024, "ЧДЦ=2; ЧН=0") + " ГБ";
	
КонецФункции

#КонецОбласти

#Область Протокол

&НаКлиенте
Процедура ДобавитьВПротокол(Текст)
	
	Если ПустаяСтрока(ТекстПротокола) Тогда
		ТекстПротокола = Текст;
	Иначе
		ТекстПротокола = ТекстПротокола + Символы.ПС + Текст;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
