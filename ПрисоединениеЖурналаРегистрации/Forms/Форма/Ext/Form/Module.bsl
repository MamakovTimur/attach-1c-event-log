&НаКлиенте
Процедура ПрисоединитьПослеПодтверждения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТекстПротокола = "";
	ПодготовитьСеансОтладки("attach");
	
	Попытка
		Если ВыполнятьНаСервере Тогда
			ВыполнитьПрисоединениеНаСервереБезопасно();
		Иначе
			ВыполнитьПрисоединение();
		КонецЕсли;
		ПоказатьПредупреждение(, "Присоединение завершено. См. протокол.");
	Исключение
		Информация = ИнформацияОбОшибке();
		ДобавитьВПротокол("Ошибка: " + ПодробноеПредставлениеОшибки(Информация));
		ДобавитьВОтладочныйЛог("[ERROR] attach_failed=" + КраткоеПредставлениеОшибки(Информация));
		ДобавитьВОтладочныйЛог(ПодробноеПредставлениеОшибки(Информация));
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(Информация));
	КонецПопытки;
	
КонецПроцедуры

