&НаКлиенте
Процедура ЗаписатьПротоколПланаПоФайлам()
	
	ДобавитьВПротокол("--- План по файлам .lgp ---");
	ДобавитьВПротокол("Найдено файлов .lgp: " + ФорматЧислаПротокола(ФайлыЖурнала.Количество()));
	
	ОбъёмБайт = 0;
	Скопировать = 0;
	Объединить = 0;
	Пропустить = 0;
	Заменить = 0;
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		
		ФайлИсточника = Новый Файл(СтрокаФайла.ПолныйПутьИсточника);
		Если ФайлИсточника.Существует() Тогда
			ОбъёмБайт = ОбъёмБайт + ФайлИсточника.Размер();
		КонецЕсли;
		
		Если СтрокаФайла.Действие = ДействиеСкопировать() Тогда
			Скопировать = Скопировать + 1;
		ИначеЕсли СтрокаФайла.Действие = РежимКонфликтаОбъединить() Тогда
			Объединить = Объединить + 1;
		ИначеЕсли СтрокаФайла.Действие = РежимКонфликтаПропустить() Тогда
			Пропустить = Пропустить + 1;
		ИначеЕсли СтрокаФайла.Действие = РежимКонфликтаЗаменить() Тогда
			Заменить = Заменить + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	ДобавитьВПротокол("Скопировать (нет в приёмнике): " + ФорматЧислаПротокола(Скопировать));
	ДобавитьВПротокол("Объединить (конфликт): " + ФорматЧислаПротокола(Объединить));
	ДобавитьВПротокол("Заменить (конфликт): " + ФорматЧислаПротокола(Заменить));
	ДобавитьВПротокол("Пропустить (конфликт): " + ФорматЧислаПротокола(Пропустить));
	ДобавитьВПротокол("Объём исходных .lgp: " + ПредставлениеРазмера(ОбъёмБайт));
	Если СоздаватьРезервнуюКопию Тогда
		ДобавитьВПротокол("Перед записью: полная копия каталога приёмника рядом с ним (*.bak_...).");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПротоколПланаПоФайламНаСервереКонтекста()
	
	ДобавитьВПротоколНаСервереКонтекста("--- План по файлам .lgp ---");
	ДобавитьВПротоколНаСервереКонтекста("Найдено файлов .lgp: " + ФорматЧислаПротокола(ФайлыЖурнала.Количество()));
	
	ОбъёмБайт = 0;
	Скопировать = 0;
	Объединить = 0;
	Пропустить = 0;
	Заменить = 0;
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		
		ФайлИсточника = Новый Файл(СтрокаФайла.ПолныйПутьИсточника);
		Если ФайлИсточника.Существует() Тогда
			ОбъёмБайт = ОбъёмБайт + ФайлИсточника.Размер();
		КонецЕсли;
		
		Если СтрокаФайла.Действие = ДействиеСкопировать() Тогда
			Скопировать = Скопировать + 1;
		ИначеЕсли СтрокаФайла.Действие = РежимКонфликтаОбъединить() Тогда
			Объединить = Объединить + 1;
		ИначеЕсли СтрокаФайла.Действие = РежимКонфликтаПропустить() Тогда
			Пропустить = Пропустить + 1;
		ИначеЕсли СтрокаФайла.Действие = РежимКонфликтаЗаменить() Тогда
			Заменить = Заменить + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	ДобавитьВПротоколНаСервереКонтекста("Скопировать (нет в приёмнике): " + ФорматЧислаПротокола(Скопировать));
	ДобавитьВПротоколНаСервереКонтекста("Объединить (конфликт): " + ФорматЧислаПротокола(Объединить));
	ДобавитьВПротоколНаСервереКонтекста("Заменить (конфликт): " + ФорматЧислаПротокола(Заменить));
	ДобавитьВПротоколНаСервереКонтекста("Пропустить (конфликт): " + ФорматЧислаПротокола(Пропустить));
	ДобавитьВПротоколНаСервереКонтекста("Объём исходных .lgp: " + ПредставлениеРазмера(ОбъёмБайт));
	Если СоздаватьРезервнуюКопию Тогда
		ДобавитьВПротоколНаСервереКонтекста("Перед записью: полная копия каталога приёмника рядом с ним (*.bak_...).");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПротоколЦелостности(СловарьИсточника, СловарьПриемника)
	
	ДобавитьВПротокол("--- Проверка целостности (выборка) ---");
	Проблемы = 0;
	Проверено = 0;
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		
		Проверено = Проверено + 1;
		Результат = ПроверитьЦелостностьФайлаLgp(
			СтрокаФайла.ПолныйПутьИсточника,
			СловарьИсточника.GUID,
			СловарьИсточника.Версия);
		
		Если Не Результат.Ок Тогда
			Проблемы = Проблемы + 1;
			ДобавитьВПротокол("  " + СтрокаФайла.ИмяФайла + ": " + Результат.Сообщение);
		КонецЕсли;
		
		Если ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
			РезультатПриемника = ПроверитьЦелостностьФайлаLgp(
				СтрокаФайла.ПолныйПутьПриемника,
				СловарьПриемника.GUID,
				СловарьПриемника.Версия);
			Если Не РезультатПриемника.Ок Тогда
				Проблемы = Проблемы + 1;
				ДобавитьВПротокол("  (приёмник) " + СтрокаФайла.ИмяФайла + ": " + РезультатПриемника.Сообщение);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Проблемы = 0 Тогда
		ДобавитьВПротокол("Целостность: замечаний нет (проверено файлов источника: "
			+ ФорматЧислаПротокола(Проверено) + ").");
	Иначе
		ДобавитьВПротокол("Целостность: замечаний " + ФорматЧислаПротокола(Проблемы) + ".");
	КонецЕсли;
	
КонецПроцедуры

