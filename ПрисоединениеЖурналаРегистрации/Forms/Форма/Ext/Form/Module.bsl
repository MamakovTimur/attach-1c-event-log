&НаКлиенте
Процедура ЗаписатьОтладочныйСнимокАнализа(СловарьИсточника, СловарьПриемника, РезультатКарт)

	Если Не РежимОтладки Тогда
		Возврат;
	КонецЕсли;

	ДобавитьВОтладочныйЛог("--- [DBG] analyze snapshot ---");
	ДобавитьВОтладочныйЛог("[METRIC] lgf_src_entries=" + ФорматЧислаПротокола(СловарьИсточника.Количество));
	ДобавитьВОтладочныйЛог("[METRIC] lgf_dst_entries=" + ФорматЧислаПротокола(СловарьПриемника.Количество));
	ДобавитьВОтладочныйЛог("[METRIC] lgf_new_entries="
		+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	ДобавитьВОтладочныйЛог("[METRIC] need_renumber=" + ?(НужнаПеренумерация, "true", "false"));
	ДобавитьВОтладочныйЛог("[METRIC] guid_src=" + СловарьИсточника.GUID);
	ДобавитьВОтладочныйЛог("[METRIC] guid_dst=" + СловарьПриемника.GUID);

	ДобавитьВОтладочныйЛог(
		"[DBG] dry-run snapshot: только размеры файлов (без полного скана .lgp; приёмник не открывается).");
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		МетрикиИсточника = СобратьМетрикиФайлаLgpТолькоРазмер(СтрокаФайла.ПолныйПутьИсточника);
		ДобавитьВОтладочныйЛог("--- [FILE] " + СтрокаФайла.ИмяФайла
			+ " action=" + Строка(СтрокаФайла.Действие) + " marked="
			+ ?(СтрокаФайла.Пометка, "true", "false") + " ---");
		ДобавитьВОтладочныйЛог(СтрокаМетрикLgpЛегкие("src", МетрикиИсточника));
		ДобавитьВОтладочныйЛог(СтрокаМетрикLgpЛегкие("dst_before",
			СобратьМетрикиФайлаLgpТолькоРазмер(СтрокаФайла.ПолныйПутьПриемника)));
	КонецЦикла;

	ДобавитьВОтладочныйЛог("=== DEBUG SESSION analyze END ===");

КонецПроцедуры

&НаСервере
Процедура ЗаписатьОтладочныйСнимокАнализаНаСервереКонтекста(СловарьИсточника, СловарьПриемника, РезультатКарт)

	Если Не РежимОтладки Тогда
		Возврат;
	КонецЕсли;

	ДобавитьВОтладочныйЛогНаСервереКонтекста("--- [DBG] analyze snapshot ---");
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] lgf_src_entries=" + ФорматЧислаПротокола(СловарьИсточника.Количество));
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] lgf_dst_entries=" + ФорматЧислаПротокола(СловарьПриемника.Количество));
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] lgf_new_entries="
		+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] need_renumber=" + ?(НужнаПеренумерация, "true", "false"));
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] guid_src=" + СловарьИсточника.GUID);
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] guid_dst=" + СловарьПриемника.GUID);

	ДобавитьВОтладочныйЛогНаСервереКонтекста(
		"[DBG] dry-run snapshot: только размеры файлов (без полного скана .lgp; приёмник не открывается).");
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		МетрикиИсточника = СобратьМетрикиФайлаLgpТолькоРазмер(СтрокаФайла.ПолныйПутьИсточника);
		ДобавитьВОтладочныйЛогНаСервереКонтекста("--- [FILE] " + СтрокаФайла.ИмяФайла
			+ " action=" + Строка(СтрокаФайла.Действие) + " marked="
			+ ?(СтрокаФайла.Пометка, "true", "false") + " ---");
		ДобавитьВОтладочныйЛогНаСервереКонтекста(СтрокаМетрикLgpЛегкие("src", МетрикиИсточника));
		ДобавитьВОтладочныйЛогНаСервереКонтекста(СтрокаМетрикLgpЛегкие("dst_before",
			СобратьМетрикиФайлаLgpТолькоРазмер(СтрокаФайла.ПолныйПутьПриемника)));
	КонецЦикла;

	ДобавитьВОтладочныйЛогНаСервереКонтекста("=== DEBUG SESSION analyze END ===");

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьОтладкуОперацииФайла(ИмяФайла, Объединять, СведенияФайла, МетрикиИсточника, МетрикиДо, МетрикиПосле)

	Если Не РежимОтладки Тогда
		Возврат;
	КонецЕсли;

	СтрокиОтладки = СтрокиОтладкиОперацииФайла(
		ИмяФайла, Объединять, СведенияФайла, МетрикиИсточника, МетрикиДо, МетрикиПосле);
	Для Индекс = 0 По СтрокиОтладки.ВГраница() Цикл
		ДобавитьВОтладочныйЛог(СтрокиОтладки[Индекс]);
	КонецЦикла;

КонецПроцедуры

