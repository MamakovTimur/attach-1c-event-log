		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПротоколАнализа(СловарьИсточника, СловарьПриемника, РезультатКарт)
	
	МоментНачала = ТекущаяДата();
	ДобавитьВПротокол("=== DRY-RUN / ПЛАН (запись не выполняется) ===");
	Если ВыполнятьНаСервере Тогда
		ДобавитьВПротокол("Контекст файлов: СЕРВЕР приложений 1С (пути как на сервере).");
	Иначе
		ДобавитьВПротокол("Контекст файлов: КЛИЕНТ.");
	КонецЕсли;
	ДобавитьВПротокол("Источник: " + КаталогИсточника);
	ДобавитьВПротокол("Приёмник: " + КаталогПриемника);
	ДобавитьВПротокол("Идентификатор старого журнала (GUID): " + СловарьИсточника.GUID);
	ДобавитьВПротокол("Идентификатор нового журнала (GUID): " + СловарьПриемника.GUID);
	Если ВРег(СокрЛП(СловарьИсточника.GUID)) <> ВРег(СокрЛП(СловарьПриемника.GUID)) Тогда
		Для Каждого СтрокаПредупреждения Из СтрокиПредупрежденияРазныхИдентификаторовЖурнала(НужнаПеренумерация) Цикл
			ДобавитьВПротокол(СтрокаПредупреждения);
		КонецЦикла;
	Иначе
		ДобавитьВПротокол("Идентификаторы совпадают — заголовки периодов уже от того же журнала.");
	КонецЕсли;
	
	ДобавитьВПротокол("Записей словаря источника: " + ФорматЧислаПротокола(СловарьИсточника.Количество));
	ДобавитьВПротокол("Записей словаря приёмника: " + ФорматЧислаПротокола(СловарьПриемника.Количество));
	ДобавитьВПротокол("Новых записей в словарь приёмника: "
		+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	
	Если НужнаПеренумерация Тогда
		ДобавитьВПротокол("Номера пользователей/событий в файлах периодов не совпадают с новым словарём — будет перенумерация.");
	Иначе
		ДобавитьВПротокол("Номера объектов совпадают — полная перенумерация не нужна (при разном GUID заголовок .lgp всё равно будет согласован с новым журналом).");
	КонецЕсли;
	
	ЗаписатьПротоколКартыПеренумерации(РезультатКарт);
	ЗаписатьПротоколПланаПоФайлам();
	
	Если ПроверятьЦелостность Тогда
		ЗаписатьПротоколЦелостности(СловарьИсточника, СловарьПриемника);
	КонецЕсли;
	
	ЗаписатьПротоколБлокировокПриемника();
	ДобавитьВПротокол("=== Конец dry-run. Длительность: "
		+ ПредставлениеДлительностиПротокола(ТекущаяДата() - МоментНачала)
		+ ". Для записи нажмите «Присоединить». ===");
	ЗаписатьОтладочныйСнимокАнализа(СловарьИсточника, СловарьПриемника, РезультатКарт);
	
КонецПроцедуры

