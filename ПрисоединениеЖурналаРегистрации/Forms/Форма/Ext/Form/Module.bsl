		ДописатьСтрокиВLgf(ПутьLgfПриемника, РезультатКарт.ДобавленныеСтроки);
		ДобавитьВПротоколНаСервереКонтекста("В 1Cv8.lgf добавлено записей: "
			+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	Иначе
		ДобавитьВПротоколНаСервереКонтекста("Словарь приёмника уже содержит все объекты источника.");
	КонецЕсли;
	
	Обработано = 0;
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		
		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		#Если Клиент Тогда
		ОбработкаПрерыванияПользователя();
		Состояние("Присоединение " + СтрокаФайла.ИмяФайла);
		#КонецЕсли
		
		Если СтрокаФайла.Действие = РежимКонфликтаПропустить()
			И ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
			ДобавитьВПротоколНаСервереКонтекста("Пропущен (уже есть): " + СтрокаФайла.ИмяФайла);
			Продолжить;
		КонецЕсли;
		
		Объединять = (СтрокаФайла.Действие = РежимКонфликтаОбъединить()
			И ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника));
		
		ПрисоединитьФайлLgp(
			СтрокаФайла.ПолныйПутьИсточника,
			СтрокаФайла.ПолныйПутьПриемника,
			СловарьПриемника,
			РезультатКарт.Карты,
			Объединять,
			НужнаПеренумерация);
		
		Если Объединять Тогда
			ДобавитьВПротоколНаСервереКонтекста("Объединён: " + СтрокаФайла.ИмяФайла);
		Иначе
			ДобавитьВПротоколНаСервереКонтекста("Скопирован: " + СтрокаФайла.ИмяФайла);
		КонецЕсли;
		
		Обработано = Обработано + 1;
		
	КонецЦикла;
	
	УдалитьИндексыЖурналаНаСервереКонтекста(КаталогПриемника);
	ДобавитьВПротоколНаСервереКонтекста("Обработано файлов: " + ФорматЧислаПротокола(Обработано));
	ДобавитьВПротоколНаСервереКонтекста("Индексы *.lgx удалены - платформа построит их заново при открытии ЖР.");
	
	Если ПроверятьЦелостность Тогда
		ДобавитьВПротоколНаСервереКонтекста("--- Контроль после записи ---");
		СловарьПосле = ПрочитатьСловарьLgf(ПутьLgfПриемника);
		ЗамечанияПосле = 0;
		Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
			Если Не СтрокаФайла.Пометка Или Не ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаФайла.Действие = РежимКонфликтаПропустить() Тогда
				Продолжить;
			КонецЕсли;
			Результат = ПроверитьЦелостностьФайлаLgp(
				СтрокаФайла.ПолныйПутьПриемника,
				СловарьПосле.GUID,
				СловарьПосле.Версия);
			Если Не Результат.Ок Тогда
				ЗамечанияПосле = ЗамечанияПосле + 1;
				ДобавитьВПротоколНаСервереКонтекста("  " + СтрокаФайла.ИмяФайла + ": " + Результат.Сообщение);
			КонецЕсли;
		КонецЦикла;
		Если ЗамечанияПосле = 0 Тогда
			ДобавитьВПротоколНаСервереКонтекста("Контроль после записи: замечаний нет.");
		КонецЕсли;
	КонецЕсли;
	
	ДобавитьВПротоколНаСервереКонтекста("Готово. Если работали с копией, остановите кластер и подмените каталог 1Cv8Log.");
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИндексыЖурнала(КаталогЖР)
	
	ФайлыИндекса = НайтиФайлы(КаталогЖР, "*.lgx", Ложь);
	Для Каждого ФайлИндекса Из ФайлыИндекса Цикл
		Попытка
			УдалитьФайлы(ФайлИндекса.ПолноеИмя);
		Исключение
			ДобавитьВПротокол("Не удалось удалить индекс " + ФайлИндекса.Имя + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьИндексыЖурналаНаСервереКонтекста(КаталогЖР)
	
	ФайлыИндекса = НайтиФайлы(КаталогЖР, "*.lgx", Ложь);
	Для Каждого ФайлИндекса Из ФайлыИндекса Цикл
		Попытка
			УдалитьФайлы(ФайлИндекса.ПолноеИмя);
		Исключение
			ДобавитьВПротоколНаСервереКонтекста("Не удалось удалить индекс " + ФайлИндекса.Имя + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция КоличествоОтмеченныхФайлов()
	
	Результат = 0;
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		Если СтрокаФайла.Пометка Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПометкиФайлов(Пометка)
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		СтрокаФайла.Пометка = Пометка;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьЦелостностьФайлаLgp(ПутьКФайлу, ОжидаемыйGUID, ОжидаемаяВерсия)
	
	Результат = Новый Структура("Ок,Сообщение", Истина, "");
	
	Попытка
		Чтение = ОткрытьЧтениеЖурнала(ПутьКФайлу);
	Исключение
		Результат.Ок = Ложь;
		Результат.Сообщение = "не удалось открыть: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	
	Версия = "";
	GUID = "";
	НомерСтроки = 0;
	БуферЗаписи = "";
	Глубина = 0;
	ВКавычках = Ложь;
	ПрочитаноБайт = 0;
	ЛимитБайт = 2097152;
	Записей = 0;
	БитаяЗапись = Ложь;
	
	Пока Истина Цикл
		
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		ПрочитаноБайт = ПрочитаноБайт + СтрДлина(СтрокаФайла) + 2;
		
		Если НомерСтроки = 1 Тогда
			Версия = СокрЛП(СтрокаФайла);
			Продолжить;
		ИначеЕсли НомерСтроки = 2 Тогда
			GUID = СокрЛП(СтрокаФайла);
			Продолжить;
		КонецЕсли;
		
		ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках);
		Если Глубина = 0 И Не ПустаяСтрока(БуферЗаписи) Тогда
			Записей = Записей + 1;
			БуферЗаписи = "";
		КонецЕсли;
		
		Если ПрочитаноБайт >= ЛимитБайт Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Глубина <> 0 Или Не ПустаяСтрока(БуферЗаписи) Тогда
		БитаяЗапись = Истина;
	КонецЕсли;
	
	Чтение.Закрыть();
	
	Замечания = Новый Массив;
	Если СтрНайти(Версия, МаркерФорматаЖР()) = 0 Тогда
		Замечания.Добавить("нет маркера формата ЖР в заголовке");
	КонецЕсли;
	Если Не ПустаяСтрока(ОжидаемаяВерсия) И Версия <> ОжидаемаяВерсия Тогда
		Замечания.Добавить("версия заголовка отличается от словаря");
	КонецЕсли;
	Если ВРег(СокрЛП(GUID)) <> ВРег(СокрЛП(ОжидаемыйGUID)) Тогда
		Замечания.Добавить("GUID файла (" + GUID + ") не совпадает со словарём (" + ОжидаемыйGUID + ")");
	КонецЕсли;
	Если БитаяЗапись Тогда
		Замечания.Добавить("незакрытая скобочная запись в выборке (~"
			+ ПредставлениеРазмера(ПрочитаноБайт) + ")");
	КонецЕсли;
	
	Если Замечания.Количество() > 0 Тогда
		Результат.Ок = Ложь;
		Результат.Сообщение = СтрСоединить(Замечания, "; ");
	Иначе
		Результат.Сообщение = "ok, записей в выборке: " + ФорматЧислаПротокола(Записей);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция НайтиЗаблокированныеФайлыПриемника()
	
	Результат = Новый Массив;
	
	ПутьLgf = ПутьКСловарюЖР(КаталогПриемника);
	Если ФайлСуществует(ПутьLgf) И ФайлЗаблокированДляЗаписи(ПутьLgf) Тогда
		Результат.Добавить(ИмяФайлаСловаряЖР());
	КонецЕсли;
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		
		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Если Не ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаФайла.Действие = РежимКонфликтаПропустить() Тогда
			Продолжить;
		КонецЕсли;
		
		Если ФайлЗаблокированДляЗаписи(СтрокаФайла.ПолныйПутьПриемника) Тогда
			Результат.Добавить(СтрокаФайла.ИмяФайла);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция НайтиЗаблокированныеФайлыПриемникаНаСервереКонтекста()
	
	Результат = Новый Массив;
	
	ПутьLgf = ПутьКСловарюЖР(КаталогПриемника);
	Если ФайлСуществует(ПутьLgf) И ФайлЗаблокированДляЗаписи(ПутьLgf) Тогда
		Результат.Добавить(ИмяФайлаСловаряЖР());
	КонецЕсли;
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		
		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Если Не ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаФайла.Действие = РежимКонфликтаПропустить() Тогда
			Продолжить;
		КонецЕсли;
		
		Если ФайлЗаблокированДляЗаписи(СтрокаФайла.ПолныйПутьПриемника) Тогда
			Результат.Добавить(СтрокаФайла.ИмяФайла);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФайлЗаблокированДляЗаписи(ПолноеИмя)
	
	ВременноеИмя = ПолноеИмя + ".lockcheck_" + Формат(ТекущаяДата(), "ДФ=HHmmss");
	
	Попытка
		ПереместитьФайл(ПолноеИмя, ВременноеИмя);
		ПереместитьФайл(ВременноеИмя, ПолноеИмя);
		Возврат Ложь;
	Исключение
		Если ФайлСуществует(ВременноеИмя) И Не ФайлСуществует(ПолноеИмя) Тогда
			Попытка
				ПереместитьФайл(ВременноеИмя, ПолноеИмя);
			Исключение
			КонецПопытки;
		КонецЕсли;
		Возврат Истина;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция СоздатьПолнуюКопиюКаталогаПриемника()
	
	КаталогФайл = Новый Файл(КаталогПриемника);
	Родитель = КаталогФайл.Путь;
	ИмяКаталога = КаталогФайл.Имя;
	Если ПустаяСтрока(ИмяКаталога) Тогда
		ИмяКаталога = ИмяКаталогаЖР();
	КонецЕсли;
	
	ПутьКопии = ОбъединитьПуть(Родитель, ИмяКаталога + ".bak_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss"));
	СоздатьКаталог(ПутьКопии);
	
	ФайлыИсточника = НайтиФайлы(КаталогПриемника, "*", Ложь);
	Скопировано = 0;
	Для Каждого ФайлИсточника Из ФайлыИсточника Цикл
		
		Если ФайлИсточника.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		
		КопироватьФайл(ФайлИсточника.ПолноеИмя, ОбъединитьПуть(ПутьКопии, ФайлИсточника.Имя));
		Скопировано = Скопировано + 1;
		
	КонецЦикла;
	
	ДобавитьВПротокол("В резервную копию скопировано файлов: " + ФорматЧислаПротокола(Скопировано));
	Возврат ПутьКопии;
	
КонецФункции

&НаСервере
Функция СоздатьПолнуюКопиюКаталогаПриемникаНаСервереКонтекста()
	
	КаталогФайл = Новый Файл(КаталогПриемника);
	Родитель = КаталогФайл.Путь;
	ИмяКаталога = КаталогФайл.Имя;
	Если ПустаяСтрока(ИмяКаталога) Тогда
		ИмяКаталога = ИмяКаталогаЖР();
	КонецЕсли;
	
	ПутьКопии = ОбъединитьПуть(Родитель, ИмяКаталога + ".bak_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss"));
	СоздатьКаталог(ПутьКопии);
	
	ФайлыИсточника = НайтиФайлы(КаталогПриемника, "*", Ложь);
	Скопировано = 0;
	Для Каждого ФайлИсточника Из ФайлыИсточника Цикл
		
		Если ФайлИсточника.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		
		КопироватьФайл(ФайлИсточника.ПолноеИмя, ОбъединитьПуть(ПутьКопии, ФайлИсточника.Имя));
		Скопировано = Скопировано + 1;
		
	КонецЦикла;
	
	ДобавитьВПротоколНаСервереКонтекста("В резервную копию скопировано файлов: " + ФорматЧислаПротокола(Скопировано));
	Возврат ПутьКопии;
	
КонецФункции

#Область ПоискВSrvinfo

&НаКлиенте
Процедура НачатьПоискКаталогаЖРВSrvinfo(ИмяРеквизитаКаталога)
	
	Если ВыполнятьНаСервере Тогда
		НачатьПоискКаталогаЖРНаСервере(ИмяРеквизитаКаталога);
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Каталог srvinfo (или reg_XXXX кластера)";
	Если Не ПустаяСтрока(КаталогSrvinfo) Тогда
		Диалог.Каталог = КаталогSrvinfo;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения(
		"НайтиВКластереЗавершениеВыбораSrvinfo",
		ЭтотОбъект,
		ИмяРеквизитаКаталога);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПоискКаталогаЖРНаСервере(ИмяРеквизитаКаталога)
	
	Если Не ПустаяСтрока(КаталогSrvinfo) Тогда
		ПрименитьПоискЖРНаСервере(ИмяРеквизитаКаталога, КаталогSrvinfo);
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения(
		"ВводКаталогаSrvinfoЗавершение",
		ЭтотОбъект,
		ИмяРеквизитаКаталога);
	ПоказатьВводСтроки(
		Оповещение,
		КаталогSrvinfo,
		"Путь srvinfo или reg_XXXX на сервере 1С",
		0,
		Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВводКаталогаSrvinfoЗавершение(Строка, ИмяРеквизитаКаталога) Экспорт
	
	Если Строка = Неопределено Или ПустаяСтрока(СокрЛП(Строка)) Тогда
		Возврат;
	КонецЕсли;
	
	КаталогSrvinfo = СокрЛП(Строка);
	ПрименитьПоискЖРНаСервере(ИмяРеквизитаКаталога, КаталогSrvinfo);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьПоискЖРНаСервере(ИмяРеквизитаКаталога, ПутьSrvinfo)
	
	Попытка
		Кандидаты = НайтиКаталогиЖРВSrvinfoНаСервере(ПутьSrvinfo, ИмяИБ);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Если Кандидаты.Количество() = 0 Тогда
		ПоказатьПредупреждение(,
			"На сервере не найдены каталоги 1Cv8Log с 1Cv8.lgf.
			|Проверьте путь srvinfo/reg_XXXX и фильтр имени ИБ.");
		Возврат;
	КонецЕсли;
	
	Если Кандидаты.Количество() = 1 Тогда
		УстановитьКаталогЖРИзПоиска(ИмяРеквизитаКаталога, Кандидаты[0]);
		Возврат;
	КонецЕсли;
	
	СписокВыбора = Новый СписокЗначений;
	Для Каждого Кандидат Из Кандидаты Цикл
		СписокВыбора.Добавить(Кандидат.Путь, Кандидат.Представление);
	КонецЦикла;
	
	Оповещение = Новый ОписаниеОповещения(
		"НайтиВКластереПослеВыбораКандидата",
		ЭтотОбъект,
		ИмяРеквизитаКаталога);
	СписокВыбора.ПоказатьВыборЭлемента(Оповещение, "Выберите каталог журнала регистрации (сервер)");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиКаталогиЖРВSrvinfoНаСервере(КореньПоиска, ФильтрИмениИБ)
	
	Возврат НайтиКаталогиЖРВSrvinfo(КореньПоиска, ФильтрИмениИБ);
	
КонецФункции

&НаКлиенте
Процедура НайтиВКластереЗавершениеВыбораSrvinfo(ВыбранныеФайлы, ИмяРеквизитаКаталога) Экспорт
	
	ПутьSrvinfo = ПервыйПутьИзРезультатаДиалога(ВыбранныеФайлы);
	Если ПустаяСтрока(ПутьSrvinfo) Тогда
		Возврат;
	КонецЕсли;
	
	КаталогSrvinfo = ПутьSrvinfo;
	
	Попытка
		Кандидаты = НайтиКаталогиЖРВSrvinfo(ПутьSrvinfo, ИмяИБ);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Если Кандидаты.Количество() = 0 Тогда
		ПоказатьПредупреждение(,
			"Каталоги 1Cv8Log с 1Cv8.lgf не найдены.
			|Укажите srvinfo или reg_XXXX и при необходимости имя ИБ в фильтре.");
		Возврат;
	КонецЕсли;
	
	Если Кандидаты.Количество() = 1 Тогда
		УстановитьКаталогЖРИзПоиска(ИмяРеквизитаКаталога, Кандидаты[0]);
		Возврат;
	КонецЕсли;
	
	СписокВыбора = Новый СписокЗначений;
	Для Каждого Кандидат Из Кандидаты Цикл
		СписокВыбора.Добавить(Кандидат.Путь, Кандидат.Представление);
	КонецЦикла;
	
	Оповещение = Новый ОписаниеОповещения(
		"НайтиВКластереПослеВыбораКандидата",
		ЭтотОбъект,
		ИмяРеквизитаКаталога);
	СписокВыбора.ПоказатьВыборЭлемента(Оповещение, "Выберите каталог журнала регистрации");
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиВКластереПослеВыбораКандидата(ВыбранныйЭлемент, ИмяРеквизитаКаталога) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Кандидат = Новый Структура("Путь,Представление", ВыбранныйЭлемент.Значение, ВыбранныйЭлемент.Представление);
	УстановитьКаталогЖРИзПоиска(ИмяРеквизитаКаталога, Кандидат);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКаталогЖРИзПоиска(ИмяРеквизитаКаталога, Кандидат)
	
	Если ИмяРеквизитаКаталога = "КаталогИсточника" Тогда
		КаталогИсточника = Кандидат.Путь;
	Иначе
		КаталогПриемника = Кандидат.Путь;
	КонецЕсли;
	
	ДобавитьВПротокол("Найден каталог ЖР: " + Кандидат.Представление);
	ДобавитьВПротокол("Путь: " + Кандидат.Путь);
	ПоказатьПредупреждение(, "Установлен каталог:
		|" + Кандидат.Путь);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НайтиКаталогиЖРВSrvinfo(КореньПоиска, ФильтрИмениИБ)
	
	Результат = Новый Массив;
	ИменаПоUUID = ПрочитатьИменаИБИзClst(КореньПоиска);
	Фильтр = НРег(СокрЛП(ФильтрИмениИБ));
	
	КаталогиЖР = НайтиФайлы(КореньПоиска, ИмяКаталогаЖР(), Истина);
	Для Каждого КаталогЖР Из КаталогиЖР Цикл
		
		Если Не КаталогЖР.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Если Не ФайлСуществует(ПутьКСловарюЖР(КаталогЖР.ПолноеИмя)) Тогда
			Продолжить;
		КонецЕсли;
		
		UUIDИБ = ИзвлечьUUIDИзПутиЖР(КаталогЖР.ПолноеИмя);
		ИмяИБИзClst = "";
		Если Не ПустаяСтрока(UUIDИБ) Тогда
			ИмяИБИзClst = ИменаПоUUID.Получить(НРег(UUIDИБ));
			Если ИмяИБИзClst = Неопределено Тогда
				ИмяИБИзClst = "";
			КонецЕсли;
		КонецЕсли;
		
		Если Не ПустаяСтрока(Фильтр) Тогда
			СтрокаПоиска = НРег(ИмяИБИзClst + " " + UUIDИБ + " " + КаталогЖР.ПолноеИмя);
			Если СтрНайти(СтрокаПоиска, Фильтр) = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Представление = КаталогЖР.ПолноеИмя;
		Если Не ПустаяСтрока(ИмяИБИзClst) Тогда
			Представление = ИмяИБИзClst + " — " + КаталогЖР.ПолноеИмя;
		ИначеЕсли Не ПустаяСтрока(UUIDИБ) Тогда
			Представление = UUIDИБ + " — " + КаталогЖР.ПолноеИмя;
		КонецЕсли;
		
		Кандидат = Новый Структура("Путь,Представление,UUID,ИмяИБ",
			КаталогЖР.ПолноеИмя, Представление, UUIDИБ, ИмяИБИзClst);
		Результат.Добавить(Кандидат);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьИменаИБИзClst(КореньПоиска)
	
	ИменаПоUUID = Новый Соответствие;
	ФайлыClst = НайтиФайлы(КореньПоиска, "1CV8Clst.lst", Истина);
	
	Для Каждого ФайлClst Из ФайлыClst Цикл
		
		Попытка
			Чтение = Новый ЧтениеТекста(ФайлClst.ПолноеИмя, КодировкаТекста.UTF8);
			Текст = Чтение.Прочитать();
			Чтение.Закрыть();
		Исключение
			Продолжить;
		КонецПопытки;
		
		Если Текст = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьИменаИБИзТекстаClst(Текст, ИменаПоUUID);
		
	КонецЦикла;
	
	Возврат ИменаПоUUID;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьИменаИБИзТекстаClst(Знач Текст, ИменаПоUUID)
	
	// Фрагменты вида: {uuid,"RefName","Description",...
	Позиция = 1;
	Длина = СтрДлина(Текст);
	
	Пока Позиция <= Длина Цикл
		
		ПозицияUUID = НайтиUUIDВТекстеСПозиции(Текст, Позиция);
		Если ПозицияUUID = 0 Тогда
			Прервать;
		КонецЕсли;
		
		UUID = Сред(Текст, ПозицияUUID, 36);
		ПослеUUID = ПозицияUUID + 36;
		Если ПослеUUID + 2 > Длина Или Сред(Текст, ПослеUUID, 2) <> ",""" Тогда
			Позиция = ПозицияUUID + 1;
			Продолжить;
		КонецЕсли;
		
		НачалоИмени = ПослеUUID + 2;
		КонецИмени = СтрНайти(Текст, """", НаправлениеПоиска.СНачала, НачалоИмени);
		Если КонецИмени = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ИмяИБИзClst = Сред(Текст, НачалоИмени, КонецИмени - НачалоИмени);
		Если Не ПустаяСтрока(ИмяИБИзClst) Тогда
			ИменаПоUUID.Вставить(НРег(UUID), ИмяИБИзClst);
		КонецЕсли;
		
		Позиция = КонецИмени + 1;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НайтиUUIDВТекстеСПозиции(Знач Текст, Знач ПозицияСтарта)
	
	Длина = СтрДлина(Текст);
	Позиция = ПозицияСтарта;
	
	Пока Позиция <= Длина - 35 Цикл
		
		Фрагмент = Сред(Текст, Позиция, 36);
		Если ЭтоСтрокаUUID(Фрагмент) Тогда
			Возврат Позиция;
		КонецЕсли;
		Позиция = Позиция + 1;
		
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоСтрокаUUID(Знач Значение)
	
	Если СтрДлина(Значение) <> 36 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Сред(Значение, 9, 1) <> "-" Или Сред(Значение, 14, 1) <> "-"
		Или Сред(Значение, 19, 1) <> "-" Или Сред(Значение, 24, 1) <> "-" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = 1 По 36 Цикл
		Если Индекс = 9 Или Индекс = 14 Или Индекс = 19 Или Индекс = 24 Тогда
			Продолжить;
		КонецЕсли;
		Символ = НРег(Сред(Значение, Индекс, 1));
		Если СтрНайти("0123456789abcdef", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИзвлечьUUIDИзПутиЖР(Знач ПутьКЖР)
	
	Норм = СтрЗаменить(ПутьКЖР, "/", "\");
	Пока СтрЗаканчиваетсяНа(Норм, "\") Цикл
		Норм = Лев(Норм, СтрДлина(Норм) - 1);
	КонецЦикла;
	
	Части = СтрРазделить(Норм, "\", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	
	Если ВРег(Части[Части.ВГраница()]) <> ВРег(ИмяКаталогаЖР()) Тогда
		Возврат "";
	КонецЕсли;
	
	КандидатUUID = Части[Части.ВГраница() - 1];
	Если ЭтоСтрокаUUID(КандидатUUID) Тогда
		Возврат КандидатUUID;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СловарьLgf

&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьСловарьLgf(ПутьКФайлу)
	
	Результат = НовыйСловарьLgf();
	Чтение = ОткрытьЧтениеЖурнала(ПутьКФайлу);
	
	НомерСтроки = 0;
	Пока Истина Цикл
		
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		Если НомерСтроки = 1 Тогда
			Результат.Версия = СокрЛП(СтрокаФайла);
			Продолжить;
		ИначеЕсли НомерСтроки = 2 Тогда
			Результат.GUID = СокрЛП(СтрокаФайла);
			Продолжить;
		КонецЕсли;
		
		ДобавитьЗаписьСловаряИзСтроки(Результат, СтрокаФайла);
		
	КонецЦикла;
	
	Чтение.Закрыть();
	
	Если СтрНайти(Результат.Версия, МаркерФорматаЖР()) = 0 Тогда
		ВызватьИсключение "Файл не похож на словарь журнала регистрации: " + ПутьКФайлу;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НовыйСловарьLgf()
	
	Результат = Новый Структура;
	Результат.Вставить("Версия", "");
	Результат.Вставить("GUID", "");
	Результат.Вставить("ПоНомеру", Новый Соответствие);
	Результат.Вставить("ПоКлючу", Новый Соответствие);
	Результат.Вставить("МаксНомер", Новый Соответствие);
	Результат.Вставить("Количество", 0);
	
	Для ТипОбъекта = 1 По МаксимальныйТипОбъектаСловаря() Цикл
		Результат.ПоНомеру.Вставить(ТипОбъекта, Новый Соответствие);
		Результат.ПоКлючу.Вставить(ТипОбъекта, Новый Соответствие);
		Результат.МаксНомер.Вставить(ТипОбъекта, 0);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьЗаписьСловаряИзСтроки(Словарь, Знач СтрокаФайла)
	
	СтрокаФайла = УбратьХвостовуюЗапятую(СокрЛП(СтрокаФайла));
	Если Не ЭтоСкобочнаяЗапись(СтрокаФайла) Тогда
		Возврат;
	КонецЕсли;
	
	Токены = Токенизировать(ТелоСкобочнойЗаписи(СтрокаФайла));
	Если Токены.Количество() < 3 Тогда
		Возврат;
	КонецЕсли;
	
	ТипОбъекта = ЧислоИзТокена(Токены[1]);
	Номер = ЧислоИзТокена(Токены[Токены.ВГраница()]);
	Если ТипОбъекта < 1 Или ТипОбъекта > МаксимальныйТипОбъектаСловаря() Или Номер <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	Описание = Новый Структура("ТипОбъекта,Номер,Имя,UUID,Ключ", ТипОбъекта, Номер, "", "", "");
	Если ЭтоТипСUUID(ТипОбъекта) И Токены.Количество() >= 4 Тогда
		Описание.UUID = СнятьКавычки(Токены[2]);
		Описание.Имя = СнятьКавычки(Токены[3]);
		Описание.Ключ = НРег(Описание.UUID);
		Если ПустаяСтрока(Описание.Ключ) Тогда
			Описание.Ключ = НРег(Описание.Имя);
		КонецЕсли;
	Иначе
		Описание.Имя = СнятьКавычки(Токены[2]);
		Описание.Ключ = НРег(Описание.Имя);
	КонецЕсли;
	
	Если ПустаяСтрока(Описание.Ключ) Тогда
		Возврат;
	КонецЕсли;
	
	Словарь.ПоНомеру.Получить(ТипОбъекта).Вставить(Номер, Описание);
	Словарь.ПоКлючу.Получить(ТипОбъекта).Вставить(Описание.Ключ, Номер);
	Если Номер > Словарь.МаксНомер.Получить(ТипОбъекта) Тогда
		Словарь.МаксНомер.Вставить(ТипОбъекта, Номер);
	КонецЕсли;
	Словарь.Количество = Словарь.Количество + 1;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПостроитьКартыПеренумерации(СловарьИсточника, СловарьПриемника)
	
	Карты = Новый Соответствие;
	ДобавленныеСтроки = Новый Массив;
	НужнаПеренумерация = Ложь;
	
	Для ТипОбъекта = 1 По МаксимальныйТипОбъектаСловаря() Цикл
		
		Карта = Новый Соответствие;
		Карты.Вставить(ТипОбъекта, Карта);
		МаксНомер = СловарьПриемника.МаксНомер.Получить(ТипОбъекта);
		ИсточникПоНомеру = СловарьИсточника.ПоНомеру.Получить(ТипОбъекта);
		ПриемникПоКлючу = СловарьПриемника.ПоКлючу.Получить(ТипОбъекта);
		
		Для Каждого Пара Из ИсточникПоНомеру Цикл
			
			СтарыйНомер = Пара.Ключ;
			Описание = Пара.Значение;
			НовыйНомер = ПриемникПоКлючу.Получить(Описание.Ключ);
			
			Если НовыйНомер = Неопределено Тогда
				МаксНомер = МаксНомер + 1;
				НовыйНомер = МаксНомер;
				ДобавленныеСтроки.Добавить(СформироватьСтрокуСловаря(Описание, НовыйНомер));
				ПриемникПоКлючу.Вставить(Описание.Ключ, НовыйНомер);
			КонецЕсли;
			
			Карта.Вставить(СтарыйНомер, НовыйНомер);
			Если НовыйНомер <> СтарыйНомер Тогда
				НужнаПеренумерация = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		СловарьПриемника.МаксНомер.Вставить(ТипОбъекта, МаксНомер);
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("Карты", Карты);
	Результат.Вставить("ДобавленныеСтроки", ДобавленныеСтроки);
	Результат.Вставить("НужнаПеренумерация", НужнаПеренумерация);
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьСтрокуСловаря(Описание, Номер)
	
	НомерСтрокой = ФорматЧислаПротокола(Номер);
	ТипСтрокой = ФорматЧислаПротокола(Описание.ТипОбъекта);
	
	Если ЭтоТипСUUID(Описание.ТипОбъекта) Тогда
		Возврат "{" + ТипСтрокой + ",""" + ЭкранироватьКавычки(Описание.UUID) + ""","""
			+ ЭкранироватьКавычки(Описание.Имя) + """," + НомерСтрокой + "},";
	КонецЕсли;
	
	Возврат "{" + ТипСтрокой + ",""" + ЭкранироватьКавычки(Описание.Имя) + """," + НомерСтрокой + "},";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДописатьСтрокиВLgf(ПутьКФайлу, ДобавленныеСтроки)
	
	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(ПутьКФайлу, КодировкаТекста.UTF8);
	
	КоличествоСтрок = Текст.КоличествоСтрок();
	Пока КоличествоСтрок > 0 И ПустаяСтрока(СокрЛП(Текст.ПолучитьСтроку(КоличествоСтрок))) Цикл
		Текст.УдалитьСтроку(КоличествоСтрок);
		КоличествоСтрок = Текст.КоличествоСтрок();
	КонецЦикла;
	
	Если КоличествоСтрок > 0 Тогда
		Последняя = СокрЛП(Текст.ПолучитьСтроку(КоличествоСтрок));
		Если Не ПустаяСтрока(Последняя) И Не СтрЗаканчиваетсяНа(Последняя, ",") Тогда
			Текст.ЗаменитьСтроку(КоличествоСтрок, Текст.ПолучитьСтроку(КоличествоСтрок) + ",");
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого СтрокаСловаря Из ДобавленныеСтроки Цикл
		Текст.ДобавитьСтроку(СтрокаСловаря);
	КонецЦикла;
	
	Текст.Записать(ПутьКФайлу, КодировкаТекста.UTF8);
	
КонецПроцедуры

#КонецОбласти

#Область ФайлыLgp

&НаКлиентеНаСервереБезКонтекста
Процедура ПрисоединитьФайлLgp(ПутьИсточника, ПутьПриемника, СловарьПриемника, Карты, Объединять, НужнаПеренумерация)
	
	Если Не Объединять И Не НужнаПеренумерация Тогда
		КопироватьФайлСЗаменой(ПутьИсточника, ПутьПриемника);
		Возврат;
	КонецЕсли;
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("lgp");
	Запись = Новый ЗаписьТекста(ВременныйФайл, КодировкаТекста.UTF8);
	
	Если Объединять И ФайлСуществует(ПутьПриемника) Тогда
		СкопироватьПриемникСЗапятой(ПутьПриемника, Запись);
	Иначе
		Запись.ЗаписатьСтроку(СловарьПриемника.Версия);
		Запись.ЗаписатьСтроку(СловарьПриемника.GUID);
	КонецЕсли;
	
	ВыгрузитьЗаписиLgp(ПутьИсточника, Запись, Карты, НужнаПеренумерация);
	Запись.Закрыть();
	
	КопироватьФайлСЗаменой(ВременныйФайл, ПутьПриемника);
	УдалитьФайлы(ВременныйФайл);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СкопироватьПриемникСЗапятой(ПутьПриемника, Запись)
	
	Чтение = ОткрытьЧтениеЖурнала(ПутьПриемника);
	ПоследняяЗначимая = "";
	
	Пока Истина Цикл
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если ПоследняяЗначимая <> "" Тогда
			Запись.ЗаписатьСтроку(ПоследняяЗначимая);
		КонецЕсли;
		ПоследняяЗначимая = СтрокаФайла;
	КонецЦикла;
	
	Чтение.Закрыть();
	
	Если ПоследняяЗначимая <> "" Тогда
		ПоследняяЗначимая = ОбеспечитьХвостовуюЗапятую(ПоследняяЗначимая);
		Запись.ЗаписатьСтроку(ПоследняяЗначимая);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВыгрузитьЗаписиLgp(ПутьИсточника, Запись, Карты, Перенумеровывать)
	
	Чтение = ОткрытьЧтениеЖурнала(ПутьИсточника);
	
	НомерСтроки = 0;
	БуферЗаписи = "";
	Глубина = 0;
	ВКавычках = Ложь;
	СчетчикЗаписей = 0;
	
	Пока Истина Цикл
		
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		Если НомерСтроки <= 2 И Глубина = 0 И ПустаяСтрока(БуферЗаписи) Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках);
		
		Если Глубина = 0 И Не ПустаяСтрока(БуферЗаписи) Тогда
			ТекстЗаписи = ПодготовитьТекстЗаписиLgp(БуферЗаписи, Карты, Перенумеровывать);
			БуферЗаписи = "";
			Если ПустаяСтрока(ТекстЗаписи) Тогда
				Продолжить;
			КонецЕсли;
			
			Запись.ЗаписатьСтроку(ТекстЗаписи);
			СчетчикЗаписей = СчетчикЗаписей + 1;
			Если СчетчикЗаписей % 2000 = 0 Тогда
				#Если Клиент Тогда
				ОбработкаПрерыванияПользователя();
				Состояние("Перенумерация записей: " + Формат(СчетчикЗаписей, "ЧГ=0"));
				#КонецЕсли
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Чтение.Закрыть();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПодготовитьТекстЗаписиLgp(БуферЗаписи, Карты, Перенумеровывать)
	
	ТекстЗаписи = СокрЛП(БуферЗаписи);
	Если ТекстЗаписи = "" Или ТекстЗаписи = "," Тогда
		Возврат "";
	КонецЕсли;
	
	Если СтрНачинаетсяС(ТекстЗаписи, ",") Тогда
		ТекстЗаписи = СокрЛП(Сред(ТекстЗаписи, 2));
	КонецЕсли;
	Если Перенумеровывать Тогда
		ТекстЗаписи = ПеренумероватьЗаписьLgp(ТекстЗаписи, Карты);
	КонецЕсли;
	
	Возврат ОбеспечитьХвостовуюЗапятую(ТекстЗаписи);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках)
	
	Если Не ПустаяСтрока(БуферЗаписи) Тогда
		БуферЗаписи = БуферЗаписи + Символы.ПС;
	КонецЕсли;
	БуферЗаписи = БуферЗаписи + СтрокаФайла;
	
	ОбновитьСостояниеСкобокИКавычек(СтрокаФайла, Глубина, ВКавычках);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьСостояниеСкобокИКавычек(СтрокаФайла, Глубина, ВКавычках)
	
	Индекс = 1;
	Длина = СтрДлина(СтрокаФайла);
	Пока Индекс <= Длина Цикл
		Символ = Сред(СтрокаФайла, Индекс, 1);
		Если ВКавычках Тогда
			Если Символ = """" Тогда
				Если Сред(СтрокаФайла, Индекс + 1, 1) = """" Тогда
					Индекс = Индекс + 2;
					Продолжить;
				КонецЕсли;
				ВКавычках = Ложь;
			КонецЕсли;
		ИначеЕсли Символ = """" Тогда
			ВКавычках = Истина;
		ИначеЕсли Символ = "{" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = "}" Тогда
			Глубина = Глубина - 1;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПеренумероватьЗаписьLgp(ТекстЗаписи, Карты)
	
	Сжатая = СокрЛП(ТекстЗаписи);
	ХвостоваяЗапятая = СтрЗаканчиваетсяНа(Сжатая, ",");
	Если ХвостоваяЗапятая Тогда
		Сжатая = Лев(Сжатая, СтрДлина(Сжатая) - 1);
	КонецЕсли;
	Если Не ЭтоСкобочнаяЗапись(Сжатая) Тогда
		Возврат ТекстЗаписи;
	КонецЕсли;
	
	Токены = Токенизировать(ТелоСкобочнойЗаписи(Сжатая));
	КоличествоТокенов = Токены.Количество();
	
	Для Каждого ПолеСсылки Из ПоляСсылокЗаписиLgp() Цикл
		Если КоличествоТокенов < ПолеСсылки.ИндексПоля Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПолеСсылки.Составное Тогда
			Токены[ПолеСсылки.ИндексПоля] = ПеренумероватьСоставноеПоле(
				Токены[ПолеСсылки.ИндексПоля],
				Карты.Получить(ПолеСсылки.ТипОбъекта));
		Иначе
			Токены[ПолеСсылки.ИндексПоля] = ЗаменитьНомерПоТипу(
				Токены[ПолеСсылки.ИндексПоля],
				Карты,
				ПолеСсылки.ТипОбъекта);
		КонецЕсли;
	КонецЦикла;
	
	Результат = "{" + СтрСоединить(Токены, ",") + "}";
	Если ХвостоваяЗапятая Тогда
		Результат = Результат + ",";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаменитьНомерПоТипу(Токен, Карты, ТипОбъекта)
	
	Карта = Карты.Получить(ТипОбъекта);
	Если Карта = Неопределено Тогда
		Возврат Токен;
	КонецЕсли;
	
	Возврат ЗаменитьНомер(Токен, Карта);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаменитьНомер(Токен, Карта)
	
	Значение = СокрЛП(Токен);
	Номер = ЧислоИзТокена(Значение);
	Если Номер <= 0 Тогда
		Возврат Токен;
	КонецЕсли;
	
	НовыйНомер = Карта.Получить(Номер);
	Если НовыйНомер = Неопределено Тогда
		Возврат Токен;
	КонецЕсли;
	
	Возврат ФорматЧислаПротокола(НовыйНомер);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПеренумероватьСоставноеПоле(Токен, Карта)
	
	Если Карта = Неопределено Тогда
		Возврат Токен;
	КонецЕсли;
	
	Значение = СокрЛП(Токен);
	Если Не СтрНачинаетсяС(Значение, "{") Тогда
		Возврат ЗаменитьНомер(Токен, Карта);
	КонецЕсли;
	Если Не СтрЗаканчиваетсяНа(Значение, "}") Тогда
		Возврат Токен;
	КонецЕсли;
	
	Части = Токенизировать(ТелоСкобочнойЗаписи(Значение));
	Для Индекс = 1 По Части.Количество() Цикл
		Части[Индекс] = ЗаменитьНомер(Части[Индекс], Карта);
	КонецЦикла;
	
	Возврат "{" + СтрСоединить(Части, ",") + "}";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура КопироватьФайлСЗаменой(Источник, Приемник)
	
	Если ФайлСуществует(Приемник) Тогда
		УдалитьФайлы(Приемник);
	КонецЕсли;
	КопироватьФайл(Источник, Приемник);
	
КонецПроцедуры

#КонецОбласти

#Область РазборТекста

&НаКлиентеНаСервереБезКонтекста
Функция ОткрытьЧтениеЖурнала(ПутьКФайлу)
	
	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ПерваяСтрока = Чтение.ПрочитатьСтроку();
	Чтение.Закрыть();
	
	Кодировка = КодировкаТекста.UTF8;
	Если ПерваяСтрока <> Неопределено И СтрНайти(ПерваяСтрока, МаркерФорматаЖР()) = 0 Тогда
		Кодировка = КодировкаТекста.UTF16;
	КонецЕсли;
	
	Возврат Новый ЧтениеТекста(ПутьКФайлу, Кодировка);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция Токенизировать(Знач Текст)
	
	Токены = Новый Массив;
	Текущий = "";
	Глубина = 0;
	ВКавычках = Ложь;
	Индекс = 1;
	Длина = СтрДлина(Текст);
	
	Пока Индекс <= Длина Цикл
		
		Символ = Сред(Текст, Индекс, 1);
		
		Если ВКавычках Тогда
			Текущий = Текущий + Символ;
			Если Символ = """" Тогда
				Если Сред(Текст, Индекс + 1, 1) = """" Тогда
					Текущий = Текущий + """";
					Индекс = Индекс + 2;
					Продолжить;
				КонецЕсли;
				ВКавычках = Ложь;
			КонецЕсли;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		
		Если Символ = """" Тогда
			ВКавычках = Истина;
			Текущий = Текущий + Символ;
		ИначеЕсли Символ = "{" Тогда
			Глубина = Глубина + 1;
			Текущий = Текущий + Символ;
		ИначеЕсли Символ = "}" Тогда
			Глубина = Глубина - 1;
			Текущий = Текущий + Символ;
		ИначеЕсли Символ = "," И Глубина = 0 Тогда
			Токены.Добавить(СокрЛП(Текущий));
			Текущий = "";
		Иначе
			Текущий = Текущий + Символ;
		КонецЕсли;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	Если Не ПустаяСтрока(Текущий) Или Длина > 0 Тогда
		Токены.Добавить(СокрЛП(Текущий));
	КонецЕсли;
	
	Возврат Токены;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоСкобочнаяЗапись(Знач Значение)
	
	Возврат СтрНачинаетсяС(Значение, "{") И СтрЗаканчиваетсяНа(Значение, "}");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТелоСкобочнойЗаписи(Знач Значение)
	
	Возврат Сред(Значение, 2, СтрДлина(Значение) - 2);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция УбратьХвостовуюЗапятую(Знач Значение)
	
	Если СтрЗаканчиваетсяНа(Значение, ",") Тогда
		Возврат Лев(Значение, СтрДлина(Значение) - 1);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОбеспечитьХвостовуюЗапятую(Знач Значение)
	
	Если ПустаяСтрока(СокрЛП(Значение)) Тогда
		Возврат Значение;
	КонецЕсли;
	Если Не СтрЗаканчиваетсяНа(СокрЛП(Значение), ",") Тогда
		Возврат Значение + ",";
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СнятьКавычки(Знач Значение)
	
	Значение = СокрЛП(Значение);
	Если СтрДлина(Значение) >= 2 И СтрНачинаетсяС(Значение, """") И СтрЗаканчиваетсяНа(Значение, """") Тогда
		Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
		Значение = СтрЗаменить(Значение, """""", """");
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭкранироватьКавычки(Знач Значение)
	
	Возврат СтрЗаменить(Строка(Значение), """", """""");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЧислоИзТокена(Знач Значение)
	
	Значение = СокрЛП(Значение);
	Если ПустаяСтрока(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Индекс);
		Если Код < 48 Или Код > 57 Тогда
			Возврат 0;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Число(Значение);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФорматЧислаПротокола(Значение)
	
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеРазмера(Размер)
	
	Если Размер < 1024 Тогда
		Возврат ФорматЧислаПротокола(Размер) + " Б";
	ИначеЕсли Размер < 1024 * 1024 Тогда
		Возврат Формат(Размер / 1024, "ЧДЦ=1; ЧН=0") + " КБ";
	ИначеЕсли Размер < 1024 * 1024 * 1024 Тогда
		Возврат Формат(Размер / 1024 / 1024, "ЧДЦ=1; ЧН=0") + " МБ";
	КонецЕсли;
	
	Возврат Формат(Размер / 1024 / 1024 / 1024, "ЧДЦ=2; ЧН=0") + " ГБ";
	
КонецФункции

#КонецОбласти

#Область Протокол

&НаКлиенте
Процедура ДобавитьВПротокол(Текст)
	
	Если ПустаяСтрока(ТекстПротокола) Тогда
		ТекстПротокола = Текст;
	Иначе
		ТекстПротокола = ТекстПротокола + Символы.ПС + Текст;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВПротоколНаСервереКонтекста(Текст)
	
	Если ПустаяСтрока(ТекстПротокола) Тогда
		ТекстПротокола = Текст;
	Иначе
		ТекстПротокола = ТекстПротокола + Символы.ПС + Текст;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
