&НаКлиенте
Процедура ЗаписатьПротоколЦелостности(СловарьИсточника, СловарьПриемника)
	
	ДобавитьВПротокол("--- Проверка файлов периодов (начало каждого, до ~2 МБ) ---");
	Проблемы = 0;
	Проверено = 0;
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		
		Проверено = Проверено + 1;
		Результат = ПроверитьЦелостностьФайлаLgp(
			СтрокаФайла.ПолныйПутьИсточника,
			СловарьИсточника.GUID,
			СловарьИсточника.Версия);
		
		Если Не Результат.Ок Тогда
			Проблемы = Проблемы + 1;
			ДобавитьВПротокол("  " + СтрокаФайла.ИмяФайла + ": " + Результат.Сообщение);
		КонецЕсли;
		
		Если ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
			РезультатПриемника = ПроверитьЦелостностьФайлаLgp(
				СтрокаФайла.ПолныйПутьПриемника,
				СловарьПриемника.GUID,
				СловарьПриемника.Версия);
			Если Не РезультатПриемника.Ок Тогда
				Проблемы = Проблемы + 1;
				ДобавитьВПротокол("  (уже в новом журнале) " + СтрокаФайла.ИмяФайла + ": "
					+ РезультатПриемника.Сообщение);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Проблемы = 0 Тогда
		ДобавитьВПротокол("Проверка файлов: критичных замечаний нет (файлов источника: "
			+ ФорматЧислаПротокола(Проверено)
			+ "). Обрыв проверки на лимите ~2 МБ — не доказательство повреждения.");
	Иначе
		ДобавитьВПротокол("Проверка файлов: замечаний "
			+ ФорматЧислаПротокола(Проблемы)
			+ ". См. «что нашли / чем грозит / что делать» выше.");
	КонецЕсли;
	
КонецПроцедуры

