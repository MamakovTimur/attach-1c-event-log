КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СканироватьГраницуТранзакцийLgp(ПутьКФайлу)

	Результат = Новый Структура(
		"ОткрытаВКонце,ПервыйСтатус,ПоследнийСтатус,Предупреждения,ЧислоДней",
		Ложь, "", "", Новый Массив, 0);
	Если Не ФайлСуществует(ПутьКФайлу) Тогда
		Возврат Результат;
	КонецЕсли;

	ГлубинаОткрытых = 0;
	Дни = Новый Соответствие;
	Чтение = ОткрытьЧтениеЖурнала(ПутьКФайлу);
	Для Номер = 1 По 3 Цикл
		Чтение.ПрочитатьСтроку();
	КонецЦикла;

	БуферЗаписи = "";
	Глубина = 0;
	ВКавычках = Ложь;

	Пока Истина Цикл
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если Глубина = 0 И ПустаяСтрока(БуферЗаписи) Тогда
			Сжатая = СокрЛП(СтрокаФайла);
			Если ПустаяСтрока(Сжатая) Или Не СтрНачинаетсяС(СокрЛ(Сжатая), "{") Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках);
		Если Глубина = 0 И Не ПустаяСтрока(БуферЗаписи) Тогда
			Сжатая = СокрЛП(БуферЗаписи);
			БуферЗаписи = "";
			Если СтрЗаканчиваетсяНа(Сжатая, ",") Тогда
				Сжатая = УбратьХвостовуюЗапятую(Сжатая);
			КонецЕсли;
			Если Не ЭтоСкобочнаяЗапись(Сжатая) Тогда
				Продолжить;
			КонецЕсли;
			Токены = Токенизировать(ТелоСкобочнойЗаписи(Сжатая));
			Если Не ЭтоЗаписьСобытияLgpПоТокенам(Токены) Тогда
				Продолжить;
			КонецЕсли;
			День = ДеньИзТокенаДатыLgp(Токены[ИндексПоляДатыЗаписиLgp()]);
			Если Не ПустаяСтрока(День) Тогда
				Дни.Вставить(День, Истина);
			КонецЕсли;
			Статус = "";
			Если Токены.ВГраница() >= ИндексПоляСтатусаТранзакцииLgp() Тогда
				Статус = ВРег(СокрЛП(Токены[ИндексПоляСтатусаТранзакцииLgp()]));
			КонецЕсли;
			Если ПустаяСтрока(Результат.ПервыйСтатус) Тогда
				Результат.ПервыйСтатус = Статус;
			КонецЕсли;
			Результат.ПоследнийСтатус = Статус;
			Если Статус = СтатусТранзакцииНезавершена() Тогда
				ГлубинаОткрытых = ГлубинаОткрытых + 1;
			ИначеЕсли Статус = СтатусТранзакцииЗафиксирована()
				Или Статус = СтатусТранзакцииОтменена() Тогда
				Если ГлубинаОткрытых > 0 Тогда
					ГлубинаОткрытых = ГлубинаОткрытых - 1;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();

	Результат.ОткрытаВКонце = ГлубинаОткрытых > 0;
	Результат.ЧислоДней = Дни.Количество();
	Если Результат.ОткрытаВКонце Тогда
		Результат.Предупреждения.Добавить(
			"В конце файла есть незакрытая транзакция (статус U без пары C/R). "
			+ "При склейке через границу файлов пара begin/commit может разорваться.");
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СобратьОтпечаткиЗаписейLgp(ПутьКФайлу)

	Отпечатки = Новый Соответствие;
	Если Не ФайлСуществует(ПутьКФайлу) Тогда
		Возврат Отпечатки;
	КонецЕсли;

	Чтение = ОткрытьЧтениеЖурнала(ПутьКФайлу);
	Для Номер = 1 По 3 Цикл
		Чтение.ПрочитатьСтроку();
	КонецЦикла;

	БуферЗаписи = "";
	Глубина = 0;
	ВКавычках = Ложь;

	Пока Истина Цикл
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если Глубина = 0 И ПустаяСтрока(БуферЗаписи) Тогда
			Сжатая = СокрЛП(СтрокаФайла);
			Если ПустаяСтрока(Сжатая) Или Не СтрНачинаетсяС(СокрЛ(Сжатая), "{") Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках);
		Если Глубина = 0 И Не ПустаяСтрока(БуферЗаписи) Тогда
			Сжатая = СокрЛП(БуферЗаписи);
			БуферЗаписи = "";
			Если СтрЗаканчиваетсяНа(Сжатая, ",") Тогда
				Сжатая = УбратьХвостовуюЗапятую(Сжатая);
			КонецЕсли;
			Если Не ЭтоСкобочнаяЗапись(Сжатая) Тогда
				Продолжить;
			КонецЕсли;
			Токены = Токенизировать(ТелоСкобочнойЗаписи(Сжатая));
			Если ЭтоЗаписьСобытияLgpПоТокенам(Токены) Тогда
				Ключ = ОтпечатокЗаписиLgpИзТокенов(Токены);
				КоличествоСовпадений = Отпечатки.Получить(Ключ);
				Если КоличествоСовпадений = Неопределено Тогда
					КоличествоСовпадений = 0;
				КонецЕсли;
				Отпечатки.Вставить(Ключ, КоличествоСовпадений + 1);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();

	Возврат Отпечатки;

КонецФункции

&НаКлиенте
Процедура ЗаписатьПротоколКачестваСклейки()

	ДобавитьВПротокол("--- Качество склейки (оценка dry-run, без разбора тел) ---");
	ДобавитьВПротокол("Дедупликация записей: " + ?(ДедупликацияЗаписей, "включена", "выключена (по умолчанию)"));
	ДобавитьВПротокол("Разбивка источника по дням: " + ?(РазбиватьИсточникПоДням, "включена", "выключена"));

	Если ДедупликацияЗаписей Тогда
		ДобавитьВПротокол(
			"ВНИМАНИЕ: дедупликация экспериментальна. Сравниваются все поля записи "
			+ "после перенумерации. Проверяйте первый результат на копии. По умолчанию выключена.");
		ДобавитьВПротокол(
			"Оценка: дедупликация будет применена при «Присоединить» (полный разбор отпечатков по .lgp;"
			+ " на больших журналах дорого по времени и памяти). В dry-run тела файлов не сканируются.");
	КонецЕсли;
	Если РазбиватьИсточникПоДням Тогда
		ДобавитьВПротокол(
			"ВНИМАНИЕ: разбивка по дням экспериментальна. "
			+ "Резервная копия сохраняет все существующие периоды и снимок их состава. "
			+ "«Защита транзакций» — эвристика (глобальный счётчик U/C/R), не гарантия пар транзакций платформы.");
		ДобавитьВПротокол(
			"Оценка: разбивка по дням будет применена при «Присоединить» (временные файлы + полный разбор;"
			+ " на больших журналах дорого). В dry-run разбиение во временные файлы не выполняется.");
	КонецЕсли;

	ЕстьОбъединениеБезДедупа = Ложь;
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Если ВнутреннийКодДействияФайла(СтрокаФайла.Действие) = РежимКонфликтаОбъединить()
			И Не ДедупликацияЗаписей Тогда
			ЕстьОбъединениеБезДедупа = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЕстьОбъединениеБезДедупа Тогда
		ДобавитьВПротокол(
			"ВНИМАНИЕ: есть файлы с действием «Объединить» без дедупликации — при присоединении возможны повторы записей.");
	КонецЕсли;
	ДобавитьВПротокол(
		"Полный скан транзакций/архивного формата по телам .lgp в dry-run отключён (раньше тормозил анализ)."
		+ " Тяжёлая обработка — только на шаге «Присоединить».");

КонецПроцедуры

&НаСервере
Процедура ЗаписатьПротоколКачестваСклейкиНаСервереКонтекста()

	ДобавитьВПротоколНаСервереКонтекста("--- Качество склейки (оценка dry-run, без разбора тел) ---");
	ДобавитьВПротоколНаСервереКонтекста("Дедупликация записей: "
		+ ?(ДедупликацияЗаписей, "включена", "выключена (по умолчанию)"));
	ДобавитьВПротоколНаСервереКонтекста("Разбивка источника по дням: "
		+ ?(РазбиватьИсточникПоДням, "включена", "выключена"));

	Если ДедупликацияЗаписей Тогда
		ДобавитьВПротоколНаСервереКонтекста(
			"ВНИМАНИЕ: дедупликация экспериментальна. Сравниваются все поля записи "
			+ "после перенумерации. Проверяйте первый результат на копии. По умолчанию выключена.");
		ДобавитьВПротоколНаСервереКонтекста(
			"Оценка: дедупликация будет применена при «Присоединить» (полный разбор отпечатков по .lgp;"
			+ " на больших журналах дорого по времени и памяти). В dry-run тела файлов не сканируются.");
	КонецЕсли;
	Если РазбиватьИсточникПоДням Тогда
		ДобавитьВПротоколНаСервереКонтекста(
			"ВНИМАНИЕ: разбивка по дням экспериментальна. "
			+ "Резервная копия сохраняет все существующие периоды и снимок их состава. "
			+ "«Защита транзакций» — эвристика (глобальный счётчик U/C/R), не гарантия пар транзакций платформы.");
		ДобавитьВПротоколНаСервереКонтекста(
			"Оценка: разбивка по дням будет применена при «Присоединить» (временные файлы + полный разбор;"
			+ " на больших журналах дорого). В dry-run разбиение во временные файлы не выполняется.");
	КонецЕсли;

	ЕстьОбъединениеБезДедупа = Ложь;
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Если ВнутреннийКодДействияФайла(СтрокаФайла.Действие) = РежимКонфликтаОбъединить()
			И Не ДедупликацияЗаписей Тогда
			ЕстьОбъединениеБезДедупа = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЕстьОбъединениеБезДедупа Тогда
		ДобавитьВПротоколНаСервереКонтекста(
			"ВНИМАНИЕ: есть файлы с действием «Объединить» без дедупликации — при присоединении возможны повторы записей.");
	КонецЕсли;
	ДобавитьВПротоколНаСервереКонтекста(
		"Полный скан транзакций/архивного формата по телам .lgp в dry-run отключён (раньше тормозил анализ)."
		+ " Тяжёлая обработка — только на шаге «Присоединить».");

КонецПроцедуры

#КонецОбласти

#Область ФайлыLgp

&НаКлиентеНаСервереБезКонтекста
Процедура ПрисоединитьФайлLgp(ПутьИсточника, ПутьПриемника, СловарьПриемника, Карты, Объединять, НужнаПеренумерация, СведенияОтладки = Неопределено, ОпцииСклейки = Неопределено)

	Опции = НормализоватьОпцииСклейкиLgp(ОпцииСклейки);

	Если Опции.РазбиватьПоДням Тогда
		Если СведенияОтладки <> Неопределено Тогда
			СведенияОтладки.Вставить("Ветка", "split_by_day");
		КонецЕсли;
		ЗаписатьПрогрессСклейкиВФайл(
			ПутьПротоколаИзОпцийСклейки(Опции),
			"Разбивка по дням: " + ИмяФайлаИзПутиLgp(ПутьИсточника));
		ПрисоединитьФайлLgpСРазбивкойПоДням(
			ПутьИсточника,
			ПутьПриемника,
			СловарьПриемника,
			Карты,
			НужнаПеренумерация,
			Опции,
			СведенияОтладки);
		Возврат;
	КонецЕсли;

	НуженПоточныйРазбор = НужнаПеренумерация Или Опции.Дедуплицировать;

	Если Не Объединять И Не НуженПоточныйРазбор Тогда
		ЗаголовокИсточника = ПрочитатьЗаголовокLgp(ПутьИсточника);
		Если ВРег(СокрЛП(ЗаголовокИсточника.GUID)) <> ВРег(СокрЛП(СловарьПриемника.GUID))
			Или ЗаголовокИсточника.Версия <> СловарьПриемника.Версия Тогда
			Если СведенияОтладки <> Неопределено Тогда
				СведенияОтладки.Вставить("Ветка", "copy_header");
			КонецЕсли;
			СкопироватьLgpСЗаголовкомПриемника(
				ПутьИсточника,
				ПутьПриемника,
				СловарьПриемника.Версия,
				СловарьПриемника.GUID);
		Иначе
			Если СведенияОтладки <> Неопределено Тогда
				СведенияОтладки.Вставить("Ветка", "copy_raw");
			КонецЕсли;
			КопироватьФайлСЗаменой(ПутьИсточника, ПутьПриемника);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Объединять И Не НуженПоточныйРазбор Тогда
		Если СведенияОтладки <> Неопределено Тогда
			СведенияОтладки.Вставить("Ветка", "merge_raw");
		КонецЕсли;
		ОбъединитьLgpБезПеренумерации(ПутьИсточника, ПутьПриемника);
		Возврат;
	КонецЕсли;

	СтатистикаВыгрузки = Неопределено;
	Если СведенияОтладки <> Неопределено Тогда
		Если Объединять Тогда
			СведенияОтладки.Вставить("Ветка",
				?(Опции.Дедуплицировать, "merge+dedup", ?(НужнаПеренумерация, "merge+renumber", "merge")));
		Иначе
			СведенияОтладки.Вставить("Ветка", ?(НужнаПеренумерация, "rewrite+renumber", "rewrite"));
		КонецЕсли;
		СтатистикаВыгрузки = Новый Структура(
			"Записей,Однострочных,Многострочных,ПропущеноДублей", 0, 0, 0, 0);
	КонецЕсли;

	Отпечатки = Неопределено;
	Если Опции.Дедуплицировать Тогда
		Если Объединять И ФайлСуществует(ПутьПриемника) Тогда
			ПутьПротокола = ПутьПротоколаИзОпцийСклейки(Опции);
			Отпечатки = ПолучитьОтпечаткиПриемникаИзКэша(Опции, ПутьПриемника);
			Если Отпечатки = Неопределено Тогда
				ЗаписатьПрогрессСклейкиВФайл(
					ПутьПротокола,
					"Дедуп: скан приёмника " + ИмяФайлаИзПутиLgp(ПутьПриемника));
				Отпечатки = СобратьОтпечаткиЗаписейLgp(ПутьПриемника);
				СохранитьОтпечаткиПриемникаВКэш(Опции, ПутьПриемника, Отпечатки);
				ЗаписатьПрогрессСклейкиВФайл(
					ПутьПротокола,
					"Дедуп: отпечатков " + ФорматЧислаПротокола(Отпечатки.Количество()));
			КонецЕсли;
		Иначе
			Отпечатки = Новый Соответствие;
		КонецЕсли;
	КонецЕсли;

	ЗаписатьПрогрессСклейкиВФайл(
		ПутьПротоколаИзОпцийСклейки(Опции),
		?(Объединять, "Склейка", "Перезапись") + ": " + ИмяФайлаИзПутиLgp(ПутьИсточника)
			+ " -> " + ИмяФайлаИзПутиLgp(ПутьПриемника));

	ВременныйФайл = ПолучитьПутьПодготовленногоФайлаРядом(ПутьПриемника);
	ЭтоДописываниеВСуществующий = Объединять И ФайлСуществует(ПутьПриемника);
	Попытка
		Если ЭтоДописываниеВСуществующий Тогда
			КопироватьФайл(ПутьПриемника, ВременныйФайл);
			ПодготовитьПриемникLgpДляДописывания(ВременныйФайл);
		Иначе
			Разрыв = РазрывСтрокЗаголовкаLgp();
			ТекстПрефикса = СловарьПриемника.Версия + Разрыв
				+ СловарьПриемника.GUID + Разрыв
				+ Разрыв;
			ЗаписатьСыройТекстЖурналаUTF8(ВременныйФайл, ТекстПрефикса);
		КонецЕсли;

		ДобавленоЗаписей = ДописатьЗаписиLgpИзФайла(
			ПутьИсточника,
			ВременныйФайл,
			Карты,
			НужнаПеренумерация,
			СтатистикаВыгрузки,
			Отпечатки);

		Если СтатистикаВыгрузки <> Неопределено Тогда
			СведенияОтладки.Вставить("Статистика", СтатистикаВыгрузки);
		КонецЕсли;

		Если ЭтоДописываниеВСуществующий И ДобавленоЗаписей = 0 Тогда
			// Dedup/пустой источник: не публикуем stage с хвостовой запятой — приёмник нетронут.
			УдалитьФайлы(ВременныйФайл);
			Возврат;
		КонецЕсли;

		ОпубликоватьПодготовленныйФайл(ВременныйФайл, ПутьПриемника);
	Исключение
		Если ФайлСуществует(ВременныйФайл) Тогда
			УдалитьФайлы(ВременныйФайл);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПрисоединитьФайлLgpСРазбивкойПоДням(ПутьИсточника, ПутьПриемникаШаблон, СловарьПриемника, Карты, НужнаПеренумерация, Опции, СведенияОтладки = Неопределено)

	ФайлПриемника = Новый Файл(ПутьПриемникаШаблон);
	КаталогПриемника = ФайлПриемника.Путь;
	ПутьПротокола = ПутьПротоколаИзОпцийСклейки(Опции);

	ФайлыПоДням = РазложитьИсточникLgpПоДнямВоВременныеФайлы(
		ПутьИсточника,
		СловарьПриемника.Версия,
		СловарьПриемника.GUID,
		Опции.ЗащищатьТранзакции,
		ПутьПротокола);

	ЗаписатьПрогрессСклейкиВФайл(
		ПутьПротокола,
		"Разбивка завершена: дней " + ФорматЧислаПротокола(ФайлыПоДням.Количество()));

	ОпцииДня = НовыеОпцииСклейкиLgp(Опции.Дедуплицировать, Ложь);
	ОпцииДня.Вставить("ПутьПротокола", ПутьПротокола);
	ОпцииДня.Вставить("КэшОтпечатков", Новый Соответствие);
	ОбработаноДней = 0;

	Для Каждого Пара Из ФайлыПоДням Цикл

		День = Пара.Ключ;
		ВременныйИсточник = Пара.Значение;
		ПутьДня = ОбъединитьПуть(КаталогПриемника, ИмяФайлаПериодаПоДнюLgp(День));
		ОбъединятьДень = ФайлСуществует(ПутьДня);

		ЗаписатьПрогрессСклейкиВФайл(
			ПутьПротокола,
			"День " + День + ": " + ИмяФайлаИзПутиLgp(ПутьДня)
				+ ?(ОбъединятьДень, " (объединить)", " (скопировать)"));

		ПрисоединитьФайлLgp(
			ВременныйИсточник,
			ПутьДня,
			СловарьПриемника,
			Карты,
			ОбъединятьДень,
			НужнаПеренумерация,
			Неопределено,
			ОпцииДня);

		УдалитьФайлы(ВременныйИсточник);
		ОбработаноДней = ОбработаноДней + 1;

	КонецЦикла;

	Если СведенияОтладки <> Неопределено Тогда
		СведенияОтладки.Вставить("Дней", ОбработаноДней);
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РазложитьИсточникLgpПоДнямВоВременныеФайлы(ПутьИсточника, Версия, GUID, ЗащищатьТранзакции, ПутьПротокола = "")

	Результат = Новый Соответствие;
	ОткрытаяГлубина = 0;
	ЛипкийДень = "";
	Разрыв = РазрывСтрокЗаголовкаLgp();
	ТекстЗаголовка = Версия + Разрыв + GUID + Разрыв + Разрыв;
	ОбработаноЗаписей = 0;

	ЗаписатьПрогрессСклейкиВФайл(
		ПутьПротокола,
		"Разбивка: чтение " + ИмяФайлаИзПутиLgp(ПутьИсточника));

	Чтение = ОткрытьЧтениеЖурнала(ПутьИсточника);
	Для Номер = 1 По 3 Цикл
		Чтение.ПрочитатьСтроку();
	КонецЦикла;

	БуферЗаписи = "";
	Глубина = 0;
	ВКавычках = Ложь;

	Пока Истина Цикл
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если Глубина = 0 И ПустаяСтрока(БуферЗаписи) Тогда
			Сжатая = СокрЛП(СтрокаФайла);
			Если ПустаяСтрока(Сжатая) Или Не СтрНачинаетсяС(СокрЛ(Сжатая), "{") Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках);
		Если Глубина <> 0 Или ПустаяСтрока(БуферЗаписи) Тогда
			Продолжить;
		КонецЕсли;

		ТекстЗаписи = БуферЗаписи;
		БуферЗаписи = "";
		Сжатая = СокрЛП(ТекстЗаписи);
		Если СтрЗаканчиваетсяНа(Сжатая, ",") Тогда
			СжатаяПлоская = УбратьХвостовуюЗапятую(Сжатая);
		Иначе
			СжатаяПлоская = Сжатая;
		КонецЕсли;
		Если Не ЭтоСкобочнаяЗапись(СжатаяПлоская) Тогда
			Продолжить;
		КонецЕсли;

		Токены = Токенизировать(ТелоСкобочнойЗаписи(СжатаяПлоская));
		Если Не ЭтоЗаписьСобытияLgpПоТокенам(Токены) Тогда
			Продолжить;
		КонецЕсли;

		ДеньЗаписи = ДеньИзТокенаДатыLgp(Токены[ИндексПоляДатыЗаписиLgp()]);
		Если ПустаяСтрока(ДеньЗаписи) Тогда
			Продолжить;
		КонецЕсли;

		Статус = "";
		Если Токены.ВГраница() >= ИндексПоляСтатусаТранзакцииLgp() Тогда
			Статус = ВРег(СокрЛП(Токены[ИндексПоляСтатусаТранзакцииLgp()]));
		КонецЕсли;

		Если ЗащищатьТранзакции И ОткрытаяГлубина > 0 И Не ПустаяСтрока(ЛипкийДень) Тогда
			ДеньНазначения = ЛипкийДень;
		Иначе
			ДеньНазначения = ДеньЗаписи;
		КонецЕсли;

		ПутьДня = Результат.Получить(ДеньНазначения);
		Если ПутьДня = Неопределено Тогда
			ПутьДня = ПолучитьИмяВременногоФайла("lgp");
			ЗаписатьСыройТекстЖурналаUTF8(ПутьДня, ТекстЗаголовка);
			Результат.Вставить(ДеньНазначения, ПутьДня);
		Иначе
			ДописатьСыройТекстЖурналаUTF8БезBOM(ПутьДня, "," + Разрыв);
		КонецЕсли;

		ДописатьСыройТекстЖурналаUTF8БезBOM(
			ПутьДня,
			УбратьХвостовуюЗапятуюВЗаписиLgp(ТекстЗаписи) + Разрыв);

		ОбработаноЗаписей = ОбработаноЗаписей + 1;
		Если ОбработаноЗаписей = 1 Или ОбработаноЗаписей % 10000 = 0 Тогда
			ЗаписатьПрогрессСклейкиВФайл(
				ПутьПротокола,
				"Разбивка: записей " + ФорматЧислаПротокола(ОбработаноЗаписей));
		КонецЕсли;

		Если ЗащищатьТранзакции Тогда
			Если Статус = СтатусТранзакцииНезавершена() Тогда
				Если ОткрытаяГлубина = 0 Тогда
					ЛипкийДень = ДеньЗаписи;
				КонецЕсли;
				ОткрытаяГлубина = ОткрытаяГлубина + 1;
			ИначеЕсли Статус = СтатусТранзакцииЗафиксирована()
				Или Статус = СтатусТранзакцииОтменена() Тогда
				Если ОткрытаяГлубина > 0 Тогда
					ОткрытаяГлубина = ОткрытаяГлубина - 1;
				КонецЕсли;
				Если ОткрытаяГлубина = 0 Тогда
					ЛипкийДень = "";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;
	Чтение.Закрыть();

	ЗаписатьПрогрессСклейкиВФайл(
		ПутьПротокола,
		"Разбивка: всего записей " + ФорматЧислаПротокола(ОбработаноЗаписей)
			+ ", дней " + ФорматЧислаПротокола(Результат.Количество()));

	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяФайлаИзПутиLgp(ПутьКФайлу)

	ФайлLgp = Новый Файл(ПутьКФайлу);
	Возврат ФайлLgp.Имя;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьЗаголовокLgp(ПутьКФайлу)

	Результат = Новый Структура("Версия,GUID", "", "");
	Чтение = ОткрытьЧтениеЖурнала(ПутьКФайлу);
	СтрокаВерсии = Чтение.ПрочитатьСтроку();
	СтрокаGUID = Чтение.ПрочитатьСтроку();
	Чтение.Закрыть();

	Если СтрокаВерсии <> Неопределено Тогда
		Результат.Версия = СокрЛП(СтрокаВерсии);
	КонецЕсли;
	Если СтрокаGUID <> Неопределено Тогда
		Результат.GUID = СокрЛП(СтрокаGUID);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура СкопироватьLgpСЗаголовкомПриемника(ПутьИсточника, ПутьПриемника, ВерсияПриемника, GUIDПриемника)

	Разрыв = РазрывСтрокЗаголовкаLgp();

	НовыйЗаголовок = ВерсияПриемника + Разрыв + GUIDПриемника + Разрыв + Разрыв;
	ПутьПодготовленного = ПолучитьПутьПодготовленногоФайлаРядом(ПутьПриемника);
	Попытка
		Если КодировкаТекстаЖурнала(ПутьИсточника) = КодировкаТекста.UTF8 Тогда
			ЗаписатьСыройТекстЖурналаUTF8(ПутьПодготовленного, НовыйЗаголовок);
			ДописатьТелоLgpИзФайлаБинарно(ПутьИсточника, ПутьПодготовленного);
		Иначе
			// Старый UTF-16 вариант необходимо перекодировать; он встречается редко.
			ЗаписатьСыройТекстЖурналаUTF8(ПутьПодготовленного, НовыйЗаголовок);
			ДописатьТелоLgpИзТекстовогоФайлаПострочно(ПутьИсточника, ПутьПодготовленного);
		КонецЕсли;
		ОпубликоватьПодготовленныйФайл(ПутьПодготовленного, ПутьПриемника);
	Исключение
		Если ФайлСуществует(ПутьПодготовленного) Тогда
			УдалитьФайлы(ПутьПодготовленного);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТекстLgpПриемникаСЗапятойНаПоследнейЗаписи(ПутьПриемника)

	Части = ПрочитатьЗаголовокИТелоLgpПотоково(ПутьПриемника);
	Заголовок = Части.Заголовок;
	Тело = Части.Тело;

	// Битый приёмник без пустой после GUID (до 1.3.4) — восстанавливаем.
	Если Не ЗаголовокСодержитПустуюСтрокуПослеGUID(Заголовок)
		И СтрДлина(СокрЛП(Тело)) > 0
		И СтрНачинаетсяС(СокрЛП(Тело), "{") Тогда
		Разрыв = РазрывСтрокИзФрагмента(Заголовок);
		Если ПустаяСтрока(Разрыв) Тогда
			Разрыв = РазрывСтрокЗаголовкаLgp();
		КонецЕсли;
		Заголовок = Заголовок + Разрыв;
	КонецЕсли;

	Возврат Заголовок + ТекстТелаLgpСЗапятойНаПоследнейЗаписи(Тело);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГраницыПоследнейЗаписиLgpВТексте(Тело)

	Результат = Новый Структура("Найдено,Начало,Конец", Ложь, 0, 0);
	Если ПустаяСтрока(Тело) Тогда
		Возврат Результат;
	КонецЕсли;

	НачалоПоследней = 0;
	КонецПоследней = 0;
	Глубина = 0;
	ВКавычках = Ложь;
	Индекс = 1;
	Длина = СтрДлина(Тело);
	НачалоТекущей = 0;

	Пока Индекс <= Длина Цикл
		Символ = Сред(Тело, Индекс, 1);
		Если ВКавычках Тогда
			Если Символ = """" Тогда
				Если Сред(Тело, Индекс + 1, 1) = """" Тогда
					Индекс = Индекс + 2;
					Продолжить;
				КонецЕсли;
				ВКавычках = Ложь;
			КонецЕсли;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Если Символ = """" Тогда
			ВКавычках = Истина;
			Индекс = Индекс + 1;
			Продолжить;
		ИначеЕсли Символ = "{" Тогда
			Если Глубина = 0 Тогда
				НачалоТекущей = Индекс;
			КонецЕсли;
			Глубина = Глубина + 1;
			Индекс = Индекс + 1;
			Продолжить;
		ИначеЕсли Символ = "}" Тогда
			Глубина = Глубина - 1;
			Индекс = Индекс + 1;
			Если Глубина = 0 Тогда
				КонецЗаписи = Индекс;
				Если КонецЗаписи <= Длина И Сред(Тело, КонецЗаписи, 1) = "," Тогда
					КонецЗаписи = КонецЗаписи + 1;
				КонецЕсли;
				НачалоПоследней = НачалоТекущей;
				КонецПоследней = КонецЗаписи;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Индекс = Индекс + 1;
	КонецЦикла;

	Если НачалоПоследней = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Найдено = Истина;
	Результат.Начало = НачалоПоследней;
	Результат.Конец = КонецПоследней;
	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТекстТелаLgpСЗапятойНаПоследнейЗаписи(Тело)

	Границы = ГраницыПоследнейЗаписиLgpВТексте(Тело);
	Если Не Границы.Найдено Тогда
		Возврат Тело;
	КонецЕсли;

	Запись = Сред(Тело, Границы.Начало, Границы.Конец - Границы.Начало);
	Запись = ОбеспечитьХвостовуюЗапятуюВЗаписиLgp(Запись);
	Возврат Лев(Тело, Границы.Начало - 1) + Запись + Сред(Тело, Границы.Конец);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДописатьЗаписиLgpИзФайла(ПутьИсточника, ПутьДляДописывания, Карты, Перенумеровывать, СтатистикаВыгрузки = Неопределено, Отпечатки = Неопределено)

	Возврат ДописатьЗаписиLgpИзФайлаПострочно(
		ПутьИсточника,
		ПутьДляДописывания,
		Карты,
		Перенумеровывать,
		СтатистикаВыгрузки,
		Отпечатки);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПодготовитьТекстЗаписиLgp(БуферЗаписи, Карты, Перенумеровывать)

	ТекстЗаписи = БуферЗаписи;
	Если ПустаяСтрока(СокрЛП(ТекстЗаписи)) Или СокрЛП(ТекстЗаписи) = "," Тогда
		Возврат "";
	КонецЕсли;

	СжатыйПрефикс = СокрЛ(ТекстЗаписи);
	Если СтрНачинаетсяС(СжатыйПрефикс, ",") Тогда
		ТекстЗаписи = СокрЛ(Сред(СжатыйПрефикс, 2));
	КонецЕсли;
	Если Перенумеровывать Тогда
		ТекстЗаписи = ПеренумероватьЗаписьLgpСохраняяСтроки(ТекстЗаписи, Карты);
	КонецЕсли;

	Возврат ТекстЗаписи;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках)

	Если Не ПустаяСтрока(БуферЗаписи) Тогда
		БуферЗаписи = БуферЗаписи + Символы.ПС;
	КонецЕсли;
	БуферЗаписи = БуферЗаписи + СтрокаФайла;

	ОбновитьСостояниеСкобокИКавычек(СтрокаФайла, Глубина, ВКавычках);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьСостояниеСкобокИКавычек(СтрокаФайла, Глубина, ВКавычках)

	Индекс = 1;
	Длина = СтрДлина(СтрокаФайла);
	Пока Индекс <= Длина Цикл
		Символ = Сред(СтрокаФайла, Индекс, 1);
		Если ВКавычках Тогда
			Если Символ = """" Тогда
				Если Сред(СтрокаФайла, Индекс + 1, 1) = """" Тогда
					Индекс = Индекс + 2;
					Продолжить;
				КонецЕсли;
				ВКавычках = Ложь;
			КонецЕсли;
		ИначеЕсли Символ = """" Тогда
			ВКавычках = Истина;
		ИначеЕсли Символ = "{" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = "}" Тогда
			Глубина = Глубина - 1;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПеренумероватьЗаписьLgp(ТекстЗаписи, Карты)

	Сжатая = СокрЛП(ТекстЗаписи);
	ХвостоваяЗапятая = СтрЗаканчиваетсяНа(Сжатая, ",");
	Если ХвостоваяЗапятая Тогда
		Сжатая = УбратьХвостовуюЗапятую(Сжатая);
	КонецЕсли;
	Если Не ЭтоСкобочнаяЗапись(Сжатая) Тогда
		Возврат ТекстЗаписи;
	КонецЕсли;

	Токены = Токенизировать(ТелоСкобочнойЗаписи(Сжатая));
	НовыеТокены = ПеренумероватьТокеныЗаписиLgp(Токены, Карты);

	Результат = "{" + СтрСоединить(НовыеТокены, ",") + "}";
	Если ХвостоваяЗапятая Тогда
		Результат = Результат + ",";
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПеренумероватьЗаписьLgpСохраняяСтроки(БуферЗаписи, Карты)

	РазборСтрок = СобратьПлоскийТекстИПереносы(БуферЗаписи);
	Плоский = РазборСтрок.Плоский;
	ПозицииПереносов = РазборСтрок.ПозицииПереносов;

	Сжатая = СокрЛП(Плоский);
	ХвостоваяЗапятая = СтрЗаканчиваетсяНа(Сжатая, ",");
	Если ХвостоваяЗапятая Тогда
		Сжатая = УбратьХвостовуюЗапятую(Сжатая);
	КонецЕсли;
	Если Не ЭтоСкобочнаяЗапись(Сжатая) Тогда
		Возврат БуферЗаписи;
	КонецЕсли;

	Токены = Токенизировать(ТелоСкобочнойЗаписи(Сжатая));
	НовыеТокены = ПеренумероватьТокеныЗаписиLgp(Токены, Карты);

	Позиция = 2;
	Для Индекс = 0 По Токены.ВГраница() Цикл
		ДлинаСтарого = СтрДлина(Токены[Индекс]);
		Дельта = СтрДлина(НовыеТокены[Индекс]) - ДлинаСтарого;
		Если Дельта <> 0 Тогда
			СкорректироватьПозицииПереносов(ПозицииПереносов, Позиция + ДлинаСтарого, Дельта);
		КонецЕсли;
		Позиция = Позиция + ДлинаСтарого + 1;
	КонецЦикла;

	НовыйПлоский = "{" + СтрСоединить(НовыеТокены, ",") + "}";
	Если ХвостоваяЗапятая Тогда
		НовыйПлоский = НовыйПлоский + ",";
	КонецЕсли;

	Возврат ВставитьПереносыСтрок(НовыйПлоский, ПозицииПереносов);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПеренумероватьТокеныЗаписиLgp(Токены, Карты)

	НовыеТокены = Новый Массив;
	Для Индекс = 0 По Токены.ВГраница() Цикл
		НовыеТокены.Добавить(Токены[Индекс]);
	КонецЦикла;

	ВерхняяГраницаТокенов = НовыеТокены.ВГраница();
	Для Каждого ПолеСсылки Из ПоляСсылокЗаписиLgp() Цикл
		// ИндексПоля — 0-based; доступен только при ИндексПоля <= ВГраница().
		Если ПолеСсылки.ИндексПоля > ВерхняяГраницаТокенов Тогда
			Продолжить;
		КонецЕсли;

		Если ПолеСсылки.Составное Тогда
			НовыеТокены[ПолеСсылки.ИндексПоля] = ПеренумероватьСоставноеПоле(
				НовыеТокены[ПолеСсылки.ИндексПоля],
				Карты.Получить(ПолеСсылки.ТипОбъекта));
		Иначе
			НовыеТокены[ПолеСсылки.ИндексПоля] = ЗаменитьНомерПоТипу(
				НовыеТокены[ПолеСсылки.ИндексПоля],
				Карты,
				ПолеСсылки.ТипОбъекта);
		КонецЕсли;
	КонецЦикла;

	Возврат НовыеТокены;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СобратьПлоскийТекстИПереносы(БуферЗаписи)

	// Храним тип разрыва: LF / CRLF / CR — иначе CR из CRLF попадает в плоский текст и ломает токены.
	// Фрагменты между разрывами копируем целиком (Сред), без склейки по символу.
	Фрагменты = Новый Массив;
	ПозицииПереносов = Новый Массив;
	ДлинаПлоского = 0;
	НачалоФрагмента = 1;
	Индекс = 1;
	Длина = СтрДлина(БуферЗаписи);
	Пока Индекс <= Длина Цикл
		Символ = Сред(БуферЗаписи, Индекс, 1);
		Если Символ = Символы.ВК Тогда
			Если НачалоФрагмента < Индекс Тогда
				ДлинаКуска = Индекс - НачалоФрагмента;
				Фрагменты.Добавить(Сред(БуферЗаписи, НачалоФрагмента, ДлинаКуска));
				ДлинаПлоского = ДлинаПлоского + ДлинаКуска;
			КонецЕсли;
			Если Сред(БуферЗаписи, Индекс + 1, 1) = Символы.ПС Тогда
				ПозицииПереносов.Добавить(Новый Структура("Позиция,Разрыв",
					ДлинаПлоского, Символы.ВК + Символы.ПС));
				Индекс = Индекс + 2;
			Иначе
				ПозицииПереносов.Добавить(Новый Структура("Позиция,Разрыв",
					ДлинаПлоского, Символы.ВК));
				Индекс = Индекс + 1;
			КонецЕсли;
			НачалоФрагмента = Индекс;
		ИначеЕсли Символ = Символы.ПС Тогда
			Если НачалоФрагмента < Индекс Тогда
				ДлинаКуска = Индекс - НачалоФрагмента;
				Фрагменты.Добавить(Сред(БуферЗаписи, НачалоФрагмента, ДлинаКуска));
				ДлинаПлоского = ДлинаПлоского + ДлинаКуска;
			КонецЕсли;
			ПозицииПереносов.Добавить(Новый Структура("Позиция,Разрыв",
				ДлинаПлоского, Символы.ПС));
			Индекс = Индекс + 1;
			НачалоФрагмента = Индекс;
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Если НачалоФрагмента <= Длина Тогда
		Фрагменты.Добавить(Сред(БуферЗаписи, НачалоФрагмента));
	КонецЕсли;

	Возврат Новый Структура("Плоский,ПозицииПереносов", СтрСоединить(Фрагменты, ""), ПозицииПереносов);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура СкорректироватьПозицииПереносов(ПозицииПереносов, Порог, Дельта)

	Для Индекс = 0 По ПозицииПереносов.ВГраница() Цикл
		Описание = ПозицииПереносов[Индекс];
		Если Описание.Позиция >= Порог Тогда
			Описание.Позиция = Описание.Позиция + Дельта;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВставитьПереносыСтрок(Плоский, ПозицииПереносов)

	Если ПозицииПереносов.Количество() = 0 Тогда
		Возврат Плоский;
	КонецЕсли;

	Части = Новый Массив;
	ДлинаПлоского = СтрДлина(Плоский);
	ПредыдущаяПозиция = 0;

	Для Индекс = 0 По ПозицииПереносов.ВГраница() Цикл
		Описание = ПозицииПереносов[Индекс];
		Позиция = Описание.Позиция;
		Если Позиция < ПредыдущаяПозиция Или Позиция > ДлинаПлоского Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить(Сред(Плоский, ПредыдущаяПозиция + 1, Позиция - ПредыдущаяПозиция));
		Части.Добавить(Описание.Разрыв);
		ПредыдущаяПозиция = Позиция;
	КонецЦикла;

	Части.Добавить(Сред(Плоский, ПредыдущаяПозиция + 1));
	Возврат СтрСоединить(Части, "");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаменитьНомерПоТипу(Токен, Карты, ТипОбъекта)

	Карта = Карты.Получить(ТипОбъекта);
	Если Карта = Неопределено Тогда
		Возврат Токен;
	КонецЕсли;

	Возврат ЗаменитьНомер(Токен, Карта);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаменитьНомер(Токен, Карта)

	Значение = СокрЛП(Токен);
	Номер = ЧислоИзТокена(Значение);
	Если Номер <= 0 Тогда
		Возврат Токен;
	КонецЕсли;

	НовыйНомер = Карта.Получить(Номер);
	Если НовыйНомер = Неопределено Тогда
		Возврат Токен;
	КонецЕсли;

	Возврат ФорматЧислаПротокола(НовыйНомер);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПеренумероватьСоставноеПоле(Токен, Карта)

	Если Карта = Неопределено Тогда
		Возврат Токен;
	КонецЕсли;

	Значение = СокрЛП(Токен);
	Если Не СтрНачинаетсяС(Значение, "{") Тогда
		Возврат ЗаменитьНомер(Токен, Карта);
	КонецЕсли;
	Если Не СтрЗаканчиваетсяНа(Значение, "}") Тогда
		Возврат Токен;
	КонецЕсли;

	Части = Токенизировать(ТелоСкобочнойЗаписи(Значение));
	Для Индекс = 0 По Части.ВГраница() Цикл
		Части[Индекс] = ЗаменитьНомер(Части[Индекс], Карта);
	КонецЦикла;

	Возврат "{" + СтрСоединить(Части, ",") + "}";

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПутьПодготовленногоФайлаРядом(Приемник)

	Метка = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Возврат Приемник + ".stage_" + Метка;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура КопироватьФайлСЗаменой(Источник, Приемник)

	ПутьПодготовленного = ПолучитьПутьПодготовленногоФайлаРядом(Приемник);
	Попытка
		КопироватьФайл(Источник, ПутьПодготовленного);
		ОпубликоватьПодготовленныйФайл(ПутьПодготовленного, Приемник);
	Исключение
		Если ФайлСуществует(ПутьПодготовленного) Тогда
			УдалитьФайлы(ПутьПодготовленного);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОпубликоватьПодготовленныйФайл(ПутьПодготовленного, Приемник)

	Метка = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	ПутьПредыдущего = Приемник + ".previous_" + Метка;
	ЕстьПредыдущий = ФайлСуществует(Приемник);
	Опубликовано = Ложь;

	Попытка
		Если ЕстьПредыдущий Тогда
			ПереместитьФайл(Приемник, ПутьПредыдущего);
		КонецЕсли;
		ПереместитьФайл(ПутьПодготовленного, Приемник);
		Опубликовано = Истина;
		Если ФайлСуществует(ПутьПредыдущего) Тогда
			Попытка
				УдалитьФайлы(ПутьПредыдущего);
			Исключение
				// Новый файл уже опубликован; остаток previous безопаснее удалить вручную позже.
			КонецПопытки;
		КонецЕсли;
	Исключение
		Если Не Опубликовано И Не ФайлСуществует(Приемник) И ФайлСуществует(ПутьПредыдущего) Тогда
			ПереместитьФайл(ПутьПредыдущего, Приемник);
		КонецЕсли;
		Если ФайлСуществует(ПутьПодготовленного) Тогда
			УдалитьФайлы(ПутьПодготовленного);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбъединитьLgpСПоточнойПерекодировкой(ПутьИсточника, ПутьПриемника, КодировкаПриемника)

	ЧтениеЗаголовка = ОткрытьЧтениеЖурнала(ПутьПриемника);
	СтрокиЗаголовка = Новый Массив;
	Для Номер = 1 По 3 Цикл
		СтрокаЗаголовка = ЧтениеЗаголовка.ПрочитатьСтроку();
		Если СтрокаЗаголовка = Неопределено Тогда
			СтрокаЗаголовка = "";
		КонецЕсли;
		СтрокиЗаголовка.Добавить(СтрокаЗаголовка);
	КонецЦикла;
	ЧтениеЗаголовка.Закрыть();

	Разрыв = РазрывСтрокЗаголовкаLgp();
	ПутьПодготовленного = ПолучитьПутьПодготовленногоФайлаРядом(ПутьПриемника);
	Попытка
		ЗаписатьСыройТекстЖурналаВКодировке(
			ПутьПодготовленного,
			СтрСоединить(СтрокиЗаголовка, Разрыв) + Разрыв,
			КодировкаПриемника);

		ДописатьЗаписиLgpИзФайлаПострочно(
			ПутьПриемника, ПутьПодготовленного, Новый Соответствие, Ложь,
			Неопределено, Неопределено, КодировкаПриемника, Истина);
		ДобавленоИзИсточника = ДописатьЗаписиLgpИзФайлаПострочно(
			ПутьИсточника, ПутьПодготовленного, Новый Соответствие, Ложь,
			Неопределено, Неопределено, КодировкаПриемника, Ложь);

		Если ДобавленоИзИсточника = 0 Тогда
			УдалитьФайлы(ПутьПодготовленного);
			Возврат;
		КонецЕсли;

		ОпубликоватьПодготовленныйФайл(ПутьПодготовленного, ПутьПриемника);
	Исключение
		Если ФайлСуществует(ПутьПодготовленного) Тогда
			УдалитьФайлы(ПутьПодготовленного);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДописатьТелоLgpИзТекстовогоФайлаПострочно(ПутьИсточника, ПутьПриемника)

	Чтение = ОткрытьЧтениеЖурнала(ПутьИсточника);
	Для Номер = 1 По 3 Цикл
		Чтение.ПрочитатьСтроку();
	КонецЦикла;

	Разрыв = РазрывСтрокЗаголовкаLgp();
	СтрокиПакета = Новый Массив;
	Пока Истина Цикл
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		СтрокиПакета.Добавить(СтрокаФайла);
		Если СтрокиПакета.Количество() >= 3000 Тогда
			ДописатьСыройТекстЖурналаUTF8БезBOM(
				ПутьПриемника,
				СтрСоединить(СтрокиПакета, Разрыв) + Разрыв);
			СтрокиПакета.Очистить();
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();

	Если СтрокиПакета.Количество() > 0 Тогда
		ДописатьСыройТекстЖурналаUTF8БезBOM(
			ПутьПриемника,
			СтрСоединить(СтрокиПакета, Разрыв) + Разрыв);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область РазборТекста

&НаКлиентеНаСервереБезКонтекста
Функция КодировкаТекстаЖурнала(ПутьКФайлу)

	// Только префикс файла — не открывать ЧтениеТекста на весь .lgp ради одной строки.
	Префикс = ПрочитатьПрефиксФайлаЖурнала(ПутьКФайлу, 1024);
	Кодировка = КодировкаТекста.UTF8;
	Если СтрНайти(Префикс, МаркерФорматаЖР()) = 0 Тогда
		Кодировка = КодировкаТекста.UTF16;
	КонецЕсли;

	Возврат Кодировка;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОткрытьЧтениеЖурнала(ПутьКФайлу)

	Возврат Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекстаЖурнала(ПутьКФайлу));

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьСыройТекстЖурналаUTF8(ПутьКФайлу)

	Данные = Новый ДвоичныеДанные(ПутьКФайлу);
	Текст = ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
	// BOM UTF-8 (EF BB BF) после декодирования часто остаётся как U+FEFF.
	Если СтрДлина(Текст) > 0 И КодСимвола(Лев(Текст, 1)) = 65279 Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;

	Возврат Текст;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаписатьСыройТекстЖурналаUTF8(ПутьКФайлу, Текст)

	ЗаписатьСыройТекстЖурналаВКодировке(ПутьКФайлу, Текст, КодировкаТекста.UTF8);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаписатьСыройТекстЖурналаВКодировке(ПутьКФайлу, Текст, Кодировка)

	// Начало самостоятельного текстового файла всегда содержит BOM выбранной кодировки.
	Данные = ПолучитьДвоичныеДанныеИзСтроки(Текст, Кодировка, Истина);
	Данные.Записать(ПутьКФайлу);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДописатьСыройТекстЖурналаUTF8БезBOM(ПутьКФайлу, Текст)

	ДописатьСыройТекстЖурналаБезBOM(ПутьКФайлу, Текст, КодировкаТекста.UTF8);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДописатьСыройТекстЖурналаБезBOM(ПутьКФайлу, Текст, Кодировка = Неопределено)

	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	Если Кодировка = Неопределено Тогда
		Кодировка = КодировкаТекста.UTF8;
	КонецЕсли;

	Поток = Неопределено;
	Запись = Неопределено;
	Попытка
		Поток = ФайловыеПотоки.ОткрытьДляДописывания(ПутьКФайлу);
		Запись = Новый ЗаписьДанных(Поток);
		Буфер = ПолучитьБуферДвоичныхДанныхИзСтроки(Текст, Кодировка);
		Запись.ЗаписатьБуферДвоичныхДанных(Буфер);
	Исключение
		Если Запись <> Неопределено Тогда
			Запись.Закрыть();
		КонецЕсли;
		Если Поток <> Неопределено Тогда
			Поток.Закрыть();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Запись.Закрыть();
	Поток.Закрыть();

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РазрывСтрокЗаголовкаLgp()

	Возврат Символы.ВК + Символы.ПС;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РазрывСтрокИзФрагмента(Фрагмент)

	Если СтрНайти(Фрагмент, Символы.ВК + Символы.ПС) > 0 Тогда
		Возврат Символы.ВК + Символы.ПС;
	ИначеЕсли СтрНайти(Фрагмент, Символы.ПС) > 0 Тогда
		Возврат Символы.ПС;
	ИначеЕсли СтрНайти(Фрагмент, Символы.ВК) > 0 Тогда
		Возврат Символы.ВК;
	КонецЕсли;

	Возврат "";

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РазделитьЗаголовокИТелоLgp(Текст)

	// Три логические строки: версия, GUID, пустая — с исходными разрывами.
	Позиция = 1;
	НомерСтроки = 0;
	Длина = СтрДлина(Текст);
	Пока Позиция <= Длина И НомерСтроки < 3 Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = Символы.ВК Тогда
			Если Сред(Текст, Позиция + 1, 1) = Символы.ПС Тогда
				Позиция = Позиция + 2;
			Иначе
				Позиция = Позиция + 1;
			КонецЕсли;
			НомерСтроки = НомерСтроки + 1;
		ИначеЕсли Символ = Символы.ПС Тогда
			Позиция = Позиция + 1;
			НомерСтроки = НомерСтроки + 1;
		Иначе
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;

	Заголовок = Лев(Текст, Позиция - 1);
	Тело = Сред(Текст, Позиция);
	Возврат Новый Структура("Заголовок,Тело", Заголовок, Тело);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокСодержитПустуюСтрокуПослеGUID(Заголовок)

	НомерСтроки = 0;
	ПустаяТекущая = Истина;
	Индекс = 1;
	Длина = СтрДлина(Заголовок);
	Пока Индекс <= Длина Цикл
		Символ = Сред(Заголовок, Индекс, 1);
		Если Символ = Символы.ВК Тогда
			Если НомерСтроки = 2 И ПустаяТекущая Тогда
				Возврат Истина;
			КонецЕсли;
			НомерСтроки = НомерСтроки + 1;
			ПустаяТекущая = Истина;
			Если Сред(Заголовок, Индекс + 1, 1) = Символы.ПС Тогда
				Индекс = Индекс + 2;
			Иначе
				Индекс = Индекс + 1;
			КонецЕсли;
			Продолжить;
		ИначеЕсли Символ = Символы.ПС Тогда
			Если НомерСтроки = 2 И ПустаяТекущая Тогда
				Возврат Истина;
			КонецЕсли;
			НомерСтроки = НомерСтроки + 1;
			ПустаяТекущая = Истина;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		ПустаяТекущая = Ложь;
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат НомерСтроки >= 3 И ПустаяТекущая;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОбеспечитьХвостовуюЗапятуюВЗаписиLgp(БуферЗаписи)

	Хвост = "";
	Текст = БуферЗаписи;
	Пока СтрДлина(Текст) > 0 Цикл
		Символ = Сред(Текст, СтрДлина(Текст), 1);
		Если Символ = Символы.ПС Или Символ = Символы.ВК Или Символ = " " Или Символ = Символы.Таб Тогда
			Хвост = Символ + Хвост;
			Текст = Лев(Текст, СтрДлина(Текст) - 1);
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ПустаяСтрока(Текст) И Не СтрЗаканчиваетсяНа(Текст, ",") Тогда
		Текст = Текст + ",";
	КонецЕсли;

	Возврат Текст + Хвост;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция УбратьХвостовуюЗапятуюВЗаписиLgp(БуферЗаписи)

	Хвост = "";
	Текст = БуферЗаписи;
	Пока СтрДлина(Текст) > 0 Цикл
		Символ = Сред(Текст, СтрДлина(Текст), 1);
		Если Символ = Символы.ПС Или Символ = Символы.ВК Или Символ = " " Или Символ = Символы.Таб Тогда
			Хвост = Символ + Хвост;
			Текст = Лев(Текст, СтрДлина(Текст) - 1);
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если СтрЗаканчиваетсяНа(Текст, ",") Тогда
		Текст = Лев(Текст, СтрДлина(Текст) - 1);
	КонецЕсли;

	Возврат Текст + Хвост;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция Токенизировать(Знач Текст)

	Токены = Новый Массив;
	Текущий = "";
	Глубина = 0;
	ВКавычках = Ложь;
	Индекс = 1;
	Длина = СтрДлина(Текст);

	Пока Индекс <= Длина Цикл

		Символ = Сред(Текст, Индекс, 1);

		Если ВКавычках Тогда
			Текущий = Текущий + Символ;
			Если Символ = """" Тогда
				Если Сред(Текст, Индекс + 1, 1) = """" Тогда
					Текущий = Текущий + """";
					Индекс = Индекс + 2;
					Продолжить;
				КонецЕсли;
				ВКавычках = Ложь;
			КонецЕсли;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Если Символ = """" Тогда
			ВКавычках = Истина;
			Текущий = Текущий + Символ;
		ИначеЕсли Символ = "{" Тогда
			Глубина = Глубина + 1;
			Текущий = Текущий + Символ;
		ИначеЕсли Символ = "}" Тогда
			Глубина = Глубина - 1;
			Текущий = Текущий + Символ;
		ИначеЕсли Символ = "," И Глубина = 0 Тогда
			Токены.Добавить(СокрЛП(Текущий));
			Текущий = "";
		Иначе
			Текущий = Текущий + Символ;
		КонецЕсли;

		Индекс = Индекс + 1;

	КонецЦикла;

	Если Не ПустаяСтрока(Текущий) Или Длина > 0 Тогда
		Токены.Добавить(СокрЛП(Текущий));
	КонецЕсли;

	Возврат Токены;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоСкобочнаяЗапись(Знач Значение)

	Возврат СтрНачинаетсяС(Значение, "{") И СтрЗаканчиваетсяНа(Значение, "}");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТелоСкобочнойЗаписи(Знач Значение)

	Возврат Сред(Значение, 2, СтрДлина(Значение) - 2);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция УбратьХвостовуюЗапятую(Знач Значение)

	Если СтрЗаканчиваетсяНа(Значение, ",") Тогда
		Возврат Лев(Значение, СтрДлина(Значение) - 1);
	КонецЕсли;

	Возврат Значение;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СнятьКавычки(Знач Значение)

	Значение = СокрЛП(Значение);
	Если СтрДлина(Значение) >= 2 И СтрНачинаетсяС(Значение, """") И СтрЗаканчиваетсяНа(Значение, """") Тогда
		Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
		Значение = СтрЗаменить(Значение, """""", """");
	КонецЕсли;

	Возврат Значение;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭкранироватьКавычки(Знач Значение)

	Возврат СтрЗаменить(Строка(Значение), """", """""");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЧислоИзТокена(Знач Значение)

	Значение = СокрЛП(Значение);
	Если ПустаяСтрока(Значение) Тогда
		Возврат 0;
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Индекс);
		Если Код < 48 Или Код > 57 Тогда
			Возврат 0;
		КонецЕсли;
	КонецЦикла;

	Возврат Число(Значение);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФорматЧислаПротокола(Значение)

	Возврат Формат(Значение, "ЧН=0; ЧГ=0");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеРазмера(Размер)

	Если Размер < 1024 Тогда
		Возврат ФорматЧислаПротокола(Размер) + " Б";
	ИначеЕсли Размер < 1024 * 1024 Тогда
		Возврат Формат(Размер / 1024, "ЧДЦ=1; ЧН=0") + " КБ";
	ИначеЕсли Размер < 1024 * 1024 * 1024 Тогда
		Возврат Формат(Размер / 1024 / 1024, "ЧДЦ=1; ЧН=0") + " МБ";
	КонецЕсли;

	Возврат Формат(Размер / 1024 / 1024 / 1024, "ЧДЦ=2; ЧН=0") + " ГБ";

КонецФункции

#КонецОбласти

#Область УскорениеPython

&НаКлиенте
Функция ОбновитьСостояниеУскоренияPythonНаКлиенте(ПисатьВПротокол)

	Результат = Новый Структура("Доступно,Команда,Скрипт,Причина", Ложь, "", "", "");

	Если ВыполнятьНаСервере Тогда
		Результат.Причина =
			"Ускоренный режим через Python доступен только при выполнении «На клиенте»."
			+ " В режиме «На сервере» присоединяйте обычным способом в этой обработке.";
		КомандаPythonУскорения = "";
		ПутьСкриптаУскоренияPython = "";
		Если ПисатьВПротокол Тогда
			ДобавитьВПротокол(Результат.Причина);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Если ДедупликацияЗаписей Или РазбиватьИсточникПоДням Тогда
		Результат.Причина =
			"Ускорение через Python пока не поддерживает дедупликацию и разбивку по дням."
			+ " С этими опциями выполните присоединение в этой обработке (1С).";
		КомандаPythonУскорения = "";
		ПутьСкриптаУскоренияPython = "";
		Если ПисатьВПротокол Тогда
			ДобавитьВПротокол(Результат.Причина);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Скрипт = НайтиСкриптУскоренияЖРНаКлиенте();
	Если ПустаяСтрока(Скрипт) Тогда
		Результат.Причина =
			"Ускоренный режим на этом компьютере сейчас недоступен: не найден файл скрипта"
			+ " attach_event_log.py (положите его рядом с обработкой .epf или в папку tools)."
			+ " Можно продолжить обычным способом в этой обработке.";
		КомандаPythonУскорения = "";
		ПутьСкриптаУскоренияPython = "";
		Если ПисатьВПротокол Тогда
			ДобавитьВПротокол(Результат.Причина);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	КомандаPython = НайтиКомандуPythonНаКлиенте();
	Если ПустаяСтрока(КомандаPython) Тогда
		Результат.Причина =
			"Ускоренный режим на этом компьютере сейчас недоступен: не найдена программа Python."
			+ " Можно продолжить обычным способом в этой обработке."
			+ " Если нужно ускорение на больших журналах — установите Python 3 с python.org"
			+ " и отметьте Add to PATH, затем откройте обработку снова.";
		КомандаPythonУскорения = "";
		ПутьСкриптаУскоренияPython = Скрипт;
		Если ПисатьВПротокол Тогда
			ДобавитьВПротокол(Результат.Причина);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Результат.Доступно = Истина;
	Результат.Команда = КомандаPython;
	Результат.Скрипт = Скрипт;
	КомандаPythonУскорения = КомандаPython;
	ПутьСкриптаУскоренияPython = Скрипт;
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция НайтиКомандуPythonНаКлиенте()

	Кандидаты = Новый Массив;
	Кандидаты.Добавить("py -3");
	Кандидаты.Добавить("python");
	Кандидаты.Добавить("python3");

	Для Каждого Кандидат Из Кандидаты Цикл
		Если КомандаPythonОтвечаетНаКлиенте(Кандидат) Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

&НаКлиенте
Функция КомандаPythonОтвечаетНаКлиенте(КомандаPython)

	КодВозврата = Неопределено;
	СтрокаПроверки = КомандаPython
		+ " -c ""import sys; raise SystemExit(0 if sys.version_info[0] >= 3 else 1)""";
	Попытка
		ЗапуститьПриложение(СтрокаПроверки, , Истина, КодВозврата);
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат КодВозврата = 0;

КонецФункции

&НаКлиенте
Функция НайтиСкриптУскоренияЖРНаКлиенте()

	ИмяСкрипта = "attach_event_log.py";
	Кандидаты = Новый Массив;

	ПутьEpf = ПутьКФайлуОбработкиНаСервереКонтекста();
	Если Не ПустаяСтрока(ПутьEpf) Тогда
		ФайлEpf = Новый Файл(ПутьEpf);
		КаталогEpf = ФайлEpf.Путь;
		Кандидаты.Добавить(ОбъединитьПуть(КаталогEpf, ИмяСкрипта));
		Кандидаты.Добавить(ОбъединитьПуть(ОбъединитьПуть(КаталогEpf, "tools"), ИмяСкрипта));
		Родитель = КаталогРодительПути(КаталогEpf);
		Если Не ПустаяСтрока(Родитель) Тогда
			Кандидаты.Добавить(ОбъединитьПуть(ОбъединитьПуть(Родитель, "tools"), ИмяСкрипта));
		КонецЕсли;
	КонецЕсли;

	Для Каждого ПутьСкрипта Из Кандидаты Цикл
		Если ФайлСуществует(ПутьСкрипта) Тогда
			Возврат ПутьСкрипта;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КаталогРодительПути(ПутьКаталога)

	Очищенный = СокрЛП(ПутьКаталога);
	Пока СтрДлина(Очищенный) > 1
		И (СтрЗаканчиваетсяНа(Очищенный, "\") Или СтрЗаканчиваетсяНа(Очищенный, "/")) Цикл
		Очищенный = Лев(Очищенный, СтрДлина(Очищенный) - 1);
	КонецЦикла;

	ФайлКаталога = Новый Файл(Очищенный);
	Возврат ФайлКаталога.Путь;

КонецФункции

&НаСервере
Функция ПутьКФайлуОбработкиНаСервереКонтекста()

	Попытка
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		Возврат ОбработкаОбъект.ИспользуемоеИмяФайла;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция СформироватьТекстВыбораДвижкаПрисоединения(КоличествоОтмеченных, СостояниеPython)

	Сводка = СводкаПрисоединения();
	Рекомендация = ТекстРекомендацииДвижкаПрисоединения(Сводка);

	ПС = Символы.ПС;
	Текст =
		"Будут изменены файлы в каталоге текущего ЖР."
		+ ПС + "Отмечено файлов: " + Формат(КоличествоОтмеченных, "ЧГ=0")
		+ ", объём: " + ПредставлениеРазмера(Сводка.ОбъёмБайт)
		+ ", перенумерация: " + ?(НужнаПеренумерация, "да", "нет")
		+ ПС + ПС + Рекомендация;

	Если СоздаватьРезервнуюКопию Тогда
		Текст = Текст + ПС + ПС + "Перед записью будет резервная копия изменяемых файлов.";
	КонецЕсли;

	Если Не СостояниеPython.Доступно Тогда
		Текст = Текст + ПС + ПС + СостояниеPython.Причина;
	Иначе
		Текст = Текст + ПС + ПС
			+ "Выберите способ: в этой обработке или через Python на этом компьютере.";
	КонецЕсли;

	Возврат Текст;

КонецФункции

&НаКлиенте
Функция ТекстРекомендацииДвижкаПрисоединения(Сводка)

	ОбъёмБайт = Сводка.ОбъёмБайт;
	ПорогБольшогоОбъёма = 50 * 1024 * 1024;
	СклонятьКPython = (НужнаПеренумерация Или ОбъёмБайт >= ПорогБольшогоОбъёма)
		И Не ДедупликацияЗаписей
		И Не РазбиватьИсточникПоДням;

	Если СклонятьКPython Тогда
		Возврат "Рекомендация: для этого объёма и настроек обычно быстрее"
			+ " выполнить склейку через Python на этом компьютере."
			+ " Можно остаться в обработке — результат тот же.";
	КонецЕсли;

	Возврат "Рекомендация: объём небольшой, достаточно выполнить присоединение"
		+ " в этой обработке.";

КонецФункции

&НаКлиенте
Процедура НачатьПрисоединениеЧерезPython(СостояниеPython)

	СброситьПротокол();
	НачатьЗаписьПротоколаВФайл("attach-python");
	ПодготовитьСеансОтладки("attach-python");

	Попытка
		ПроверитьКаталоги();
		ПроверитьФизическоеРазличиеКаталоговДляЗаписи(КаталогИсточника, КаталогПриемника);

		Заблокированные = НайтиЗаблокированныеФайлыПриемника();
		Если Заблокированные.Количество() > 0 Тогда
			ВызватьИсключение "Файлы приёмника заблокированы (вероятно, ragent/кластер). "
				+ "Скопируйте 1Cv8Log и работайте с копией. Заблокировано: "
				+ СтрСоединить(Заблокированные, ", ");
		КонецЕсли;

		ПутьLgfИсточника = ПутьКСловарюЖР(КаталогИсточника);
		ПутьLgfПриемника = ПутьКСловарюЖР(КаталогПриемника);
		ДанныеАнализа = ПолучитьДанныеАнализаДляПрисоединения(ПутьLgfИсточника, ПутьLgfПриемника);
		РезультатКарт = ДанныеАнализа.РезультатКарт;

		Если СоздаватьРезервнуюКопию Тогда
			ПутьКопииКаталога = СоздатьВыборочнуюКопиюФайловПриемника(РезультатКарт);
			ДобавитьВПротокол("Резервная копия изменяемых файлов: " + ПутьКопииКаталога);
		КонецЕсли;

		ПутьСписка = ПолучитьИмяВременногоФайла("txt");
		ЗаписатьСписокФайловДляУскоренияPython(ПутьСписка);
		ПутьЛога = ПолучитьИмяВременногоФайла("log");
		ЗаписатьСыройТекстЖурналаUTF8(ПутьЛога, "");

		ПутьСпискаФайловУскорения = ПутьСписка;
		ПутьЛогаУскоренияPython = ПутьЛога;
		ПозицияЧтенияЛогаУскорения = 0;
		ОжиданиеУскоренияPython = Истина;

		СтрокаКоманды = СобратьКомандуУскоренияPython(
			СостояниеPython.Команда,
			СостояниеPython.Скрипт,
			КаталогИсточника,
			КаталогПриемника,
			ПутьСписка,
			ПутьЛога);

		ДобавитьВПротокол("=== Начало присоединения (ускорение Python) ===");
		ДобавитьВПротокол("Команда: " + СтрокаКоманды);
		ДобавитьВПротокол("Лог: " + ПутьЛога);

		ФайлСкрипта = Новый Файл(СостояниеPython.Скрипт);
		ПодключитьОбработчикОжидания("ОпросЛогаУскоренияPython", 1, Ложь);
		Оповещение = Новый ОписаниеОповещения("ПослеЗавершенияPythonУскорения", ЭтотОбъект);
		НачатьЗапускПриложения(Оповещение, СтрокаКоманды, ФайлСкрипта.Путь, Истина);

	Исключение
		ОжиданиеУскоренияPython = Ложь;
		ОтключитьОбработчикОжидания("ОпросЛогаУскоренияPython");
		Информация = ИнформацияОбОшибке();
		ДобавитьВПротокол("Ошибка: " + ПодробноеПредставлениеОшибки(Информация));
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(Информация));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьСписокФайловДляУскоренияPython(ПутьСписка)

	Строки = Новый Массив;
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Код = ВнутреннийКодДействияФайла(СтрокаФайла.Действие);
		Строки.Добавить(СтрокаФайла.ИмяФайла + "|" + Код);
	КонецЦикла;

	ЗаписатьСыройТекстЖурналаUTF8(ПутьСписка, СтрСоединить(Строки, Символы.ПС) + Символы.ПС);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СобратьКомандуУскоренияPython(КомандаPython, ПутьСкрипта, КаталогSrc, КаталогDst, ПутьСписка, ПутьЛога)

	Возврат КомандаPython
		+ " "
		+ КавычкиДляКоманднойСтроки(ПутьСкрипта)
		+ " --mode attach"
		+ " --src " + КавычкиДляКоманднойСтроки(КаталогSrc)
		+ " --dst " + КавычкиДляКоманднойСтроки(КаталогDst)
		+ " --conflict merge"
		+ " --files-from " + КавычкиДляКоманднойСтроки(ПутьСписка)
		+ " --out-log " + КавычкиДляКоманднойСтроки(ПутьЛога);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КавычкиДляКоманднойСтроки(Путь)

	Возврат """" + СтрЗаменить(Путь, """", """""") + """";

КонецФункции

&НаКлиенте
Процедура ОпросЛогаУскоренияPython()

	Если Не ОжиданиеУскоренияPython Или ПустаяСтрока(ПутьЛогаУскоренияPython) Тогда
		ОтключитьОбработчикОжидания("ОпросЛогаУскоренияPython");
		Возврат;
	КонецЕсли;

	ДочитатьЛогУскоренияPythonВПротокол();

КонецПроцедуры

&НаКлиенте
Процедура ДочитатьЛогУскоренияPythonВПротокол()

	Если ПустаяСтрока(ПутьЛогаУскоренияPython) Или Не ФайлСуществует(ПутьЛогаУскоренияPython) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ТекстЛога = ПрочитатьСыройТекстЖурналаUTF8(ПутьЛогаУскоренияPython);
	Исключение
		Возврат;
	КонецПопытки;

	Если СтрДлина(ТекстЛога) <= ПозицияЧтенияЛогаУскорения Тогда
		Возврат;
	КонецЕсли;

	НовыйФрагмент = Сред(ТекстЛога, ПозицияЧтенияЛогаУскорения + 1);
	ПозицияЧтенияЛогаУскорения = СтрДлина(ТекстЛога);

	Строки = СтрРазделить(НовыйФрагмент, Символы.ПС, Истина);
	Для Каждого СтрокаЛога Из Строки Цикл
		Если ПустаяСтрока(СокрЛП(СтрокаЛога)) Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьВПротокол(СокрЛП(СтрокаЛога));
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗавершенияPythonУскорения(КодВозврата, ДополнительныеПараметры) Экспорт

	ОтключитьОбработчикОжидания("ОпросЛогаУскоренияPython");
	ДочитатьЛогУскоренияPythonВПротокол();
	ОжиданиеУскоренияPython = Ложь;

	Если Не ПустаяСтрока(ПутьСпискаФайловУскорения) И ФайлСуществует(ПутьСпискаФайловУскорения) Тогда
		Попытка
			УдалитьФайлы(ПутьСпискаФайловУскорения);
		Исключение
			// временный файл
		КонецПопытки;
	КонецЕсли;

	УдалитьИндексыЖурнала(КаталогПриемника);
	ДобавитьВПротокол("Индексы *.lgx удалены - платформа построит их заново при открытии ЖР.");

	Если КодВозврата = 0 Тогда
		ДобавитьВПротокол("=== Конец присоединения (ускорение Python): успешно ===");
		УстановитьШагМастера(3);
		ПоказатьПредупреждение(, "Присоединение через Python завершено. См. протокол.");
	ИначеЕсли КодВозврата = 2 Тогда
		ДобавитьВПротокол("=== Конец присоединения (ускорение Python): файлы заняты (код 2) ===");
		ПоказатьПредупреждение(,
			"Не удалось записать файлы — они заняты другим процессом."
			+ " Работайте с копией каталога 1Cv8Log. См. протокол.");
	Иначе
		ДобавитьВПротокол("=== Конец присоединения (ускорение Python): код "
			+ ФорматЧислаПротокола(КодВозврата) + " ===");
		ПоказатьПредупреждение(,
			"Ускоренное присоединение завершилось с ошибкой. См. протокол."
			+ " Можно повторить обычным способом в этой обработке.");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПрогнозВремениПрисоединения

// Грубая оценка длительности «Присоединить» без чтения тел .lgp.
// Коэффициенты (ориентир «средний диск/CPU», не SLA):
//   copy_raw / replace без перенумерации — 80 МБ/с;
//   merge_raw без перенумерации — 40 МБ/с;
//   rewrite+renumber (или любой путь с потоковым разбором) — 8 МБ/с;
//   дедупликация — ×2.5 к базовому времени обработки объёма;
//   разбивка по дням — ×1.8;
//   резервная копия — + copy_raw того же отмеченного объёма (80 МБ/с);
//   проверка целостности после записи — +0.05 с на МБ отмеченных;
//   режим «На сервере» — ×1.15 (маршалинг/пути).
// Железо и сеть сильно меняют реальность — на форме всегда дисклеймер.

&НаКлиенте
Процедура ОбновитьПрогнозВремениПрисоединения()

	Если Не АнализАктуален Или ФайлыЖурнала.Количество() = 0 Тогда
		ТекстПрогнозаВремени = ТекстПрогнозаВремениБезАнализа();
		Возврат;
	КонецЕсли;

	ОбъёмКопияЗамена = 0;
	ОбъёмОбъединить = 0;
	ОбъёмОтмеченных = 0;
	ОтмеченоФайлов = 0;

	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл

		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;

		Код = ВнутреннийКодДействияФайла(СтрокаФайла.Действие);
		Если Код = РежимКонфликтаПропустить() Тогда
			Продолжить;
		КонецЕсли;

		РазмерБайт = СтрокаФайла.РазмерИсточникаБайт;
		ОтмеченоФайлов = ОтмеченоФайлов + 1;
		ОбъёмОтмеченных = ОбъёмОтмеченных + РазмерБайт;

		Если Код = РежимКонфликтаОбъединить() Тогда
			ОбъёмОбъединить = ОбъёмОбъединить + РазмерБайт;
		Иначе
			ОбъёмКопияЗамена = ОбъёмКопияЗамена + РазмерБайт;
		КонецЕсли;

	КонецЦикла;

	Если ОтмеченоФайлов = 0 Тогда
		ТекстПрогнозаВремени =
			"Ориентировочное время присоединения: отметьте файлы .lgp в таблице.";
		Возврат;
	КонецЕсли;

	ТекстПрогнозаВремени = СобратьТекстПрогнозаВремениПрисоединения(
		ОбъёмОтмеченных,
		ОбъёмКопияЗамена,
		ОбъёмОбъединить,
		НужнаПеренумерация,
		ДедупликацияЗаписей,
		РазбиватьИсточникПоДням,
		СоздаватьРезервнуюКопию,
		ПроверятьЦелостность,
		ВыполнятьНаСервере);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТекстПрогнозаВремениБезАнализа()

	Возврат "Ориентировочное время присоединения: сначала «Проанализировать (dry-run)»,"
		+ " затем отметьте файлы. Оценка грубая — зависит от диска/CPU/сети.";

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СобратьТекстПрогнозаВремениПрисоединения(
	ОбъёмОтмеченныхБайт,
	ОбъёмКопияЗаменаБайт,
	ОбъёмОбъединитьБайт,
	НужнаПеренумерацияФайлов,
	Дедуплицировать,
	РазбиватьПоДням,
	ДелатьБэкап,
	ПроверятьЦелостностьПосле,
	НаСервере)

	БайтВМегабайте = 1024 * 1024;
	СкоростьКопии = 80 * БайтВМегабайте;
	СкоростьОбъединения = 40 * БайтВМегабайте;
	СкоростьПеренумерации = 8 * БайтВМегабайте;

	Если НужнаПеренумерацияФайлов Или Дедуплицировать Тогда
		Секунды = ОбъёмОтмеченныхБайт / СкоростьПеренумерации;
	Иначе
		Секунды = 0;
		Если ОбъёмКопияЗаменаБайт > 0 Тогда
			Секунды = Секунды + ОбъёмКопияЗаменаБайт / СкоростьКопии;
		КонецЕсли;
		Если ОбъёмОбъединитьБайт > 0 Тогда
			Секунды = Секунды + ОбъёмОбъединитьБайт / СкоростьОбъединения;
		КонецЕсли;
	КонецЕсли;

	Если Дедуплицировать Тогда
		Секунды = Секунды * 2.5;
	КонецЕсли;
	Если РазбиватьПоДням Тогда
		Секунды = Секунды * 1.8;
	КонецЕсли;
	Если ДелатьБэкап Тогда
		Секунды = Секунды + ОбъёмОтмеченныхБайт / СкоростьКопии;
	КонецЕсли;
	Если ПроверятьЦелостностьПосле Тогда
		Секунды = Секунды + (ОбъёмОтмеченныхБайт / БайтВМегабайте) * 0.05;
	КонецЕсли;
	Если НаСервере Тогда
		Секунды = Секунды * 1.15;
	КонецЕсли;

	Если Секунды < 1 Тогда
		Секунды = 1;
	КонецЕсли;

	ПС = Символы.ПС;
	Текст =
		"Ориентировочное время присоединения: " + ПредставлениеДлительностиПрогноза(Секунды)
		+ ПС + "Почему: объём " + ПредставлениеРазмера(ОбъёмОтмеченныхБайт)
		+ "; перенумерация " + ?(НужнаПеренумерацияФайлов, "да", "нет")
		+ "; дедуп " + ?(Дедуплицировать, "да", "нет")
		+ "; split " + ?(РазбиватьПоДням, "да", "нет")
		+ "; бэкап " + ?(ДелатьБэкап, "да", "нет")
		+ "; режим " + ?(НаСервере, "сервер", "клиент")
		+ ПС + "Оценка грубая, без чтения тел .lgp — зависит от диска, CPU и сети.";

	Возврат Текст;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеДлительностиПрогноза(Секунды)

	Если Секунды < 60 Тогда
		Возврат "~" + ФорматЧислаПротокола(Цел(Секунды + 0.5)) + " с";
	КонецЕсли;

	Минуты = Секунды / 60;
	Если Минуты < 60 Тогда
		Если Минуты < 10 Тогда
			Возврат "~" + Формат(Минуты, "ЧДЦ=1; ЧН=0") + " мин";
		КонецЕсли;
		Возврат "~" + ФорматЧислаПротокола(Цел(Минуты + 0.5)) + " мин";
	КонецЕсли;

	Часы = Минуты / 60;
	Если Часы < 10 Тогда
		Возврат "~" + Формат(Часы, "ЧДЦ=1; ЧН=0") + " ч";
	КонецЕсли;

	Возврат "~" + ФорматЧислаПротокола(Цел(Часы + 0.5)) + " ч";

КонецФункции

#КонецОбласти

#Область ОтладочныйЛог

&НаКлиенте
Процедура ПодготовитьСеансОтладки(Операция)

	Если Не РежимОтладки Тогда
		Возврат;
	КонецЕсли;

	ОбновитьВидимостьСтраницыОтладкиНаСервере();
	ПодготовитьСеансОтладкиНаСервере(Операция);
	Элементы.СтраницыПротокола.ТекущаяСтраница = Элементы.СтраницаОтладка;

КонецПроцедуры

&НаСервере
Процедура ПодготовитьСеансОтладкиНаСервере(Операция)

	Если Не РежимОтладки Тогда
		Возврат;
	КонецЕсли;

	ТекстОтладочногоЛога = "";
	ДобавитьВОтладочныйЛогНаСервереКонтекста("=== DEBUG SESSION " + Операция + " "
		+ Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss") + " ===");
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] version=" + НомерВерсииОбработки());
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] execute_on_server="
		+ ?(ВыполнятьНаСервере, "true", "false"));
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] src=" + КаталогИсточника);
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] dst=" + КаталогПриемника);

КонецПроцедуры

