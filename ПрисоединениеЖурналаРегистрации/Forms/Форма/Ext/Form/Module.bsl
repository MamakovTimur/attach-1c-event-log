КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеДлительностиПротокола(Секунд)

	ВсегоСекунд = Цел(Секунд);
	Если ВсегоСекунд < 0 Тогда
		ВсегоСекунд = 0;
	КонецЕсли;

	Часы = Цел(ВсегоСекунд / 3600);
	Минуты = Цел((ВсегоСекунд - Часы * 3600) / 60);
	ОстатокСекунд = ВсегоСекунд - Часы * 3600 - Минуты * 60;

	Если Часы > 0 Тогда
		Возврат Формат(Часы, "ЧГ=0") + " ч "
			+ Формат(Минуты, "ЧЦ=2; ЧВН=; ЧГ=0") + " мин "
			+ Формат(ОстатокСекунд, "ЧЦ=2; ЧВН=; ЧГ=0") + " с";
	ИначеЕсли Минуты > 0 Тогда
		Возврат Формат(Минуты, "ЧГ=0") + " мин "
			+ Формат(ОстатокСекунд, "ЧЦ=2; ЧВН=; ЧГ=0") + " с";
	ИначеЕсли ВсегоСекунд > 0 Тогда
		Возврат Формат(ОстатокСекунд, "ЧГ=0") + " с";
	КонецЕсли;

	Возврат "менее 1 с";

КонецФункции

&НаКлиенте
Процедура ДобавитьВПротокол(Текст)

	СтрокаПротокола = СтрокаПротоколаСВременем(Текст);
	Если ПустаяСтрока(ТекстПротокола) Тогда
		ТекстПротокола = СтрокаПротокола;
	Иначе
		ТекстПротокола = ТекстПротокола + Символы.ПС + СтрокаПротокола;
	КонецЕсли;

	ДописатьСтрокуВФайлПротокола(ПутьФайлаПротокола, СтрокаПротокола);

КонецПроцедуры

&НаСервере
Процедура ДобавитьВПротоколНаСервереКонтекста(Текст)

	СтрокаПротокола = СтрокаПротоколаСВременем(Текст);
	Если ПустаяСтрока(ТекстПротокола) Тогда
		ТекстПротокола = СтрокаПротокола;
	Иначе
		ТекстПротокола = ТекстПротокола + Символы.ПС + СтрокаПротокола;
	КонецЕсли;

	ДописатьСтрокуВФайлПротокола(ПутьФайлаПротокола, СтрокаПротокола);

КонецПроцедуры

&НаКлиенте
Процедура НачатьЗаписьПротоколаВФайл(Операция)

	Если ВыполнятьНаСервере Тогда
		НачатьФайлПротоколаНаСервере(Операция);
	Иначе
		НачатьФайлПротоколаНаКлиенте(Операция);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НачатьФайлПротоколаНаКлиенте(Операция)

	Если Не ЗаписыватьПротоколВФайл Тогда
		ПутьФайлаПротокола = "";
		Возврат;
	КонецЕсли;

	ПутьФайлаПротокола = СоздатьФайлПротокола(Операция, КаталогПриемника);

КонецПроцедуры

&НаСервере
Процедура НачатьФайлПротоколаНаСервере(Операция)

	Если Не ЗаписыватьПротоколВФайл Тогда
		ПутьФайлаПротокола = "";
		Возврат;
	КонецЕсли;

	ПутьФайлаПротокола = СоздатьФайлПротокола(Операция, КаталогПриемника);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СоздатьФайлПротокола(Операция, КаталогПриемника)

	Путь = СформироватьПутьФайлаПротокола(Операция, КаталогПриемника);
	Попытка
		ИнициализироватьФайлПротокола(Путь, Операция);
		Возврат Путь;
	Исключение
		Путь = СформироватьПутьФайлаПротокола(Операция, "");
		ИнициализироватьФайлПротокола(Путь, Операция);
		Возврат Путь;
	КонецПопытки;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьПутьФайлаПротокола(Операция, КаталогПриемника)

	Метка = Формат(ТекущаяДата(), "ДФ='yyyyMMdd_HHmmss'");
	ИмяФайла = "jr_" + Операция + "_" + Метка + ".log";

	Каталог = СокрЛП(КаталогПриемника);
	Если Не ПустаяСтрока(Каталог) Тогда
		КаталогФайл = Новый Файл(Каталог);
		Если КаталогФайл.Существует() И КаталогФайл.ЭтоКаталог() Тогда
			Возврат ОбъединитьПуть(Каталог, ИмяФайла);
		КонецЕсли;
	КонецЕсли;

	Возврат ОбъединитьПуть(КаталогВременныхФайлов(), ИмяФайла);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ИнициализироватьФайлПротокола(ПутьФайла, Операция)

	ТекстЗаголовка = "=== Протокол: Присоединение журнала регистрации v"
		+ НомерВерсииОбработки() + " | " + Операция + " ===" + Символы.ПС
		+ "Создан: " + МеткаВремениПротокола() + Символы.ПС
		+ "Строки дописываются по ходу работы — откройте в Блокноте и нажимайте F5 для обновления."
		+ Символы.ПС + "Путь: " + ПутьФайла + Символы.ПС + Символы.ПС;
	ЗаписатьСыройТекстЖурналаUTF8(ПутьФайла, ТекстЗаголовка);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДописатьСтрокуВФайлПротокола(ПутьФайла, СтрокаПротокола)

	Если ПустаяСтрока(ПутьФайла) Или ПустаяСтрока(СтрокаПротокола) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ДописатьСыройТекстЖурналаUTF8БезBOM(ПутьФайла, СтрокаПротокола + Символы.ПС);
	Исключение
		// Сбой записи лога не должен прерывать склейку.
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#КонецОбласти
