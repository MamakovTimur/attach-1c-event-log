КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПротоколКартыПеренумерации(РезультатКарт)

	Если Не РезультатКарт.НужнаПеренумерация Тогда
		Возврат;
	КонецЕсли;

	ДобавитьВПротокол("--- Карта перенумерации (отличия номеров, до 30) ---");
	Показано = 0;
	Лимит = 30;

	Для ТипОбъекта = 1 По МаксимальныйТипОбъектаСловаря() Цикл

		Карта = РезультатКарт.Карты.Получить(ТипОбъекта);
		Если Карта = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Пара Из Карта Цикл

			Если Пара.Ключ = Пара.Значение Тогда
				Продолжить;
			КонецЕсли;

			ДобавитьВПротокол("  тип " + ФорматЧислаПротокола(ТипОбъекта) + ": "
				+ ФорматЧислаПротокола(Пара.Ключ) + " -> " + ФорматЧислаПротокола(Пара.Значение));
			Показано = Показано + 1;
			Если Показано >= Лимит Тогда
				ДобавитьВПротокол("  ... остальные отличия не показаны");
				Возврат;
			КонецЕсли;

