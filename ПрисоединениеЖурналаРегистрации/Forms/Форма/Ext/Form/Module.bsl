КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьОтладочныйСнимокАнализа(СловарьИсточника, СловарьПриемника, РезультатКарт)
	
	Если Не РежимОтладки Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьВОтладочныйЛог("--- [DBG] analyze snapshot ---");
	ДобавитьВОтладочныйЛог("[METRIC] lgf_src_entries=" + ФорматЧислаПротокола(СловарьИсточника.Количество));
	ДобавитьВОтладочныйЛог("[METRIC] lgf_dst_entries=" + ФорматЧислаПротокола(СловарьПриемника.Количество));
	ДобавитьВОтладочныйЛог("[METRIC] lgf_new_entries="
		+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	ДобавитьВОтладочныйЛог("[METRIC] need_renumber=" + ?(НужнаПеренумерация, "true", "false"));
	ДобавитьВОтладочныйЛог("[METRIC] guid_src=" + СловарьИсточника.GUID);
	ДобавитьВОтладочныйЛог("[METRIC] guid_dst=" + СловарьПриемника.GUID);
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		МетрикиИсточника = СобратьМетрикиФайлаLgp(СтрокаФайла.ПолныйПутьИсточника);
		МетрикиПриемника = СобратьМетрикиФайлаLgp(СтрокаФайла.ПолныйПутьПриемника);
		ДобавитьВОтладочныйЛог("--- [FILE] " + СтрокаФайла.ИмяФайла
			+ " action=" + Строка(СтрокаФайла.Действие) + " marked="
			+ ?(СтрокаФайла.Пометка, "true", "false") + " ---");
		ДобавитьВОтладочныйЛог(СтрокаМетрикLgp("src", МетрикиИсточника));
		ДобавитьВОтладочныйЛог(СтрокаМетрикLgp("dst_before", МетрикиПриемника));
	КонецЦикла;
	
	ДобавитьВОтладочныйЛог("=== DEBUG SESSION analyze END ===");
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьОтладочныйСнимокАнализаНаСервереКонтекста(СловарьИсточника, СловарьПриемника, РезультатКарт)
	
	Если Не РежимОтладки Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьВОтладочныйЛогНаСервереКонтекста("--- [DBG] analyze snapshot ---");
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] lgf_src_entries=" + ФорматЧислаПротокола(СловарьИсточника.Количество));
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] lgf_dst_entries=" + ФорматЧислаПротокола(СловарьПриемника.Количество));
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] lgf_new_entries="
		+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] need_renumber=" + ?(НужнаПеренумерация, "true", "false"));
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] guid_src=" + СловарьИсточника.GUID);
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] guid_dst=" + СловарьПриемника.GUID);
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		МетрикиИсточника = СобратьМетрикиФайлаLgp(СтрокаФайла.ПолныйПутьИсточника);
		МетрикиПриемника = СобратьМетрикиФайлаLgp(СтрокаФайла.ПолныйПутьПриемника);
		ДобавитьВОтладочныйЛогНаСервереКонтекста("--- [FILE] " + СтрокаФайла.ИмяФайла
			+ " action=" + Строка(СтрокаФайла.Действие) + " marked="
			+ ?(СтрокаФайла.Пометка, "true", "false") + " ---");
		ДобавитьВОтладочныйЛогНаСервереКонтекста(СтрокаМетрикLgp("src", МетрикиИсточника));
		ДобавитьВОтладочныйЛогНаСервереКонтекста(СтрокаМетрикLgp("dst_before", МетрикиПриемника));
	КонецЦикла;
	
	ДобавитьВОтладочныйЛогНаСервереКонтекста("=== DEBUG SESSION analyze END ===");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьОтладкуОперацииФайла(ИмяФайла, Объединять, СведенияФайла, МетрикиИсточника, МетрикиДо, МетрикиПосле)
	
	Если Не РежимОтладки Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиОтладки = СтрокиОтладкиОперацииФайла(
		ИмяФайла, Объединять, СведенияФайла, МетрикиИсточника, МетрикиДо, МетрикиПосле);
	Для Индекс = 0 По СтрокиОтладки.ВГраница() Цикл
		ДобавитьВОтладочныйЛог(СтрокиОтладки[Индекс]);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьОтладкуОперацииФайлаНаСервереКонтекста(ИмяФайла, Объединять, СведенияФайла, МетрикиИсточника, МетрикиДо, МетрикиПосле)
	
	Если Не РежимОтладки Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиОтладки = СтрокиОтладкиОперацииФайла(
		ИмяФайла, Объединять, СведенияФайла, МетрикиИсточника, МетрикиДо, МетрикиПосле);
	Для Индекс = 0 По СтрокиОтладки.ВГраница() Цикл
		ДобавитьВОтладочныйЛогНаСервереКонтекста(СтрокиОтладки[Индекс]);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СтрокиОтладкиОперацииФайла(ИмяФайла, Объединять, СведенияФайла, МетрикиИсточника, МетрикиДо, МетрикиПосле)
	
	Строки = Новый Массив;
	Строки.Добавить("--- [FILE] " + ИмяФайла + " ---");
	Строки.Добавить("[METRIC] merge=" + ?(Объединять, "true", "false"));
	
	Если СведенияФайла <> Неопределено И СведенияФайла.Свойство("Ветка") Тогда
		Строки.Добавить("[METRIC] branch=" + СведенияФайла.Ветка);
	КонецЕсли;
	
	Если СведенияФайла <> Неопределено И СведенияФайла.Свойство("Статистика") Тогда
		Статистика = СведенияФайла.Статистика;
		Строки.Добавить("[METRIC] export_records=" + ФорматЧислаПротокола(Статистика.Записей));
		Строки.Добавить("[METRIC] export_single=" + ФорматЧислаПротокола(Статистика.Однострочных));
		Строки.Добавить("[METRIC] export_multi=" + ФорматЧислаПротокола(Статистика.Многострочных));
	КонецЕсли;
	
	Строки.Добавить(СтрокаМетрикLgp("src", МетрикиИсточника));
	Строки.Добавить(СтрокаМетрикLgp("dst_before", МетрикиДо));
	Строки.Добавить(СтрокаМетрикLgp("dst_after", МетрикиПосле));
	
	Если МетрикиИсточника.Существует И МетрикиПосле.Существует
		И МетрикиПосле.Байт < МетрикиИсточника.Байт * 0.5
		И (Объединять Или МетрикиДо.Существует) Тогда
		Строки.Добавить("[WARN] dst_bytes_shrink="
			+ ФорматЧислаПротокола(МетрикиПосле.Байт - МетрикиИсточника.Байт));
	КонецЕсли;
	
	Если МетрикиИсточника.Существует И МетрикиПосле.Существует
		И МетрикиПосле.Записей < МетрикиИсточника.Записей * 0.5 Тогда
		Строки.Добавить("[WARN] dst_records_shrink="
			+ ФорматЧислаПротокола(МетрикиПосле.Записей - МетрикиИсточника.Записей));
	КонецЕсли;
	
	Возврат Строки;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СобратьМетрикиLgf(ПутьКФайлу)
	
	Результат = Новый Структура("Существует,Байт,Записей", Ложь, 0, 0);
	Файл = Новый Файл(ПутьКФайлу);
	Если Не Файл.Существует() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Существует = Истина;
	Результат.Байт = Файл.Размер();
	Словарь = ПрочитатьСловарьLgf(ПутьКФайлу);
	Результат.Записей = Словарь.Количество;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СобратьМетрикиФайлаLgp(ПутьКФайлу)
	
	Результат = Новый Структура("Существует,Байт,Записей,Однострочных,Многострочных,СтрокФайла", Ложь, 0, 0, 0, 0, 0);
	Файл = Новый Файл(ПутьКФайлу);
	Если Не Файл.Существует() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Существует = Истина;
	Результат.Байт = Файл.Размер();
	Подсчет = ПодсчитатьЗаписиLgpВФайле(ПутьКФайлу);
	Результат.Записей = Подсчет.Записей;
	Результат.Однострочных = Подсчет.Однострочных;
	Результат.Многострочных = Подсчет.Многострочных;
	Результат.СтрокФайла = Подсчет.СтрокФайла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПодсчитатьЗаписиLgpВФайле(ПутьКФайлу)
	
	Результат = Новый Структура("Записей,Однострочных,Многострочных,СтрокФайла", 0, 0, 0, 0);
	Чтение = ОткрытьЧтениеЖурнала(ПутьКФайлу);
	
	НомерСтроки = 0;
	БуферЗаписи = "";
	Глубина = 0;
	ВКавычках = Ложь;
	
	Пока Истина Цикл
		
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		Если НомерСтроки <= 2 И Глубина = 0 И ПустаяСтрока(БуферЗаписи) Тогда
			Продолжить;
		КонецЕсли;
		Если НомерСтроки = 3 И Глубина = 0 И ПустаяСтрока(БуферЗаписи) И ПустаяСтрока(СтрокаФайла) Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках);
		
		Если Глубина = 0 И Не ПустаяСтрока(БуферЗаписи) Тогда
			Если Не ПустаяСтрока(СокрЛП(БуферЗаписи)) И СокрЛП(БуферЗаписи) <> "," Тогда
				Результат.Записей = Результат.Записей + 1;
				Если СтрНайти(БуферЗаписи, Символы.ПС) > 0 Или СтрНайти(БуферЗаписи, Символы.ВК) > 0 Тогда
					Результат.Многострочных = Результат.Многострочных + 1;
				Иначе
					Результат.Однострочных = Результат.Однострочных + 1;
				КонецЕсли;
			КонецЕсли;
			БуферЗаписи = "";
		КонецЕсли;
		
	КонецЦикла;
	
	Чтение.Закрыть();
	Результат.СтрокФайла = НомерСтроки;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СтрокаМетрикLgp(Префикс, Метрики)
	
	Если Не Метрики.Существует Тогда
		Возврат "[METRIC] " + Префикс + "_exists=false";
	КонецЕсли;
	
	Возврат "[METRIC] " + Префикс
		+ "_bytes=" + ФорматЧислаПротокола(Метрики.Байт)
		+ " records=" + ФорматЧислаПротокола(Метрики.Записей)
		+ " single=" + ФорматЧислаПротокола(Метрики.Однострочных)
		+ " multi=" + ФорматЧислаПротокола(Метрики.Многострочных)
		+ " lines=" + ФорматЧислаПротокола(Метрики.СтрокФайла);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СтрокиОтладкиLgfПослеДописки(ПутьLgf, КоличествоДобавленных, ЗаписейДо)
	
	Строки = Новый Массив;
	Метрики = СобратьМетрикиLgf(ПутьLgf);
	Строки.Добавить(СтрокаМетрикLgf("lgf_after", Метрики));
	
	Если КоличествоДобавленных > 0 И Метрики.Записей <= ЗаписейДо Тогда
		Строки.Добавить("[WARN] lgf_entries_unchanged before="
			+ ФорматЧислаПротокола(ЗаписейДо)
			+ " after=" + ФорматЧислаПротокола(Метрики.Записей)
			+ " added_lines=" + ФорматЧислаПротокола(КоличествоДобавленных));
	КонецЕсли;
	
	Возврат Строки;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СтрокаМетрикLgf(Префикс, Метрики)
	
	Если Не Метрики.Существует Тогда
		Возврат "[METRIC] " + Префикс + "_exists=false";
	КонецЕсли;
	
	Возврат "[METRIC] " + Префикс
		+ "_bytes=" + ФорматЧислаПротокола(Метрики.Байт)
		+ " entries=" + ФорматЧислаПротокола(Метрики.Записей);
	
КонецФункции

#КонецОбласти

#Область Протокол

&НаКлиентеНаСервереБезКонтекста
Функция МеткаВремениПротокола()
	
	Возврат Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СтрокаПротоколаСВременем(Текст)
	
	Возврат "[" + МеткаВремениПротокола() + "] " + Текст;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеДлительностиПротокола(Секунд)
	
	ВсегоСекунд = Цел(Секунд);
	Если ВсегоСекунд < 0 Тогда
		ВсегоСекунд = 0;
	КонецЕсли;
	
	Часы = Цел(ВсегоСекунд / 3600);
	Минуты = Цел((ВсегоСекунд - Часы * 3600) / 60);
	ОстатокСекунд = ВсегоСекунд - Часы * 3600 - Минуты * 60;
	
	Если Часы > 0 Тогда
		Возврат Формат(Часы, "ЧГ=0") + " ч "
			+ Формат(Минуты, "ЧЦ=2; ЧВН=; ЧГ=0") + " мин "
			+ Формат(ОстатокСекунд, "ЧЦ=2; ЧВН=; ЧГ=0") + " с";
	ИначеЕсли Минуты > 0 Тогда
		Возврат Формат(Минуты, "ЧГ=0") + " мин "
			+ Формат(ОстатокСекунд, "ЧЦ=2; ЧВН=; ЧГ=0") + " с";
	КонецЕсли;
	
	Возврат Формат(ОстатокСекунд, "ЧГ=0") + " с";
	
КонецФункции

&НаКлиенте
Процедура ДобавитьВПротокол(Текст)
	
	СтрокаПротокола = СтрокаПротоколаСВременем(Текст);
	Если ПустаяСтрока(ТекстПротокола) Тогда
		ТекстПротокола = СтрокаПротокола;
	Иначе
		ТекстПротокола = ТекстПротокола + Символы.ПС + СтрокаПротокола;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВПротоколНаСервереКонтекста(Текст)
	
	СтрокаПротокола = СтрокаПротоколаСВременем(Текст);
	Если ПустаяСтрока(ТекстПротокола) Тогда
		ТекстПротокола = СтрокаПротокола;
	Иначе
		ТекстПротокола = ТекстПротокола + Символы.ПС + СтрокаПротокола;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
