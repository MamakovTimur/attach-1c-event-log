&НаСервере
Процедура ЗаписатьПротоколКартыПеренумерацииНаСервереКонтекста(РезультатКарт)

	Если Не РезультатКарт.НужнаПеренумерация Тогда
		Возврат;
	КонецЕсли;

	ДобавитьВПротоколНаСервереКонтекста("--- Карта перенумерации (отличия номеров, до 30) ---");
	Показано = 0;
	Лимит = 30;

	Для ТипОбъекта = 1 По МаксимальныйТипОбъектаСловаря() Цикл

		Карта = РезультатКарт.Карты.Получить(ТипОбъекта);
		Если Карта = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Пара Из Карта Цикл

			Если Пара.Ключ = Пара.Значение Тогда
				Продолжить;
			КонецЕсли;

			ДобавитьВПротоколНаСервереКонтекста("  тип " + ФорматЧислаПротокола(ТипОбъекта) + ": "
				+ ФорматЧислаПротокола(Пара.Ключ) + " -> " + ФорматЧислаПротокола(Пара.Значение));
			Показано = Показано + 1;
			Если Показано >= Лимит Тогда
				ДобавитьВПротоколНаСервереКонтекста("  ... остальные отличия не показаны");
				Возврат;
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПротоколПланаПоФайлам()

	ДобавитьВПротокол("--- План по файлам .lgp ---");
	ДобавитьВПротокол("Найдено файлов .lgp: " + ФорматЧислаПротокола(ФайлыЖурнала.Количество()));

	ОбъёмБайт = 0;
	Скопировать = 0;
	Объединить = 0;
	Пропустить = 0;
	Заменить = 0;

	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл

		ФайлИсточника = Новый Файл(СтрокаФайла.ПолныйПутьИсточника);
		Если ФайлИсточника.Существует() Тогда
			ОбъёмБайт = ОбъёмБайт + ФайлИсточника.Размер();
		КонецЕсли;

		Если ВнутреннийКодДействияФайла(СтрокаФайла.Действие) = ДействиеСкопировать() Тогда
			Скопировать = Скопировать + 1;
		ИначеЕсли ВнутреннийКодДействияФайла(СтрокаФайла.Действие) = РежимКонфликтаОбъединить() Тогда
			Объединить = Объединить + 1;
		ИначеЕсли ВнутреннийКодДействияФайла(СтрокаФайла.Действие) = РежимКонфликтаПропустить() Тогда
			Пропустить = Пропустить + 1;
		ИначеЕсли ВнутреннийКодДействияФайла(СтрокаФайла.Действие) = РежимКонфликтаЗаменить() Тогда
			Заменить = Заменить + 1;
		КонецЕсли;

	КонецЦикла;

	ДобавитьВПротокол("Скопировать (нет в приёмнике): " + ФорматЧислаПротокола(Скопировать));
	ДобавитьВПротокол("Объединить (конфликт): " + ФорматЧислаПротокола(Объединить));
	ДобавитьВПротокол("Заменить (конфликт): " + ФорматЧислаПротокола(Заменить));
	ДобавитьВПротокол("Пропустить (конфликт): " + ФорматЧислаПротокола(Пропустить));
	ДобавитьВПротокол("Объём исходных .lgp: " + ПредставлениеРазмера(ОбъёмБайт));
	Если Объединить > 0 Тогда
		ДобавитьВПротокол("ВНИМАНИЕ: при «Объединить» записи дописываются в существующий файл — возможны дубли. Проверьте журнал за затронутый период после присоединения.");
	КонецЕсли;
	Если СоздаватьРезервнуюКопию Тогда
		ДобавитьВПротокол("Перед записью: резервная копия только изменяемых файлов (1Cv8.lgf и отмеченные .lgp) "
			+ ОписаниеМестаРезервнойКопии(КаталогРезервнойКопии) + ".");
	КонецЕсли;

