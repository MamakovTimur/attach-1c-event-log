	Возврат "backup.incomplete";

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОтметитьРезервнуюКопиюКакНезавершенную(ПутьРезервнойКопии)

	ПутьМаркера = ОбъединитьПуть(
		ПутьРезервнойКопии,
		ИмяФайлаМаркераНезавершеннойРезервнойКопии());
	ЗаписатьСыройТекстЖурналаUTF8(ПутьМаркера, "INCOMPLETE" + Символы.ПС);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗавершитьРезервнуюКопию(ПутьРезервнойКопии, КаталогПриемника)

	ЗаписатьМанифестРезервнойКопии(ПутьРезервнойКопии, КаталогПриемника);
	ПутьМаркера = ОбъединитьПуть(
		ПутьРезервнойКопии,
		ИмяФайлаМаркераНезавершеннойРезервнойКопии());
	Если ФайлСуществует(ПутьМаркера) Тогда
		УдалитьФайлы(ПутьМаркера);
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаписатьМанифестРезервнойКопии(ПутьРезервнойКопии, КаталогПриемника)

	Строки = Новый Массив;
	Строки.Добавить("JR_BACKUP_MANIFEST_V2");
	ФайлыLgp = ОтсортироватьФайлыПоИмени(НайтиФайлы(КаталогПриемника, "*.lgp", Ложь));
	Для Каждого ФайлLgp Из ФайлыLgp Цикл
		Если Не ФайлLgp.ЭтоКаталог() Тогда
			Строки.Добавить("S|" + ФайлLgp.Имя);
		КонецЕсли;
	КонецЦикла;

	ПутьLgf = ПутьКСловарюЖР(ПутьРезервнойКопии);
	Если Не ФайлСуществует(ПутьLgf) Тогда
		ВызватьИсключение "Резервная копия не содержит 1Cv8.lgf: " + ПутьРезервнойКопии;
	КонецЕсли;
	ФайлLgf = Новый Файл(ПутьLgf);
	Строки.Добавить("B|" + ИмяФайлаСловаряЖР() + "|" + Формат(ФайлLgf.Размер(), "ЧГ=0"));

	Для Каждого ФайлLgp Из ОтсортироватьФайлыПоИмени(
		НайтиФайлы(ПутьРезервнойКопии, "*.lgp", Ложь)) Цикл
		Если Не ФайлLgp.ЭтоКаталог() Тогда
			Строки.Добавить("B|" + ФайлLgp.Имя + "|" + Формат(ФайлLgp.Размер(), "ЧГ=0"));
		КонецЕсли;
	КонецЦикла;

	ПутьМанифеста = ОбъединитьПуть(ПутьРезервнойКопии, ИмяФайлаМанифестаРезервнойКопии());
	ВременныйМанифест = ПутьМанифеста + ".tmp";
	ЗаписатьСыройТекстЖурналаUTF8(
		ВременныйМанифест,
		СтрСоединить(Строки, Символы.ПС) + Символы.ПС);
	КопироватьФайлСЗаменой(ВременныйМанифест, ПутьМанифеста);
	УдалитьФайлы(ВременныйМанифест);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПодготовитьВосстановлениеПоМанифесту(ПутьРезервнойКопии, КаталогПриемника)

	ПутьМанифеста = ОбъединитьПуть(ПутьРезервнойКопии, ИмяФайлаМанифестаРезервнойКопии());
	ПутьМаркера = ОбъединитьПуть(
		ПутьРезервнойКопии,
		ИмяФайлаМаркераНезавершеннойРезервнойКопии());
	Если ФайлСуществует(ПутьМаркера) Тогда
		ВызватьИсключение "Резервная копия не была завершена: " + ПутьРезервнойКопии;
	КонецЕсли;
	Если Не ФайлСуществует(ПутьМанифеста) Тогда
		// Старые резервные копии не содержат снимка состава; для них удаление небезопасно.
		Возврат Неопределено;
	КонецЕсли;

	Строки = СтрРазделить(
		СтрЗаменить(ПрочитатьСыройТекстЖурналаUTF8(ПутьМанифеста), Символы.ВК, ""),
		Символы.ПС,
		Ложь);
	Если Строки.Количество() = 0 Или СокрЛП(Строки[0]) <> "JR_BACKUP_MANIFEST_V2" Тогда
		ВызватьИсключение "Неизвестный или повреждённый манифест резервной копии: " + ПутьМанифеста;
	КонецЕсли;

	ИсходныеИмена = Новый Соответствие;
	ИменаФайловКопии = Новый Соответствие;
	ФайлыДляВосстановления = Новый Массив;
	СловарьПроверен = Ложь;
	Для Индекс = 1 По Строки.ВГраница() Цикл
		СтрокаМанифеста = СокрЛП(Строки[Индекс]);
		Если ПустаяСтрока(СтрокаМанифеста) Тогда
			Продолжить;
		КонецЕсли;
		Поля = СтрРазделить(СтрокаМанифеста, "|", Истина);
		Если Поля.Количество() = 2 И Поля[0] = "S" Тогда
			ИмяФайла = СокрЛП(Поля[1]);
			ФайлПроверки = Новый Файл(ИмяФайла);
			Если ФайлПроверки.Имя <> ИмяФайла Или Не СтрЗаканчиваетсяНа(НРег(ИмяФайла), ".lgp") Тогда
				ВызватьИсключение "Недопустимое имя файла в манифесте резервной копии: " + ИмяФайла;
			КонецЕсли;
			ИсходныеИмена.Вставить(ВРег(ИмяФайла), Истина);
			Продолжить;
		КонецЕсли;
		Если Поля.Количество() <> 3 Или Поля[0] <> "B" Тогда
			ВызватьИсключение "Повреждённая строка манифеста резервной копии: " + СтрокаМанифеста;
		КонецЕсли;
		ИмяФайла = СокрЛП(Поля[1]);
		ФайлПроверки = Новый Файл(ИмяФайла);
		Если ФайлПроверки.Имя <> ИмяФайла Тогда
			ВызватьИсключение "Недопустимое имя файла в манифесте резервной копии: " + ИмяФайла;
		КонецЕсли;
		ПутьПроверки = ОбъединитьПуть(ПутьРезервнойКопии, ИмяФайла);
		Если Не ФайлСуществует(ПутьПроверки) Тогда
			ВызватьИсключение "В резервной копии отсутствует файл из манифеста: " + ИмяФайла;
		КонецЕсли;
		ОжидаемыйРазмер = Число(Поля[2]);
		ФайлРезервнойКопии = Новый Файл(ПутьПроверки);
		Если ФайлРезервнойКопии.Размер() <> ОжидаемыйРазмер Тогда
			ВызватьИсключение "Размер файла резервной копии не совпадает с манифестом: " + ИмяФайла;
		КонецЕсли;
		Если ВРег(ИмяФайла) = ВРег(ИмяФайлаСловаряЖР()) Тогда
			СловарьПроверен = Истина;
		ИначеЕсли Не СтрЗаканчиваетсяНа(НРег(ИмяФайла), ".lgp") Тогда
			ВызватьИсключение "Манифест содержит посторонний файл: " + ИмяФайла;
		Иначе
			Если ИменаФайловКопии.Получить(ВРег(ИмяФайла)) <> Неопределено Тогда
				ВызватьИсключение "Файл повторяется в манифесте резервной копии: " + ИмяФайла;
			КонецЕсли;
			ИменаФайловКопии.Вставить(ВРег(ИмяФайла), Истина);
			ФайлыДляВосстановления.Добавить(ИмяФайла);
		КонецЕсли;
	КонецЦикла;
	Если Не СловарьПроверен Тогда
		ВызватьИсключение "Манифест резервной копии не содержит 1Cv8.lgf: " + ПутьМанифеста;
	КонецЕсли;

	Для Каждого ФайлLgp Из НайтиФайлы(ПутьРезервнойКопии, "*.lgp", Ложь) Цикл
		Если Не ФайлLgp.ЭтоКаталог()
			И ИменаФайловКопии.Получить(ВРег(ФайлLgp.Имя)) = Неопределено Тогда
			ВызватьИсключение
				"В резервной копии есть период, не указанный в манифесте: " + ФайлLgp.Имя;
		КонецЕсли;
	КонецЦикла;

	Для Каждого ФайлLgp Из НайтиФайлы(КаталогПриемника, "*.lgp", Ложь) Цикл
		Если Не ФайлLgp.ЭтоКаталог() И ИсходныеИмена.Получить(ВРег(ФайлLgp.Имя)) = Неопределено Тогда
			УдалитьФайлы(ФайлLgp.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Возврат ФайлыДляВосстановления;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВосстановитьФайлыЖРИзКаталогаРезервнойКопии(ПутьРезервнойКопии, КаталогПриемника)

	Если Не ФайлСуществует(ПутьРезервнойКопии) Тогда
		ВызватьИсключение "Каталог резервной копии не найден: " + ПутьРезервнойКопии;
	КонецЕсли;
	ПроверитьЧтоКаталогСуществует(КаталогПриемника, "Каталог приёмника не найден: ");
	ФайлыПоМанифесту = ПодготовитьВосстановлениеПоМанифесту(ПутьРезервнойКопии, КаталогПриемника);

	Скопировано = 0;
	ПутьLgfИсточник = ПутьКСловарюЖР(ПутьРезервнойКопии);
	Если ФайлСуществует(ПутьLgfИсточник) Тогда
		КопироватьФайлСЗаменой(ПутьLgfИсточник, ПутьКСловарюЖР(КаталогПриемника));
		Скопировано = Скопировано + 1;
	КонецЕсли;

	Если ФайлыПоМанифесту = Неопределено Тогда
		ФайлыLgp = НайтиФайлы(ПутьРезервнойКопии, "*.lgp", Ложь);
		Для Каждого ФайлLgp Из ФайлыLgp Цикл
			Если Не ФайлLgp.ЭтоКаталог() Тогда
				КопироватьФайлСЗаменой(
					ФайлLgp.ПолноеИмя,
					ОбъединитьПуть(КаталогПриемника, ФайлLgp.Имя));
				Скопировано = Скопировано + 1;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого ИмяФайла Из ФайлыПоМанифесту Цикл
			КопироватьФайлСЗаменой(
				ОбъединитьПуть(ПутьРезервнойКопии, ИмяФайла),
				ОбъединитьПуть(КаталогПриемника, ИмяФайла));
			Скопировано = Скопировано + 1;
		КонецЦикла;
	КонецЕсли;

	Возврат Скопировано;

КонецФункции

#КонецОбласти

#Область МастерИПротоколUX

&НаКлиенте
Процедура УстановитьШагМастера(НовыйШаг)

	Если НовыйШаг < 1 Тогда
		НовыйШаг = 1;
	ИначеЕсли НовыйШаг > 3 Тогда
		НовыйШаг = 3;
	КонецЕсли;

	ШагМастера = НовыйШаг;
	ОбновитьОтображениеМастера();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеМастера()

	ОбновитьОтображениеМастераНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьОтображениеМастераНаСервере()

	Если ШагМастера < 1 Или ШагМастера > 3 Тогда
		ШагМастера = 1;
	КонецЕсли;

	Если ШагМастера = 1 Тогда
		ТекстШагаМастера = "Шаг 1 из 3 — копии каталогов";
		Элементы.ПодсказкаМастера.Заголовок =
			"Укажите копии каталогов ЖР. Режим выполнения и бэкап — в блоках выше. Подробнее — «Справка».";
	ИначеЕсли ШагМастера = 2 Тогда
		ТекстШагаМастера = "Шаг 2 из 3 — анализ (dry-run)";
		Элементы.ПодсказкаМастера.Заголовок =
			"«Проанализировать» или «Далее» — план без записи.";
	Иначе
		ТекстШагаМастера = "Шаг 3 из 3 — присоединение";
		Элементы.ПодсказкаМастера.Заголовок =
			"Отметьте .lgp и нажмите «Присоединить». Опции — вкладка «Справка».";
	КонецЕсли;

	Элементы.КнопкаМастерНазад.Доступность = (ШагМастера > 1);
	Если ШагМастера < 3 Тогда
		Элементы.КнопкаМастерДалее.Заголовок = "Далее →";
	Иначе
		Элементы.КнопкаМастерДалее.Заголовок = "Присоединить…";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НачатьВосстановлениеИзРезервнойКопии()

	Попытка
		Если ВыполнятьНаСервере Тогда
			Кандидаты = НайтиКаталогиРезервныхКопийНаСервере(КаталогПриемника, КаталогРезервнойКопии);
		Иначе
			Кандидаты = НайтиКаталогиРезервныхКопий(КаталогПриемника, КаталогРезервнойКопии);
		КонецЕсли;
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если Кандидаты.Количество() = 0 Тогда
		МестоПоиска = ОписаниеМестаРезервнойКопии(КаталогРезервнойКопии);
		ПоказатьПредупреждение(,
			"Не найдены каталоги резервных копий (*"
			+ ПрефиксИмениКаталогаРезервнойКопии(КаталогПриемника) + "…) — искали "
			+ МестоПоиска + ".
			|Сначала выполните присоединение с включённой резервной копией.");
		Возврат;
	КонецЕсли;

	Если Кандидаты.Количество() = 1 Тогда
		ПодтвердитьВосстановлениеИзРезервнойКопии(Кандидаты[0]);
		Возврат;
	КонецЕсли;

	СписокВыбора = Новый СписокЗначений;
	Для Каждого Кандидат Из Кандидаты Цикл
		СписокВыбора.Добавить(Кандидат.Путь, Кандидат.Представление);
	КонецЦикла;

	Оповещение = Новый ОписаниеОповещения("ВосстановитьИзРезервнойКопииПослеВыбора", ЭтотОбъект);
	СписокВыбора.ПоказатьВыборЭлемента(Оповещение, "Выберите резервную копию для восстановления");

КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьИзРезервнойКопииПослеВыбора(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Кандидат = Новый Структура("Путь,Представление", ВыбранныйЭлемент.Значение, ВыбранныйЭлемент.Представление);
	ПодтвердитьВосстановлениеИзРезервнойКопии(Кандидат);

КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьВосстановлениеИзРезервнойКопии(Кандидат)

	ТекстВопроса =
		"Восстановить в каталог приёмника файлы 1Cv8.lgf и *.lgp из резервной копии?
		|
		|" + Кандидат.Представление + "
		|
		|Путь копии: " + Кандидат.Путь + "
		|Приёмник: " + КаталогПриемника + "
		|
		|Существующие одноимённые файлы в приёмнике будут перезаписаны.
		|Если копия содержит манифест, созданные после неё периоды *.lgp будут удалены.";

	Оповещение = Новый ОписаниеОповещения(
		"ВосстановитьИзРезервнойКопииПослеПодтверждения",
		ЭтотОбъект,
		Кандидат.Путь);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьИзРезервнойКопииПослеПодтверждения(РезультатВопроса, ПутьРезервнойКопии) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Если ВыполнятьНаСервере Тогда
			Скопировано = ВосстановитьФайлыЖРИзКаталогаРезервнойКопииНаСервере(
				ПутьРезервнойКопии,
				КаталогПриемника);
		Иначе
			Скопировано = ВосстановитьФайлыЖРИзКаталогаРезервнойКопии(
				ПутьРезервнойКопии,
				КаталогПриемника);
		КонецЕсли;
	Исключение
		Информация = ИнформацияОбОшибке();
		ДобавитьВПротокол("Ошибка восстановления: " + ПодробноеПредставлениеОшибки(Информация));
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(Информация));
		Возврат;
	КонецПопытки;

	СброситьПланАнализа();
	ДобавитьВПротокол("Восстановлено файлов из резервной копии: " + ФорматЧислаПротокола(Скопировано));
	ДобавитьВПротокол("Источник копии: " + ПутьРезервнойКопии);
	ДобавитьВПротокол("Приёмник: " + КаталогПриемника);
	УстановитьШагМастера(1);
	ПоказатьПредупреждение(,
		"Восстановление завершено. Скопировано файлов: " + ФорматЧислаПротокола(Скопировано) + ".
		|Выполните анализ заново перед присоединением.");

КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиКаталогиРезервныхКопийНаСервере(КаталогЖР, КаталогРезервнойКопии)

	Возврат НайтиКаталогиРезервныхКопий(КаталогЖР, КаталогРезервнойКопии);

КонецФункции

&НаСервереБезКонтекста
Функция ВосстановитьФайлыЖРИзКаталогаРезервнойКопииНаСервере(ПутьРезервнойКопии, КаталогПриемника)

	Возврат ВосстановитьФайлыЖРИзКаталогаРезервнойКопии(ПутьРезервнойКопии, КаталогПриемника);

КонецФункции

&НаКлиенте
Процедура СохранитьПротоколЗавершениеВыбора(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	ПутьФайла = ПервыйПутьИзРезультатаДиалога(ВыбранныеФайлы);
	Если ПустаяСтрока(ПутьФайла) Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьТекстПротоколаВФайлКлиент(ПутьФайла);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьПротоколПослеВводаПутиСервера(Строка, ДополнительныеПараметры) Экспорт

	Если Строка = Неопределено Или ПустаяСтрока(СокрЛП(Строка)) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		СохранитьПротоколНаСервер(СокрЛП(Строка), ТекстПротокола);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ДобавитьВПротокол("Протокол сохранён на сервере: " + СокрЛП(Строка));
	ПоказатьПредупреждение(, "Протокол сохранён на сервере:
		|" + СокрЛП(Строка));

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьТекстПротоколаВФайлКлиент(ПутьФайла)

	Попытка
		Документ = Новый ТекстовыйДокумент;
		Документ.УстановитьТекст(ТекстПротокола);
		Документ.Записать(ПутьФайла, КодировкаТекста.UTF8);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ДобавитьВПротокол("Протокол сохранён: " + ПутьФайла);
	ПоказатьПредупреждение(, "Протокол сохранён:
		|" + ПутьФайла);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьПротоколНаСервер(ПутьФайла, Текст)

	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(Текст);
	Документ.Записать(ПутьФайла, КодировкаТекста.UTF8);

КонецПроцедуры

#КонецОбласти

#Область ПрисоединениеНаСервереПакетами

&НаКлиенте
Процедура НачатьПрисоединениеНаСервереПакетами()

	Попытка
		ИнициализироватьПрисоединениеНаСервере();
	Исключение
		Информация = ИнформацияОбОшибке();
		ДобавитьВПротокол("Ошибка: " + ПодробноеПредставлениеОшибки(Информация));
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(Информация));
		Возврат;
	КонецПопытки;

	ПродолжитьПрисоединениеНаСервереПакетами();

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПрисоединениеНаСервереПакетами() Экспорт

	Попытка
		Результат = ОбработатьПакетПрисоединенияНаСервере();
		Если Результат.Завершено Тогда
			Если Результат.Успех Тогда
				УстановитьШагМастера(3);
				ПоказатьПредупреждение(, "Присоединение завершено. См. протокол.");
			Иначе
				ПоказатьПредупреждение(, Результат.ТекстОшибки);
			КонецЕсли;
			Возврат;
		КонецЕсли;

		Состояние(Результат.ТекстПрогресса);
		ПодключитьОбработчикОжидания("ПродолжитьПрисоединениеНаСервереПакетами", 0.1, Истина);
	Исключение
		Информация = ИнформацияОбОшибке();
		ДобавитьВПротокол("Ошибка: " + ПодробноеПредставлениеОшибки(Информация));
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(Информация));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура СохранитьСостояниеПрисоединенияВоВременноеХранилище(Состояние)

	Если Состояние = Неопределено Тогда
		Если Не ПустаяСтрока(АдресСостоянияПрисоединения) Тогда
			УдалитьИзВременногоХранилища(АдресСостоянияПрисоединения);
		КонецЕсли;
		АдресСостоянияПрисоединения = "";
		Возврат;
	КонецЕсли;

	АдресСостоянияПрисоединения = ПоместитьВоВременноеХранилище(Состояние, УникальныйИдентификатор);

КонецПроцедуры

&НаСервере
Функция ПолучитьСостояниеПрисоединенияИзВременногоХранилища()

	Если ПустаяСтрока(АдресСостоянияПрисоединения) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПолучитьИзВременногоХранилища(АдресСостоянияПрисоединения);

КонецФункции

&НаСервере
Процедура ИнициализироватьПрисоединениеНаСервере()

	Состояние = Новый Структура(
		"Фаза,ИндексФайла,Обработано,ЗамечанияПосле,ПутьLgfПриемника",
		"files", 0, 0, 0, "");

	МоментНачала = ТекущаяДата();
	ДобавитьВПротоколНаСервереКонтекста("=== Начало присоединения ===");

	ПроверитьКаталогиНаСервереКонтекста();
	ПроверитьФизическоеРазличиеКаталоговДляЗаписи(КаталогИсточника, КаталогПриемника);

	КэшБлокировок = Новый Соответствие;
	Заблокированные = НайтиЗаблокированныеФайлыПриемникаНаСервереКонтекста(КэшБлокировок);
	Если Заблокированные.Количество() > 0 Тогда
		ТекстБлокировки = "Файлы приёмника заблокированы (вероятно, ragent/кластер). "
			+ "Скопируйте 1Cv8Log и работайте с копией. Заблокировано: "
			+ СтрСоединить(Заблокированные, ", ");
		ВызватьИсключение ТекстБлокировки;
	КонецЕсли;

	ПутьLgfИсточника = ПутьКСловарюЖР(КаталогИсточника);
	ПутьLgfПриемника = ПутьКСловарюЖР(КаталогПриемника);
	Состояние.ПутьLgfПриемника = ПутьLgfПриемника;

	ДанныеАнализа = ПолучитьДанныеАнализаДляПрисоединенияНаСервере(ПутьLgfИсточника, ПутьLgfПриемника);
	СловарьПриемника = ДанныеАнализа.СловарьПриемника;
	РезультатКарт = ДанныеАнализа.РезультатКарт;
	НужнаПеренумерация = РезультатКарт.НужнаПеренумерация;

	Если СоздаватьРезервнуюКопию Тогда
		ПутьКопииКаталога = СоздатьВыборочнуюКопиюФайловПриемникаНаСервереКонтекста(РезультатКарт);
		ДобавитьВПротоколНаСервереКонтекста("Резервная копия изменяемых файлов: " + ПутьКопииКаталога);
	КонецЕсли;

	Если РезультатКарт.ДобавленныеСтроки.Количество() > 0 Тогда
		ДописатьСтрокиВLgf(ПутьLgfПриемника, РезультатКарт.ДобавленныеСтроки);
		ДобавитьВПротоколНаСервереКонтекста("В 1Cv8.lgf добавлено записей: "
			+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	Иначе
		ДобавитьВПротоколНаСервереКонтекста("Словарь приёмника уже содержит все объекты источника.");
	КонецЕсли;

	Состояние.Вставить("СловарьПриемника", СловарьПриемника);
	Состояние.Вставить("РезультатКарт", РезультатКарт);
	Состояние.Вставить("НужнаПеренумерация", НужнаПеренумерация);
	Состояние.Вставить("МоментНачала", МоментНачала);
	СохранитьСостояниеПрисоединенияВоВременноеХранилище(Состояние);

КонецПроцедуры

&НаСервере
Функция ОбработатьПакетПрисоединенияНаСервере()

	Результат = Новый Структура("Завершено,Успех,ТекстОшибки,ТекстПрогресса", Ложь, Истина, "", "");

	Состояние = ПолучитьСостояниеПрисоединенияИзВременногоХранилища();
	Если Состояние = Неопределено Тогда
		Результат.Завершено = Истина;
		Результат.Успех = Ложь;
		Результат.ТекстОшибки = "Внутренняя ошибка: не инициализировано присоединение.";
		Возврат Результат;
	КонецЕсли;

	СловарьПриемника = Состояние.СловарьПриемника;
	РезультатКарт = Состояние.РезультатКарт;
	НужнаПеренумерация = Состояние.НужнаПеренумерация;
	Индекс = Состояние.ИндексФайла;

	Пока Индекс < ФайлыЖурнала.Количество() Цикл

		СтрокаФайла = ФайлыЖурнала[Индекс];
		Индекс = Индекс + 1;
		Состояние.ИндексФайла = Индекс;

		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;

		Результат.ТекстПрогресса = "Присоединение " + СтрокаФайла.ИмяФайла
			+ " (" + Формат(Индекс, "ЧГ=0") + "/" + Формат(ФайлыЖурнала.Количество(), "ЧГ=0") + ")";

		Если ВнутреннийКодДействияФайла(СтрокаФайла.Действие) = РежимКонфликтаПропустить()
			И ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
			ДобавитьВПротоколНаСервереКонтекста("Пропущен (уже есть): " + СтрокаФайла.ИмяФайла);
			Продолжить;
		КонецЕсли;

		Объединять = (ВнутреннийКодДействияФайла(СтрокаФайла.Действие) = РежимКонфликтаОбъединить()
			И ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника));

		ПрисоединитьФайлLgp(
			СтрокаФайла.ПолныйПутьИсточника,
			СтрокаФайла.ПолныйПутьПриемника,
			СловарьПриемника,
			РезультатКарт.Карты,
			Объединять,
			НужнаПеренумерация,
			Неопределено,
			ОпцииСклейкиИзРеквизитовФормыНаСервере());

		Если Объединять Тогда
			ДобавитьВПротоколНаСервереКонтекста("Объединён: " + СтрокаФайла.ИмяФайла);
		Иначе
			ДобавитьВПротоколНаСервереКонтекста("Скопирован: " + СтрокаФайла.ИмяФайла);
		КонецЕсли;

		Состояние.Обработано = Состояние.Обработано + 1;
		СохранитьСостояниеПрисоединенияВоВременноеХранилище(Состояние);
		Возврат Результат;

	КонецЦикла;

	УдалитьИндексыЖурналаНаСервереКонтекста(КаталогПриемника);
	ДобавитьВПротоколНаСервереКонтекста("Обработано файлов: "
		+ ФорматЧислаПротокола(Состояние.Обработано));
	ДобавитьВПротоколНаСервереКонтекста("Индексы *.lgx удалены - платформа построит их заново при открытии ЖР.");

	Если ПроверятьЦелостность Тогда
		ЗамечанияПосле = ЗавершитьКонтрольЦелостностиПослеПрисоединенияНаСервере(Состояние, СловарьПриемника);
	Иначе
		ЗамечанияПосле = 0;
	КонецЕсли;

	ДобавитьВПротоколНаСервереКонтекста("=== Конец присоединения. Длительность: "
		+ ПредставлениеДлительностиПротокола(ТекущаяДата() - Состояние.МоментНачала) + " ===");
	Если ЗамечанияПосле > 0 Тогда
		ДобавитьВПротоколНаСервереКонтекста(
			"Завершено с замечаниями контроля. Не подменяйте боевой каталог, пока не разберёте протокол.");
	Иначе
		ДобавитьВПротоколНаСервереКонтекста(
			"Готово. Если работали с копией, остановите кластер и подмените каталог 1Cv8Log.");
	КонецЕсли;

	СохранитьСостояниеПрисоединенияВоВременноеХранилище(Неопределено);
	Результат.Завершено = Истина;
	Возврат Результат;

КонецФункции

&НаСервере
Функция ЗавершитьКонтрольЦелостностиПослеПрисоединенияНаСервере(Состояние, СловарьПриемника)

	ДобавитьВПротоколНаСервереКонтекста("--- Контроль после записи ---");
	СловарьПосле = ПрочитатьСловарьLgf(Состояние.ПутьLgfПриемника);
	ЗамечанияПосле = 0;
	КэшЦелостности = Новый Соответствие;

	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		Если Не СтрокаФайла.Пометка Или Не ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
			Продолжить;
		КонецЕсли;
		Если ВнутреннийКодДействияФайла(СтрокаФайла.Действие) = РежимКонфликтаПропустить() Тогда
			Продолжить;
		КонецЕсли;
		РезультатПроверки = ПроверитьЦелостностьФайлаLgp(
			СтрокаФайла.ПолныйПутьПриемника,
			СловарьПосле.GUID,
			СловарьПосле.Версия,
			КэшЦелостности);
		Если Не РезультатПроверки.Ок Тогда
			ЗамечанияПосле = ЗамечанияПосле + 1;
			ДобавитьВПротоколНаСервереКонтекста("  " + СтрокаФайла.ИмяФайла + ": " + РезультатПроверки.Сообщение);
		КонецЕсли;
	КонецЦикла;

	Если ЗамечанияПосле = 0 Тогда
		ДобавитьВПротоколНаСервереКонтекста("Контроль после записи: замечаний нет — заголовки периодов согласованы с новым журналом.");
	Иначе
		ДобавитьВПротоколНаСервереКонтекста("Контроль после записи: замечаний "
			+ ФорматЧислаПротокола(ЗамечанияПосле)
			+ ". Часть периодов может не открыться — см. формулировки выше.");
	КонецЕсли;

	Возврат ЗамечанияПосле;

КонецФункции

#КонецОбласти

#Область ПотоковоеЧтениеLgp

&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьЗаголовокИТелоLgpПотоково(ПутьКФайлу)

	Чтение = ОткрытьЧтениеЖурнала(ПутьКФайлу);
	СтрокиЗаголовка = Новый Массив;
	Для Номер = 1 По 3 Цикл
		Строка = Чтение.ПрочитатьСтроку();
		Если Строка = Неопределено Тогда
			Строка = "";
		КонецЕсли;
		СтрокиЗаголовка.Добавить(Строка);
	КонецЦикла;

	СтрокиТела = Новый Массив;
	Пока Истина Цикл
		Строка = Чтение.ПрочитатьСтроку();
		Если Строка = Неопределено Тогда
			Прервать;
		КонецЕсли;
		СтрокиТела.Добавить(Строка);
	КонецЦикла;
	Чтение.Закрыть();

	Разрыв = РазрывСтрокЗаголовкаLgp();
	Заголовок = СтрСоединить(СтрокиЗаголовка, Разрыв) + Разрыв;
	Тело = "";
	Если СтрокиТела.Количество() > 0 Тогда
		Тело = СтрСоединить(СтрокиТела, Разрыв);
		Если Не ПустаяСтрока(Тело) Тогда
			Тело = Тело + Разрыв;
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Структура("Заголовок,Тело", Заголовок, Тело);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбъединитьLgpБезПеренумерации(ПутьИсточника, ПутьПриемника)

	КодировкаИсточника = КодировкаТекстаЖурнала(ПутьИсточника);
	КодировкаПриемника = КодировкаТекстаЖурнала(ПутьПриемника);
	Если КодировкаИсточника <> КодировкаТекста.UTF8
		Или КодировкаПриемника <> КодировкаТекста.UTF8 Тогда
		ОбъединитьLgpСПоточнойПерекодировкой(
			ПутьИсточника,
			ПутьПриемника,
			КодировкаПриемника);
		Возврат;
	КонецЕсли;

	СмещениеТелаИсточника = СмещениеТелаLgpВФайле(ПутьИсточника);
	ФайлИсточника = Новый Файл(ПутьИсточника);
	Если ФайлИсточника.Размер() <= СмещениеТелаИсточника Тогда
		// Пустое тело — не трогаем приёмник (иначе останется хвостовая запятая после подготовки).
		Возврат;
	КонецЕсли;

	ПутьПодготовленного = ПолучитьПутьПодготовленногоФайлаРядом(ПутьПриемника);
	Попытка
		КопироватьФайл(ПутьПриемника, ПутьПодготовленного);
		ОбеспечитьЗапятуюНаПоследнейЗаписиLgpВФайле(ПутьПодготовленного);
		ДописатьТелоLgpИзФайлаБинарно(ПутьИсточника, ПутьПодготовленного);
		ОпубликоватьПодготовленныйФайл(ПутьПодготовленного, ПутьПриемника);
	Исключение
		Если ФайлСуществует(ПутьПодготовленного) Тогда
			УдалитьФайлы(ПутьПодготовленного);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПодготовитьПриемникLgpДляДописывания(ПутьКФайлу)

	ИсправитьПустуюСтрокуПослеGUIDВLgpЕслиНужно(ПутьКФайлу);
	ОбеспечитьЗапятуюНаПоследнейЗаписиLgpВФайле(ПутьКФайлу);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ИсправитьПустуюСтрокуПослеGUIDВLgpЕслиНужно(ПутьКФайлу)

	СмещениеТела = СмещениеТелаLgpВФайле(ПутьКФайлу);
	Если СмещениеТела <= 0 Тогда
		Возврат;
	КонецЕсли;

	ДанныеНачалаТела = ПрочитатьДвоичныйФрагментФайла(ПутьКФайлу, СмещениеТела, 1);
	Если ДанныеНачалаТела.Размер() = 0 Или ДанныеНачалаТела[0] <> 123 Тогда // "{"
		Возврат;
	КонецЕсли;

	ДанныеЗаголовка = ПрочитатьДвоичныйФрагментФайла(ПутьКФайлу, 0, СмещениеТела);
	ТекстЗаголовка = ПолучитьСтрокуИзДвоичныхДанных(ДанныеЗаголовка, КодировкаТекста.UTF8);
	Если СтрДлина(ТекстЗаголовка) > 0 И КодСимвола(Лев(ТекстЗаголовка, 1)) = 65279 Тогда
		ТекстЗаголовка = Сред(ТекстЗаголовка, 2);
	КонецЕсли;

	Если ЗаголовокСодержитПустуюСтрокуПослеGUID(ТекстЗаголовка) Тогда
		Возврат;
	КонецЕсли;

	Разрыв = РазрывСтрокИзФрагмента(ТекстЗаголовка);
	Если ПустаяСтрока(Разрыв) Тогда
		Разрыв = РазрывСтрокЗаголовкаLgp();
	КонецЕсли;

	ВставитьБайтыПередСмещениемВФайле(
		ПутьКФайлу,
		СмещениеТела,
		ПолучитьДвоичныеДанныеИзСтроки(Разрыв, КодировкаТекста.UTF8));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбеспечитьЗапятуюНаПоследнейЗаписиLgpВФайле(ПутьКФайлу)

	СмещениеТела = СмещениеТелаLgpВФайле(ПутьКФайлу);
	ФайлLgp = Новый Файл(ПутьКФайлу);
	РазмерФайла = ФайлLgp.Размер();
	РазмерТела = РазмерФайла - СмещениеТела;
	Если РазмерТела <= 0 Тогда
		Возврат;
	КонецЕсли;

	КандидатыХвоста = Новый Массив;
	КандидатыХвоста.Добавить(262144);
	КандидатыХвоста.Добавить(1048576);
	КандидатыХвоста.Добавить(4194304);
	КандидатыХвоста.Добавить(16777216);
	КандидатыХвоста.Добавить(РазмерТела);

	Для Индекс = 0 По КандидатыХвоста.ВГраница() Цикл

		МаксХвост = КандидатыХвоста[Индекс];
		РазмерХвоста = Мин(РазмерТела, МаксХвост);
		Если РазмерХвоста <= 0 Тогда
			Продолжить;
		КонецЕсли;

		СмещениеХвоста = СмещениеТела + РазмерТела - РазмерХвоста;
		ДанныеХвоста = ПрочитатьДвоичныйФрагментФайла(ПутьКФайлу, СмещениеХвоста, РазмерХвоста);
		Хвост = ПолучитьСтрокуИзДвоичныхДанных(ДанныеХвоста, КодировкаТекста.UTF8);
		Границы = ГраницыПоследнейЗаписиLgpВТексте(Хвост);
		Если Не Границы.Найдено Тогда
			Продолжить;
		КонецЕсли;

		НовыйХвост = ТекстТелаLgpСЗапятойНаПоследнейЗаписи(Хвост);
		Если НовыйХвост = Хвост Тогда
			Возврат;
		КонецЕсли;

		Если РазмерХвоста = РазмерТела Или Границы.Начало = 1 Тогда
			ЗаменитьХвостТелаLgpВФайле(ПутьКФайлу, РазмерХвоста, НовыйХвост);
			Возврат;
		КонецЕсли;

	КонецЦикла;

	// Редкий fallback: очень длинная последняя запись — старый путь через полное чтение.
	Части = ПрочитатьЗаголовокИТелоLgpПотоково(ПутьКФайлу);
	НовоеТело = ТекстТелаLgpСЗапятойНаПоследнейЗаписи(Части.Тело);
	Если НовоеТело = Части.Тело Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьСыройТекстЖурналаUTF8(ПутьКФайлу, Части.Заголовок + НовоеТело);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДописатьТелоLgpИзФайлаБинарно(ПутьИсточника, ПутьПриемника)

	Смещение = СмещениеТелаLgpВФайле(ПутьИсточника);
	ПотокИсточник = ФайловыеПотоки.ОткрытьДляЧтения(ПутьИсточника);
	ПотокИсточник.Перейти(Смещение, ПозицияВПотоке.Начало);
	Чтение = Новый ЧтениеДанных(ПотокИсточник);

	ПотокПриемник = ФайловыеПотоки.ОткрытьДляДописывания(ПутьПриемника);
	Запись = Новый ЗаписьДанных(ПотокПриемник);

	РазмерБлока = 1048576;
	Пока Истина Цикл
		Буфер = ПрочитатьБлокВБуфер(Чтение, РазмерБлока);
		Если Буфер = Неопределено Или Буфер.Размер = 0 Тогда
			Прервать;
		КонецЕсли;
		Запись.ЗаписатьБуферДвоичныхДанных(Буфер);
	КонецЦикла;

	Запись.Закрыть();
	ПотокПриемник.Закрыть();
	Чтение.Закрыть();
	ПотокИсточник.Закрыть();

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СмещениеТелаLgpВФайле(ПутьКФайлу)

	Файл = Новый Файл(ПутьКФайлу);
	РазмерПрефикса = Мин(8192, Файл.Размер());
	Если РазмерПрефикса = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Поток = ФайловыеПотоки.ОткрытьДляЧтения(ПутьКФайлу);
	Чтение = Новый ЧтениеДанных(Поток);
	ТекстПрефикса = ПолучитьСтрокуИзДвоичныхДанных(
		ПрочитатьБлокДвоичныхДанных(Чтение, РазмерПрефикса), КодировкаТекста.UTF8);
	Чтение.Закрыть();
	Поток.Закрыть();
	Если СтрДлина(ТекстПрефикса) > 0 И КодСимвола(Лев(ТекстПрефикса, 1)) = 65279 Тогда
		ТекстПрефикса = Сред(ТекстПрефикса, 2);
	КонецЕсли;

	Части = РазделитьЗаголовокИТелоLgp(ТекстПрефикса);
	ДанныеЗаголовка = ПолучитьДвоичныеДанныеИзСтроки(Части.Заголовок, КодировкаТекста.UTF8);
	Смещение = ДанныеЗаголовка.Размер();

	ПотокБом = ФайловыеПотоки.ОткрытьДляЧтения(ПутьКФайлу);
	ЧтениеБом = Новый ЧтениеДанных(ПотокБом);
	БуферБом = ПрочитатьБлокВБуфер(ЧтениеБом, 3);
	ЧтениеБом.Закрыть();
	ПотокБом.Закрыть();
	Если БуферБом <> Неопределено И БуферБом.Размер >= 3
		И БуферБом[0] = 239 И БуферБом[1] = 187 И БуферБом[2] = 191 Тогда
		Смещение = Смещение + 3;
	КонецЕсли;

	Возврат Смещение;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьДвоичныйФрагментФайла(ПутьКФайлу, Смещение, Размер)

	Поток = ФайловыеПотоки.ОткрытьДляЧтения(ПутьКФайлу);
	Поток.Перейти(Смещение, ПозицияВПотоке.Начало);
	Чтение = Новый ЧтениеДанных(Поток);
	Данные = ПрочитатьБлокДвоичныхДанных(Чтение, Размер);
	Чтение.Закрыть();
	Поток.Закрыть();

	Возврат Данные;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ВставитьБайтыПередСмещениемВФайле(ПутьКФайлу, Смещение, Вставка)

	Если Вставка = Неопределено Или Вставка.Размер() = 0 Тогда
		Возврат;
	КонецЕсли;

	ВременныйФайл = ПолучитьИмяВременногоФайла("lgp");
	ПотокИсточник = ФайловыеПотоки.ОткрытьДляЧтения(ПутьКФайлу);
	ПотокНазначение = ФайловыеПотоки.ОткрытьДляЗаписи(ВременныйФайл);
	Чтение = Новый ЧтениеДанных(ПотокИсточник);
	Запись = Новый ЗаписьДанных(ПотокНазначение);
	РазмерБлока = 1048576;

	Осталось = Смещение;
	Пока Осталось > 0 Цикл
		РазмерЧтения = Мин(Осталось, РазмерБлока);
		Буфер = ПрочитатьБлокВБуфер(Чтение, РазмерЧтения);
		Если Буфер = Неопределено Или Буфер.Размер = 0 Тогда
			Прервать;
		КонецЕсли;
		Запись.ЗаписатьБуферДвоичныхДанных(Буфер);
		Осталось = Осталось - Буфер.Размер;
	КонецЦикла;

	Запись.Записать(Вставка);

	Пока Истина Цикл
		Буфер = ПрочитатьБлокВБуфер(Чтение, РазмерБлока);
		Если Буфер = Неопределено Или Буфер.Размер = 0 Тогда
			Прервать;
		КонецЕсли;
		Запись.ЗаписатьБуферДвоичныхДанных(Буфер);
	КонецЦикла;

	Запись.Закрыть();
	Чтение.Закрыть();
	ПотокНазначение.Закрыть();
	ПотокИсточник.Закрыть();

	КопироватьФайлСЗаменой(ВременныйФайл, ПутьКФайлу);
	УдалитьФайлы(ВременныйФайл);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаменитьХвостТелаLgpВФайле(ПутьКФайлу, РазмерСтарогоХвостаБайт, НовыйХвостТекст)

	ФайлLgp = Новый Файл(ПутьКФайлу);
	РазмерФайла = ФайлLgp.Размер();
	СмещениеПрефикса = РазмерФайла - РазмерСтарогоХвостаБайт;
	Если СмещениеПрефикса < 0 Тогда
		Возврат;
	КонецЕсли;

	ВременныйФайл = ПолучитьИмяВременногоФайла("lgp");
	ПотокИсточник = ФайловыеПотоки.ОткрытьДляЧтения(ПутьКФайлу);
	ПотокНазначение = ФайловыеПотоки.ОткрытьДляЗаписи(ВременныйФайл);
	Чтение = Новый ЧтениеДанных(ПотокИсточник);
	Запись = Новый ЗаписьДанных(ПотокНазначение);
	РазмерБлока = 1048576;

	Осталось = СмещениеПрефикса;
	Пока Осталось > 0 Цикл
		РазмерЧтения = Мин(Осталось, РазмерБлока);
		Буфер = ПрочитатьБлокВБуфер(Чтение, РазмерЧтения);
		Если Буфер = Неопределено Или Буфер.Размер = 0 Тогда
			Прервать;
		КонецЕсли;
		Запись.ЗаписатьБуферДвоичныхДанных(Буфер);
		Осталось = Осталось - Буфер.Размер;
	КонецЦикла;

	БуферХвоста = ПолучитьБуферДвоичныхДанныхИзСтроки(НовыйХвостТекст, КодировкаТекста.UTF8);
	Запись.ЗаписатьБуферДвоичныхДанных(БуферХвоста);

	Запись.Закрыть();
	Чтение.Закрыть();
	ПотокНазначение.Закрыть();
	ПотокИсточник.Закрыть();

	КопироватьФайлСЗаменой(ВременныйФайл, ПутьКФайлу);
	УдалитьФайлы(ВременныйФайл);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДописатьЗаписиLgpИзФайлаПострочно(ПутьИсточника, ПутьДляДописывания, Карты, Перенумеровывать, СтатистикаВыгрузки = Неопределено, Отпечатки = Неопределено, КодировкаНазначения = Неопределено, ХвостоваяЗапятаяВПоследней = Ложь)

	Чтение = ОткрытьЧтениеЖурнала(ПутьИсточника);
	Для Номер = 1 По 3 Цикл
		Чтение.ПрочитатьСтроку();
	КонецЦикла;

	Части = Новый Массив;
	РазмерПакетаЗаписей = 3000;
	ЗаписейВПакете = 0;
	ОтложеннаяЗапись = "";
	ОтложенныйПрефикс = "";
	ЕстьОтложеннаяЗапись = Ложь;
	СчетчикЗаписей = 0;
	РазмерФайлаБайт = 0;
	Попытка
		ФайлИсточникаРазмер = Новый Файл(ПутьИсточника);
		РазмерФайлаБайт = ФайлИсточникаРазмер.Размер();
	Исключение
		РазмерФайлаБайт = 0;
	КонецПопытки;
	ВремяНачалаМс = 0;
	#Если Клиент Тогда
	ВремяНачалаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	#КонецЕсли

	БуферЗаписи = "";
	Глубина = 0;
	ВКавычках = Ложь;
	ПрефиксПередЗаписью = "";

	Пока Истина Цикл

		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Если Глубина = 0 И Не ПустаяСтрока(БуферЗаписи) Тогда
				ТекстЗаписи = ПодготовитьТекстЗаписиLgp(БуферЗаписи, Карты, Перенумеровывать);
				Если Не ПустаяСтрока(ТекстЗаписи)
					И Не ЗаписьLgpПропущенаКакДубль(ТекстЗаписи, Отпечатки, СтатистикаВыгрузки) Тогда
					Если ЕстьОтложеннаяЗапись Тогда
						Части.Добавить(ОтложенныйПрефикс);
						Части.Добавить(ОбеспечитьХвостовуюЗапятуюВЗаписиLgp(ОтложеннаяЗапись));
						ЗаписейВПакете = ЗаписейВПакете + 1;
					КонецЕсли;
					Части.Добавить(ПрефиксПередЗаписью);
					Части.Добавить(УбратьХвостовуюЗапятуюВЗаписиLgp(ТекстЗаписи));
					ЕстьОтложеннаяЗапись = Ложь;
					СчетчикЗаписей = СчетчикЗаписей + 1;
					Если СтатистикаВыгрузки <> Неопределено Тогда
						СтатистикаВыгрузки.Записей = СтатистикаВыгрузки.Записей + 1;
						Если СтрНайти(ТекстЗаписи, Символы.ПС) > 0 Или СтрНайти(ТекстЗаписи, Символы.ВК) > 0 Тогда
							СтатистикаВыгрузки.Многострочных = СтатистикаВыгрузки.Многострочных + 1;
						Иначе
							СтатистикаВыгрузки.Однострочных = СтатистикаВыгрузки.Однострочных + 1;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			Прервать;
		КонецЕсли;

		Если Глубина = 0 И ПустаяСтрока(БуферЗаписи) Тогда
			Сжатая = СокрЛП(СтрокаФайла);
			Если ПустаяСтрока(Сжатая) Или (Не СтрНачинаетсяС(СокрЛ(Сжатая), "{") И Не ЕстьОтложеннаяЗапись) Тогда
				ПрефиксПередЗаписью = ДобавитьСтрокуСРазрывом(ПрефиксПередЗаписью, СтрокаФайла);
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках);
		Если Глубина = 0 И Не ПустаяСтрока(БуферЗаписи) Тогда

			ТекстЗаписи = ПодготовитьТекстЗаписиLgp(БуферЗаписи, Карты, Перенумеровывать);
			БуферЗаписи = "";

			Если Не ПустаяСтрока(ТекстЗаписи)
				И Не ЗаписьLgpПропущенаКакДубль(ТекстЗаписи, Отпечатки, СтатистикаВыгрузки) Тогда
				Если ЕстьОтложеннаяЗапись Тогда
					Части.Добавить(ОтложенныйПрефикс);
					Части.Добавить(ОбеспечитьХвостовуюЗапятуюВЗаписиLgp(ОтложеннаяЗапись));
					ЗаписейВПакете = ЗаписейВПакете + 1;
					Если ЗаписейВПакете >= РазмерПакетаЗаписей Тогда
						ДописатьСыройТекстЖурналаБезBOM(
							ПутьДляДописывания, СтрСоединить(Части, ""), КодировкаНазначения);
						Части.Очистить();
						ЗаписейВПакете = 0;
					КонецЕсли;
				КонецЕсли;
				ОтложеннаяЗапись = ТекстЗаписи;
				ОтложенныйПрефикс = ПрефиксПередЗаписью;
				ЕстьОтложеннаяЗапись = Истина;
				ПрефиксПередЗаписью = "";

				СчетчикЗаписей = СчетчикЗаписей + 1;
				Если СтатистикаВыгрузки <> Неопределено Тогда
					СтатистикаВыгрузки.Записей = СтатистикаВыгрузки.Записей + 1;
					Если СтрНайти(ТекстЗаписи, Символы.ПС) > 0 Или СтрНайти(ТекстЗаписи, Символы.ВК) > 0 Тогда
						СтатистикаВыгрузки.Многострочных = СтатистикаВыгрузки.Многострочных + 1;
					Иначе
						СтатистикаВыгрузки.Однострочных = СтатистикаВыгрузки.Однострочных + 1;
					КонецЕсли;
				КонецЕсли;
				Если СчетчикЗаписей % 2000 = 0 Тогда
					#Если Клиент Тогда
					ОбработкаПрерыванияПользователя();
					Состояние(ТекстПрогрессаПеренумерации(СчетчикЗаписей, РазмерФайлаБайт, ВремяНачалаМс));
					#КонецЕсли
				КонецЕсли;
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Чтение.Закрыть();

	Если ЕстьОтложеннаяЗапись Тогда
		Части.Добавить(ОтложенныйПрефикс);
		Если ХвостоваяЗапятаяВПоследней Тогда
			Части.Добавить(ОбеспечитьХвостовуюЗапятуюВЗаписиLgp(ОтложеннаяЗапись));
		Иначе
			Части.Добавить(УбратьХвостовуюЗапятуюВЗаписиLgp(ОтложеннаяЗапись));
		КонецЕсли;
	КонецЕсли;

	Если Части.Количество() > 0 Тогда
		ДописатьСыройТекстЖурналаБезBOM(
			ПутьДляДописывания, СтрСоединить(Части, ""), КодировкаНазначения);
	КонецЕсли;

	Возврат СчетчикЗаписей;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаписьLgpПропущенаКакДубль(ТекстЗаписи, Отпечатки, СтатистикаВыгрузки)

	Если Отпечатки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Сжатая = СокрЛП(ТекстЗаписи);
	Если СтрЗаканчиваетсяНа(Сжатая, ",") Тогда
		Сжатая = УбратьХвостовуюЗапятую(Сжатая);
	КонецЕсли;
	Если Не ЭтоСкобочнаяЗапись(Сжатая) Тогда
		Возврат Ложь;
	КонецЕсли;

	Токены = Токенизировать(ТелоСкобочнойЗаписи(Сжатая));
	Если Не ЭтоЗаписьСобытияLgpПоТокенам(Токены) Тогда
		Возврат Ложь;
	КонецЕсли;

	Ключ = ОтпечатокЗаписиLgpИзТокенов(Токены);
	ОсталосьСовпадений = Отпечатки.Получить(Ключ);
	Если ОсталосьСовпадений <> Неопределено И ОсталосьСовпадений > 0 Тогда
		Отпечатки.Вставить(Ключ, ОсталосьСовпадений - 1);
		Если СтатистикаВыгрузки <> Неопределено Тогда
			Если СтатистикаВыгрузки.Свойство("ПропущеноДублей") Тогда
				СтатистикаВыгрузки.ПропущеноДублей = СтатистикаВыгрузки.ПропущеноДублей + 1;
			КонецЕсли;
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТекстПрогрессаПеренумерации(СчетчикЗаписей, РазмерФайлаБайт, ВремяНачалаМс)

	Текст = "Перенумерация: " + ФорматЧислаПротокола(СчетчикЗаписей) + " записей";
	Если РазмерФайлаБайт > 0 Тогда
		Текст = Текст + " / файл " + ПредставлениеРазмера(РазмерФайлаБайт);
	КонецЕсли;

	Если ВремяНачалаМс <= 0 Или СчетчикЗаписей < 100 Тогда
		Возврат Текст;
	КонецЕсли;

	ПрошлоМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаМс;
	Если ПрошлоМс < 500 Тогда
		Возврат Текст;
	КонецЕсли;

	Скорость = СчетчикЗаписей / (ПрошлоМс / 1000);
	Текст = Текст + ", ~" + ФорматЧислаПротокола(Цел(Скорость)) + " зап/с";

	Если РазмерФайлаБайт <= 0 Или Скорость <= 0 Тогда
		Возврат Текст;
	КонецЕсли;

	// Оценка объёма по типичному размеру записи текстового .lgp (~280 байт).
	СреднийБайтНаЗапись = 280;
	ОценкаВсего = Цел(РазмерФайлаБайт / СреднийБайтНаЗапись);
	Если ОценкаВсего < СчетчикЗаписей Тогда
		ОценкаВсего = Цел(СчетчикЗаписей * 11 / 10);
	КонецЕсли;

	ОсталосьЗаписей = ОценкаВсего - СчетчикЗаписей;
	Если ОсталосьЗаписей <= 0 Тогда
		Текст = Текст + ", осталось меньше минуты";
		Возврат Текст;
	КонецЕсли;

	СекундОсталось = Цел(ОсталосьЗаписей / Скорость);
	Текст = Текст + ", осталось ~" + ПредставлениеИнтервалаСекунд(СекундОсталось);
	Возврат Текст;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеИнтервалаСекунд(Секунд)

	Если Секунд < 0 Тогда
		Секунд = 0;
	КонецЕсли;
	Если Секунд < 60 Тогда
		Возврат ФорматЧислаПротокола(Секунд) + " с";
	КонецЕсли;

	Минут = Цел(Секунд / 60);
	Сек = Секунд - Минут * 60;
	Если Минут < 60 Тогда
		Возврат ФорматЧислаПротокола(Минут) + " мин " + ФорматЧислаПротокола(Сек) + " с";
	КонецЕсли;

	Часов = Цел(Минут / 60);
	Минут = Минут - Часов * 60;
	Возврат ФорматЧислаПротокола(Часов) + " ч " + ФорматЧислаПротокола(Минут) + " мин";

КонецФункции

