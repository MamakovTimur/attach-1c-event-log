&НаКлиенте
Процедура ВыбратьКаталогЖРЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВыбранныйКаталог = "";
	Если ДополнительныеПараметры.Свойство("Диалог") Тогда
		ВыбранныйКаталог = ДополнительныеПараметры.Диалог.Каталог;
	КонецЕсли;
	Если ПустаяСтрока(ВыбранныйКаталог) Тогда
		ВыбранныйКаталог = ПервыйПутьИзРезультатаДиалога(ВыбранныеФайлы);
	КонецЕсли;
	Если ПустаяСтрока(ВыбранныйКаталог) Тогда
		Возврат;
	КонецЕсли;

	ИмяРеквизита = ДополнительныеПараметры.ИмяРеквизита;
	Если ИмяРеквизита = "КаталогРезервнойКопии" Тогда
		ЭтотОбъект[ИмяРеквизита] = СокрЛП(ВыбранныйКаталог);
		Возврат;
	КонецЕсли;

	ЭтотОбъект[ИмяРеквизита] = НормализоватьКаталогЖР(ВыбранныйКаталог);
	СброситьПланАнализа();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлыЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПервыйПуть = ПервыйПутьИзРезультатаДиалога(ВыбранныеФайлы);
	Если ПустаяСтрока(ПервыйПуть) Тогда
		Возврат;
	КонецЕсли;

	ПервыйФайл = Новый Файл(ПервыйПуть);
	КаталогИсточника = НормализоватьКаталогЖР(ПервыйФайл.Путь);

	ТекстПротокола = "";
	Если Не ВыполнитьАнализБезопасно(Ложь) Тогда
		Возврат;
	КонецЕсли;

	ВыбранныеИмена = Новый Соответствие;
	Для Каждого ПолноеИмя Из ВыбранныеФайлы Цикл
		ФайлНаДиске = Новый Файл(ПолноеИмя);
		ВыбранныеИмена.Вставить(НРег(ФайлНаДиске.Имя), Истина);
	КонецЦикла;

	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		СтрокаФайла.Пометка = (ВыбранныеИмена.Получить(НРег(СтрокаФайла.ИмяФайла)) = Истина);
	КонецЦикла;

	ДобавитьВПротокол("Отмечены выбранные вручную файлы: " + Формат(ВыбранныеФайлы.Количество(), "ЧГ=0"));
	ОбновитьПрогнозВремениПрисоединения();

КонецПроцедуры

&НаКлиенте
Функция ПервыйПутьИзРезультатаДиалога(ВыбранныеФайлы)

	Если ТипЗнч(ВыбранныеФайлы) = Тип("Строка") Тогда
		Возврат СокрЛП(ВыбранныеФайлы);
	КонецЕсли;

	Для Каждого Элемент Из ВыбранныеФайлы Цикл
		Если ТипЗнч(Элемент) = Тип("Строка") Тогда
			Возврат СокрЛП(Элемент);
		КонецЕсли;
		Возврат СокрЛП(Строка(Элемент));
	КонецЦикла;

	Возврат "";

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НормализоватьКаталогЖР(Знач Каталог)

	Каталог = СокрЛП(Каталог);
	Если ПустаяСтрока(Каталог) Тогда
		Возврат Каталог;
	КонецЕсли;

	Если ФайлСуществует(ПутьКСловарюЖР(Каталог)) Тогда
		Возврат Каталог;
	КонецЕсли;

	КаталогLog = ОбъединитьПуть(Каталог, ИмяКаталогаЖР());
	Если ФайлСуществует(ПутьКСловарюЖР(КаталогLog)) Тогда
		Возврат КаталогLog;
	КонецЕсли;

	Возврат Каталог;

КонецФункции

&НаКлиенте
Функция КаталогЖРФайловойБазы()

	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	Маркер = "File=";
	Позиция = СтрНайти(ВРег(СтрокаСоединения), ВРег(Маркер));
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(СтрокаСоединения, Позиция + СтрДлина(Маркер));
	Если СтрНачинаетсяС(Остаток, """") Тогда
		Остаток = Сред(Остаток, 2);
		ПозицияКонца = СтрНайти(Остаток, """");
	Иначе
		ПозицияКонца = СтрНайти(Остаток, ";");
	КонецЕсли;

	Если ПозицияКонца > 0 Тогда
		ПутьБазы = Лев(Остаток, ПозицияКонца - 1);
	Иначе
		ПутьБазы = Остаток;
	КонецЕсли;

	Возврат ОбъединитьПуть(СокрЛП(ПутьБазы), ИмяКаталогаЖР());

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПутьКСловарюЖР(КаталогЖР)

	Возврат ОбъединитьПуть(КаталогЖР, ИмяФайлаСловаряЖР());

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОбъединитьПуть(Путь1, Путь2)

	#Если Клиент Тогда
		Разделитель = ПолучитьРазделительПутиКлиента();
	#Иначе
		Разделитель = ПолучитьРазделительПутиСервера();
	#КонецЕсли

	Если СтрЗаканчиваетсяНа(Путь1, Разделитель) Или СтрЗаканчиваетсяНа(Путь1, "/") Или СтрЗаканчиваетсяНа(Путь1, "\") Тогда
		Возврат Путь1 + Путь2;
	КонецЕсли;

	Возврат Путь1 + Разделитель + Путь2;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФайлСуществует(ПолноеИмя)

	ФайлНаДиске = Новый Файл(ПолноеИмя);
	Возврат ФайлНаДиске.Существует();

КонецФункции

// Эвристика: путь похож на локальный профиль Windows / OneDrive / Desktop.
// UNC (\\server\…) не считаем клиентским — для сервера это нормальный вариант.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПутьПохожНаКлиентскийЛокальный(Знач Путь)

	ПутьВерх = ВРег(СокрЛП(Путь));
	Если ПустаяСтрока(ПутьВерх) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрНачинаетсяС(ПутьВерх, "\\") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрНайти(ПутьВерх, ":\USERS\") > 0
		Или СтрНайти(ПутьВерх, "/USERS/") > 0
		Или СтрНайти(ПутьВерх, "\USERS\") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрНайти(ПутьВерх, "ONEDRIVE") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрНайти(ПутьВерх, "\DESKTOP\") > 0
		Или СтрНайти(ПутьВерх, "/DESKTOP/") > 0
		Или СтрНайти(ПутьВерх, "\РАБОЧИЙ СТОЛ\") > 0
		Или СтрНайти(ПутьВерх, "/РАБОЧИЙ СТОЛ/") > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТекстПредупрежденияКлиентскихПутейНаСервере(Знач КаталогИсточникаЖР, Знач КаталогПриемникаЖР)

	Проблемные = Новый Массив;
	Если ПутьПохожНаКлиентскийЛокальный(КаталогИсточникаЖР) Тогда
		Проблемные.Добавить("источник: " + СокрЛП(КаталогИсточникаЖР));
	КонецЕсли;
	Если ПутьПохожНаКлиентскийЛокальный(КаталогПриемникаЖР) Тогда
		Проблемные.Добавить("приёмник: " + СокрЛП(КаталогПриемникаЖР));
	КонецЕсли;
	Если Проблемные.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат "ВНИМАНИЕ: включён режим «На сервере», а путь похож на локальный клиентский ("
		+ СтрСоединить(Проблемные, "; ")
		+ "). Сервер приложений часто не видит C:\Users\, OneDrive и Desktop"
		+ " и может долго ждать сеть или завершиться ошибкой."
		+ " Переключите тумблер на «На клиенте» либо укажите UNC/пути, доступные серверу.";

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОтсортироватьФайлыПоИмени(МассивФайлов)

	Список = Новый СписокЗначений;
	Для Каждого ФайлОбъект Из МассивФайлов Цикл
		Список.Добавить(ФайлОбъект, ФайлОбъект.Имя);
	КонецЦикла;
	Список.СортироватьПоЗначению();

	Результат = Новый Массив;
	Для Каждого ЭлементСписка Из Список Цикл
		Результат.Добавить(ЭлементСписка.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область АнализИПрисоединение

&НаКлиенте
Функция ВыполнитьАнализБезопасно(ПисатьОшибкуВПротокол)

	Если ВыполнятьНаСервере Тогда
		Результат = ВыполнитьАнализБезопасноНаСервере(ПисатьОшибкуВПротокол);
		Если Не Результат.Ок Тогда
			ПоказатьПредупреждение(, Результат.ТекстОшибки);
		КонецЕсли;
		Возврат Результат.Ок;
	КонецЕсли;

	Попытка
		ВыполнитьАнализ();
		Возврат Истина;
	Исключение
		Информация = ИнформацияОбОшибке();
		Если ПисатьОшибкуВПротокол Тогда
			ДобавитьВПротокол("Ошибка анализа: " + КраткоеПредставлениеОшибки(Информация));
			ДобавитьВОтладочныйЛог("[ERROR] analyze_failed=" + КраткоеПредставлениеОшибки(Информация));
		КонецЕсли;
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(Информация));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаСервере
Функция ВыполнитьАнализБезопасноНаСервере(ПисатьОшибкуВПротокол)

	Результат = Новый Структура("Ок,ТекстОшибки", Истина, "");
	Попытка
		ВыполнитьАнализНаСервереКонтекста();
	Исключение
		Информация = ИнформацияОбОшибке();
		Результат.Ок = Ложь;
		Результат.ТекстОшибки = КраткоеПредставлениеОшибки(Информация);
		Если ПисатьОшибкуВПротокол Тогда
			ДобавитьВПротоколНаСервереКонтекста("Ошибка анализа: " + Результат.ТекстОшибки);
			ДобавитьВОтладочныйЛогНаСервереКонтекста("[ERROR] analyze_failed=" + Результат.ТекстОшибки);
		КонецЕсли;
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ВыполнитьАнализ()

	#Если Клиент Тогда
	ОбработкаПрерыванияПользователя();
	Состояние("Анализ: проверка каталогов…");
	#КонецЕсли

	КаталогИсточника = НормализоватьКаталогЖР(КаталогИсточника);
	КаталогПриемника = НормализоватьКаталогЖР(КаталогПриемника);
	ПроверитьКаталоги();

	#Если Клиент Тогда
	ОбработкаПрерыванияПользователя();
	Состояние("Анализ: чтение словарей lgf…");
	#КонецЕсли
	ДобавитьВПротокол("--- Этап: словари 1Cv8.lgf ---");
	СловарьИсточника = ПрочитатьСловарьLgf(ПутьКСловарюЖР(КаталогИсточника));
	СловарьПриемника = ПрочитатьСловарьLgf(ПутьКСловарюЖР(КаталогПриемника));

	#Если Клиент Тогда
	ОбработкаПрерыванияПользователя();
	Состояние("Анализ: карта перенумерации…");
	#КонецЕсли
	ДобавитьВПротокол("--- Этап: карта перенумерации ---");
	РезультатКарт = ПостроитьКартыПеренумерации(СловарьИсточника, СловарьПриемника);

	НужнаПеренумерация = РезультатКарт.НужнаПеренумерация;
	#Если Клиент Тогда
	ОбработкаПрерыванияПользователя();
	Состояние("Анализ: список файлов .lgp…");
	#КонецЕсли
	ДобавитьВПротокол("--- Этап: список файлов ---");
	ЗаполнитьТаблицуФайловЖурнала();
	ЗаписатьПротоколАнализа(СловарьИсточника, СловарьПриемника, РезультатКарт);
	СохранитьКэшАнализа(СловарьИсточника, СловарьПриемника, РезультатКарт);
	АнализАктуален = Истина;

	Если ФайлыЖурнала.Количество() = 0 Тогда
		ВызватьИсключение "В каталоге источника нет файлов .lgp.";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВыполнитьАнализНаСервереКонтекста()

	ТекстПредупрежденияПутей = ТекстПредупрежденияКлиентскихПутейНаСервере(
		КаталогИсточника, КаталогПриемника);
	Если Не ПустаяСтрока(ТекстПредупрежденияПутей) Тогда
		ДобавитьВПротоколНаСервереКонтекста(ТекстПредупрежденияПутей);
	КонецЕсли;

	КаталогИсточника = НормализоватьКаталогЖР(КаталогИсточника);
	КаталогПриемника = НормализоватьКаталогЖР(КаталогПриемника);
	ПроверитьКаталогиНаСервереКонтекста();

	ДобавитьВПротоколНаСервереКонтекста("--- Этап: словари 1Cv8.lgf ---");
	СловарьИсточника = ПрочитатьСловарьLgf(ПутьКСловарюЖР(КаталогИсточника));
	СловарьПриемника = ПрочитатьСловарьLgf(ПутьКСловарюЖР(КаталогПриемника));
	ДобавитьВПротоколНаСервереКонтекста("--- Этап: карта перенумерации ---");
	РезультатКарт = ПостроитьКартыПеренумерации(СловарьИсточника, СловарьПриемника);

	НужнаПеренумерация = РезультатКарт.НужнаПеренумерация;
	ДобавитьВПротоколНаСервереКонтекста("--- Этап: список файлов ---");
	ЗаполнитьТаблицуФайловЖурналаНаСервереКонтекста();
	ЗаписатьПротоколАнализаНаСервереКонтекста(СловарьИсточника, СловарьПриемника, РезультатКарт);
	СохранитьКэшАнализаНаСервере(СловарьИсточника, СловарьПриемника, РезультатКарт);
	АнализАктуален = Истина;

	Если ФайлыЖурнала.Количество() = 0 Тогда
		ВызватьИсключение "В каталоге источника нет файлов .lgp.";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуФайловЖурнала()

	ФайлыЖурнала.Очистить();
	НайденныеФайлы = ОтсортироватьФайлыПоИмени(НайтиФайлы(КаталогИсточника, "*.lgp", Ложь));
	ВсегоФайлов = НайденныеФайлы.Количество();
	НомерФайла = 0;

	Для Каждого ФайлИсточника Из НайденныеФайлы Цикл

		НомерФайла = НомерФайла + 1;
		#Если Клиент Тогда
		ОбработкаПрерыванияПользователя();
		Если НомерФайла = 1 Или НомерФайла = ВсегоФайлов Или НомерФайла % 10 = 0 Тогда
			Состояние("Список файлов " + Формат(НомерФайла, "ЧГ=0")
				+ "/" + Формат(ВсегоФайлов, "ЧГ=0") + "…");
		КонецЕсли;
		#КонецЕсли

		СтрокаФайла = ФайлыЖурнала.Добавить();
		СтрокаФайла.Пометка = Истина;
		СтрокаФайла.ИмяФайла = ФайлИсточника.Имя;
		СтрокаФайла.ПолныйПутьИсточника = ФайлИсточника.ПолноеИмя;
		СтрокаФайла.ПолныйПутьПриемника = ОбъединитьПуть(КаталогПриемника, ФайлИсточника.Имя);
		СтрокаФайла.РазмерИсточникаБайт = ФайлИсточника.Размер();
		СтрокаФайла.РазмерИсточника = ПредставлениеРазмера(СтрокаФайла.РазмерИсточникаБайт);

		ФайлПриемника = Новый Файл(СтрокаФайла.ПолныйПутьПриемника);
		Если ФайлПриемника.Существует() Тогда
			СтрокаФайла.РазмерПриемника = ПредставлениеРазмера(ФайлПриемника.Размер());
			СтрокаФайла.Действие = ПредставлениеДействияФайла(РежимКонфликта);
		Иначе
			СтрокаФайла.РазмерПриемника = "-";
			СтрокаФайла.Действие = ПредставлениеДействияФайла(ДействиеСкопировать());
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

