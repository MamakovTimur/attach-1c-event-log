КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СтрокиОтладкиLgfПослеДописки(ПутьLgf, КоличествоДобавленных, ЗаписейДо)

	Строки = Новый Массив;
	Метрики = СобратьМетрикиLgf(ПутьLgf);
	Строки.Добавить(СтрокаМетрикLgf("lgf_after", Метрики));

	Если КоличествоДобавленных > 0 И Метрики.Записей <= ЗаписейДо Тогда
		Строки.Добавить("[WARN] lgf_entries_unchanged before="
			+ ФорматЧислаПротокола(ЗаписейДо)
			+ " after=" + ФорматЧислаПротокола(Метрики.Записей)
			+ " added_lines=" + ФорматЧислаПротокола(КоличествоДобавленных));
	КонецЕсли;

	Возврат Строки;

КонецФункции

