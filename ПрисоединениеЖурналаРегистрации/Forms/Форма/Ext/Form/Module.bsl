&НаКлиенте
Процедура НайтиВКластереЗавершениеВыбораSrvinfo(ВыбранныеФайлы, ИмяРеквизитаКаталога) Экспорт
	
	ПутьSrvinfo = ПервыйПутьИзРезультатаДиалога(ВыбранныеФайлы);
	Если ПустаяСтрока(ПутьSrvinfo) Тогда
		Возврат;
	КонецЕсли;
	
	КаталогSrvinfo = ПутьSrvinfo;
	
	Попытка
		Кандидаты = НайтиКаталогиЖРВSrvinfo(ПутьSrvinfo, ИмяИБ);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Если Кандидаты.Количество() = 0 Тогда
		ПоказатьПредупреждение(,
			"Каталоги 1Cv8Log с 1Cv8.lgf не найдены.
			|Укажите srvinfo или reg_XXXX и при необходимости имя ИБ в фильтре.");
		Возврат;
	КонецЕсли;
	
	Если Кандидаты.Количество() = 1 Тогда
		УстановитьКаталогЖРИзПоиска(ИмяРеквизитаКаталога, Кандидаты[0]);
		Возврат;
	КонецЕсли;
	
	СписокВыбора = Новый СписокЗначений;
	Для Каждого Кандидат Из Кандидаты Цикл
		СписокВыбора.Добавить(Кандидат.Путь, Кандидат.Представление);
	КонецЦикла;
	
	Оповещение = Новый ОписаниеОповещения(
		"НайтиВКластереПослеВыбораКандидата",
		ЭтотОбъект,
		ИмяРеквизитаКаталога);
	СписокВыбора.ПоказатьВыборЭлемента(Оповещение, "Выберите каталог журнала регистрации");
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиВКластереПослеВыбораКандидата(ВыбранныйЭлемент, ИмяРеквизитаКаталога) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Кандидат = Новый Структура("Путь,Представление", ВыбранныйЭлемент.Значение, ВыбранныйЭлемент.Представление);
	УстановитьКаталогЖРИзПоиска(ИмяРеквизитаКаталога, Кандидат);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКаталогЖРИзПоиска(ИмяРеквизитаКаталога, Кандидат)
	
	Если ИмяРеквизитаКаталога = "КаталогИсточника" Тогда
		КаталогИсточника = Кандидат.Путь;
	Иначе
		КаталогПриемника = Кандидат.Путь;
	КонецЕсли;
	
	ДобавитьВПротокол("Найден каталог ЖР: " + Кандидат.Представление);
	ДобавитьВПротокол("Путь: " + Кандидат.Путь);
	ПоказатьПредупреждение(, "Установлен каталог:
		|" + Кандидат.Путь);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НайтиКаталогиЖРВSrvinfo(КореньПоиска, ФильтрИмениИБ)
	
	Результат = Новый Массив;
	ИменаПоUUID = ПрочитатьИменаИБИзClst(КореньПоиска);
	Фильтр = НРег(СокрЛП(ФильтрИмениИБ));
	
	КаталогиЖР = НайтиФайлы(КореньПоиска, ИмяКаталогаЖР(), Истина);
	Для Каждого КаталогЖР Из КаталогиЖР Цикл
		
		Если Не КаталогЖР.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Если Не ФайлСуществует(ПутьКСловарюЖР(КаталогЖР.ПолноеИмя)) Тогда
			Продолжить;
		КонецЕсли;
		
		UUIDИБ = ИзвлечьUUIDИзПутиЖР(КаталогЖР.ПолноеИмя);
		ИмяИБИзClst = "";
		Если Не ПустаяСтрока(UUIDИБ) Тогда
			ИмяИБИзClst = ИменаПоUUID.Получить(НРег(UUIDИБ));
			Если ИмяИБИзClst = Неопределено Тогда
				ИмяИБИзClst = "";
			КонецЕсли;
		КонецЕсли;
		
		Если Не ПустаяСтрока(Фильтр) Тогда
			СтрокаПоиска = НРег(ИмяИБИзClst + " " + UUIDИБ + " " + КаталогЖР.ПолноеИмя);
			Если СтрНайти(СтрокаПоиска, Фильтр) = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Представление = КаталогЖР.ПолноеИмя;
		Если Не ПустаяСтрока(ИмяИБИзClst) Тогда
			Представление = ИмяИБИзClst + " — " + КаталогЖР.ПолноеИмя;
		ИначеЕсли Не ПустаяСтрока(UUIDИБ) Тогда
			Представление = UUIDИБ + " — " + КаталогЖР.ПолноеИмя;
		КонецЕсли;
		
		Кандидат = Новый Структура("Путь,Представление,UUID,ИмяИБ",
			КаталогЖР.ПолноеИмя, Представление, UUIDИБ, ИмяИБИзClst);
		Результат.Добавить(Кандидат);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьИменаИБИзClst(КореньПоиска)
	
	ИменаПоUUID = Новый Соответствие;
	ФайлыClst = НайтиФайлы(КореньПоиска, "1CV8Clst.lst", Истина);
	
	Для Каждого ФайлClst Из ФайлыClst Цикл
		
		Попытка
			Чтение = Новый ЧтениеТекста(ФайлClst.ПолноеИмя, КодировкаТекста.UTF8);
			Текст = Чтение.Прочитать();
			Чтение.Закрыть();
		Исключение
			Продолжить;
		КонецПопытки;
		
		Если Текст = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьИменаИБИзТекстаClst(Текст, ИменаПоUUID);
		
	КонецЦикла;
	
	Возврат ИменаПоUUID;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьИменаИБИзТекстаClst(Знач Текст, ИменаПоUUID)
	
	// Фрагменты вида: {uuid,"RefName","Description",...
	Позиция = 1;
	Длина = СтрДлина(Текст);
	
	Пока Позиция <= Длина Цикл
		
		ПозицияUUID = НайтиUUIDВТекстеСПозиции(Текст, Позиция);
		Если ПозицияUUID = 0 Тогда
			Прервать;
		КонецЕсли;
		
		UUID = Сред(Текст, ПозицияUUID, 36);
		ПослеUUID = ПозицияUUID + 36;
		Если ПослеUUID + 2 > Длина Или Сред(Текст, ПослеUUID, 2) <> ",""" Тогда
			Позиция = ПозицияUUID + 1;
			Продолжить;
		КонецЕсли;
		
		НачалоИмени = ПослеUUID + 2;
		КонецИмени = СтрНайти(Текст, """", НаправлениеПоиска.СНачала, НачалоИмени);
		Если КонецИмени = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ИмяИБИзClst = Сред(Текст, НачалоИмени, КонецИмени - НачалоИмени);
		Если Не ПустаяСтрока(ИмяИБИзClst) Тогда
			ИменаПоUUID.Вставить(НРег(UUID), ИмяИБИзClst);
		КонецЕсли;
		
		Позиция = КонецИмени + 1;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НайтиUUIDВТекстеСПозиции(Знач Текст, Знач ПозицияСтарта)
	
	Длина = СтрДлина(Текст);
	Позиция = ПозицияСтарта;
	
	Пока Позиция <= Длина - 35 Цикл
		
		Фрагмент = Сред(Текст, Позиция, 36);
		Если ЭтоСтрокаUUID(Фрагмент) Тогда
			Возврат Позиция;
		КонецЕсли;
		Позиция = Позиция + 1;
		
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоСтрокаUUID(Знач Значение)
	
	Если СтрДлина(Значение) <> 36 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Сред(Значение, 9, 1) <> "-" Или Сред(Значение, 14, 1) <> "-"
		Или Сред(Значение, 19, 1) <> "-" Или Сред(Значение, 24, 1) <> "-" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = 1 По 36 Цикл
		Если Индекс = 9 Или Индекс = 14 Или Индекс = 19 Или Индекс = 24 Тогда
			Продолжить;
		КонецЕсли;
		Символ = НРег(Сред(Значение, Индекс, 1));
		Если СтрНайти("0123456789abcdef", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИзвлечьUUIDИзПутиЖР(Знач ПутьКЖР)
	
	Норм = СтрЗаменить(ПутьКЖР, "/", "\");
	Пока СтрЗаканчиваетсяНа(Норм, "\") Цикл
		Норм = Лев(Норм, СтрДлина(Норм) - 1);
	КонецЦикла;
	
	Части = СтрРазделить(Норм, "\", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	
	Если ВРег(Части[Части.ВГраница()]) <> ВРег(ИмяКаталогаЖР()) Тогда
		Возврат "";
	КонецЕсли;
	
	КандидатUUID = Части[Части.ВГраница() - 1];
	Если ЭтоСтрокаUUID(КандидатUUID) Тогда
		Возврат КандидатUUID;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СловарьLgf

&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьСловарьLgf(ПутьКФайлу)
	
	Результат = НовыйСловарьLgf();
	Чтение = ОткрытьЧтениеЖурнала(ПутьКФайлу);
	
	НомерСтроки = 0;
	БуферЗаписи = "";
	Глубина = 0;
	ВКавычках = Ложь;
	
	Пока Истина Цикл
		
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		Если НомерСтроки = 1 Тогда
			Результат.Версия = СокрЛП(СтрокаФайла);
			Продолжить;
		ИначеЕсли НомерСтроки = 2 Тогда
			Результат.GUID = СокрЛП(СтрокаФайла);
			Продолжить;
		КонецЕсли;
		
		Если Глубина = 0 И ПустаяСтрока(БуферЗаписи) И ПустаяСтрока(СтрокаФайла) Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках);
		
		Если Глубина = 0 И Не ПустаяСтрока(БуферЗаписи) Тогда
			ДобавитьЗаписьСловаряИзСтроки(Результат, БуферЗаписи);
			БуферЗаписи = "";
		КонецЕсли;
		
	КонецЦикла;
	
	Чтение.Закрыть();
	
	Если СтрНайти(Результат.Версия, МаркерФорматаЖР()) = 0 Тогда
		ВызватьИсключение "Файл не похож на словарь журнала регистрации: " + ПутьКФайлу;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НовыйСловарьLgf()
	
	Результат = Новый Структура;
	Результат.Вставить("Версия", "");
	Результат.Вставить("GUID", "");
	Результат.Вставить("ПоНомеру", Новый Соответствие);
	Результат.Вставить("ПоКлючу", Новый Соответствие);
	Результат.Вставить("МаксНомер", Новый Соответствие);
	Результат.Вставить("Количество", 0);
	
	Для ТипОбъекта = 1 По МаксимальныйТипОбъектаСловаря() Цикл
		Результат.ПоНомеру.Вставить(ТипОбъекта, Новый Соответствие);
		Результат.ПоКлючу.Вставить(ТипОбъекта, Новый Соответствие);
		Результат.МаксНомер.Вставить(ТипОбъекта, 0);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьЗаписьСловаряИзСтроки(Словарь, Знач СтрокаФайла)
	
	СтрокаФайла = УбратьХвостовуюЗапятую(СокрЛП(СтрокаФайла));
	Если Не ЭтоСкобочнаяЗапись(СтрокаФайла) Тогда
		Возврат;
	КонецЕсли;
	
	Токены = Токенизировать(ТелоСкобочнойЗаписи(СтрокаФайла));
	Если Токены.Количество() < 3 Тогда
		Возврат;
	КонецЕсли;
	
	ТипОбъекта = ЧислоИзТокена(Токены[0]);
	Номер = ЧислоИзТокена(Токены[Токены.ВГраница()]);
	Если ТипОбъекта < 1 Или ТипОбъекта > МаксимальныйТипОбъектаСловаря() Или Номер <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	Описание = Новый Структура("ТипОбъекта,Номер,Имя,UUID,Ключ", ТипОбъекта, Номер, "", "", "");
	Если ЭтоТипСUUID(ТипОбъекта) И Токены.Количество() >= 4 Тогда
		Описание.UUID = СнятьКавычки(Токены[1]);
		Описание.Имя = СнятьКавычки(Токены[2]);
		Описание.Ключ = НРег(Описание.UUID);
		Если ПустаяСтрока(Описание.Ключ) Тогда
			Описание.Ключ = НРег(Описание.Имя);
		КонецЕсли;
	Иначе
		Описание.Имя = СнятьКавычки(Токены[1]);
		Описание.Ключ = НРег(Описание.Имя);
	КонецЕсли;
	
	Если ПустаяСтрока(Описание.Ключ) Тогда
		Возврат;
	КонецЕсли;
	
	Словарь.ПоНомеру.Получить(ТипОбъекта).Вставить(Номер, Описание);
	Словарь.ПоКлючу.Получить(ТипОбъекта).Вставить(Описание.Ключ, Номер);
	Если Номер > Словарь.МаксНомер.Получить(ТипОбъекта) Тогда
		Словарь.МаксНомер.Вставить(ТипОбъекта, Номер);
	КонецЕсли;
	Словарь.Количество = Словарь.Количество + 1;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПостроитьКартыПеренумерации(СловарьИсточника, СловарьПриемника)
	
	Карты = Новый Соответствие;
	ДобавленныеСтроки = Новый Массив;
	НужнаПеренумерация = Ложь;
	
	Для ТипОбъекта = 1 По МаксимальныйТипОбъектаСловаря() Цикл
		
		Карта = Новый Соответствие;
		Карты.Вставить(ТипОбъекта, Карта);
		МаксНомер = СловарьПриемника.МаксНомер.Получить(ТипОбъекта);
		ИсточникПоНомеру = СловарьИсточника.ПоНомеру.Получить(ТипОбъекта);
		ПриемникПоКлючу = СловарьПриемника.ПоКлючу.Получить(ТипОбъекта);
		
		Для Каждого Пара Из ИсточникПоНомеру Цикл
			
			СтарыйНомер = Пара.Ключ;
			Описание = Пара.Значение;
			НовыйНомер = ПриемникПоКлючу.Получить(Описание.Ключ);
			
			Если НовыйНомер = Неопределено Тогда
				МаксНомер = МаксНомер + 1;
				НовыйНомер = МаксНомер;
				ДобавленныеСтроки.Добавить(СформироватьСтрокуСловаря(Описание, НовыйНомер));
				ПриемникПоКлючу.Вставить(Описание.Ключ, НовыйНомер);
			КонецЕсли;
			
			Карта.Вставить(СтарыйНомер, НовыйНомер);
			Если НовыйНомер <> СтарыйНомер Тогда
				НужнаПеренумерация = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		СловарьПриемника.МаксНомер.Вставить(ТипОбъекта, МаксНомер);
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("Карты", Карты);
	Результат.Вставить("ДобавленныеСтроки", ДобавленныеСтроки);
	Результат.Вставить("НужнаПеренумерация", НужнаПеренумерация);
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьСтрокуСловаря(Описание, Номер)
	
	НомерСтрокой = ФорматЧислаПротокола(Номер);
	ТипСтрокой = ФорматЧислаПротокола(Описание.ТипОбъекта);
	
	// Нативный lgf: UUID типов 1/5 без кавычек; имя — в кавычках.
	Если ЭтоТипСUUID(Описание.ТипОбъекта) Тогда
		Если ПустаяСтрока(Описание.UUID) Тогда
			ЧастьUUID = """""";
		Иначе
			ЧастьUUID = Описание.UUID;
		КонецЕсли;
		Возврат "{" + ТипСтрокой + "," + ЧастьUUID + ","""
			+ ЭкранироватьКавычки(Описание.Имя) + """," + НомерСтрокой + "},";
	КонецЕсли;
	
	// Порты 7/8: нативно без кавычек — {7,1560,1}; с кавычками платформа даёт «Ошибка формата потока».
	Если Описание.ТипОбъекта = ТипОбъектаГлавныеПорты()
		Или Описание.ТипОбъекта = ТипОбъектаДопПорты() Тогда
		Возврат "{" + ТипСтрокой + "," + Описание.Имя + "," + НомерСтрокой + "},";
	КонецЕсли;
	
	Возврат "{" + ТипСтрокой + ",""" + ЭкранироватьКавычки(Описание.Имя) + """," + НомерСтрокой + "},";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДописатьСтрокиВLgf(ПутьКФайлу, ДобавленныеСтроки)
	
	// Сырой UTF-8+BOM: ТекстовыйДокумент может переписать существующие строки словаря.
	Текст = ПрочитатьСыройТекстЖурналаUTF8(ПутьКФайлу);
	Разрыв = РазрывСтрокИзФрагмента(Текст);
	Если ПустаяСтрока(Разрыв) Тогда
		Разрыв = РазрывСтрокЗаголовкаLgp();
	КонецЕсли;
	
	СтрокиФайла = СтрРазделить(Текст, Разрыв, Истина);
	Пока СтрокиФайла.Количество() > 0
		И ПустаяСтрока(СокрЛП(СтрокиФайла[СтрокиФайла.ВГраница()])) Цикл
		СтрокиФайла.Удалить(СтрокиФайла.ВГраница());
	КонецЦикла;
	
	Если СтрокиФайла.Количество() > 0 Тогда
		ИндексПоследней = СтрокиФайла.ВГраница();
		Последняя = СокрЛП(СтрокиФайла[ИндексПоследней]);
		Если Не ПустаяСтрока(Последняя) И Не СтрЗаканчиваетсяНа(Последняя, ",") Тогда
			СтрокиФайла[ИндексПоследней] = СтрокиФайла[ИндексПоследней] + ",";
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого СтрокаСловаря Из ДобавленныеСтроки Цикл
		СтрокиФайла.Добавить(СтрокаСловаря);
	КонецЦикла;
	
	// Нативный формат: у последней записи словаря нет хвостовой запятой.
	УбратьХвостовуюЗапятуюПоследнейСтрокиМассива(СтрокиФайла);
	
	ЗаписатьСыройТекстЖурналаUTF8(ПутьКФайлу, СтрСоединить(СтрокиФайла, Разрыв));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УбратьХвостовуюЗапятуюПоследнейСтрокиМассива(СтрокиФайла)
	
	Индекс = СтрокиФайла.ВГраница();
	Пока Индекс >= 0 И ПустаяСтрока(СокрЛП(СтрокиФайла[Индекс])) Цикл
		Индекс = Индекс - 1;
	КонецЦикла;
	
	Если Индекс < 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрЗаканчиваетсяНа(СокрЛП(СтрокиФайла[Индекс]), ",") Тогда
		СтрокиФайла[Индекс] = УбратьХвостовуюЗапятую(СокрЛП(СтрокиФайла[Индекс]));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ФайлыLgp

&НаКлиентеНаСервереБезКонтекста
Процедура ПрисоединитьФайлLgp(ПутьИсточника, ПутьПриемника, СловарьПриемника, Карты, Объединять, НужнаПеренумерация, СведенияОтладки = Неопределено)
	
	Если Не Объединять И Не НужнаПеренумерация Тогда
		ЗаголовокИсточника = ПрочитатьЗаголовокLgp(ПутьИсточника);
		Если ВРег(СокрЛП(ЗаголовокИсточника.GUID)) <> ВРег(СокрЛП(СловарьПриемника.GUID))
			Или ЗаголовокИсточника.Версия <> СловарьПриемника.Версия Тогда
			Если СведенияОтладки <> Неопределено Тогда
				СведенияОтладки.Вставить("Ветка", "copy_header");
			КонецЕсли;
			СкопироватьLgpСЗаголовкомПриемника(
				ПутьИсточника,
				ПутьПриемника,
				СловарьПриемника.Версия,
				СловарьПриемника.GUID);
		Иначе
			Если СведенияОтладки <> Неопределено Тогда
				СведенияОтладки.Вставить("Ветка", "copy_raw");
			КонецЕсли;
			КопироватьФайлСЗаменой(ПутьИсточника, ПутьПриемника);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	СтатистикаВыгрузки = Неопределено;
	Если СведенияОтладки <> Неопределено Тогда
		Если Объединять Тогда
			СведенияОтладки.Вставить("Ветка", ?(НужнаПеренумерация, "merge+renumber", "merge"));
		Иначе
			СведенияОтладки.Вставить("Ветка", ?(НужнаПеренумерация, "rewrite+renumber", "rewrite"));
		КонецЕсли;
		СтатистикаВыгрузки = Новый Структура("Записей,Однострочных,Многострочных", 0, 0, 0);
	КонецЕсли;
	
	// Сырой текст: внутри кавычек платформа пишет LF, между структурными строками — CRLF.
	// ЗаписьТекста/ЗаписатьСтроку это различие уничтожает → «Ошибка формата потока».
	// Префикс пишем сразу; тело дописываем пакетами без BOM, чтобы не держать source+result целиком.
	Если Объединять И ФайлСуществует(ПутьПриемника) Тогда
		ТекстПрефикса = ТекстLgpПриемникаСЗапятойНаПоследнейЗаписи(ПутьПриемника);
	Иначе
		Разрыв = РазрывСтрокЗаголовкаLgp();
		ТекстПрефикса = СловарьПриемника.Версия + Разрыв
			+ СловарьПриемника.GUID + Разрыв
			+ Разрыв;
	КонецЕсли;
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("lgp");
	ЗаписатьСыройТекстЖурналаUTF8(ВременныйФайл, ТекстПрефикса);
	ДописатьЗаписиLgpИзФайла(ПутьИсточника, ВременныйФайл, Карты, НужнаПеренумерация, СтатистикаВыгрузки);
	
	Если СтатистикаВыгрузки <> Неопределено Тогда
		СведенияОтладки.Вставить("Статистика", СтатистикаВыгрузки);
	КонецЕсли;
	
	КопироватьФайлСЗаменой(ВременныйФайл, ПутьПриемника);
	УдалитьФайлы(ВременныйФайл);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьЗаголовокLgp(ПутьКФайлу)
	
	Результат = Новый Структура("Версия,GUID", "", "");
	Чтение = ОткрытьЧтениеЖурнала(ПутьКФайлу);
	СтрокаВерсии = Чтение.ПрочитатьСтроку();
	СтрокаGUID = Чтение.ПрочитатьСтроку();
	Чтение.Закрыть();
	
	Если СтрокаВерсии <> Неопределено Тогда
		Результат.Версия = СокрЛП(СтрокаВерсии);
	КонецЕсли;
	Если СтрокаGUID <> Неопределено Тогда
		Результат.GUID = СокрЛП(СтрокаGUID);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура СкопироватьLgpСЗаголовкомПриемника(ПутьИсточника, ПутьПриемника, ВерсияПриемника, GUIDПриемника)
	
	ТекстИсточника = ПрочитатьСыройТекстЖурналаUTF8(ПутьИсточника);
	Части = РазделитьЗаголовокИТелоLgp(ТекстИсточника);
	Разрыв = РазрывСтрокИзФрагмента(Части.Заголовок);
	Если ПустаяСтрока(Разрыв) Тогда
		Разрыв = РазрывСтрокЗаголовкаLgp();
	КонецЕсли;
	
	НовыйЗаголовок = ВерсияПриемника + Разрыв + GUIDПриемника + Разрыв + Разрыв;
	ЗаписатьСыройТекстЖурналаUTF8(ПутьПриемника, НовыйЗаголовок + Части.Тело);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТекстLgpПриемникаСЗапятойНаПоследнейЗаписи(ПутьПриемника)
	
	Текст = ПрочитатьСыройТекстЖурналаUTF8(ПутьПриемника);
	Части = РазделитьЗаголовокИТелоLgp(Текст);
	Заголовок = Части.Заголовок;
	Тело = Части.Тело;
	
	// Битый приёмник без пустой после GUID (до 1.3.4) — восстанавливаем.
	Если Не ЗаголовокСодержитПустуюСтрокуПослеGUID(Заголовок)
		И СтрДлина(СокрЛП(Тело)) > 0
		И СтрНачинаетсяС(СокрЛП(Тело), "{") Тогда
		Разрыв = РазрывСтрокИзФрагмента(Заголовок);
		Если ПустаяСтрока(Разрыв) Тогда
			Разрыв = РазрывСтрокЗаголовкаLgp();
		КонецЕсли;
		Заголовок = Заголовок + Разрыв;
	КонецЕсли;
	
	Возврат Заголовок + ТекстТелаLgpСЗапятойНаПоследнейЗаписи(Тело);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТекстТелаLgpСЗапятойНаПоследнейЗаписи(Тело)
	
	Если ПустаяСтрока(Тело) Тогда
		Возврат Тело;
	КонецЕсли;
	
	НачалоПоследней = 0;
	КонецПоследней = 0;
	Глубина = 0;
	ВКавычках = Ложь;
	Индекс = 1;
	Длина = СтрДлина(Тело);
	НачалоТекущей = 0;
	
	Пока Индекс <= Длина Цикл
		Символ = Сред(Тело, Индекс, 1);
		Если ВКавычках Тогда
			Если Символ = """" Тогда
				Если Сред(Тело, Индекс + 1, 1) = """" Тогда
					Индекс = Индекс + 2;
					Продолжить;
				КонецЕсли;
				ВКавычках = Ложь;
			КонецЕсли;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		
		Если Символ = """" Тогда
			ВКавычках = Истина;
			Индекс = Индекс + 1;
			Продолжить;
		ИначеЕсли Символ = "{" Тогда
			Если Глубина = 0 Тогда
				НачалоТекущей = Индекс;
			КонецЕсли;
			Глубина = Глубина + 1;
			Индекс = Индекс + 1;
			Продолжить;
		ИначеЕсли Символ = "}" Тогда
			Глубина = Глубина - 1;
			Индекс = Индекс + 1;
			Если Глубина = 0 Тогда
				КонецЗаписи = Индекс;
				Если КонецЗаписи <= Длина И Сред(Тело, КонецЗаписи, 1) = "," Тогда
					КонецЗаписи = КонецЗаписи + 1;
				КонецЕсли;
				НачалоПоследней = НачалоТекущей;
				КонецПоследней = КонецЗаписи;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Если НачалоПоследней = 0 Тогда
		Возврат Тело;
	КонецЕсли;
	
	Запись = Сред(Тело, НачалоПоследней, КонецПоследней - НачалоПоследней);
	Запись = ОбеспечитьХвостовуюЗапятуюВЗаписиLgp(Запись);
	Возврат Лев(Тело, НачалоПоследней - 1) + Запись + Сред(Тело, КонецПоследней);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДописатьЗаписиLgpИзФайла(ПутьИсточника, ПутьДляДописывания, Карты, Перенумеровывать, СтатистикаВыгрузки = Неопределено)
	
	ТекстИсточника = ПрочитатьСыройТекстЖурналаUTF8(ПутьИсточника);
	ЧастиФайла = РазделитьЗаголовокИТелоLgp(ТекстИсточника);
	Тело = ЧастиФайла.Тело;
	
	Части = Новый Массив;
	РазмерПакетаЗаписей = 3000;
	ЗаписейВПакете = 0;
	ОтложеннаяЗапись = "";
	ОтложенныйПрефикс = "";
	ЕстьОтложеннаяЗапись = Ложь;
	СчетчикЗаписей = 0;
	
	Глубина = 0;
	ВКавычках = Ложь;
	Индекс = 1;
	Длина = СтрДлина(Тело);
	НачалоЗаписи = 0;
	НачалоПромежутка = 1;
	
	Пока Индекс <= Длина Цикл
		Символ = Сред(Тело, Индекс, 1);
		Если ВКавычках Тогда
			Если Символ = """" Тогда
				Если Сред(Тело, Индекс + 1, 1) = """" Тогда
					Индекс = Индекс + 2;
					Продолжить;
				КонецЕсли;
				ВКавычках = Ложь;
			КонецЕсли;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		
		Если Символ = """" Тогда
			ВКавычках = Истина;
			Индекс = Индекс + 1;
			Продолжить;
		ИначеЕсли Символ = "{" Тогда
			Если Глубина = 0 Тогда
				НачалоЗаписи = Индекс;
			КонецЕсли;
			Глубина = Глубина + 1;
			Индекс = Индекс + 1;
			Продолжить;
		ИначеЕсли Символ = "}" Тогда
			Глубина = Глубина - 1;
			Индекс = Индекс + 1;
			Если Глубина = 0 Тогда
				КонецЗаписи = Индекс;
				Если КонецЗаписи <= Длина И Сред(Тело, КонецЗаписи, 1) = "," Тогда
					КонецЗаписи = КонецЗаписи + 1;
				КонецЕсли;
				
				Префикс = Сред(Тело, НачалоПромежутка, НачалоЗаписи - НачалоПромежутка);
				БуферЗаписи = Сред(Тело, НачалоЗаписи, КонецЗаписи - НачалоЗаписи);
				ТекстЗаписи = ПодготовитьТекстЗаписиLgp(БуферЗаписи, Карты, Перенумеровывать);
				НачалоПромежутка = КонецЗаписи;
				
				Если ПустаяСтрока(ТекстЗаписи) Тогда
					Продолжить;
				КонецЕсли;
				
				Если ЕстьОтложеннаяЗапись Тогда
					Части.Добавить(ОтложенныйПрефикс);
					Части.Добавить(ОбеспечитьХвостовуюЗапятуюВЗаписиLgp(ОтложеннаяЗапись));
					ЗаписейВПакете = ЗаписейВПакете + 1;
					Если ЗаписейВПакете >= РазмерПакетаЗаписей Тогда
						ДописатьСыройТекстЖурналаUTF8БезBOM(ПутьДляДописывания, СтрСоединить(Части, ""));
						Части.Очистить();
						ЗаписейВПакете = 0;
					КонецЕсли;
				КонецЕсли;
				ОтложеннаяЗапись = ТекстЗаписи;
				ОтложенныйПрефикс = Префикс;
				ЕстьОтложеннаяЗапись = Истина;
				
				СчетчикЗаписей = СчетчикЗаписей + 1;
				Если СтатистикаВыгрузки <> Неопределено Тогда
					СтатистикаВыгрузки.Записей = СтатистикаВыгрузки.Записей + 1;
					Если СтрНайти(ТекстЗаписи, Символы.ПС) > 0 Или СтрНайти(ТекстЗаписи, Символы.ВК) > 0 Тогда
						СтатистикаВыгрузки.Многострочных = СтатистикаВыгрузки.Многострочных + 1;
					Иначе
						СтатистикаВыгрузки.Однострочных = СтатистикаВыгрузки.Однострочных + 1;
					КонецЕсли;
				КонецЕсли;
				Если СчетчикЗаписей % 2000 = 0 Тогда
					#Если Клиент Тогда
					ОбработкаПрерыванияПользователя();
					Состояние("Перенумерация записей: " + Формат(СчетчикЗаписей, "ЧГ=0"));
					#КонецЕсли
				КонецЕсли;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Если ЕстьОтложеннаяЗапись Тогда
		Части.Добавить(ОтложенныйПрефикс);
		Части.Добавить(УбратьХвостовуюЗапятуюВЗаписиLgp(ОтложеннаяЗапись));
	КонецЕсли;
	Если НачалоПромежутка <= Длина Тогда
		Части.Добавить(Сред(Тело, НачалоПромежутка));
	КонецЕсли;
	
	Если Части.Количество() > 0 Тогда
		ДописатьСыройТекстЖурналаUTF8БезBOM(ПутьДляДописывания, СтрСоединить(Части, ""));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПодготовитьТекстЗаписиLgp(БуферЗаписи, Карты, Перенумеровывать)
	
	ТекстЗаписи = БуферЗаписи;
	Если ПустаяСтрока(СокрЛП(ТекстЗаписи)) Или СокрЛП(ТекстЗаписи) = "," Тогда
		Возврат "";
	КонецЕсли;
	
	СжатыйПрефикс = СокрЛ(ТекстЗаписи);
	Если СтрНачинаетсяС(СжатыйПрефикс, ",") Тогда
		ТекстЗаписи = СокрЛ(Сред(СжатыйПрефикс, 2));
	КонецЕсли;
	Если Перенумеровывать Тогда
		ТекстЗаписи = ПеренумероватьЗаписьLgpСохраняяСтроки(ТекстЗаписи, Карты);
	КонецЕсли;
	
	Возврат ТекстЗаписи;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках)
	
	Если Не ПустаяСтрока(БуферЗаписи) Тогда
		БуферЗаписи = БуферЗаписи + Символы.ПС;
	КонецЕсли;
	БуферЗаписи = БуферЗаписи + СтрокаФайла;
	
	ОбновитьСостояниеСкобокИКавычек(СтрокаФайла, Глубина, ВКавычках);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьСостояниеСкобокИКавычек(СтрокаФайла, Глубина, ВКавычках)
	
	Индекс = 1;
	Длина = СтрДлина(СтрокаФайла);
	Пока Индекс <= Длина Цикл
		Символ = Сред(СтрокаФайла, Индекс, 1);
		Если ВКавычках Тогда
			Если Символ = """" Тогда
				Если Сред(СтрокаФайла, Индекс + 1, 1) = """" Тогда
					Индекс = Индекс + 2;
					Продолжить;
				КонецЕсли;
				ВКавычках = Ложь;
			КонецЕсли;
		ИначеЕсли Символ = """" Тогда
			ВКавычках = Истина;
		ИначеЕсли Символ = "{" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = "}" Тогда
			Глубина = Глубина - 1;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПеренумероватьЗаписьLgp(ТекстЗаписи, Карты)
	
	Сжатая = СокрЛП(ТекстЗаписи);
	ХвостоваяЗапятая = СтрЗаканчиваетсяНа(Сжатая, ",");
	Если ХвостоваяЗапятая Тогда
		Сжатая = УбратьХвостовуюЗапятую(Сжатая);
	КонецЕсли;
	Если Не ЭтоСкобочнаяЗапись(Сжатая) Тогда
		Возврат ТекстЗаписи;
	КонецЕсли;
	
	Токены = Токенизировать(ТелоСкобочнойЗаписи(Сжатая));
	НовыеТокены = ПеренумероватьТокеныЗаписиLgp(Токены, Карты);
	
	Результат = "{" + СтрСоединить(НовыеТокены, ",") + "}";
	Если ХвостоваяЗапятая Тогда
		Результат = Результат + ",";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПеренумероватьЗаписьLgpСохраняяСтроки(БуферЗаписи, Карты)
	
	РазборСтрок = СобратьПлоскийТекстИПереносы(БуферЗаписи);
	Плоский = РазборСтрок.Плоский;
	ПозицииПереносов = РазборСтрок.ПозицииПереносов;
	
	Сжатая = СокрЛП(Плоский);
	ХвостоваяЗапятая = СтрЗаканчиваетсяНа(Сжатая, ",");
	Если ХвостоваяЗапятая Тогда
		Сжатая = УбратьХвостовуюЗапятую(Сжатая);
	КонецЕсли;
	Если Не ЭтоСкобочнаяЗапись(Сжатая) Тогда
		Возврат БуферЗаписи;
	КонецЕсли;
	
	Токены = Токенизировать(ТелоСкобочнойЗаписи(Сжатая));
	НовыеТокены = ПеренумероватьТокеныЗаписиLgp(Токены, Карты);
	
	Позиция = 2;
	Для Индекс = 0 По Токены.ВГраница() Цикл
		ДлинаСтарого = СтрДлина(Токены[Индекс]);
		Дельта = СтрДлина(НовыеТокены[Индекс]) - ДлинаСтарого;
		Если Дельта <> 0 Тогда
			СкорректироватьПозицииПереносов(ПозицииПереносов, Позиция + ДлинаСтарого, Дельта);
		КонецЕсли;
		Позиция = Позиция + ДлинаСтарого + 1;
	КонецЦикла;
	
	НовыйПлоский = "{" + СтрСоединить(НовыеТокены, ",") + "}";
	Если ХвостоваяЗапятая Тогда
		НовыйПлоский = НовыйПлоский + ",";
	КонецЕсли;
	
	Возврат ВставитьПереносыСтрок(НовыйПлоский, ПозицииПереносов);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПеренумероватьТокеныЗаписиLgp(Токены, Карты)
	
	НовыеТокены = Новый Массив;
	Для Индекс = 0 По Токены.ВГраница() Цикл
		НовыеТокены.Добавить(Токены[Индекс]);
	КонецЦикла;
	
	ВерхняяГраницаТокенов = НовыеТокены.ВГраница();
	Для Каждого ПолеСсылки Из ПоляСсылокЗаписиLgp() Цикл
		// ИндексПоля — 0-based; доступен только при ИндексПоля <= ВГраница().
		Если ПолеСсылки.ИндексПоля > ВерхняяГраницаТокенов Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПолеСсылки.Составное Тогда
			НовыеТокены[ПолеСсылки.ИндексПоля] = ПеренумероватьСоставноеПоле(
				НовыеТокены[ПолеСсылки.ИндексПоля],
				Карты.Получить(ПолеСсылки.ТипОбъекта));
		Иначе
			НовыеТокены[ПолеСсылки.ИндексПоля] = ЗаменитьНомерПоТипу(
				НовыеТокены[ПолеСсылки.ИндексПоля],
				Карты,
				ПолеСсылки.ТипОбъекта);
		КонецЕсли;
	КонецЦикла;
	
	Возврат НовыеТокены;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СобратьПлоскийТекстИПереносы(БуферЗаписи)
	
	// Храним тип разрыва: LF / CRLF / CR — иначе CR из CRLF попадает в плоский текст и ломает токены.
	// Фрагменты между разрывами копируем целиком (Сред), без склейки по символу.
	Фрагменты = Новый Массив;
	ПозицииПереносов = Новый Массив;
	ДлинаПлоского = 0;
	НачалоФрагмента = 1;
	Индекс = 1;
	Длина = СтрДлина(БуферЗаписи);
	Пока Индекс <= Длина Цикл
		Символ = Сред(БуферЗаписи, Индекс, 1);
		Если Символ = Символы.ВК Тогда
			Если НачалоФрагмента < Индекс Тогда
				ДлинаКуска = Индекс - НачалоФрагмента;
				Фрагменты.Добавить(Сред(БуферЗаписи, НачалоФрагмента, ДлинаКуска));
				ДлинаПлоского = ДлинаПлоского + ДлинаКуска;
			КонецЕсли;
			Если Сред(БуферЗаписи, Индекс + 1, 1) = Символы.ПС Тогда
				ПозицииПереносов.Добавить(Новый Структура("Позиция,Разрыв",
					ДлинаПлоского, Символы.ВК + Символы.ПС));
				Индекс = Индекс + 2;
			Иначе
				ПозицииПереносов.Добавить(Новый Структура("Позиция,Разрыв",
					ДлинаПлоского, Символы.ВК));
				Индекс = Индекс + 1;
			КонецЕсли;
			НачалоФрагмента = Индекс;
		ИначеЕсли Символ = Символы.ПС Тогда
			Если НачалоФрагмента < Индекс Тогда
				ДлинаКуска = Индекс - НачалоФрагмента;
				Фрагменты.Добавить(Сред(БуферЗаписи, НачалоФрагмента, ДлинаКуска));
				ДлинаПлоского = ДлинаПлоского + ДлинаКуска;
			КонецЕсли;
			ПозицииПереносов.Добавить(Новый Структура("Позиция,Разрыв",
				ДлинаПлоского, Символы.ПС));
			Индекс = Индекс + 1;
			НачалоФрагмента = Индекс;
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если НачалоФрагмента <= Длина Тогда
		Фрагменты.Добавить(Сред(БуферЗаписи, НачалоФрагмента));
	КонецЕсли;
	
	Возврат Новый Структура("Плоский,ПозицииПереносов", СтрСоединить(Фрагменты, ""), ПозицииПереносов);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура СкорректироватьПозицииПереносов(ПозицииПереносов, Порог, Дельта)
	
	Для Индекс = 0 По ПозицииПереносов.ВГраница() Цикл
		Описание = ПозицииПереносов[Индекс];
		Если Описание.Позиция >= Порог Тогда
			Описание.Позиция = Описание.Позиция + Дельта;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВставитьПереносыСтрок(Плоский, ПозицииПереносов)
	
	Если ПозицииПереносов.Количество() = 0 Тогда
		Возврат Плоский;
	КонецЕсли;
	
	Части = Новый Массив;
	ДлинаПлоского = СтрДлина(Плоский);
	ПредыдущаяПозиция = 0;
	
	Для Индекс = 0 По ПозицииПереносов.ВГраница() Цикл
		Описание = ПозицииПереносов[Индекс];
		Позиция = Описание.Позиция;
		Если Позиция < ПредыдущаяПозиция Или Позиция > ДлинаПлоского Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить(Сред(Плоский, ПредыдущаяПозиция + 1, Позиция - ПредыдущаяПозиция));
		Части.Добавить(Описание.Разрыв);
		ПредыдущаяПозиция = Позиция;
	КонецЦикла;
	
	Части.Добавить(Сред(Плоский, ПредыдущаяПозиция + 1));
	Возврат СтрСоединить(Части, "");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаменитьНомерПоТипу(Токен, Карты, ТипОбъекта)
	
	Карта = Карты.Получить(ТипОбъекта);
	Если Карта = Неопределено Тогда
		Возврат Токен;
	КонецЕсли;
	
	Возврат ЗаменитьНомер(Токен, Карта);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаменитьНомер(Токен, Карта)
	
	Значение = СокрЛП(Токен);
	Номер = ЧислоИзТокена(Значение);
	Если Номер <= 0 Тогда
		Возврат Токен;
	КонецЕсли;
	
	НовыйНомер = Карта.Получить(Номер);
	Если НовыйНомер = Неопределено Тогда
		Возврат Токен;
	КонецЕсли;
	
	Возврат ФорматЧислаПротокола(НовыйНомер);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПеренумероватьСоставноеПоле(Токен, Карта)
	
	Если Карта = Неопределено Тогда
		Возврат Токен;
	КонецЕсли;
	
	Значение = СокрЛП(Токен);
	Если Не СтрНачинаетсяС(Значение, "{") Тогда
		Возврат ЗаменитьНомер(Токен, Карта);
	КонецЕсли;
	Если Не СтрЗаканчиваетсяНа(Значение, "}") Тогда
		Возврат Токен;
	КонецЕсли;
	
	Части = Токенизировать(ТелоСкобочнойЗаписи(Значение));
	Для Индекс = 0 По Части.ВГраница() Цикл
		Части[Индекс] = ЗаменитьНомер(Части[Индекс], Карта);
	КонецЦикла;
	
	Возврат "{" + СтрСоединить(Части, ",") + "}";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура КопироватьФайлСЗаменой(Источник, Приемник)
	
	Если ФайлСуществует(Приемник) Тогда
		УдалитьФайлы(Приемник);
	КонецЕсли;
	КопироватьФайл(Источник, Приемник);
	
КонецПроцедуры

#КонецОбласти

#Область РазборТекста

&НаКлиентеНаСервереБезКонтекста
Функция КодировкаТекстаЖурнала(ПутьКФайлу)
	
	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ПерваяСтрока = Чтение.ПрочитатьСтроку();
	Чтение.Закрыть();
	
	Кодировка = КодировкаТекста.UTF8;
	Если ПерваяСтрока <> Неопределено И СтрНайти(ПерваяСтрока, МаркерФорматаЖР()) = 0 Тогда
		Кодировка = КодировкаТекста.UTF16;
	КонецЕсли;
	
	Возврат Кодировка;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОткрытьЧтениеЖурнала(ПутьКФайлу)
	
	Возврат Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекстаЖурнала(ПутьКФайлу));
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьСыройТекстЖурналаUTF8(ПутьКФайлу)
	
	Данные = Новый ДвоичныеДанные(ПутьКФайлу);
	Текст = ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
	// BOM UTF-8 (EF BB BF) после декодирования часто остаётся как U+FEFF.
	Если СтрДлина(Текст) > 0 И КодСимвола(Лев(Текст, 1)) = 65279 Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаписатьСыройТекстЖурналаUTF8(ПутьКФайлу, Текст)
	
	// Нативные .lgp/.lgf: UTF-8 с BOM EF BB BF.
	Данные = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина);
	Данные.Записать(ПутьКФайлу);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДописатьСыройТекстЖурналаUTF8БезBOM(ПутьКФайлу, Текст)
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	
	Поток = Неопределено;
	Запись = Неопределено;
	Попытка
		Поток = ФайловыеПотоки.ОткрытьДляДописывания(ПутьКФайлу);
		Запись = Новый ЗаписьДанных(Поток);
		Буфер = ПолучитьБуферДвоичныхДанныхИзСтроки(Текст, КодировкаТекста.UTF8);
		Запись.ЗаписатьБуферДвоичныхДанных(Буфер);
	Исключение
		Если Запись <> Неопределено Тогда
			Запись.Закрыть();
		КонецЕсли;
		Если Поток <> Неопределено Тогда
			Поток.Закрыть();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
	Запись.Закрыть();
	Поток.Закрыть();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РазрывСтрокЗаголовкаLgp()
	
	Возврат Символы.ВК + Символы.ПС;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РазрывСтрокИзФрагмента(Фрагмент)
	
	Если СтрНайти(Фрагмент, Символы.ВК + Символы.ПС) > 0 Тогда
		Возврат Символы.ВК + Символы.ПС;
	ИначеЕсли СтрНайти(Фрагмент, Символы.ПС) > 0 Тогда
		Возврат Символы.ПС;
	ИначеЕсли СтрНайти(Фрагмент, Символы.ВК) > 0 Тогда
		Возврат Символы.ВК;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РазделитьЗаголовокИТелоLgp(Текст)
	
	// Три логические строки: версия, GUID, пустая — с исходными разрывами.
	Позиция = 1;
	НомерСтроки = 0;
	Длина = СтрДлина(Текст);
	Пока Позиция <= Длина И НомерСтроки < 3 Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = Символы.ВК Тогда
			Если Сред(Текст, Позиция + 1, 1) = Символы.ПС Тогда
				Позиция = Позиция + 2;
			Иначе
				Позиция = Позиция + 1;
			КонецЕсли;
			НомерСтроки = НомерСтроки + 1;
		ИначеЕсли Символ = Символы.ПС Тогда
			Позиция = Позиция + 1;
			НомерСтроки = НомерСтроки + 1;
		Иначе
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	
	Заголовок = Лев(Текст, Позиция - 1);
	Тело = Сред(Текст, Позиция);
	Возврат Новый Структура("Заголовок,Тело", Заголовок, Тело);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокСодержитПустуюСтрокуПослеGUID(Заголовок)
	
	НомерСтроки = 0;
	ПустаяТекущая = Истина;
	Индекс = 1;
	Длина = СтрДлина(Заголовок);
	Пока Индекс <= Длина Цикл
		Символ = Сред(Заголовок, Индекс, 1);
		Если Символ = Символы.ВК Тогда
			Если НомерСтроки = 2 И ПустаяТекущая Тогда
				Возврат Истина;
			КонецЕсли;
			НомерСтроки = НомерСтроки + 1;
			ПустаяТекущая = Истина;
			Если Сред(Заголовок, Индекс + 1, 1) = Символы.ПС Тогда
				Индекс = Индекс + 2;
			Иначе
				Индекс = Индекс + 1;
			КонецЕсли;
			Продолжить;
		ИначеЕсли Символ = Символы.ПС Тогда
			Если НомерСтроки = 2 И ПустаяТекущая Тогда
				Возврат Истина;
			КонецЕсли;
			НомерСтроки = НомерСтроки + 1;
			ПустаяТекущая = Истина;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		ПустаяТекущая = Ложь;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат НомерСтроки >= 3 И ПустаяТекущая;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОбеспечитьХвостовуюЗапятуюВЗаписиLgp(БуферЗаписи)
	
	Хвост = "";
	Текст = БуферЗаписи;
	Пока СтрДлина(Текст) > 0 Цикл
		Символ = Сред(Текст, СтрДлина(Текст), 1);
		Если Символ = Символы.ПС Или Символ = Символы.ВК Или Символ = " " Или Символ = Символы.Таб Тогда
			Хвост = Символ + Хвост;
			Текст = Лев(Текст, СтрДлина(Текст) - 1);
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ПустаяСтрока(Текст) И Не СтрЗаканчиваетсяНа(Текст, ",") Тогда
		Текст = Текст + ",";
	КонецЕсли;
	
	Возврат Текст + Хвост;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция УбратьХвостовуюЗапятуюВЗаписиLgp(БуферЗаписи)
	
	Хвост = "";
	Текст = БуферЗаписи;
	Пока СтрДлина(Текст) > 0 Цикл
		Символ = Сред(Текст, СтрДлина(Текст), 1);
		Если Символ = Символы.ПС Или Символ = Символы.ВК Или Символ = " " Или Символ = Символы.Таб Тогда
			Хвост = Символ + Хвост;
			Текст = Лев(Текст, СтрДлина(Текст) - 1);
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрЗаканчиваетсяНа(Текст, ",") Тогда
		Текст = Лев(Текст, СтрДлина(Текст) - 1);
	КонецЕсли;
	
	Возврат Текст + Хвост;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция Токенизировать(Знач Текст)
	
	Токены = Новый Массив;
	Текущий = "";
	Глубина = 0;
	ВКавычках = Ложь;
	Индекс = 1;
	Длина = СтрДлина(Текст);
	
	Пока Индекс <= Длина Цикл
		
		Символ = Сред(Текст, Индекс, 1);
		
		Если ВКавычках Тогда
			Текущий = Текущий + Символ;
			Если Символ = """" Тогда
				Если Сред(Текст, Индекс + 1, 1) = """" Тогда
					Текущий = Текущий + """";
					Индекс = Индекс + 2;
					Продолжить;
				КонецЕсли;
				ВКавычках = Ложь;
			КонецЕсли;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		
		Если Символ = """" Тогда
			ВКавычках = Истина;
			Текущий = Текущий + Символ;
		ИначеЕсли Символ = "{" Тогда
			Глубина = Глубина + 1;
			Текущий = Текущий + Символ;
		ИначеЕсли Символ = "}" Тогда
			Глубина = Глубина - 1;
			Текущий = Текущий + Символ;
		ИначеЕсли Символ = "," И Глубина = 0 Тогда
			Токены.Добавить(СокрЛП(Текущий));
			Текущий = "";
		Иначе
			Текущий = Текущий + Символ;
		КонецЕсли;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	Если Не ПустаяСтрока(Текущий) Или Длина > 0 Тогда
		Токены.Добавить(СокрЛП(Текущий));
	КонецЕсли;
	
	Возврат Токены;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоСкобочнаяЗапись(Знач Значение)
	
	Возврат СтрНачинаетсяС(Значение, "{") И СтрЗаканчиваетсяНа(Значение, "}");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТелоСкобочнойЗаписи(Знач Значение)
	
	Возврат Сред(Значение, 2, СтрДлина(Значение) - 2);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция УбратьХвостовуюЗапятую(Знач Значение)
	
	Если СтрЗаканчиваетсяНа(Значение, ",") Тогда
		Возврат Лев(Значение, СтрДлина(Значение) - 1);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СнятьКавычки(Знач Значение)
	
	Значение = СокрЛП(Значение);
	Если СтрДлина(Значение) >= 2 И СтрНачинаетсяС(Значение, """") И СтрЗаканчиваетсяНа(Значение, """") Тогда
		Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
		Значение = СтрЗаменить(Значение, """""", """");
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭкранироватьКавычки(Знач Значение)
	
	Возврат СтрЗаменить(Строка(Значение), """", """""");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЧислоИзТокена(Знач Значение)
	
	Значение = СокрЛП(Значение);
	Если ПустаяСтрока(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Индекс);
		Если Код < 48 Или Код > 57 Тогда
			Возврат 0;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Число(Значение);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФорматЧислаПротокола(Значение)
	
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеРазмера(Размер)
	
	Если Размер < 1024 Тогда
		Возврат ФорматЧислаПротокола(Размер) + " Б";
	ИначеЕсли Размер < 1024 * 1024 Тогда
		Возврат Формат(Размер / 1024, "ЧДЦ=1; ЧН=0") + " КБ";
	ИначеЕсли Размер < 1024 * 1024 * 1024 Тогда
		Возврат Формат(Размер / 1024 / 1024, "ЧДЦ=1; ЧН=0") + " МБ";
	КонецЕсли;
	
	Возврат Формат(Размер / 1024 / 1024 / 1024, "ЧДЦ=2; ЧН=0") + " ГБ";
	
КонецФункции

#КонецОбласти

#Область ОтладочныйЛог

&НаКлиенте
Процедура ПодготовитьСеансОтладки(Операция)
	
	Если Не РежимОтладки Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьВидимостьСтраницыОтладкиНаСервере();
	ПодготовитьСеансОтладкиНаСервере(Операция);
	Элементы.СтраницыПротокола.ТекущаяСтраница = Элементы.СтраницаОтладка;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьСеансОтладкиНаСервере(Операция)
	
	Если Не РежимОтладки Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОтладочногоЛога = "";
	ДобавитьВОтладочныйЛогНаСервереКонтекста("=== DEBUG SESSION " + Операция + " "
		+ Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss") + " ===");
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] version=" + НомерВерсииОбработки());
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] execute_on_server="
		+ ?(ВыполнятьНаСервере, "true", "false"));
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] src=" + КаталогИсточника);
	ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] dst=" + КаталогПриемника);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтображаемуюВерсиюОбработки()
	
	Номер = НомерВерсииОбработки();
	ВерсияОбработки = "v" + Номер;
	Заголовок = "Присоединение журнала регистрации — v" + Номер;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьСтраницыОтладкиНаСервере()
	
	Элементы.СтраницаОтладка.Видимость = РежимОтладки;
	
