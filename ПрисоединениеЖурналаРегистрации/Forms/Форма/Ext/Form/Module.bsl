&НаКлиенте
Процедура ПрисоединитьПослеПодтверждения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТекстПротокола = "";
	
	Попытка
		Если ВыполнятьНаСервере Тогда
			ВыполнитьПрисоединениеНаСервереБезопасно();
		Иначе
			ВыполнитьПрисоединение();
		КонецЕсли;
		ПоказатьПредупреждение(, "Присоединение завершено. См. протокол.");
	Исключение
		Информация = ИнформацияОбОшибке();
		ДобавитьВПротокол("Ошибка: " + ПодробноеПредставлениеОшибки(Информация));
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(Информация));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьПрисоединениеНаСервереБезопасно()
	
	ВыполнитьПрисоединениеНаСервереКонтекста();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПрисоединение()
	
	ПроверитьКаталоги();
	
	Заблокированные = НайтиЗаблокированныеФайлыПриемника();
	Если Заблокированные.Количество() > 0 Тогда
		ТекстБлокировки = "Файлы приёмника заблокированы (вероятно, ragent/кластер). "
			+ "Скопируйте 1Cv8Log и работайте с копией. Заблокировано: "
			+ СтрСоединить(Заблокированные, ", ");
		ВызватьИсключение ТекстБлокировки;
	КонецЕсли;
	
	ПутьLgfИсточника = ПутьКСловарюЖР(КаталогИсточника);
	ПутьLgfПриемника = ПутьКСловарюЖР(КаталогПриемника);
	
	СловарьИсточника = ПрочитатьСловарьLgf(ПутьLgfИсточника);
	СловарьПриемника = ПрочитатьСловарьLgf(ПутьLgfПриемника);
	РезультатКарт = ПостроитьКартыПеренумерации(СловарьИсточника, СловарьПриемника);
	НужнаПеренумерация = РезультатКарт.НужнаПеренумерация;
	
	Если СоздаватьРезервнуюКопию Тогда
		ПутьКопииКаталога = СоздатьПолнуюКопиюКаталогаПриемника();
		ДобавитьВПротокол("Полная резервная копия каталога приёмника: " + ПутьКопииКаталога);
	КонецЕсли;
	
	Если РезультатКарт.ДобавленныеСтроки.Количество() > 0 Тогда
		ДописатьСтрокиВLgf(ПутьLgfПриемника, РезультатКарт.ДобавленныеСтроки);
		ДобавитьВПротокол("В 1Cv8.lgf добавлено записей: "
			+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	Иначе
		ДобавитьВПротокол("Словарь приёмника уже содержит все объекты источника.");
	КонецЕсли;
	
	Обработано = 0;
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		
		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		#Если Клиент Тогда
		ОбработкаПрерыванияПользователя();
		Состояние("Присоединение " + СтрокаФайла.ИмяФайла);
		#КонецЕсли
		
		Если СтрокаФайла.Действие = РежимКонфликтаПропустить()
			И ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
			ДобавитьВПротокол("Пропущен (уже есть): " + СтрокаФайла.ИмяФайла);
			Продолжить;
		КонецЕсли;
		
		Объединять = (СтрокаФайла.Действие = РежимКонфликтаОбъединить()
			И ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника));
		
		ПрисоединитьФайлLgp(
			СтрокаФайла.ПолныйПутьИсточника,
			СтрокаФайла.ПолныйПутьПриемника,
			СловарьПриемника,
			РезультатКарт.Карты,
			Объединять,
			НужнаПеренумерация);
		
		Если Объединять Тогда
			ДобавитьВПротокол("Объединён: " + СтрокаФайла.ИмяФайла);
		Иначе
			ДобавитьВПротокол("Скопирован: " + СтрокаФайла.ИмяФайла);
		КонецЕсли;
		
		Обработано = Обработано + 1;
		
	КонецЦикла;
	
	УдалитьИндексыЖурнала(КаталогПриемника);
	ДобавитьВПротокол("Обработано файлов: " + ФорматЧислаПротокола(Обработано));
	ДобавитьВПротокол("Индексы *.lgx удалены - платформа построит их заново при открытии ЖР.");
	
	Если ПроверятьЦелостность Тогда
		ДобавитьВПротокол("--- Контроль после записи ---");
		СловарьПосле = ПрочитатьСловарьLgf(ПутьLgfПриемника);
		ЗамечанияПосле = 0;
		Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
			Если Не СтрокаФайла.Пометка Или Не ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаФайла.Действие = РежимКонфликтаПропустить() Тогда
				Продолжить;
			КонецЕсли;
			Результат = ПроверитьЦелостностьФайлаLgp(
				СтрокаФайла.ПолныйПутьПриемника,
				СловарьПосле.GUID,
				СловарьПосле.Версия);
			Если Не Результат.Ок Тогда
				ЗамечанияПосле = ЗамечанияПосле + 1;
				ДобавитьВПротокол("  " + СтрокаФайла.ИмяФайла + ": " + Результат.Сообщение);
			КонецЕсли;
		КонецЦикла;
		Если ЗамечанияПосле = 0 Тогда
			ДобавитьВПротокол("Контроль после записи: замечаний нет.");
		КонецЕсли;
	КонецЕсли;
	
	ДобавитьВПротокол("Готово. Если работали с копией, остановите кластер и подмените каталог 1Cv8Log.");
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьПрисоединениеНаСервереКонтекста()
	
	ПроверитьКаталогиНаСервереКонтекста();
	
