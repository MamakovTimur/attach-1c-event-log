			Продолжить;
		КонецЕсли;
		
		Объединять = (ВнутреннийКодДействияФайла(СтрокаФайла.Действие) = РежимКонфликтаОбъединить()
			И ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника));
		
		СведенияФайла = Неопределено;
		МетрикиДо = Неопределено;
		МетрикиИсточника = Неопределено;
		Если РежимОтладки Тогда
			СведенияФайла = Новый Структура;
			МетрикиДо = СобратьМетрикиФайлаLgp(СтрокаФайла.ПолныйПутьПриемника);
			МетрикиИсточника = СобратьМетрикиФайлаLgp(СтрокаФайла.ПолныйПутьИсточника);
		КонецЕсли;
		
		ПрисоединитьФайлLgp(
			СтрокаФайла.ПолныйПутьИсточника,
			СтрокаФайла.ПолныйПутьПриемника,
			СловарьПриемника,
			РезультатКарт.Карты,
			Объединять,
			НужнаПеренумерация,
			СведенияФайла,
			ОпцииСклейкиИзРеквизитовФормыНаСервере());
		
		Если РежимОтладки Тогда
			МетрикиПосле = СобратьМетрикиФайлаLgp(СтрокаФайла.ПолныйПутьПриемника);
			ЗаписатьОтладкуОперацииФайлаНаСервереКонтекста(
				СтрокаФайла.ИмяФайла,
				Объединять,
				СведенияФайла,
				МетрикиИсточника,
				МетрикиДо,
				МетрикиПосле);
		КонецЕсли;
		
		Если Объединять Тогда
			ДобавитьВПротоколНаСервереКонтекста("Объединён: " + СтрокаФайла.ИмяФайла);
		Иначе
			ДобавитьВПротоколНаСервереКонтекста("Скопирован: " + СтрокаФайла.ИмяФайла);
		КонецЕсли;
		
		Обработано = Обработано + 1;
		
	КонецЦикла;
	
	УдалитьИндексыЖурналаНаСервереКонтекста(КаталогПриемника);
	ДобавитьВПротоколНаСервереКонтекста("Обработано файлов: " + ФорматЧислаПротокола(Обработано));
	ДобавитьВПротоколНаСервереКонтекста("Индексы *.lgx удалены - платформа построит их заново при открытии ЖР.");
	
	Если РежимОтладки Тогда
		ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] files_processed=" + ФорматЧислаПротокола(Обработано));
		ДобавитьВОтладочныйЛогНаСервереКонтекста("=== DEBUG SESSION attach END ===");
	КонецЕсли;
	
	Если ПроверятьЦелостность Тогда
		ДобавитьВПротоколНаСервереКонтекста("--- Контроль после записи ---");
		СловарьПосле = ПрочитатьСловарьLgf(ПутьLgfПриемника);
		ЗамечанияПосле = 0;
		КэшЦелостности = Новый Соответствие;
		Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
			Если Не СтрокаФайла.Пометка Или Не ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
				Продолжить;
			КонецЕсли;
			Если ВнутреннийКодДействияФайла(СтрокаФайла.Действие) = РежимКонфликтаПропустить() Тогда
				Продолжить;
			КонецЕсли;
			Результат = ПроверитьЦелостностьФайлаLgp(
				СтрокаФайла.ПолныйПутьПриемника,
				СловарьПосле.GUID,
				СловарьПосле.Версия,
				КэшЦелостности);
			Если Не Результат.Ок Тогда
				ЗамечанияПосле = ЗамечанияПосле + 1;
				ДобавитьВПротоколНаСервереКонтекста("  " + СтрокаФайла.ИмяФайла + ": " + Результат.Сообщение);
			КонецЕсли;
		КонецЦикла;
		Если ЗамечанияПосле = 0 Тогда
			ДобавитьВПротоколНаСервереКонтекста(
				"Контроль после записи: замечаний нет — заголовки периодов согласованы с новым журналом.");
		Иначе
			ДобавитьВПротоколНаСервереКонтекста("Контроль после записи: замечаний "
				+ ФорматЧислаПротокола(ЗамечанияПосле)
				+ ". Часть периодов может не открыться — см. формулировки выше.");
		КонецЕсли;
	КонецЕсли;
	
	ДобавитьВПротоколНаСервереКонтекста("=== Конец присоединения. Длительность: "
		+ ПредставлениеДлительностиПротокола(ТекущаяДата() - МоментНачала) + " ===");
	ДобавитьВПротоколНаСервереКонтекста("Готово. Если работали с копией, остановите кластер и подмените каталог 1Cv8Log.");
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИндексыЖурнала(КаталогЖР)
	
	ФайлыИндекса = НайтиФайлы(КаталогЖР, "*.lgx", Ложь);
	Для Каждого ФайлИндекса Из ФайлыИндекса Цикл
		Попытка
			УдалитьФайлы(ФайлИндекса.ПолноеИмя);
		Исключение
			ДобавитьВПротокол("Не удалось удалить индекс " + ФайлИндекса.Имя + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьИндексыЖурналаНаСервереКонтекста(КаталогЖР)
	
	ФайлыИндекса = НайтиФайлы(КаталогЖР, "*.lgx", Ложь);
	Для Каждого ФайлИндекса Из ФайлыИндекса Цикл
		Попытка
			УдалитьФайлы(ФайлИндекса.ПолноеИмя);
		Исключение
			ДобавитьВПротоколНаСервереКонтекста("Не удалось удалить индекс " + ФайлИндекса.Имя + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция КоличествоОтмеченныхФайлов()
	
	Результат = 0;
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		Если СтрокаФайла.Пометка Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПометкиФайлов(Пометка)
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		СтрокаФайла.Пометка = Пометка;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьЦелостностьФайлаLgp(ПутьКФайлу, ОжидаемыйGUID, ОжидаемаяВерсия, КэшЦелостности = Неопределено)
	
	Если КэшЦелостности <> Неопределено Тогда
		КлючКэша = КлючКэшаПроверкиФайла(ПутьКФайлу, ОжидаемыйGUID, ОжидаемаяВерсия);
		Кэшированный = КэшЦелостности.Получить(КлючКэша);
		Если Кэшированный <> Неопределено Тогда
			Возврат Кэшированный;
		КонецЕсли;
	КонецЕсли;
	
	Результат = ПроверитьЦелостностьФайлаLgpБезКэша(ПутьКФайлу, ОжидаемыйGUID, ОжидаемаяВерсия);
	
	Если КэшЦелостности <> Неопределено Тогда
		КэшЦелостности.Вставить(КлючКэша, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьЦелостностьФайлаLgpБезКэша(ПутьКФайлу, ОжидаемыйGUID, ОжидаемаяВерсия)
	
	Результат = Новый Структура("Ок,Сообщение", Истина, "");
	
	Попытка
		Чтение = ОткрытьЧтениеЖурнала(ПутьКФайлу);
	Исключение
		Результат.Ок = Ложь;
		Результат.Сообщение = "Что нашли: файл не удалось открыть ("
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + "). "
			+ "Чем грозит: период не попадёт в журнал. "
			+ "Что делать: проверьте права доступа и что файл не занят кластером.";
		Возврат Результат;
	КонецПопытки;
	
	Версия = "";
	GUID = "";
	НомерСтроки = 0;
	БуферЗаписи = "";
	Глубина = 0;
	ВКавычках = Ложь;
	ПрочитаноБайт = 0;
	ЛимитБайт = 2097152;
	Записей = 0;
	КонецФайла = Ложь;
	ДостигнутЛимитВыборки = Ложь;
	
	Пока Истина Цикл
		
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			КонецФайла = Истина;
			Прервать;
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		ПрочитаноБайт = ПрочитаноБайт + СтрДлина(СтрокаФайла) + 2;
		
		Если НомерСтроки = 1 Тогда
			Версия = СокрЛП(СтрокаФайла);
			Продолжить;
		ИначеЕсли НомерСтроки = 2 Тогда
			GUID = СокрЛП(СтрокаФайла);
			Продолжить;
		КонецЕсли;
		
		ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках);
		Если Глубина = 0 И Не ПустаяСтрока(БуферЗаписи) Тогда
			Записей = Записей + 1;
			БуферЗаписи = "";
		КонецЕсли;
		
		Если ПрочитаноБайт >= ЛимитБайт Тогда
			ДостигнутЛимитВыборки = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Чтение.Закрыть();
	
	Замечания = Новый Массив;
	Если СтрНайти(Версия, МаркерФорматаЖР()) = 0 Тогда
		Замечания.Добавить(
			"Что нашли: в начале файла нет метки старого журнала (1CV8LOG). "
			+ "Чем грозит: платформа не примет файл как журнал регистрации. "
			+ "Что делать: убедитесь, что это каталог 1Cv8Log старого текстового формата (не SQLite .lgd).");
	КонецЕсли;
	Если Не ПустаяСтрока(ОжидаемаяВерсия) И Версия <> ОжидаемаяВерсия Тогда
		Замечания.Добавить(
			"Что нашли: версия в заголовке файла периода отличается от словаря 1Cv8.lgf. "
			+ "Чем грозит: журнал может не показать этот период. "
			+ "Что делать: при «Присоединить» обработка выставит версию и идентификатор текущего журнала в заголовок.");
	КонецЕсли;
	Если ВРег(СокрЛП(GUID)) <> ВРег(СокрЛП(ОжидаемыйGUID)) Тогда
		Замечания.Добавить(
			"Что нашли: идентификатор журнала в файле периода (" + GUID
			+ ") не совпадает со словарём (" + ОжидаемыйGUID + "). "
			+ "Чем грозит: период может не открыться в журнале регистрации. "
			+ "Что делать: при «Присоединить» обработка подставит идентификатор приёмника в заголовок .lgp "
			+ "(полная перенумерация нужна только если номера объектов различаются — это видно в плане выше).");
	КонецЕсли;
	// Незакрытая скобка при обрыве на лимите ~2 МБ — не доказательство повреждения.
	Если КонецФайла И (Глубина <> 0 Или Не ПустаяСтрока(БуферЗаписи)) Тогда
		Замечания.Добавить(
			"Что нашли: файл оборван — запись в скобках не закрыта до конца файла. "
			+ "Чем грозит: платформа может не прочитать этот период. "
			+ "Что делать: возьмите целый файл .lgp из резервной копии старого кластера.");
	КонецЕсли;
	
	Если Замечания.Количество() > 0 Тогда
		Результат.Ок = Ложь;
		Результат.Сообщение = СтрСоединить(Замечания, " ");
	ИначеЕсли ДостигнутЛимитВыборки Тогда
		Результат.Сообщение = "ok (проверено начало до ~" + ПредставлениеРазмера(ЛимитБайт)
			+ "; дальше не читали — это не признак повреждения)";
	Иначе
		Результат.Сообщение = "ok, записей в выборке: " + ФорматЧислаПротокола(Записей);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СтрокиПредупрежденияРазныхИдентификаторовЖурнала(НужнаПеренумерацияФайлов)
	
	Строки = Новый Массив;
	Строки.Добавить(
		"Что нашли: старый и новый журнал — разные (разные идентификаторы GUID в 1Cv8.lgf).");
	Строки.Добавить(
		"Чем грозит: если скопировать файлы периодов «как есть», в них останется чужой заголовок — "
		+ "новый журнал может не показать старый период.");
	Если НужнаПеренумерацияФайлов Тогда
		Строки.Добавить(
			"Что сделает обработка: перенумерует ссылки в записях и запишет заголовок нового журнала.");
	Иначе
		Строки.Добавить(
			"Что сделает обработка: номера объектов совпадают — полная перенумерация не нужна; "
			+ "при копировании всё равно подставит идентификатор и версию нового журнала в заголовок .lgp.");
	КонецЕсли;
	
	Возврат Строки;
	
КонецФункции

&НаКлиенте
Функция НайтиЗаблокированныеФайлыПриемника(КэшБлокировок = Неопределено)
	
	Результат = Новый Массив;
	
	ПутьLgf = ПутьКСловарюЖР(КаталогПриемника);
	Если ФайлСуществует(ПутьLgf) И ФайлЗаблокированДляЗаписи(ПутьLgf, КэшБлокировок) Тогда
		Результат.Добавить(ИмяФайлаСловаряЖР());
	КонецЕсли;
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		
		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Если Не ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
			Продолжить;
		КонецЕсли;
		Если ВнутреннийКодДействияФайла(СтрокаФайла.Действие) = РежимКонфликтаПропустить() Тогда
			Продолжить;
		КонецЕсли;
		
		Если ФайлЗаблокированДляЗаписи(СтрокаФайла.ПолныйПутьПриемника, КэшБлокировок) Тогда
			Результат.Добавить(СтрокаФайла.ИмяФайла);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
