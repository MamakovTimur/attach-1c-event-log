КонецПроцедуры

#КонецОбласти

#Область ФайлыLgp

&НаКлиентеНаСервереБезКонтекста
Процедура ПрисоединитьФайлLgp(ПутьИсточника, ПутьПриемника, СловарьПриемника, Карты, Объединять, НужнаПеренумерация, СведенияОтладки = Неопределено, ОпцииСклейки = Неопределено)
	
	Опции = НормализоватьОпцииСклейкиLgp(ОпцииСклейки);
	
	Если Опции.РазбиватьПоДням Тогда
		Если СведенияОтладки <> Неопределено Тогда
			СведенияОтладки.Вставить("Ветка", "split_by_day");
		КонецЕсли;
		ПрисоединитьФайлLgpСРазбивкойПоДням(
			ПутьИсточника,
			ПутьПриемника,
			СловарьПриемника,
			Карты,
			НужнаПеренумерация,
			Опции,
			СведенияОтладки);
		Возврат;
	КонецЕсли;
	
	НуженПоточныйРазбор = НужнаПеренумерация Или Опции.Дедуплицировать;
	
	Если Не Объединять И Не НуженПоточныйРазбор Тогда
		ЗаголовокИсточника = ПрочитатьЗаголовокLgp(ПутьИсточника);
		Если ВРег(СокрЛП(ЗаголовокИсточника.GUID)) <> ВРег(СокрЛП(СловарьПриемника.GUID))
			Или ЗаголовокИсточника.Версия <> СловарьПриемника.Версия Тогда
			Если СведенияОтладки <> Неопределено Тогда
				СведенияОтладки.Вставить("Ветка", "copy_header");
			КонецЕсли;
			СкопироватьLgpСЗаголовкомПриемника(
				ПутьИсточника,
				ПутьПриемника,
				СловарьПриемника.Версия,
				СловарьПриемника.GUID);
		Иначе
			Если СведенияОтладки <> Неопределено Тогда
				СведенияОтладки.Вставить("Ветка", "copy_raw");
			КонецЕсли;
			КопироватьФайлСЗаменой(ПутьИсточника, ПутьПриемника);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Объединять И Не НуженПоточныйРазбор Тогда
		Если СведенияОтладки <> Неопределено Тогда
			СведенияОтладки.Вставить("Ветка", "merge_raw");
		КонецЕсли;
		ОбъединитьLgpБезПеренумерации(ПутьИсточника, ПутьПриемника);
		Возврат;
	КонецЕсли;
	
	СтатистикаВыгрузки = Неопределено;
	Если СведенияОтладки <> Неопределено Тогда
		Если Объединять Тогда
			СведенияОтладки.Вставить("Ветка",
				?(Опции.Дедуплицировать, "merge+dedup", ?(НужнаПеренумерация, "merge+renumber", "merge")));
		Иначе
			СведенияОтладки.Вставить("Ветка", ?(НужнаПеренумерация, "rewrite+renumber", "rewrite"));
		КонецЕсли;
		СтатистикаВыгрузки = Новый Структура(
			"Записей,Однострочных,Многострочных,ПропущеноДублей", 0, 0, 0, 0);
	КонецЕсли;
	
	Отпечатки = Неопределено;
	Если Опции.Дедуплицировать Тогда
		Если Объединять И ФайлСуществует(ПутьПриемника) Тогда
			Отпечатки = СобратьОтпечаткиЗаписейLgp(ПутьПриемника);
		Иначе
			Отпечатки = Новый Соответствие;
		КонецЕсли;
	КонецЕсли;
	
	Если Объединять И ФайлСуществует(ПутьПриемника) Тогда
		ТекстПрефикса = ТекстLgpПриемникаСЗапятойНаПоследнейЗаписи(ПутьПриемника);
	Иначе
		Разрыв = РазрывСтрокЗаголовкаLgp();
		ТекстПрефикса = СловарьПриемника.Версия + Разрыв
			+ СловарьПриемника.GUID + Разрыв
			+ Разрыв;
	КонецЕсли;
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("lgp");
	ЗаписатьСыройТекстЖурналаUTF8(ВременныйФайл, ТекстПрефикса);
	ДописатьЗаписиLgpИзФайла(
		ПутьИсточника,
		ВременныйФайл,
		Карты,
		НужнаПеренумерация,
		СтатистикаВыгрузки,
		Отпечатки);
	
	Если СтатистикаВыгрузки <> Неопределено Тогда
		СведенияОтладки.Вставить("Статистика", СтатистикаВыгрузки);
	КонецЕсли;
	
	КопироватьФайлСЗаменой(ВременныйФайл, ПутьПриемника);
	УдалитьФайлы(ВременныйФайл);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПрисоединитьФайлLgpСРазбивкойПоДням(ПутьИсточника, ПутьПриемникаШаблон, СловарьПриемника, Карты, НужнаПеренумерация, Опции, СведенияОтладки = Неопределено)
	
	ФайлПриемника = Новый Файл(ПутьПриемникаШаблон);
	КаталогПриемника = ФайлПриемника.Путь;
	
	ФайлыПоДням = РазложитьИсточникLgpПоДнямВоВременныеФайлы(
		ПутьИсточника,
		СловарьПриемника.Версия,
		СловарьПриемника.GUID,
		Опции.ЗащищатьТранзакции);
	
	ОпцииДня = НовыеОпцииСклейкиLgp(Опции.Дедуплицировать, Ложь);
	ОбработаноДней = 0;
	
	Для Каждого Пара Из ФайлыПоДням Цикл
		
		День = Пара.Ключ;
		ВременныйИсточник = Пара.Значение;
		ПутьДня = ОбъединитьПуть(КаталогПриемника, ИмяФайлаПериодаПоДнюLgp(День));
		ОбъединятьДень = ФайлСуществует(ПутьДня);
		
		ПрисоединитьФайлLgp(
			ВременныйИсточник,
			ПутьДня,
			СловарьПриемника,
			Карты,
			ОбъединятьДень,
			НужнаПеренумерация,
			Неопределено,
			ОпцииДня);
		
		УдалитьФайлы(ВременныйИсточник);
		ОбработаноДней = ОбработаноДней + 1;
		
	КонецЦикла;
	
	Если СведенияОтладки <> Неопределено Тогда
		СведенияОтладки.Вставить("Дней", ОбработаноДней);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РазложитьИсточникLgpПоДнямВоВременныеФайлы(ПутьИсточника, Версия, GUID, ЗащищатьТранзакции)
	
	Результат = Новый Соответствие;
	ОткрытаяГлубина = 0;
	ЛипкийДень = "";
	Разрыв = РазрывСтрокЗаголовкаLgp();
	ТекстЗаголовка = Версия + Разрыв + GUID + Разрыв + Разрыв;
	
	Чтение = ОткрытьЧтениеЖурнала(ПутьИсточника);
	Для Номер = 1 По 3 Цикл
		Чтение.ПрочитатьСтроку();
	КонецЦикла;
	
	БуферЗаписи = "";
	Глубина = 0;
	ВКавычках = Ложь;
	
	Пока Истина Цикл
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если Глубина = 0 И ПустаяСтрока(БуферЗаписи) Тогда
			Сжатая = СокрЛП(СтрокаФайла);
			Если ПустаяСтрока(Сжатая) Или Не СтрНачинаетсяС(СокрЛ(Сжатая), "{") Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках);
		Если Глубина <> 0 Или ПустаяСтрока(БуферЗаписи) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстЗаписи = БуферЗаписи;
		БуферЗаписи = "";
		Сжатая = СокрЛП(ТекстЗаписи);
		Если СтрЗаканчиваетсяНа(Сжатая, ",") Тогда
			СжатаяПлоская = УбратьХвостовуюЗапятую(Сжатая);
		Иначе
			СжатаяПлоская = Сжатая;
		КонецЕсли;
		Если Не ЭтоСкобочнаяЗапись(СжатаяПлоская) Тогда
			Продолжить;
		КонецЕсли;
		
		Токены = Токенизировать(ТелоСкобочнойЗаписи(СжатаяПлоская));
		Если Не ЭтоЗаписьСобытияLgpПоТокенам(Токены) Тогда
			Продолжить;
		КонецЕсли;
		
		ДеньЗаписи = ДеньИзТокенаДатыLgp(Токены[ИндексПоляДатыЗаписиLgp()]);
		Если ПустаяСтрока(ДеньЗаписи) Тогда
			Продолжить;
		КонецЕсли;
		
		Статус = "";
		Если Токены.ВГраница() >= ИндексПоляСтатусаТранзакцииLgp() Тогда
			Статус = ВРег(СокрЛП(Токены[ИндексПоляСтатусаТранзакцииLgp()]));
		КонецЕсли;
		
		Если ЗащищатьТранзакции И ОткрытаяГлубина > 0 И Не ПустаяСтрока(ЛипкийДень) Тогда
			ДеньНазначения = ЛипкийДень;
		Иначе
			ДеньНазначения = ДеньЗаписи;
		КонецЕсли;
		
		ПутьДня = Результат.Получить(ДеньНазначения);
		Если ПутьДня = Неопределено Тогда
			ПутьДня = ПолучитьИмяВременногоФайла("lgp");
			ЗаписатьСыройТекстЖурналаUTF8(ПутьДня, ТекстЗаголовка);
			Результат.Вставить(ДеньНазначения, ПутьДня);
		Иначе
			ОбеспечитьЗапятуюНаПоследнейЗаписиLgpВФайле(ПутьДня);
		КонецЕсли;
		
		ДописатьСыройТекстЖурналаUTF8БезBOM(
			ПутьДня,
			УбратьХвостовуюЗапятуюВЗаписиLgp(ТекстЗаписи) + Разрыв);
		
		Если ЗащищатьТранзакции Тогда
			Если Статус = СтатусТранзакцииНезавершена() Тогда
				Если ОткрытаяГлубина = 0 Тогда
					ЛипкийДень = ДеньЗаписи;
				КонецЕсли;
				ОткрытаяГлубина = ОткрытаяГлубина + 1;
			ИначеЕсли Статус = СтатусТранзакцииЗафиксирована()
				Или Статус = СтатусТранзакцииОтменена() Тогда
				Если ОткрытаяГлубина > 0 Тогда
					ОткрытаяГлубина = ОткрытаяГлубина - 1;
				КонецЕсли;
				Если ОткрытаяГлубина = 0 Тогда
					ЛипкийДень = "";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	Чтение.Закрыть();
	
	Возврат Результат;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьЗаголовокLgp(ПутьКФайлу)
	
	Результат = Новый Структура("Версия,GUID", "", "");
	Чтение = ОткрытьЧтениеЖурнала(ПутьКФайлу);
	СтрокаВерсии = Чтение.ПрочитатьСтроку();
	СтрокаGUID = Чтение.ПрочитатьСтроку();
	Чтение.Закрыть();
	
	Если СтрокаВерсии <> Неопределено Тогда
		Результат.Версия = СокрЛП(СтрокаВерсии);
	КонецЕсли;
	Если СтрокаGUID <> Неопределено Тогда
		Результат.GUID = СокрЛП(СтрокаGUID);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура СкопироватьLgpСЗаголовкомПриемника(ПутьИсточника, ПутьПриемника, ВерсияПриемника, GUIDПриемника)
	
	ТекстИсточника = ПрочитатьСыройТекстЖурналаUTF8(ПутьИсточника);
	Части = РазделитьЗаголовокИТелоLgp(ТекстИсточника);
	Разрыв = РазрывСтрокИзФрагмента(Части.Заголовок);
	Если ПустаяСтрока(Разрыв) Тогда
		Разрыв = РазрывСтрокЗаголовкаLgp();
	КонецЕсли;
	
	НовыйЗаголовок = ВерсияПриемника + Разрыв + GUIDПриемника + Разрыв + Разрыв;
	ЗаписатьСыройТекстЖурналаUTF8(ПутьПриемника, НовыйЗаголовок + Части.Тело);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТекстLgpПриемникаСЗапятойНаПоследнейЗаписи(ПутьПриемника)
	
	Части = ПрочитатьЗаголовокИТелоLgpПотоково(ПутьПриемника);
	Заголовок = Части.Заголовок;
	Тело = Части.Тело;
	
	// Битый приёмник без пустой после GUID (до 1.3.4) — восстанавливаем.
	Если Не ЗаголовокСодержитПустуюСтрокуПослеGUID(Заголовок)
		И СтрДлина(СокрЛП(Тело)) > 0
		И СтрНачинаетсяС(СокрЛП(Тело), "{") Тогда
		Разрыв = РазрывСтрокИзФрагмента(Заголовок);
		Если ПустаяСтрока(Разрыв) Тогда
			Разрыв = РазрывСтрокЗаголовкаLgp();
		КонецЕсли;
		Заголовок = Заголовок + Разрыв;
	КонецЕсли;
	
	Возврат Заголовок + ТекстТелаLgpСЗапятойНаПоследнейЗаписи(Тело);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТекстТелаLgpСЗапятойНаПоследнейЗаписи(Тело)
	
	Если ПустаяСтрока(Тело) Тогда
		Возврат Тело;
	КонецЕсли;
	
	НачалоПоследней = 0;
	КонецПоследней = 0;
	Глубина = 0;
	ВКавычках = Ложь;
	Индекс = 1;
	Длина = СтрДлина(Тело);
	НачалоТекущей = 0;
	
	Пока Индекс <= Длина Цикл
		Символ = Сред(Тело, Индекс, 1);
		Если ВКавычках Тогда
			Если Символ = """" Тогда
				Если Сред(Тело, Индекс + 1, 1) = """" Тогда
					Индекс = Индекс + 2;
					Продолжить;
				КонецЕсли;
				ВКавычках = Ложь;
			КонецЕсли;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		
		Если Символ = """" Тогда
			ВКавычках = Истина;
			Индекс = Индекс + 1;
			Продолжить;
		ИначеЕсли Символ = "{" Тогда
			Если Глубина = 0 Тогда
				НачалоТекущей = Индекс;
			КонецЕсли;
			Глубина = Глубина + 1;
			Индекс = Индекс + 1;
			Продолжить;
		ИначеЕсли Символ = "}" Тогда
			Глубина = Глубина - 1;
			Индекс = Индекс + 1;
			Если Глубина = 0 Тогда
				КонецЗаписи = Индекс;
				Если КонецЗаписи <= Длина И Сред(Тело, КонецЗаписи, 1) = "," Тогда
					КонецЗаписи = КонецЗаписи + 1;
				КонецЕсли;
				НачалоПоследней = НачалоТекущей;
				КонецПоследней = КонецЗаписи;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Если НачалоПоследней = 0 Тогда
		Возврат Тело;
	КонецЕсли;
	
	Запись = Сред(Тело, НачалоПоследней, КонецПоследней - НачалоПоследней);
	Запись = ОбеспечитьХвостовуюЗапятуюВЗаписиLgp(Запись);
	Возврат Лев(Тело, НачалоПоследней - 1) + Запись + Сред(Тело, КонецПоследней);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДописатьЗаписиLgpИзФайла(ПутьИсточника, ПутьДляДописывания, Карты, Перенумеровывать, СтатистикаВыгрузки = Неопределено, Отпечатки = Неопределено)
	
	ДописатьЗаписиLgpИзФайлаПострочно(
		ПутьИсточника,
		ПутьДляДописывания,
		Карты,
		Перенумеровывать,
		СтатистикаВыгрузки,
		Отпечатки);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПодготовитьТекстЗаписиLgp(БуферЗаписи, Карты, Перенумеровывать)
	
	ТекстЗаписи = БуферЗаписи;
	Если ПустаяСтрока(СокрЛП(ТекстЗаписи)) Или СокрЛП(ТекстЗаписи) = "," Тогда
		Возврат "";
	КонецЕсли;
	
	СжатыйПрефикс = СокрЛ(ТекстЗаписи);
	Если СтрНачинаетсяС(СжатыйПрефикс, ",") Тогда
		ТекстЗаписи = СокрЛ(Сред(СжатыйПрефикс, 2));
	КонецЕсли;
	Если Перенумеровывать Тогда
		ТекстЗаписи = ПеренумероватьЗаписьLgpСохраняяСтроки(ТекстЗаписи, Карты);
	КонецЕсли;
	
	Возврат ТекстЗаписи;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках)
	
	Если Не ПустаяСтрока(БуферЗаписи) Тогда
		БуферЗаписи = БуферЗаписи + Символы.ПС;
	КонецЕсли;
	БуферЗаписи = БуферЗаписи + СтрокаФайла;
	
	ОбновитьСостояниеСкобокИКавычек(СтрокаФайла, Глубина, ВКавычках);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьСостояниеСкобокИКавычек(СтрокаФайла, Глубина, ВКавычках)
	
	Индекс = 1;
	Длина = СтрДлина(СтрокаФайла);
	Пока Индекс <= Длина Цикл
		Символ = Сред(СтрокаФайла, Индекс, 1);
		Если ВКавычках Тогда
			Если Символ = """" Тогда
				Если Сред(СтрокаФайла, Индекс + 1, 1) = """" Тогда
					Индекс = Индекс + 2;
					Продолжить;
				КонецЕсли;
				ВКавычках = Ложь;
			КонецЕсли;
		ИначеЕсли Символ = """" Тогда
			ВКавычках = Истина;
		ИначеЕсли Символ = "{" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = "}" Тогда
			Глубина = Глубина - 1;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПеренумероватьЗаписьLgp(ТекстЗаписи, Карты)
	
	Сжатая = СокрЛП(ТекстЗаписи);
	ХвостоваяЗапятая = СтрЗаканчиваетсяНа(Сжатая, ",");
	Если ХвостоваяЗапятая Тогда
		Сжатая = УбратьХвостовуюЗапятую(Сжатая);
	КонецЕсли;
	Если Не ЭтоСкобочнаяЗапись(Сжатая) Тогда
		Возврат ТекстЗаписи;
	КонецЕсли;
	
	Токены = Токенизировать(ТелоСкобочнойЗаписи(Сжатая));
	НовыеТокены = ПеренумероватьТокеныЗаписиLgp(Токены, Карты);
	
	Результат = "{" + СтрСоединить(НовыеТокены, ",") + "}";
	Если ХвостоваяЗапятая Тогда
		Результат = Результат + ",";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПеренумероватьЗаписьLgpСохраняяСтроки(БуферЗаписи, Карты)
	
	РазборСтрок = СобратьПлоскийТекстИПереносы(БуферЗаписи);
	Плоский = РазборСтрок.Плоский;
	ПозицииПереносов = РазборСтрок.ПозицииПереносов;
	
	Сжатая = СокрЛП(Плоский);
	ХвостоваяЗапятая = СтрЗаканчиваетсяНа(Сжатая, ",");
	Если ХвостоваяЗапятая Тогда
		Сжатая = УбратьХвостовуюЗапятую(Сжатая);
	КонецЕсли;
	Если Не ЭтоСкобочнаяЗапись(Сжатая) Тогда
		Возврат БуферЗаписи;
	КонецЕсли;
	
	Токены = Токенизировать(ТелоСкобочнойЗаписи(Сжатая));
	НовыеТокены = ПеренумероватьТокеныЗаписиLgp(Токены, Карты);
	
	Позиция = 2;
	Для Индекс = 0 По Токены.ВГраница() Цикл
		ДлинаСтарого = СтрДлина(Токены[Индекс]);
		Дельта = СтрДлина(НовыеТокены[Индекс]) - ДлинаСтарого;
		Если Дельта <> 0 Тогда
			СкорректироватьПозицииПереносов(ПозицииПереносов, Позиция + ДлинаСтарого, Дельта);
		КонецЕсли;
		Позиция = Позиция + ДлинаСтарого + 1;
	КонецЦикла;
	
	НовыйПлоский = "{" + СтрСоединить(НовыеТокены, ",") + "}";
	Если ХвостоваяЗапятая Тогда
		НовыйПлоский = НовыйПлоский + ",";
	КонецЕсли;
	
	Возврат ВставитьПереносыСтрок(НовыйПлоский, ПозицииПереносов);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПеренумероватьТокеныЗаписиLgp(Токены, Карты)
	
	НовыеТокены = Новый Массив;
	Для Индекс = 0 По Токены.ВГраница() Цикл
		НовыеТокены.Добавить(Токены[Индекс]);
	КонецЦикла;
	
	ВерхняяГраницаТокенов = НовыеТокены.ВГраница();
	Для Каждого ПолеСсылки Из ПоляСсылокЗаписиLgp() Цикл
		// ИндексПоля — 0-based; доступен только при ИндексПоля <= ВГраница().
		Если ПолеСсылки.ИндексПоля > ВерхняяГраницаТокенов Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПолеСсылки.Составное Тогда
			НовыеТокены[ПолеСсылки.ИндексПоля] = ПеренумероватьСоставноеПоле(
				НовыеТокены[ПолеСсылки.ИндексПоля],
				Карты.Получить(ПолеСсылки.ТипОбъекта));
		Иначе
			НовыеТокены[ПолеСсылки.ИндексПоля] = ЗаменитьНомерПоТипу(
				НовыеТокены[ПолеСсылки.ИндексПоля],
				Карты,
				ПолеСсылки.ТипОбъекта);
		КонецЕсли;
	КонецЦикла;
	
	Возврат НовыеТокены;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СобратьПлоскийТекстИПереносы(БуферЗаписи)
	
	// Храним тип разрыва: LF / CRLF / CR — иначе CR из CRLF попадает в плоский текст и ломает токены.
	// Фрагменты между разрывами копируем целиком (Сред), без склейки по символу.
	Фрагменты = Новый Массив;
	ПозицииПереносов = Новый Массив;
	ДлинаПлоского = 0;
	НачалоФрагмента = 1;
	Индекс = 1;
	Длина = СтрДлина(БуферЗаписи);
	Пока Индекс <= Длина Цикл
		Символ = Сред(БуферЗаписи, Индекс, 1);
		Если Символ = Символы.ВК Тогда
			Если НачалоФрагмента < Индекс Тогда
				ДлинаКуска = Индекс - НачалоФрагмента;
				Фрагменты.Добавить(Сред(БуферЗаписи, НачалоФрагмента, ДлинаКуска));
				ДлинаПлоского = ДлинаПлоского + ДлинаКуска;
			КонецЕсли;
			Если Сред(БуферЗаписи, Индекс + 1, 1) = Символы.ПС Тогда
				ПозицииПереносов.Добавить(Новый Структура("Позиция,Разрыв",
					ДлинаПлоского, Символы.ВК + Символы.ПС));
				Индекс = Индекс + 2;
			Иначе
				ПозицииПереносов.Добавить(Новый Структура("Позиция,Разрыв",
					ДлинаПлоского, Символы.ВК));
				Индекс = Индекс + 1;
			КонецЕсли;
			НачалоФрагмента = Индекс;
		ИначеЕсли Символ = Символы.ПС Тогда
			Если НачалоФрагмента < Индекс Тогда
				ДлинаКуска = Индекс - НачалоФрагмента;
				Фрагменты.Добавить(Сред(БуферЗаписи, НачалоФрагмента, ДлинаКуска));
				ДлинаПлоского = ДлинаПлоского + ДлинаКуска;
			КонецЕсли;
			ПозицииПереносов.Добавить(Новый Структура("Позиция,Разрыв",
				ДлинаПлоского, Символы.ПС));
			Индекс = Индекс + 1;
			НачалоФрагмента = Индекс;
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если НачалоФрагмента <= Длина Тогда
		Фрагменты.Добавить(Сред(БуферЗаписи, НачалоФрагмента));
	КонецЕсли;
	
	Возврат Новый Структура("Плоский,ПозицииПереносов", СтрСоединить(Фрагменты, ""), ПозицииПереносов);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура СкорректироватьПозицииПереносов(ПозицииПереносов, Порог, Дельта)
	
	Для Индекс = 0 По ПозицииПереносов.ВГраница() Цикл
		Описание = ПозицииПереносов[Индекс];
		Если Описание.Позиция >= Порог Тогда
			Описание.Позиция = Описание.Позиция + Дельта;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВставитьПереносыСтрок(Плоский, ПозицииПереносов)
	
	Если ПозицииПереносов.Количество() = 0 Тогда
		Возврат Плоский;
	КонецЕсли;
	
	Части = Новый Массив;
	ДлинаПлоского = СтрДлина(Плоский);
	ПредыдущаяПозиция = 0;
	
	Для Индекс = 0 По ПозицииПереносов.ВГраница() Цикл
		Описание = ПозицииПереносов[Индекс];
		Позиция = Описание.Позиция;
		Если Позиция < ПредыдущаяПозиция Или Позиция > ДлинаПлоского Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить(Сред(Плоский, ПредыдущаяПозиция + 1, Позиция - ПредыдущаяПозиция));
		Части.Добавить(Описание.Разрыв);
		ПредыдущаяПозиция = Позиция;
	КонецЦикла;
	
	Части.Добавить(Сред(Плоский, ПредыдущаяПозиция + 1));
	Возврат СтрСоединить(Части, "");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаменитьНомерПоТипу(Токен, Карты, ТипОбъекта)
	
	Карта = Карты.Получить(ТипОбъекта);
	Если Карта = Неопределено Тогда
		Возврат Токен;
	КонецЕсли;
	
	Возврат ЗаменитьНомер(Токен, Карта);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаменитьНомер(Токен, Карта)
	
	Значение = СокрЛП(Токен);
	Номер = ЧислоИзТокена(Значение);
	Если Номер <= 0 Тогда
		Возврат Токен;
	КонецЕсли;
	
	НовыйНомер = Карта.Получить(Номер);
	Если НовыйНомер = Неопределено Тогда
		Возврат Токен;
	КонецЕсли;
	
	Возврат ФорматЧислаПротокола(НовыйНомер);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПеренумероватьСоставноеПоле(Токен, Карта)
	
	Если Карта = Неопределено Тогда
		Возврат Токен;
	КонецЕсли;
	
	Значение = СокрЛП(Токен);
	Если Не СтрНачинаетсяС(Значение, "{") Тогда
		Возврат ЗаменитьНомер(Токен, Карта);
	КонецЕсли;
	Если Не СтрЗаканчиваетсяНа(Значение, "}") Тогда
		Возврат Токен;
	КонецЕсли;
	
	Части = Токенизировать(ТелоСкобочнойЗаписи(Значение));
	Для Индекс = 0 По Части.ВГраница() Цикл
		Части[Индекс] = ЗаменитьНомер(Части[Индекс], Карта);
	КонецЦикла;
	
	Возврат "{" + СтрСоединить(Части, ",") + "}";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура КопироватьФайлСЗаменой(Источник, Приемник)
	
	Если ФайлСуществует(Приемник) Тогда
		УдалитьФайлы(Приемник);
	КонецЕсли;
	КопироватьФайл(Источник, Приемник);
	
КонецПроцедуры

#КонецОбласти

#Область РазборТекста

&НаКлиентеНаСервереБезКонтекста
Функция КодировкаТекстаЖурнала(ПутьКФайлу)
	
	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ПерваяСтрока = Чтение.ПрочитатьСтроку();
	Чтение.Закрыть();
	
	Кодировка = КодировкаТекста.UTF8;
	Если ПерваяСтрока <> Неопределено И СтрНайти(ПерваяСтрока, МаркерФорматаЖР()) = 0 Тогда
		Кодировка = КодировкаТекста.UTF16;
	КонецЕсли;
	
	Возврат Кодировка;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОткрытьЧтениеЖурнала(ПутьКФайлу)
	
	Возврат Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекстаЖурнала(ПутьКФайлу));
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьСыройТекстЖурналаUTF8(ПутьКФайлу)
	
	Данные = Новый ДвоичныеДанные(ПутьКФайлу);
	Текст = ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
	// BOM UTF-8 (EF BB BF) после декодирования часто остаётся как U+FEFF.
	Если СтрДлина(Текст) > 0 И КодСимвола(Лев(Текст, 1)) = 65279 Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаписатьСыройТекстЖурналаUTF8(ПутьКФайлу, Текст)
	
	// Нативные .lgp/.lgf: UTF-8 с BOM EF BB BF.
	Данные = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина);
	Данные.Записать(ПутьКФайлу);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДописатьСыройТекстЖурналаUTF8БезBOM(ПутьКФайлу, Текст)
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	
	Поток = Неопределено;
	Запись = Неопределено;
	Попытка
		Поток = ФайловыеПотоки.ОткрытьДляДописывания(ПутьКФайлу);
		Запись = Новый ЗаписьДанных(Поток);
		Буфер = ПолучитьБуферДвоичныхДанныхИзСтроки(Текст, КодировкаТекста.UTF8);
		Запись.ЗаписатьБуферДвоичныхДанных(Буфер);
	Исключение
		Если Запись <> Неопределено Тогда
			Запись.Закрыть();
		КонецЕсли;
		Если Поток <> Неопределено Тогда
			Поток.Закрыть();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
	Запись.Закрыть();
	Поток.Закрыть();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РазрывСтрокЗаголовкаLgp()
	
	Возврат Символы.ВК + Символы.ПС;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РазрывСтрокИзФрагмента(Фрагмент)
	
	Если СтрНайти(Фрагмент, Символы.ВК + Символы.ПС) > 0 Тогда
		Возврат Символы.ВК + Символы.ПС;
	ИначеЕсли СтрНайти(Фрагмент, Символы.ПС) > 0 Тогда
		Возврат Символы.ПС;
	ИначеЕсли СтрНайти(Фрагмент, Символы.ВК) > 0 Тогда
		Возврат Символы.ВК;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РазделитьЗаголовокИТелоLgp(Текст)
	
	// Три логические строки: версия, GUID, пустая — с исходными разрывами.
	Позиция = 1;
	НомерСтроки = 0;
	Длина = СтрДлина(Текст);
	Пока Позиция <= Длина И НомерСтроки < 3 Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = Символы.ВК Тогда
			Если Сред(Текст, Позиция + 1, 1) = Символы.ПС Тогда
				Позиция = Позиция + 2;
			Иначе
				Позиция = Позиция + 1;
			КонецЕсли;
			НомерСтроки = НомерСтроки + 1;
		ИначеЕсли Символ = Символы.ПС Тогда
			Позиция = Позиция + 1;
			НомерСтроки = НомерСтроки + 1;
		Иначе
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	
	Заголовок = Лев(Текст, Позиция - 1);
	Тело = Сред(Текст, Позиция);
	Возврат Новый Структура("Заголовок,Тело", Заголовок, Тело);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокСодержитПустуюСтрокуПослеGUID(Заголовок)
	
	НомерСтроки = 0;
	ПустаяТекущая = Истина;
	Индекс = 1;
	Длина = СтрДлина(Заголовок);
	Пока Индекс <= Длина Цикл
		Символ = Сред(Заголовок, Индекс, 1);
		Если Символ = Символы.ВК Тогда
			Если НомерСтроки = 2 И ПустаяТекущая Тогда
				Возврат Истина;
			КонецЕсли;
			НомерСтроки = НомерСтроки + 1;
			ПустаяТекущая = Истина;
			Если Сред(Заголовок, Индекс + 1, 1) = Символы.ПС Тогда
				Индекс = Индекс + 2;
			Иначе
				Индекс = Индекс + 1;
			КонецЕсли;
			Продолжить;
		ИначеЕсли Символ = Символы.ПС Тогда
			Если НомерСтроки = 2 И ПустаяТекущая Тогда
				Возврат Истина;
			КонецЕсли;
			НомерСтроки = НомерСтроки + 1;
			ПустаяТекущая = Истина;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		ПустаяТекущая = Ложь;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат НомерСтроки >= 3 И ПустаяТекущая;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОбеспечитьХвостовуюЗапятуюВЗаписиLgp(БуферЗаписи)
	
	Хвост = "";
	Текст = БуферЗаписи;
	Пока СтрДлина(Текст) > 0 Цикл
		Символ = Сред(Текст, СтрДлина(Текст), 1);
		Если Символ = Символы.ПС Или Символ = Символы.ВК Или Символ = " " Или Символ = Символы.Таб Тогда
			Хвост = Символ + Хвост;
			Текст = Лев(Текст, СтрДлина(Текст) - 1);
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ПустаяСтрока(Текст) И Не СтрЗаканчиваетсяНа(Текст, ",") Тогда
		Текст = Текст + ",";
	КонецЕсли;
	
	Возврат Текст + Хвост;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция УбратьХвостовуюЗапятуюВЗаписиLgp(БуферЗаписи)
	
	Хвост = "";
	Текст = БуферЗаписи;
	Пока СтрДлина(Текст) > 0 Цикл
		Символ = Сред(Текст, СтрДлина(Текст), 1);
		Если Символ = Символы.ПС Или Символ = Символы.ВК Или Символ = " " Или Символ = Символы.Таб Тогда
			Хвост = Символ + Хвост;
			Текст = Лев(Текст, СтрДлина(Текст) - 1);
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрЗаканчиваетсяНа(Текст, ",") Тогда
		Текст = Лев(Текст, СтрДлина(Текст) - 1);
	КонецЕсли;
	
	Возврат Текст + Хвост;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция Токенизировать(Знач Текст)
	
	Токены = Новый Массив;
	Текущий = "";
	Глубина = 0;
	ВКавычках = Ложь;
	Индекс = 1;
	Длина = СтрДлина(Текст);
	
	Пока Индекс <= Длина Цикл
		
		Символ = Сред(Текст, Индекс, 1);
		
		Если ВКавычках Тогда
			Текущий = Текущий + Символ;
			Если Символ = """" Тогда
				Если Сред(Текст, Индекс + 1, 1) = """" Тогда
					Текущий = Текущий + """";
					Индекс = Индекс + 2;
					Продолжить;
				КонецЕсли;
				ВКавычках = Ложь;
			КонецЕсли;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		
		Если Символ = """" Тогда
			ВКавычках = Истина;
			Текущий = Текущий + Символ;
		ИначеЕсли Символ = "{" Тогда
			Глубина = Глубина + 1;
			Текущий = Текущий + Символ;
		ИначеЕсли Символ = "}" Тогда
			Глубина = Глубина - 1;
			Текущий = Текущий + Символ;
		ИначеЕсли Символ = "," И Глубина = 0 Тогда
			Токены.Добавить(СокрЛП(Текущий));
			Текущий = "";
		Иначе
			Текущий = Текущий + Символ;
		КонецЕсли;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	Если Не ПустаяСтрока(Текущий) Или Длина > 0 Тогда
		Токены.Добавить(СокрЛП(Текущий));
	КонецЕсли;
	
	Возврат Токены;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоСкобочнаяЗапись(Знач Значение)
	
	Возврат СтрНачинаетсяС(Значение, "{") И СтрЗаканчиваетсяНа(Значение, "}");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТелоСкобочнойЗаписи(Знач Значение)
	
	Возврат Сред(Значение, 2, СтрДлина(Значение) - 2);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция УбратьХвостовуюЗапятую(Знач Значение)
	
	Если СтрЗаканчиваетсяНа(Значение, ",") Тогда
		Возврат Лев(Значение, СтрДлина(Значение) - 1);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СнятьКавычки(Знач Значение)
	
	Значение = СокрЛП(Значение);
	Если СтрДлина(Значение) >= 2 И СтрНачинаетсяС(Значение, """") И СтрЗаканчиваетсяНа(Значение, """") Тогда
		Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
		Значение = СтрЗаменить(Значение, """""", """");
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭкранироватьКавычки(Знач Значение)
	
	Возврат СтрЗаменить(Строка(Значение), """", """""");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЧислоИзТокена(Знач Значение)
	
	Значение = СокрЛП(Значение);
	Если ПустаяСтрока(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Индекс);
		Если Код < 48 Или Код > 57 Тогда
			Возврат 0;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Число(Значение);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФорматЧислаПротокола(Значение)
	
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеРазмера(Размер)
	
	Если Размер < 1024 Тогда
		Возврат ФорматЧислаПротокола(Размер) + " Б";
	ИначеЕсли Размер < 1024 * 1024 Тогда
		Возврат Формат(Размер / 1024, "ЧДЦ=1; ЧН=0") + " КБ";
	ИначеЕсли Размер < 1024 * 1024 * 1024 Тогда
		Возврат Формат(Размер / 1024 / 1024, "ЧДЦ=1; ЧН=0") + " МБ";
	КонецЕсли;
	
	Возврат Формат(Размер / 1024 / 1024 / 1024, "ЧДЦ=2; ЧН=0") + " ГБ";
	
КонецФункции

