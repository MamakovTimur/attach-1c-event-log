КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПротоколБлокировокПриемника()
	
	ДобавитьВПротокол("--- Блокировки файлов приёмника ---");
	КэшБлокировок = Новый Соответствие;
	Заблокированные = НайтиЗаблокированныеФайлыПриемника(КэшБлокировок);
	
	Если Заблокированные.Количество() = 0 Тогда
		ДобавитьВПротокол("Блокировок не обнаружено (проверка переименованием).");
	Иначе
		ДобавитьВПротокол("Обнаружена блокировка — кластер/процесс держит файлы. Работайте с копией 1Cv8Log:");
		Для Каждого ИмяФайла Из Заблокированные Цикл
			ДобавитьВПротокол("  " + ИмяФайла);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПротоколБлокировокПриемникаНаСервереКонтекста()
	
	ДобавитьВПротоколНаСервереКонтекста("--- Блокировки файлов приёмника ---");
	КэшБлокировок = Новый Соответствие;
	Заблокированные = НайтиЗаблокированныеФайлыПриемникаНаСервереКонтекста(КэшБлокировок);
	
	Если Заблокированные.Количество() = 0 Тогда
		ДобавитьВПротоколНаСервереКонтекста("Блокировок не обнаружено (проверка переименованием).");
	Иначе
		ДобавитьВПротоколНаСервереКонтекста("Обнаружена блокировка — кластер/процесс держит файлы. Работайте с копией 1Cv8Log:");
		Для Каждого ИмяФайла Из Заблокированные Цикл
			ДобавитьВПротоколНаСервереКонтекста("  " + ИмяФайла);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКаталоги()
	
	Если ПустаяСтрока(КаталогИсточника) Тогда
		ВызватьИсключение "Укажите каталог старого журнала регистрации.";
	КонецЕсли;
	Если ПустаяСтрока(КаталогПриемника) Тогда
		ВызватьИсключение "Укажите каталог текущего журнала регистрации.";
	КонецЕсли;
	
	ПроверитьЧтоКаталогСуществует(КаталогИсточника, "Каталог источника не найден: ");
	ПроверитьЧтоКаталогСуществует(КаталогПриемника, "Каталог приёмника не найден: ");
	
	Если ВРег(СокрЛП(КаталогИсточника)) = ВРег(СокрЛП(КаталогПриемника)) Тогда
		ВызватьИсключение "Каталоги источника и приёмника совпадают.";
	КонецЕсли;
	
	Если Не ФайлСуществует(ПутьКСловарюЖР(КаталогИсточника)) Тогда
		ВызватьИсключение "В каталоге источника нет 1Cv8.lgf. Укажите папку 1Cv8Log старого кластера.";
	КонецЕсли;
	Если Не ФайлСуществует(ПутьКСловарюЖР(КаталогПриемника)) Тогда
		ВызватьИсключение "В каталоге приёмника нет 1Cv8.lgf. Укажите папку 1Cv8Log текущего кластера.";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьКаталогиНаСервереКонтекста()
	
	Если ПустаяСтрока(КаталогИсточника) Тогда
		ВызватьИсключение "Укажите каталог старого журнала регистрации.";
	КонецЕсли;
	Если ПустаяСтрока(КаталогПриемника) Тогда
		ВызватьИсключение "Укажите каталог текущего журнала регистрации.";
	КонецЕсли;
	
	ПроверитьЧтоКаталогСуществует(КаталогИсточника, "Каталог источника не найден: ");
	ПроверитьЧтоКаталогСуществует(КаталогПриемника, "Каталог приёмника не найден: ");
	
	Если ВРег(СокрЛП(КаталогИсточника)) = ВРег(СокрЛП(КаталогПриемника)) Тогда
		ВызватьИсключение "Каталоги источника и приёмника совпадают.";
	КонецЕсли;
	
	Если Не ФайлСуществует(ПутьКСловарюЖР(КаталогИсточника)) Тогда
		ВызватьИсключение "В каталоге источника нет 1Cv8.lgf. Укажите папку 1Cv8Log старого кластера.";
	КонецЕсли;
	Если Не ФайлСуществует(ПутьКСловарюЖР(КаталогПриемника)) Тогда
		ВызватьИсключение "В каталоге приёмника нет 1Cv8.lgf. Укажите папку 1Cv8Log текущего кластера.";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьЧтоКаталогСуществует(ПутьКаталога, ПрефиксОшибки)
	
	КаталогФайл = Новый Файл(ПутьКаталога);
	Если Не КаталогФайл.Существует() Тогда
		ВызватьИсключение ПрефиксОшибки + ПутьКаталога;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрисоединитьПослеПодтверждения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	СброситьПротокол();
	ПодготовитьСеансОтладки("attach");
	
	Попытка
		Если ВыполнятьНаСервере Тогда
			НачатьПрисоединениеНаСервереПакетами();
			Возврат;
		Иначе
			ВыполнитьПрисоединение();
		КонецЕсли;
		ПоказатьПредупреждение(, "Присоединение завершено. См. протокол.");
		УстановитьШагМастера(3);
	Исключение
		Информация = ИнформацияОбОшибке();
		ДобавитьВПротокол("Ошибка: " + ПодробноеПредставлениеОшибки(Информация));
		ДобавитьВОтладочныйЛог("[ERROR] attach_failed=" + КраткоеПредставлениеОшибки(Информация));
		ДобавитьВОтладочныйЛог(ПодробноеПредставлениеОшибки(Информация));
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(Информация));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьПрисоединениеНаСервереБезопасно()
	
	ВыполнитьПрисоединениеНаСервереКонтекста();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПрисоединение()
	
	МоментНачала = ТекущаяДата();
	ДобавитьВПротокол("=== Начало присоединения ===");
	
	ПроверитьКаталоги();
	
	Заблокированные = НайтиЗаблокированныеФайлыПриемника();
	Если Заблокированные.Количество() > 0 Тогда
		ТекстБлокировки = "Файлы приёмника заблокированы (вероятно, ragent/кластер). "
			+ "Скопируйте 1Cv8Log и работайте с копией. Заблокировано: "
			+ СтрСоединить(Заблокированные, ", ");
		ВызватьИсключение ТекстБлокировки;
	КонецЕсли;
	
	ПутьLgfИсточника = ПутьКСловарюЖР(КаталогИсточника);
	ПутьLgfПриемника = ПутьКСловарюЖР(КаталогПриемника);
	
	ДанныеАнализа = ПолучитьДанныеАнализаДляПрисоединения(ПутьLgfИсточника, ПутьLgfПриемника);
	СловарьИсточника = ДанныеАнализа.СловарьИсточника;
	СловарьПриемника = ДанныеАнализа.СловарьПриемника;
	РезультатКарт = ДанныеАнализа.РезультатКарт;
	НужнаПеренумерация = РезультатКарт.НужнаПеренумерация;
	
	Если РежимОтладки Тогда
		ДобавитьВОтладочныйЛог("[METRIC] need_renumber=" + ?(НужнаПеренумерация, "true", "false"));
		ДобавитьВОтладочныйЛог("[METRIC] lgf_before_entries="
			+ ФорматЧислаПротокола(СловарьПриемника.Количество));
		ДобавитьВОтладочныйЛог("[METRIC] lgf_new_entries="
			+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	КонецЕсли;
	
	ЗаписейLgfДо = СловарьПриемника.Количество;
	
	Если СоздаватьРезервнуюКопию Тогда
		ПутьКопииКаталога = СоздатьВыборочнуюКопиюФайловПриемника(РезультатКарт);
		ДобавитьВПротокол("Резервная копия изменяемых файлов: " + ПутьКопииКаталога);
	КонецЕсли;
	
	Если РезультатКарт.ДобавленныеСтроки.Количество() > 0 Тогда
		ДописатьСтрокиВLgf(ПутьLgfПриемника, РезультатКарт.ДобавленныеСтроки);
		ДобавитьВПротокол("В 1Cv8.lgf добавлено записей: "
			+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	Иначе
		ДобавитьВПротокол("Словарь приёмника уже содержит все объекты источника.");
	КонецЕсли;
	
	Если РежимОтладки Тогда
		Для Каждого СтрокаОтладки Из СтрокиОтладкиLgfПослеДописки(
			ПутьLgfПриемника, РезультатКарт.ДобавленныеСтроки.Количество(), ЗаписейLgfДо) Цикл
			ДобавитьВОтладочныйЛог(СтрокаОтладки);
		КонецЦикла;
	КонецЕсли;
	
	Обработано = 0;
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		
		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		#Если Клиент Тогда
		ОбработкаПрерыванияПользователя();
		Состояние("Присоединение " + СтрокаФайла.ИмяФайла);
		#КонецЕсли
		
		Если ВнутреннийКодДействияФайла(СтрокаФайла.Действие) = РежимКонфликтаПропустить()
			И ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
			ДобавитьВПротокол("Пропущен (уже есть): " + СтрокаФайла.ИмяФайла);
			Если РежимОтладки Тогда
				ДобавитьВОтладочныйЛог("[FILE] " + СтрокаФайла.ИмяФайла + " action=skip");
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Объединять = (ВнутреннийКодДействияФайла(СтрокаФайла.Действие) = РежимКонфликтаОбъединить()
			И ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника));
		
		СведенияФайла = Неопределено;
		МетрикиДо = Неопределено;
		МетрикиИсточника = Неопределено;
		Если РежимОтладки Тогда
			СведенияФайла = Новый Структура;
			МетрикиДо = СобратьМетрикиФайлаLgp(СтрокаФайла.ПолныйПутьПриемника);
			МетрикиИсточника = СобратьМетрикиФайлаLgp(СтрокаФайла.ПолныйПутьИсточника);
		КонецЕсли;
		
		ПрисоединитьФайлLgp(
			СтрокаФайла.ПолныйПутьИсточника,
			СтрокаФайла.ПолныйПутьПриемника,
			СловарьПриемника,
			РезультатКарт.Карты,
			Объединять,
			НужнаПеренумерация,
			СведенияФайла,
			ОпцииСклейкиИзРеквизитовФормы());
		
		Если РежимОтладки Тогда
			МетрикиПосле = СобратьМетрикиФайлаLgp(СтрокаФайла.ПолныйПутьПриемника);
			ЗаписатьОтладкуОперацииФайла(
				СтрокаФайла.ИмяФайла,
				Объединять,
				СведенияФайла,
				МетрикиИсточника,
				МетрикиДо,
				МетрикиПосле);
		КонецЕсли;
		
		Если Объединять Тогда
			ДобавитьВПротокол("Объединён: " + СтрокаФайла.ИмяФайла);
		Иначе
			ДобавитьВПротокол("Скопирован: " + СтрокаФайла.ИмяФайла);
		КонецЕсли;
		
		Обработано = Обработано + 1;
		
	КонецЦикла;
	
	УдалитьИндексыЖурнала(КаталогПриемника);
	ДобавитьВПротокол("Обработано файлов: " + ФорматЧислаПротокола(Обработано));
	ДобавитьВПротокол("Индексы *.lgx удалены - платформа построит их заново при открытии ЖР.");
	
	Если РежимОтладки Тогда
		ДобавитьВОтладочныйЛог("[METRIC] files_processed=" + ФорматЧислаПротокола(Обработано));
		ДобавитьВОтладочныйЛог("=== DEBUG SESSION attach END ===");
	КонецЕсли;
	
	Если ПроверятьЦелостность Тогда
		ДобавитьВПротокол("--- Контроль после записи ---");
		СловарьПосле = ПрочитатьСловарьLgf(ПутьLgfПриемника);
		ЗамечанияПосле = 0;
		КэшЦелостности = Новый Соответствие;
		Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
			Если Не СтрокаФайла.Пометка Или Не ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
				Продолжить;
			КонецЕсли;
			Если ВнутреннийКодДействияФайла(СтрокаФайла.Действие) = РежимКонфликтаПропустить() Тогда
				Продолжить;
			КонецЕсли;
			Результат = ПроверитьЦелостностьФайлаLgp(
				СтрокаФайла.ПолныйПутьПриемника,
				СловарьПосле.GUID,
				СловарьПосле.Версия,
				КэшЦелостности);
			Если Не Результат.Ок Тогда
				ЗамечанияПосле = ЗамечанияПосле + 1;
				ДобавитьВПротокол("  " + СтрокаФайла.ИмяФайла + ": " + Результат.Сообщение);
			КонецЕсли;
		КонецЦикла;
		Если ЗамечанияПосле = 0 Тогда
			ДобавитьВПротокол("Контроль после записи: замечаний нет — заголовки периодов согласованы с новым журналом.");
		Иначе
			ДобавитьВПротокол("Контроль после записи: замечаний "
				+ ФорматЧислаПротокола(ЗамечанияПосле)
				+ ". Часть периодов может не открыться — см. формулировки выше.");
		КонецЕсли;
	КонецЕсли;
	
	ДобавитьВПротокол("=== Конец присоединения. Длительность: "
		+ ПредставлениеДлительностиПротокола(ТекущаяДата() - МоментНачала) + " ===");
	ДобавитьВПротокол("Готово. Если работали с копией, остановите кластер и подмените каталог 1Cv8Log.");
	
КонецПроцедуры

&НаСервере
