&НаКлиенте
Функция СоздатьВыборочнуюКопиюФайловПриемника(РезультатКарт)

	ОбеспечитьКаталогБазыРезервнойКопии(КаталогРезервнойКопии);
	ПутьКопии = ПутьКаталогаРезервнойКопии(КаталогПриемника, КаталогРезервнойКопии);
	СоздатьКаталог(ПутьКопии);
	ОтметитьРезервнуюКопиюКакНезавершенную(ПутьКопии);

	Скопировано = 0;
	ПутьLgf = ПутьКСловарюЖР(КаталогПриемника);
	Если ФайлСуществует(ПутьLgf) Тогда
		КопироватьФайл(ПутьLgf, ОбъединитьПуть(ПутьКопии, ИмяФайлаСловаряЖР()));
		Скопировано = Скопировано + 1;
	КонецЕсли;

	Если РазбиватьИсточникПоДням Тогда
		ФайлыПриемника = НайтиФайлы(КаталогПриемника, "*.lgp", Ложь);
		Для Каждого ФайлПриемника Из ФайлыПриемника Цикл
			Если Не ФайлПриемника.ЭтоКаталог() Тогда
				КопироватьФайл(ФайлПриемника.ПолноеИмя, ОбъединитьПуть(ПутьКопии, ФайлПриемника.Имя));
				Скопировано = Скопировано + 1;
			КонецЕсли;
		КонецЦикла;
		ДобавитьВПротокол("Для разбивки по дням сохранены все существующие периоды приёмника.");
	Иначе
		Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл

		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Код = ВнутреннийКодДействияФайла(СтрокаФайла.Действие);
		Если Код = РежимКонфликтаПропустить() Тогда
			Продолжить;
		КонецЕсли;
		Если ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
			КопироватьФайл(СтрокаФайла.ПолныйПутьПриемника, ОбъединитьПуть(ПутьКопии, СтрокаФайла.ИмяФайла));
			Скопировано = Скопировано + 1;
		КонецЕсли;

		КонецЦикла;
	КонецЕсли;
	ЗавершитьРезервнуюКопию(ПутьКопии, КаталогПриемника);

	ДобавитьВПротокол("В резервную копию скопировано файлов: " + ФорматЧислаПротокола(Скопировано));
	ДобавитьВПротокол("Каталог резервной копии: " + ПутьКопии);
	Возврат ПутьКопии;

КонецФункции

&НаСервере
Функция СоздатьВыборочнуюКопиюФайловПриемникаНаСервереКонтекста(РезультатКарт)

	ОбеспечитьКаталогБазыРезервнойКопии(КаталогРезервнойКопии);
	ПутьКопии = ПутьКаталогаРезервнойКопии(КаталогПриемника, КаталогРезервнойКопии);
	СоздатьКаталог(ПутьКопии);
	ОтметитьРезервнуюКопиюКакНезавершенную(ПутьКопии);

	Скопировано = 0;
	ПутьLgf = ПутьКСловарюЖР(КаталогПриемника);
	Если ФайлСуществует(ПутьLgf) Тогда
		КопироватьФайл(ПутьLgf, ОбъединитьПуть(ПутьКопии, ИмяФайлаСловаряЖР()));
		Скопировано = Скопировано + 1;
	КонецЕсли;

	Если РазбиватьИсточникПоДням Тогда
		ФайлыПриемника = НайтиФайлы(КаталогПриемника, "*.lgp", Ложь);
		Для Каждого ФайлПриемника Из ФайлыПриемника Цикл
			Если Не ФайлПриемника.ЭтоКаталог() Тогда
				КопироватьФайл(ФайлПриемника.ПолноеИмя, ОбъединитьПуть(ПутьКопии, ФайлПриемника.Имя));
				Скопировано = Скопировано + 1;
			КонецЕсли;
		КонецЦикла;
		ДобавитьВПротоколНаСервереКонтекста(
			"Для разбивки по дням сохранены все существующие периоды приёмника.");
	Иначе
		Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл

		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Код = ВнутреннийКодДействияФайла(СтрокаФайла.Действие);
		Если Код = РежимКонфликтаПропустить() Тогда
			Продолжить;
		КонецЕсли;
		Если ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
			КопироватьФайл(СтрокаФайла.ПолныйПутьПриемника, ОбъединитьПуть(ПутьКопии, СтрокаФайла.ИмяФайла));
			Скопировано = Скопировано + 1;
		КонецЕсли;

		КонецЦикла;
	КонецЕсли;
	ЗавершитьРезервнуюКопию(ПутьКопии, КаталогПриемника);

	ДобавитьВПротоколНаСервереКонтекста("В резервную копию скопировано файлов: " + ФорматЧислаПротокола(Скопировано));
	ДобавитьВПротоколНаСервереКонтекста("Каталог резервной копии: " + ПутьКопии);
	Возврат ПутьКопии;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОписаниеМестаРезервнойКопии(КаталогБазыРезервнойКопии)

	База = СокрЛП(КаталогБазыРезервнойКопии);
	Если ПустаяСтрока(База) Тогда
		Возврат "рядом с приёмником (*.bak_… у родителя каталога 1Cv8Log)";
	КонецЕсли;

	Возврат "в каталоге «" + База + "» (подкаталоги *.bak_…)";

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбеспечитьКаталогБазыРезервнойКопии(КаталогБазыРезервнойКопии)

	База = СокрЛП(КаталогБазыРезервнойКопии);
	Если ПустаяСтрока(База) Тогда
		Возврат;
	КонецЕсли;

	Если ФайлСуществует(База) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		СоздатьКаталог(База);
	Исключение
		ВызватьИсключение "Не удалось создать каталог резервной копии: " + База
			+ Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Если Не ФайлСуществует(База) Тогда
		ВызватьИсключение "Каталог резервной копии не существует и не создан: " + База;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПутьКаталогаРезервнойКопии(КаталогЖР, КаталогБазыРезервнойКопии)

	КаталогФайл = Новый Файл(КаталогЖР);
	ИмяКаталога = КаталогФайл.Имя;
	Если ПустаяСтрока(ИмяКаталога) Тогда
		ИмяКаталога = ИмяКаталогаЖР();
	КонецЕсли;

	СуффиксИмени = ИмяКаталога + ".bak_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss");
	База = СокрЛП(КаталогБазыРезервнойКопии);
	Если ПустаяСтрока(База) Тогда
		Родитель = КаталогФайл.Путь;
		Возврат ОбъединитьПуть(Родитель, СуффиксИмени);
	КонецЕсли;

	Возврат ОбъединитьПуть(База, СуффиксИмени);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПрефиксИмениКаталогаРезервнойКопии(КаталогЖР)

	КаталогФайл = Новый Файл(КаталогЖР);
	ИмяКаталога = КаталогФайл.Имя;
	Если ПустаяСтрока(ИмяКаталога) Тогда
		ИмяКаталога = ИмяКаталогаЖР();
	КонецЕсли;

	Возврат ИмяКаталога + ".bak_";

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НайтиКаталогиРезервныхКопий(КаталогЖР, КаталогБазыРезервнойКопии)

	Результат = Новый Массив;
	БазаПоиска = СокрЛП(КаталогБазыРезервнойКопии);
	Если ПустаяСтрока(БазаПоиска) Тогда
		КаталогФайл = Новый Файл(КаталогЖР);
		БазаПоиска = КаталогФайл.Путь;
	КонецЕсли;
	Если ПустаяСтрока(БазаПоиска) Тогда
		Возврат Результат;
	КонецЕсли;

	Префикс = ПрефиксИмениКаталогаРезервнойКопии(КаталогЖР);
	ПрефиксНРег = НРег(Префикс);
	Найденные = НайтиФайлы(БазаПоиска, Префикс + "*", Ложь);

	Для Каждого Элемент Из Найденные Цикл

		Если Не Элемент.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Если Не СтрНачинаетсяС(НРег(Элемент.Имя), ПрефиксНРег) Тогда
			Продолжить;
		КонецЕсли;
		ПутьМаркера = ОбъединитьПуть(
			Элемент.ПолноеИмя,
			ИмяФайлаМаркераНезавершеннойРезервнойКопии());
		Если ФайлСуществует(ПутьМаркера) Тогда
			Продолжить;
		КонецЕсли;

		Метка = Сред(Элемент.Имя, СтрДлина(Префикс) + 1);
		ДатаКопии = Неопределено;
		Попытка
			ДатаКопии = Элемент.ПолучитьВремяИзменения();
		Исключение
			ДатаКопии = Неопределено;
		КонецПопытки;

		РазмерБайт = РазмерФайловЖРВКаталоге(Элемент.ПолноеИмя);
		Представление = Элемент.Имя;
		Если ДатаКопии <> Неопределено Тогда
			Представление = Представление + " | " + Формат(ДатаКопии, "ДФ='dd.MM.yyyy HH:mm:ss'");
		ИначеЕсли Не ПустаяСтрока(Метка) Тогда
			Представление = Представление + " | метка " + Метка;
		КонецЕсли;
		Представление = Представление + " | " + ПредставлениеРазмера(РазмерБайт);

		Кандидат = Новый Структура("Путь,Представление,Имя",
			Элемент.ПолноеИмя, Представление, Элемент.Имя);
		Результат.Добавить(Кандидат);

	КонецЦикла;

	ОтсортироватьКандидатовРезервныхКопийПоИмениУбыв(Результат);
	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОтсортироватьКандидатовРезервныхКопийПоИмениУбыв(Кандидаты)

	Если Кандидаты.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;

	Для Индекс1 = 0 По Кандидаты.ВГраница() - 1 Цикл
		Для Индекс2 = Индекс1 + 1 По Кандидаты.ВГраница() Цикл
			Если Кандидаты[Индекс2].Имя > Кандидаты[Индекс1].Имя Тогда
				Временный = Кандидаты[Индекс1];
				Кандидаты[Индекс1] = Кандидаты[Индекс2];
				Кандидаты[Индекс2] = Временный;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
