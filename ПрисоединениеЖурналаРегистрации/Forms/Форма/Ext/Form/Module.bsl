#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСписокРежимовКонфликта();
	
	Если ПустаяСтрока(РежимКонфликта) Тогда
		РежимКонфликта = РежимКонфликтаОбъединить();
		СоздаватьРезервнуюКопию = Истина;
		ПроверятьЦелостность = Истина;
	КонецЕсли;
	
	ОбновитьВидимостьСтраницыОтладкиНаСервере();
	УстановитьОтображаемуюВерсиюОбработки();
	Если ШагМастера < 1 Или ШагМастера > 3 Тогда
		ШагМастера = 1;
	КонецЕсли;
	ОбновитьОтображениеМастераНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ПустаяСтрока(КаталогПриемника) И Не ВыполнятьНаСервере Тогда
		КаталогПриемника = КаталогЖРФайловойБазы();
	КонецЕсли;
	
	ОбновитьПодсказкуРежимаВыполнения();
	// Настройки формы подгружаются после ПриСозданииНаСервере —
	// видимость вкладки «Отладка» нужно синхронизировать ещё раз.
	ОбновитьВидимостьСтраницыОтладкиНаСервере();
	Если ШагМастера < 1 Или ШагМастера > 3 Тогда
		ШагМастера = 1;
	КонецЕсли;
	ОбновитьОтображениеМастера();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	ОбновитьВидимостьСтраницыОтладкиНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КаталогИсточникаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ВыполнятьНаСервере Тогда
		ВвестиПутьКаталогаСервера("КаталогИсточника", "Путь к старому ЖР на сервере (Linux/Windows сервера 1С)");
		Возврат;
	КонецЕсли;
	ВыбратьКаталогЖР("КаталогИсточника", "Каталог старого журнала регистрации (кластер 1)");
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогПриемникаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ВыполнятьНаСервере Тогда
		ВвестиПутьКаталогаСервера("КаталогПриемника", "Путь к текущему ЖР на сервере (Linux/Windows сервера 1С)");
		Возврат;
	КонецЕсли;
	ВыбратьКаталогЖР("КаталогПриемника", "Каталог текущего журнала регистрации (кластер 2)");
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогИсточникаПриИзменении(Элемент)
	
	СброситьПланАнализа();
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогПриемникаПриИзменении(Элемент)
	
	СброситьПланАнализа();
	
КонецПроцедуры

&НаКлиенте
Процедура РежимКонфликтаПриИзменении(Элемент)
	
	ОбновитьДействияКонфликтныхФайлов();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнятьНаСервереПриИзменении(Элемент)
	
	ОбновитьПодсказкуРежимаВыполнения();
	СброситьПланАнализа();
	
КонецПроцедуры

&НаКлиенте
Процедура РежимОтладкиПриИзменении(Элемент)
	
	ОбновитьВидимостьСтраницыОтладкиНаСервере();
	Если РежимОтладки Тогда
		Элементы.СтраницыПротокола.ТекущаяСтраница = Элементы.СтраницаОтладка;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Анализировать(Команда)
	
	СброситьПротокол();
	ПодготовитьСеансОтладки("analyze");
	
	Если Не ВыполнитьАнализБезопасно(Истина) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьШагМастера(2);
	
КонецПроцедуры

&НаКлиенте
Процедура Присоединить(Команда)
	
	Если Не АнализАктуален И ФайлыЖурнала.Количество() > 0 Тогда
		ПоказатьПредупреждение(, "Каталоги изменились — сначала выполните «Проанализировать (dry-run)».");
		Возврат;
	КонецЕсли;
	
	Если ФайлыЖурнала.Количество() = 0 Тогда
		Если Не ВыполнитьАнализБезопасно(Ложь) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	КоличествоОтмеченных = КоличествоОтмеченныхФайлов();
	Если КоличествоОтмеченных = 0 Тогда
		ПоказатьПредупреждение(, "Отметьте хотя бы один файл .lgp для присоединения.");
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = СформироватьТекстПодтвержденияПрисоединения(КоличествоОтмеченных);
	
	Оповещение = Новый ОписаниеОповещения("ПрисоединитьПослеПодтверждения", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлы(Команда)
	
	Если ВыполнятьНаСервере Тогда
		ПоказатьПредупреждение(,
			"В режиме «На сервере 1С» список файлов заполняется анализом по пути на сервере.
			|Кнопка «Выбрать файлы» работает только в клиентском режиме.");
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Файлы журнала регистрации старого кластера";
	Диалог.Фильтр = "Файлы журнала регистрации (*.lgp)|*.lgp|Все файлы (*.*)|*.*";
	Диалог.МножественныйВыбор = Истина;
	Диалог.ПроверятьСуществованиеФайла = Истина;
	Если Не ПустаяСтрока(КаталогИсточника) Тогда
		Диалог.Каталог = КаталогИсточника;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ВыбратьФайлыЗавершение", ЭтотОбъект);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	
	УстановитьПометкиФайлов(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	УстановитьПометкиФайлов(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиВКластереИсточник(Команда)
	
	НачатьПоискКаталогаЖРВSrvinfo("КаталогИсточника");
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиВКластереПриемник(Команда)
	
	НачатьПоискКаталогаЖРВSrvinfo("КаталогПриемника");
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьИзРезервнойКопии(Команда)
	
	Если ПустаяСтрока(СокрЛП(КаталогПриемника)) Тогда
		ПоказатьПредупреждение(, "Сначала укажите каталог текущего ЖР (приёмник).");
		Возврат;
	КонецЕсли;
	
	НачатьВосстановлениеИзРезервнойКопии();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПротокол(Команда)
	
	Если ПустаяСтрока(СокрЛП(ТекстПротокола)) Тогда
		ПоказатьПредупреждение(, "Протокол пуст — сохранять нечего.");
		Возврат;
	КонецЕсли;
	
	Если ВыполнятьНаСервере Тогда
		ОповещениеПути = Новый ОписаниеОповещения("СохранитьПротоколПослеВводаПутиСервера", ЭтотОбъект);
		ПоказатьВводСтроки(
			ОповещениеПути,
			"protocol_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".log",
			"Полный путь файла протокола на сервере 1С (.txt / .log)",
			0,
			Ложь);
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранить протокол";
	Диалог.ПолноеИмяФайла = "protocol_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".log";
	Диалог.Фильтр = "Протокол (*.log)|*.log|Текст (*.txt)|*.txt|Все файлы (*.*)|*.*";
	Диалог.МножественныйВыбор = Ложь;
	
	Оповещение = Новый ОписаниеОповещения("СохранитьПротоколЗавершениеВыбора", ЭтотОбъект);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура МастерДалее(Команда)
	
	Если ШагМастера <= 1 Тогда
		Если ПустаяСтрока(СокрЛП(КаталогИсточника)) Или ПустаяСтрока(СокрЛП(КаталогПриемника)) Тогда
			ПоказатьПредупреждение(,
				"Укажите каталоги старого и текущего ЖР (лучше копии, не живой srvinfo).");
			Возврат;
		КонецЕсли;
		УстановитьШагМастера(2);
		Возврат;
	КонецЕсли;
	
	Если ШагМастера = 2 Тогда
		Если Не АнализАктуален Или ФайлыЖурнала.Количество() = 0 Тогда
			СброситьПротокол();
			ПодготовитьСеансОтладки("analyze");
			Если Не ВыполнитьАнализБезопасно(Истина) Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		УстановитьШагМастера(3);
		Возврат;
	КонецЕсли;
	
	Присоединить(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура МастерНазад(Команда)
	
	Если ШагМастера <= 1 Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьШагМастера(ШагМастера - 1);
	
КонецПроцедуры

