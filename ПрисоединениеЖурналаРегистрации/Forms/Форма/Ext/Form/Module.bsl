&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьОтпечаткиПриемникаИзКэша(Опции, ПутьПриемника)

	Если Опции = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не Опции.Свойство("КэшОтпечатков") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Кэш = Опции.КэшОтпечатков;
	Если Кэш = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ключ = ВРег(СокрЛП(ПутьПриемника));
	Отпечатки = Кэш.Получить(Ключ);
	Если Отпечатки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Отпечатки;

КонецФункции

