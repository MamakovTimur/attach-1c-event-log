// Индексы полей записи .lgp в массиве токенов (0-based): Infostart 1-based минус 1.
// Не включать поле сеанса (Infostart 17 → индекс 16).
//
&НаКлиентеНаСервереБезКонтекста
Функция ПоляСсылокЗаписиLgp()
	
	Результат = Новый Массив;
	ДобавитьПолеСсылкиLgp(Результат, 3, ТипОбъектаПользователи(), Ложь);
	ДобавитьПолеСсылкиLgp(Результат, 4, ТипОбъектаКомпьютеры(), Ложь);
	ДобавитьПолеСсылкиLgp(Результат, 5, ТипОбъектаПриложения(), Ложь);
	ДобавитьПолеСсылкиLgp(Результат, 7, ТипОбъектаСобытия(), Ложь);
	ДобавитьПолеСсылкиLgp(Результат, 10, ТипОбъектаМетаданные(), Истина);
	ДобавитьПолеСсылкиLgp(Результат, 13, ТипОбъектаСерверы(), Ложь);
	ДобавитьПолеСсылкиLgp(Результат, 14, ТипОбъектаГлавныеПорты(), Ложь);
	ДобавитьПолеСсылкиLgp(Результат, 15, ТипОбъектаДопПорты(), Ложь);
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьПолеСсылкиLgp(Коллекция, ИндексПоля, ТипОбъекта, Составное)
	
	Описание = Новый Структура("ИндексПоля, ТипОбъекта, Составное", ИндексПоля, ТипОбъекта, Составное);
	Коллекция.Добавить(Описание);
	
КонецПроцедуры

#КонецОбласти

#Область ДиалогиИПути

&НаСервере
Процедура ЗаполнитьСписокРежимовКонфликта()
	
	Элементы.РежимКонфликта.СписокВыбора.Очистить();
	Элементы.РежимКонфликта.СписокВыбора.Добавить(РежимКонфликтаОбъединить(), "Объединить записи");
	Элементы.РежимКонфликта.СписокВыбора.Добавить(РежимКонфликтаПропустить(), "Пропустить (оставить текущий)");
	Элементы.РежимКонфликта.СписокВыбора.Добавить(РежимКонфликтаЗаменить(), "Заменить текущий файлом из старого ЖР");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКаталогЖР(ИмяРеквизита, ЗаголовокДиалога)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = ЗаголовокДиалога;
	Диалог.МножественныйВыбор = Ложь;
	Диалог.ПроверятьСуществованиеФайла = Истина;
	ТекущийПуть = ЭтотОбъект[ИмяРеквизита];
	Если Не ПустаяСтрока(ТекущийПуть) Тогда
		Диалог.Каталог = ТекущийПуть;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ИмяРеквизита, Диалог", ИмяРеквизита, Диалог);
	Оповещение = Новый ОписаниеОповещения("ВыбратьКаталогЖРЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиПутьКаталогаСервера(ИмяРеквизита, ЗаголовокВвода)
	
	Оповещение = Новый ОписаниеОповещения("ВвестиПутьКаталогаСервераЗавершение", ЭтотОбъект, ИмяРеквизита);
	ПоказатьВводСтроки(Оповещение, ЭтотОбъект[ИмяРеквизита], ЗаголовокВвода, 0, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиПутьКаталогаСервераЗавершение(Строка, ИмяРеквизита) Экспорт
	
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект[ИмяРеквизита] = СокрЛП(Строка);
	СброситьПланАнализа();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПодсказкуРежимаВыполнения()
	
	Если ВыполнятьНаСервере Тогда
		Элементы.ПодсказкаРежимаСервера.Заголовок =
			"Режим «На сервере 1С»: файлы читаются и пишутся на сервере приложений. "
			+ "Указывайте пути так, как их видит сервер (Linux/Windows сервера).";
		Элементы.ПодсказкаРежимаСервера.Видимость = Истина;
	Иначе
		Элементы.ПодсказкаРежимаСервера.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКаталогЖРЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранныйКаталог = "";
	Если ДополнительныеПараметры.Свойство("Диалог") Тогда
		ВыбранныйКаталог = ДополнительныеПараметры.Диалог.Каталог;
	КонецЕсли;
	Если ПустаяСтрока(ВыбранныйКаталог) Тогда
		ВыбранныйКаталог = ПервыйПутьИзРезультатаДиалога(ВыбранныеФайлы);
	КонецЕсли;
	Если ПустаяСтрока(ВыбранныйКаталог) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект[ДополнительныеПараметры.ИмяРеквизита] = НормализоватьКаталогЖР(ВыбранныйКаталог);
	СброситьПланАнализа();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлыЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПервыйПуть = ПервыйПутьИзРезультатаДиалога(ВыбранныеФайлы);
	Если ПустаяСтрока(ПервыйПуть) Тогда
		Возврат;
	КонецЕсли;
	
	ПервыйФайл = Новый Файл(ПервыйПуть);
	КаталогИсточника = НормализоватьКаталогЖР(ПервыйФайл.Путь);
	
	ТекстПротокола = "";
	Если Не ВыполнитьАнализБезопасно(Ложь) Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранныеИмена = Новый Соответствие;
	Для Каждого ПолноеИмя Из ВыбранныеФайлы Цикл
		ФайлНаДиске = Новый Файл(ПолноеИмя);
		ВыбранныеИмена.Вставить(НРег(ФайлНаДиске.Имя), Истина);
	КонецЦикла;
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		СтрокаФайла.Пометка = (ВыбранныеИмена.Получить(НРег(СтрокаФайла.ИмяФайла)) = Истина);
	КонецЦикла;
	
	ДобавитьВПротокол("Отмечены выбранные вручную файлы: " + Формат(ВыбранныеФайлы.Количество(), "ЧГ=0"));
	
КонецПроцедуры

&НаКлиенте
Функция ПервыйПутьИзРезультатаДиалога(ВыбранныеФайлы)
	
	Если ТипЗнч(ВыбранныеФайлы) = Тип("Строка") Тогда
		Возврат СокрЛП(ВыбранныеФайлы);
	КонецЕсли;
	
	Для Каждого Элемент Из ВыбранныеФайлы Цикл
		Если ТипЗнч(Элемент) = Тип("Строка") Тогда
			Возврат СокрЛП(Элемент);
		КонецЕсли;
		Возврат СокрЛП(Строка(Элемент));
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НормализоватьКаталогЖР(Знач Каталог)
	
	Каталог = СокрЛП(Каталог);
	Если ПустаяСтрока(Каталог) Тогда
		Возврат Каталог;
	КонецЕсли;
	
	Если ФайлСуществует(ПутьКСловарюЖР(Каталог)) Тогда
		Возврат Каталог;
	КонецЕсли;
	
	КаталогLog = ОбъединитьПуть(Каталог, ИмяКаталогаЖР());
	Если ФайлСуществует(ПутьКСловарюЖР(КаталогLog)) Тогда
		Возврат КаталогLog;
	КонецЕсли;
	
	Возврат Каталог;
	
КонецФункции

&НаКлиенте
Функция КаталогЖРФайловойБазы()
	
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	Маркер = "File=";
	Позиция = СтрНайти(ВРег(СтрокаСоединения), ВРег(Маркер));
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Остаток = Сред(СтрокаСоединения, Позиция + СтрДлина(Маркер));
	Если СтрНачинаетсяС(Остаток, """") Тогда
		Остаток = Сред(Остаток, 2);
		ПозицияКонца = СтрНайти(Остаток, """");
	Иначе
		ПозицияКонца = СтрНайти(Остаток, ";");
	КонецЕсли;
	
	Если ПозицияКонца > 0 Тогда
		ПутьБазы = Лев(Остаток, ПозицияКонца - 1);
	Иначе
		ПутьБазы = Остаток;
	КонецЕсли;
	
	Возврат ОбъединитьПуть(СокрЛП(ПутьБазы), ИмяКаталогаЖР());
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПутьКСловарюЖР(КаталогЖР)
	
	Возврат ОбъединитьПуть(КаталогЖР, ИмяФайлаСловаряЖР());
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОбъединитьПуть(Путь1, Путь2)
	
	#Если Клиент Тогда
		Разделитель = ПолучитьРазделительПутиКлиента();
	#Иначе
		Разделитель = ПолучитьРазделительПутиСервера();
	#КонецЕсли
	
	Если СтрЗаканчиваетсяНа(Путь1, Разделитель) Или СтрЗаканчиваетсяНа(Путь1, "/") Или СтрЗаканчиваетсяНа(Путь1, "\") Тогда
		Возврат Путь1 + Путь2;
	КонецЕсли;
	
	Возврат Путь1 + Разделитель + Путь2;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФайлСуществует(ПолноеИмя)
	
	ФайлНаДиске = Новый Файл(ПолноеИмя);
	Возврат ФайлНаДиске.Существует();
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОтсортироватьФайлыПоИмени(МассивФайлов)
	
	Список = Новый СписокЗначений;
	Для Каждого ФайлОбъект Из МассивФайлов Цикл
		Список.Добавить(ФайлОбъект, ФайлОбъект.Имя);
	КонецЦикла;
	Список.СортироватьПоЗначению();
	
	Результат = Новый Массив;
	Для Каждого ЭлементСписка Из Список Цикл
		Результат.Добавить(ЭлементСписка.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область АнализИПрисоединение

&НаКлиенте
Функция ВыполнитьАнализБезопасно(ПисатьОшибкуВПротокол)
	
	Если ВыполнятьНаСервере Тогда
		Результат = ВыполнитьАнализБезопасноНаСервере(ПисатьОшибкуВПротокол);
		Если Не Результат.Ок Тогда
			ПоказатьПредупреждение(, Результат.ТекстОшибки);
		КонецЕсли;
		Возврат Результат.Ок;
	КонецЕсли;
	
	Попытка
		ВыполнитьАнализ();
		Возврат Истина;
	Исключение
		Информация = ИнформацияОбОшибке();
		Если ПисатьОшибкуВПротокол Тогда
			ДобавитьВПротокол("Ошибка анализа: " + КраткоеПредставлениеОшибки(Информация));
			ДобавитьВОтладочныйЛог("[ERROR] analyze_failed=" + КраткоеПредставлениеОшибки(Информация));
		КонецЕсли;
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(Информация));
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ВыполнитьАнализБезопасноНаСервере(ПисатьОшибкуВПротокол)
	
	Результат = Новый Структура("Ок,ТекстОшибки", Истина, "");
	Попытка
		ВыполнитьАнализНаСервереКонтекста();
	Исключение
		Информация = ИнформацияОбОшибке();
		Результат.Ок = Ложь;
		Результат.ТекстОшибки = КраткоеПредставлениеОшибки(Информация);
		Если ПисатьОшибкуВПротокол Тогда
			ДобавитьВПротоколНаСервереКонтекста("Ошибка анализа: " + Результат.ТекстОшибки);
			ДобавитьВОтладочныйЛогНаСервереКонтекста("[ERROR] analyze_failed=" + Результат.ТекстОшибки);
		КонецЕсли;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьАнализ()
	
	КаталогИсточника = НормализоватьКаталогЖР(КаталогИсточника);
	КаталогПриемника = НормализоватьКаталогЖР(КаталогПриемника);
	ПроверитьКаталоги();
	
	СловарьИсточника = ПрочитатьСловарьLgf(ПутьКСловарюЖР(КаталогИсточника));
	СловарьПриемника = ПрочитатьСловарьLgf(ПутьКСловарюЖР(КаталогПриемника));
	РезультатКарт = ПостроитьКартыПеренумерации(СловарьИсточника, СловарьПриемника);
	
	НужнаПеренумерация = РезультатКарт.НужнаПеренумерация;
	ЗаполнитьТаблицуФайловЖурнала();
	ЗаписатьПротоколАнализа(СловарьИсточника, СловарьПриемника, РезультатКарт);
	СохранитьКэшАнализа(СловарьИсточника, СловарьПриемника, РезультатКарт);
	АнализАктуален = Истина;
	
	Если ФайлыЖурнала.Количество() = 0 Тогда
		ВызватьИсключение "В каталоге источника нет файлов .lgp.";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьАнализНаСервереКонтекста()
	
	КаталогИсточника = НормализоватьКаталогЖР(КаталогИсточника);
	КаталогПриемника = НормализоватьКаталогЖР(КаталогПриемника);
	ПроверитьКаталогиНаСервереКонтекста();
	
	СловарьИсточника = ПрочитатьСловарьLgf(ПутьКСловарюЖР(КаталогИсточника));
	СловарьПриемника = ПрочитатьСловарьLgf(ПутьКСловарюЖР(КаталогПриемника));
	РезультатКарт = ПостроитьКартыПеренумерации(СловарьИсточника, СловарьПриемника);
	
	НужнаПеренумерация = РезультатКарт.НужнаПеренумерация;
	ЗаполнитьТаблицуФайловЖурналаНаСервереКонтекста();
	ЗаписатьПротоколАнализаНаСервереКонтекста(СловарьИсточника, СловарьПриемника, РезультатКарт);
	СохранитьКэшАнализаНаСервере(СловарьИсточника, СловарьПриемника, РезультатКарт);
	АнализАктуален = Истина;
	
	Если ФайлыЖурнала.Количество() = 0 Тогда
		ВызватьИсключение "В каталоге источника нет файлов .lgp.";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуФайловЖурнала()
	
	ФайлыЖурнала.Очистить();
	НайденныеФайлы = ОтсортироватьФайлыПоИмени(НайтиФайлы(КаталогИсточника, "*.lgp", Ложь));
	
	Для Каждого ФайлИсточника Из НайденныеФайлы Цикл
		
		СтрокаФайла = ФайлыЖурнала.Добавить();
		СтрокаФайла.Пометка = Истина;
		СтрокаФайла.ИмяФайла = ФайлИсточника.Имя;
		СтрокаФайла.ПолныйПутьИсточника = ФайлИсточника.ПолноеИмя;
		СтрокаФайла.ПолныйПутьПриемника = ОбъединитьПуть(КаталогПриемника, ФайлИсточника.Имя);
		СтрокаФайла.РазмерИсточника = ПредставлениеРазмера(ФайлИсточника.Размер());
		
		ФайлПриемника = Новый Файл(СтрокаФайла.ПолныйПутьПриемника);
		Если ФайлПриемника.Существует() Тогда
			СтрокаФайла.РазмерПриемника = ПредставлениеРазмера(ФайлПриемника.Размер());
			СтрокаФайла.Действие = ПредставлениеДействияФайла(РежимКонфликта);
		Иначе
			СтрокаФайла.РазмерПриемника = "-";
			СтрокаФайла.Действие = ПредставлениеДействияФайла(ДействиеСкопировать());
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуФайловЖурналаНаСервереКонтекста()
	
	ФайлыЖурнала.Очистить();
	НайденныеФайлы = ОтсортироватьФайлыПоИмени(НайтиФайлы(КаталогИсточника, "*.lgp", Ложь));
	
	Для Каждого ФайлИсточника Из НайденныеФайлы Цикл
		
		СтрокаФайла = ФайлыЖурнала.Добавить();
		СтрокаФайла.Пометка = Истина;
		СтрокаФайла.ИмяФайла = ФайлИсточника.Имя;
		СтрокаФайла.ПолныйПутьИсточника = ФайлИсточника.ПолноеИмя;
		СтрокаФайла.ПолныйПутьПриемника = ОбъединитьПуть(КаталогПриемника, ФайлИсточника.Имя);
		СтрокаФайла.РазмерИсточника = ПредставлениеРазмера(ФайлИсточника.Размер());
		
		ФайлПриемника = Новый Файл(СтрокаФайла.ПолныйПутьПриемника);
		Если ФайлПриемника.Существует() Тогда
			СтрокаФайла.РазмерПриемника = ПредставлениеРазмера(ФайлПриемника.Размер());
			СтрокаФайла.Действие = ПредставлениеДействияФайла(РежимКонфликта);
		Иначе
			СтрокаФайла.РазмерПриемника = "-";
			СтрокаФайла.Действие = ПредставлениеДействияФайла(ДействиеСкопировать());
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПротоколАнализа(СловарьИсточника, СловарьПриемника, РезультатКарт)
	
	МоментНачала = ТекущаяДата();
	ДобавитьВПротокол("=== DRY-RUN / ПЛАН (запись не выполняется) ===");
	Если ВыполнятьНаСервере Тогда
		ДобавитьВПротокол("Контекст файлов: СЕРВЕР приложений 1С (пути как на сервере).");
	Иначе
		ДобавитьВПротокол("Контекст файлов: КЛИЕНТ.");
	КонецЕсли;
	ДобавитьВПротокол("Источник: " + КаталогИсточника);
	ДобавитьВПротокол("Приёмник: " + КаталогПриемника);
	ДобавитьВПротокол("Идентификатор старого журнала (GUID): " + СловарьИсточника.GUID);
	ДобавитьВПротокол("Идентификатор нового журнала (GUID): " + СловарьПриемника.GUID);
	Если ВРег(СокрЛП(СловарьИсточника.GUID)) <> ВРег(СокрЛП(СловарьПриемника.GUID)) Тогда
		Для Каждого СтрокаПредупреждения Из СтрокиПредупрежденияРазныхИдентификаторовЖурнала(НужнаПеренумерация) Цикл
			ДобавитьВПротокол(СтрокаПредупреждения);
		КонецЦикла;
	Иначе
		ДобавитьВПротокол("Идентификаторы совпадают — заголовки периодов уже от того же журнала.");
	КонецЕсли;
	
	ДобавитьВПротокол("Записей словаря источника: " + ФорматЧислаПротокола(СловарьИсточника.Количество));
	ДобавитьВПротокол("Записей словаря приёмника: " + ФорматЧислаПротокола(СловарьПриемника.Количество));
	ДобавитьВПротокол("Новых записей в словарь приёмника: "
		+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	
	Если НужнаПеренумерация Тогда
		ДобавитьВПротокол("Номера пользователей/событий в файлах периодов не совпадают с новым словарём — будет перенумерация.");
	Иначе
		ДобавитьВПротокол("Номера объектов совпадают — полная перенумерация не нужна (при разном GUID заголовок .lgp всё равно будет согласован с новым журналом).");
	КонецЕсли;
	
	ЗаписатьПротоколКартыПеренумерации(РезультатКарт);
	ЗаписатьПротоколПланаПоФайлам();
	ЗаписатьПротоколКачестваСклейки();
	
	Если ПроверятьЦелостность Тогда
		ЗаписатьПротоколЦелостности(СловарьИсточника, СловарьПриемника);
	КонецЕсли;
	
	ЗаписатьПротоколБлокировокПриемника();
	ДобавитьВПротокол("--- После присоединения ---");
	ДобавитьВПротокол("1. Остановите кластер, если подменяете боевой каталог 1Cv8Log.");
	ДобавитьВПротокол("2. Откройте журнал регистрации — проверьте записи за перенесённый период.");
	ДобавитьВПротокол("3. Проверьте пользователей и события в отфильтрованных записях.");
	ДобавитьВПротокол("=== Конец dry-run. Длительность: "
		+ ПредставлениеДлительностиПротокола(ТекущаяДата() - МоментНачала)
		+ ". Для записи нажмите «Присоединить». ===");
	ЗаписатьОтладочныйСнимокАнализа(СловарьИсточника, СловарьПриемника, РезультатКарт);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПротоколАнализаНаСервереКонтекста(СловарьИсточника, СловарьПриемника, РезультатКарт)
	
	МоментНачала = ТекущаяДата();
	ДобавитьВПротоколНаСервереКонтекста("=== DRY-RUN / ПЛАН (запись не выполняется) ===");
	Если ВыполнятьНаСервере Тогда
		ДобавитьВПротоколНаСервереКонтекста("Контекст файлов: СЕРВЕР приложений 1С (пути как на сервере).");
	Иначе
		ДобавитьВПротоколНаСервереКонтекста("Контекст файлов: КЛИЕНТ.");
	КонецЕсли;
	ДобавитьВПротоколНаСервереКонтекста("Источник: " + КаталогИсточника);
	ДобавитьВПротоколНаСервереКонтекста("Приёмник: " + КаталогПриемника);
	ДобавитьВПротоколНаСервереКонтекста("Идентификатор старого журнала (GUID): " + СловарьИсточника.GUID);
	ДобавитьВПротоколНаСервереКонтекста("Идентификатор нового журнала (GUID): " + СловарьПриемника.GUID);
	Если ВРег(СокрЛП(СловарьИсточника.GUID)) <> ВРег(СокрЛП(СловарьПриемника.GUID)) Тогда
		Для Каждого СтрокаПредупреждения Из СтрокиПредупрежденияРазныхИдентификаторовЖурнала(НужнаПеренумерация) Цикл
			ДобавитьВПротоколНаСервереКонтекста(СтрокаПредупреждения);
		КонецЦикла;
	Иначе
		ДобавитьВПротоколНаСервереКонтекста("Идентификаторы совпадают — заголовки периодов уже от того же журнала.");
	КонецЕсли;
	
	ДобавитьВПротоколНаСервереКонтекста("Записей словаря источника: " + ФорматЧислаПротокола(СловарьИсточника.Количество));
	ДобавитьВПротоколНаСервереКонтекста("Записей словаря приёмника: " + ФорматЧислаПротокола(СловарьПриемника.Количество));
	ДобавитьВПротоколНаСервереКонтекста("Новых записей в словарь приёмника: "
		+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	
	Если НужнаПеренумерация Тогда
		ДобавитьВПротоколНаСервереКонтекста("Номера пользователей/событий в файлах периодов не совпадают с новым словарём — будет перенумерация.");
	Иначе
		ДобавитьВПротоколНаСервереКонтекста("Номера объектов совпадают — полная перенумерация не нужна (при разном GUID заголовок .lgp всё равно будет согласован с новым журналом).");
	КонецЕсли;
	
	ЗаписатьПротоколКартыПеренумерацииНаСервереКонтекста(РезультатКарт);
	ЗаписатьПротоколПланаПоФайламНаСервереКонтекста();
	ЗаписатьПротоколКачестваСклейкиНаСервереКонтекста();
	
	Если ПроверятьЦелостность Тогда
		ЗаписатьПротоколЦелостностиНаСервереКонтекста(СловарьИсточника, СловарьПриемника);
	КонецЕсли;
	
	ЗаписатьПротоколБлокировокПриемникаНаСервереКонтекста();
	ДобавитьВПротоколНаСервереКонтекста("--- После присоединения ---");
	ДобавитьВПротоколНаСервереКонтекста("1. Остановите кластер, если подменяете боевой каталог 1Cv8Log.");
	ДобавитьВПротоколНаСервереКонтекста("2. Откройте журнал регистрации — проверьте записи за перенесённый период.");
	ДобавитьВПротоколНаСервереКонтекста("3. Проверьте пользователей и события в отфильтрованных записях.");
	ДобавитьВПротоколНаСервереКонтекста("=== Конец dry-run. Длительность: "
		+ ПредставлениеДлительностиПротокола(ТекущаяДата() - МоментНачала)
		+ ". Для записи нажмите «Присоединить». ===");
	ЗаписатьОтладочныйСнимокАнализаНаСервереКонтекста(СловарьИсточника, СловарьПриемника, РезультатКарт);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПротоколКартыПеренумерации(РезультатКарт)
	
	Если Не РезультатКарт.НужнаПеренумерация Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьВПротокол("--- Карта перенумерации (отличия номеров, до 30) ---");
	Показано = 0;
	Лимит = 30;
	
	Для ТипОбъекта = 1 По МаксимальныйТипОбъектаСловаря() Цикл
		
		Карта = РезультатКарт.Карты.Получить(ТипОбъекта);
		Если Карта = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Пара Из Карта Цикл
			
			Если Пара.Ключ = Пара.Значение Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьВПротокол("  тип " + ФорматЧислаПротокола(ТипОбъекта) + ": "
				+ ФорматЧислаПротокола(Пара.Ключ) + " -> " + ФорматЧислаПротокола(Пара.Значение));
			Показано = Показано + 1;
			Если Показано >= Лимит Тогда
				ДобавитьВПротокол("  ... остальные отличия не показаны");
				Возврат;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

