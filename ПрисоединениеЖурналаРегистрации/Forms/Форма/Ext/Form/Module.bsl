&НаКлиентеНаСервереБезКонтекста
Функция ОтпечатокЗаписиLgpИзТокенов(Токены)
	
	Части = Новый Массив;
	Индексы = Новый Массив;
	Индексы.Добавить(ИндексПоляДатыЗаписиLgp());
	Индексы.Добавить(3);
	Индексы.Добавить(4);
	Индексы.Добавить(5);
	Индексы.Добавить(6);
	Индексы.Добавить(7);
	Индексы.Добавить(8);
	Индексы.Добавить(9);
	Индексы.Добавить(16);
	
	Верх = Токены.ВГраница();
	Для Каждого ИндексПоля Из Индексы Цикл
		Если ИндексПоля > Верх Тогда
			Части.Добавить("");
		Иначе
			Части.Добавить(СокрЛП(Токены[ИндексПоля]));
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(Части, "|");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДеньИзТокенаДатыLgp(ТокенДаты)
	
	Текст = СокрЛП(ТокенДаты);
	Если СтрДлина(Текст) < 8 Тогда
		Возврат "";
	КонецЕсли;
	Для Индекс = 1 По 8 Цикл
		Код = КодСимвола(Сред(Текст, Индекс, 1));
		Если Код < 48 Или Код > 57 Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	Возврат Лев(Текст, 8);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяФайлаПериодаПоДнюLgp(ДеньYYYYMMDD)
	
