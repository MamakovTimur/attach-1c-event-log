&НаКлиенте
Процедура ЗаписатьПротоколЦелостности(СловарьИсточника, СловарьПриемника)

	ДобавитьВПротокол("--- Проверка заголовков .lgp источника (бинарный префикс 4 КБ) ---");
	ДобавитьВПротокол(
		"Лёгкая проверка заголовка, не полная валидация тела файла.");
	Если ПутьПохожНаКлиентскийЛокальный(КаталогИсточника)
		Или ПутьПохожНаКлиентскийЛокальный(КаталогПриемника) Тогда
		ДобавитьВПротокол(
			"ВНИМАНИЕ: путь похож на OneDrive/Desktop/Users. Облачный диск при открытии .lgp "
			+ "может скачивать весь файл с сети — анализ «зависает» на минуты и часы. "
			+ "Скопируйте каталоги 1Cv8Log на обычный локальный диск (например D:\jr\…) и укажите их здесь.");
	КонецЕсли;

	Проблемы = 0;
	Проверено = 0;
	ВсегоФайлов = ФайлыЖурнала.Количество();
	КэшЦелостности = Новый Соответствие;

	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл

		Проверено = Проверено + 1;
		#Если Клиент Тогда
		ОбработкаПрерыванияПользователя();
		Состояние("Заголовок источника " + Формат(Проверено, "ЧГ=0") + "/" + Формат(ВсегоФайлов, "ЧГ=0") + "…");
		#КонецЕсли
		Если Проверено = 1 Или Проверено = ВсегоФайлов Или Проверено % 50 = 0 Тогда
			ДобавитьВПротокол("  … проверено " + ФорматЧислаПротокола(Проверено)
				+ " из " + ФорматЧислаПротокола(ВсегоФайлов));
		КонецЕсли;
		// В dry-run не трогаем файлы приёмника: лишний open на OneDrive удваивает ожидание.
		Результат = ПроверитьЦелостностьФайлаLgp(
			СтрокаФайла.ПолныйПутьИсточника,
			СловарьИсточника.GUID,
			СловарьИсточника.Версия,
			КэшЦелостности);

		Если Не Результат.Ок Тогда
			Проблемы = Проблемы + 1;
			ДобавитьВПротокол("  " + СтрокаФайла.ИмяФайла + ": " + Результат.Сообщение);
		КонецЕсли;

	КонецЦикла;

	Если Проблемы = 0 Тогда
		ДобавитьВПротокол("Проверка заголовков источника: замечаний нет (файлов: "
			+ ФорматЧислаПротокола(Проверено)
			+ "). Приёмник в анализе не открывался.");
	Иначе
		ДобавитьВПротокол("Проверка заголовков источника: замечаний "
			+ ФорматЧислаПротокола(Проблемы)
			+ ". См. «что нашли / чем грозит / что делать» выше.");
	КонецЕсли;

КонецПроцедуры

