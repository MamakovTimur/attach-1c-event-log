		Результат.Добавить(ИмяФайлаСловаряЖР());
	КонецЕсли;
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		
		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Если Не ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
			Продолжить;
		КонецЕсли;
		Если ВнутреннийКодДействияФайла(СтрокаФайла.Действие) = РежимКонфликтаПропустить() Тогда
			Продолжить;
		КонецЕсли;
		
		Если ФайлЗаблокированДляЗаписи(СтрокаФайла.ПолныйПутьПриемника, КэшБлокировок) Тогда
			Результат.Добавить(СтрокаФайла.ИмяФайла);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФайлЗаблокированДляЗаписи(ПолноеИмя, КэшБлокировок = Неопределено)
	
	Если КэшБлокировок <> Неопределено Тогда
		Кэшированный = КэшБлокировок.Получить(ПолноеИмя);
		Если Кэшированный <> Неопределено Тогда
			Возврат Кэшированный;
		КонецЕсли;
	КонецЕсли;
	
	Заблокирован = ФайлЗаблокированДляЗаписиБезКэша(ПолноеИмя);
	
	Если КэшБлокировок <> Неопределено Тогда
		КэшБлокировок.Вставить(ПолноеИмя, Заблокирован);
	КонецЕсли;
	
	Возврат Заблокирован;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФайлЗаблокированДляЗаписиБезКэша(ПолноеИмя)
	
	ВременноеИмя = ПолноеИмя + ".lockcheck_" + Формат(ТекущаяДата(), "ДФ=HHmmss");
	
	Попытка
		ПереместитьФайл(ПолноеИмя, ВременноеИмя);
		ПереместитьФайл(ВременноеИмя, ПолноеИмя);
		Возврат Ложь;
	Исключение
		Если ФайлСуществует(ВременноеИмя) И Не ФайлСуществует(ПолноеИмя) Тогда
			Попытка
				ПереместитьФайл(ВременноеИмя, ПолноеИмя);
			Исключение
			КонецПопытки;
		КонецЕсли;
		Возврат Истина;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция СоздатьПолнуюКопиюКаталогаПриемника()
	
	КаталогФайл = Новый Файл(КаталогПриемника);
	Родитель = КаталогФайл.Путь;
	ИмяКаталога = КаталогФайл.Имя;
	Если ПустаяСтрока(ИмяКаталога) Тогда
		ИмяКаталога = ИмяКаталогаЖР();
	КонецЕсли;
	
	ПутьКопии = ОбъединитьПуть(Родитель, ИмяКаталога + ".bak_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss"));
	СоздатьКаталог(ПутьКопии);
	
	ФайлыИсточника = НайтиФайлы(КаталогПриемника, "*", Ложь);
	Скопировано = 0;
	Для Каждого ФайлИсточника Из ФайлыИсточника Цикл
		
		Если ФайлИсточника.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		
		КопироватьФайл(ФайлИсточника.ПолноеИмя, ОбъединитьПуть(ПутьКопии, ФайлИсточника.Имя));
		Скопировано = Скопировано + 1;
		
	КонецЦикла;
	
	ДобавитьВПротокол("В резервную копию скопировано файлов: " + ФорматЧислаПротокола(Скопировано));
	Возврат ПутьКопии;
	
КонецФункции

&НаСервере
Функция СоздатьПолнуюКопиюКаталогаПриемникаНаСервереКонтекста()
	
	КаталогФайл = Новый Файл(КаталогПриемника);
	Родитель = КаталогФайл.Путь;
	ИмяКаталога = КаталогФайл.Имя;
	Если ПустаяСтрока(ИмяКаталога) Тогда
		ИмяКаталога = ИмяКаталогаЖР();
	КонецЕсли;
	
	ПутьКопии = ОбъединитьПуть(Родитель, ИмяКаталога + ".bak_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss"));
	СоздатьКаталог(ПутьКопии);
	
	ФайлыИсточника = НайтиФайлы(КаталогПриемника, "*", Ложь);
	Скопировано = 0;
	Для Каждого ФайлИсточника Из ФайлыИсточника Цикл
		
		Если ФайлИсточника.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		
		КопироватьФайл(ФайлИсточника.ПолноеИмя, ОбъединитьПуть(ПутьКопии, ФайлИсточника.Имя));
		Скопировано = Скопировано + 1;
		
	КонецЦикла;
	
	ДобавитьВПротоколНаСервереКонтекста("В резервную копию скопировано файлов: " + ФорматЧислаПротокола(Скопировано));
	Возврат ПутьКопии;
	
КонецФункции

#Область ПоискВSrvinfo

&НаКлиенте
Процедура НачатьПоискКаталогаЖРВSrvinfo(ИмяРеквизитаКаталога)
	
	Если ВыполнятьНаСервере Тогда
		НачатьПоискКаталогаЖРНаСервере(ИмяРеквизитаКаталога);
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Каталог srvinfo (или reg_XXXX кластера)";
	Если Не ПустаяСтрока(КаталогSrvinfo) Тогда
		Диалог.Каталог = КаталогSrvinfo;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения(
		"НайтиВКластереЗавершениеВыбораSrvinfo",
		ЭтотОбъект,
		ИмяРеквизитаКаталога);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПоискКаталогаЖРНаСервере(ИмяРеквизитаКаталога)
	
	Если Не ПустаяСтрока(КаталогSrvinfo) Тогда
		ПрименитьПоискЖРНаСервере(ИмяРеквизитаКаталога, КаталогSrvinfo);
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения(
		"ВводКаталогаSrvinfoЗавершение",
		ЭтотОбъект,
		ИмяРеквизитаКаталога);
	ПоказатьВводСтроки(
		Оповещение,
		КаталогSrvinfo,
		"Путь srvinfo или reg_XXXX на сервере 1С",
		0,
		Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВводКаталогаSrvinfoЗавершение(Строка, ИмяРеквизитаКаталога) Экспорт
	
	Если Строка = Неопределено Или ПустаяСтрока(СокрЛП(Строка)) Тогда
		Возврат;
	КонецЕсли;
	
	КаталогSrvinfo = СокрЛП(Строка);
	ПрименитьПоискЖРНаСервере(ИмяРеквизитаКаталога, КаталогSrvinfo);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьПоискЖРНаСервере(ИмяРеквизитаКаталога, ПутьSrvinfo)
	
	Попытка
		Кандидаты = НайтиКаталогиЖРВSrvinfoНаСервере(ПутьSrvinfo, ИмяИБ);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Если Кандидаты.Количество() = 0 Тогда
		ПоказатьПредупреждение(,
			"На сервере не найдены каталоги 1Cv8Log с 1Cv8.lgf.
			|Проверьте путь srvinfo/reg_XXXX и фильтр имени ИБ.");
		Возврат;
	КонецЕсли;
	
	Если Кандидаты.Количество() = 1 Тогда
		УстановитьКаталогЖРИзПоиска(ИмяРеквизитаКаталога, Кандидаты[0]);
		Возврат;
	КонецЕсли;
	
	СписокВыбора = Новый СписокЗначений;
	Для Каждого Кандидат Из Кандидаты Цикл
		СписокВыбора.Добавить(Кандидат.Путь, Кандидат.Представление);
	КонецЦикла;
	
	Оповещение = Новый ОписаниеОповещения(
		"НайтиВКластереПослеВыбораКандидата",
		ЭтотОбъект,
		ИмяРеквизитаКаталога);
	СписокВыбора.ПоказатьВыборЭлемента(Оповещение, "Выберите каталог журнала регистрации (сервер)");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиКаталогиЖРВSrvinfoНаСервере(КореньПоиска, ФильтрИмениИБ)
	
	Возврат НайтиКаталогиЖРВSrvinfo(КореньПоиска, ФильтрИмениИБ);
	
КонецФункции

&НаКлиенте
Процедура НайтиВКластереЗавершениеВыбораSrvinfo(ВыбранныеФайлы, ИмяРеквизитаКаталога) Экспорт
	
	ПутьSrvinfo = ПервыйПутьИзРезультатаДиалога(ВыбранныеФайлы);
	Если ПустаяСтрока(ПутьSrvinfo) Тогда
		Возврат;
	КонецЕсли;
	
	КаталогSrvinfo = ПутьSrvinfo;
	
	Попытка
		Кандидаты = НайтиКаталогиЖРВSrvinfo(ПутьSrvinfo, ИмяИБ);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Если Кандидаты.Количество() = 0 Тогда
		ПоказатьПредупреждение(,
			"Каталоги 1Cv8Log с 1Cv8.lgf не найдены.
			|Укажите srvinfo или reg_XXXX и при необходимости имя ИБ в фильтре.");
		Возврат;
	КонецЕсли;
	
	Если Кандидаты.Количество() = 1 Тогда
		УстановитьКаталогЖРИзПоиска(ИмяРеквизитаКаталога, Кандидаты[0]);
		Возврат;
	КонецЕсли;
	
	СписокВыбора = Новый СписокЗначений;
	Для Каждого Кандидат Из Кандидаты Цикл
		СписокВыбора.Добавить(Кандидат.Путь, Кандидат.Представление);
	КонецЦикла;
	
	Оповещение = Новый ОписаниеОповещения(
		"НайтиВКластереПослеВыбораКандидата",
		ЭтотОбъект,
		ИмяРеквизитаКаталога);
	СписокВыбора.ПоказатьВыборЭлемента(Оповещение, "Выберите каталог журнала регистрации");
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиВКластереПослеВыбораКандидата(ВыбранныйЭлемент, ИмяРеквизитаКаталога) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Кандидат = Новый Структура("Путь,Представление", ВыбранныйЭлемент.Значение, ВыбранныйЭлемент.Представление);
	УстановитьКаталогЖРИзПоиска(ИмяРеквизитаКаталога, Кандидат);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКаталогЖРИзПоиска(ИмяРеквизитаКаталога, Кандидат)
	
	Если ИмяРеквизитаКаталога = "КаталогИсточника" Тогда
		КаталогИсточника = Кандидат.Путь;
	Иначе
		КаталогПриемника = Кандидат.Путь;
	КонецЕсли;
	
	ДобавитьВПротокол("Найден каталог ЖР: " + Кандидат.Представление);
	ДобавитьВПротокол("Путь: " + Кандидат.Путь);
	ПоказатьПредупреждение(, "Установлен каталог:
		|" + Кандидат.Путь);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НайтиКаталогиЖРВSrvinfo(КореньПоиска, ФильтрИмениИБ)
	
	Результат = Новый Массив;
	ИменаПоUUID = ПрочитатьИменаИБИзClst(КореньПоиска);
	Фильтр = НРег(СокрЛП(ФильтрИмениИБ));
	
	КаталогиЖР = НайтиФайлы(КореньПоиска, ИмяКаталогаЖР(), Истина);
	Для Каждого КаталогЖР Из КаталогиЖР Цикл
		
		Если Не КаталогЖР.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Если Не ФайлСуществует(ПутьКСловарюЖР(КаталогЖР.ПолноеИмя)) Тогда
			Продолжить;
		КонецЕсли;
		
		UUIDИБ = ИзвлечьUUIDИзПутиЖР(КаталогЖР.ПолноеИмя);
		ИмяИБИзClst = "";
		Если Не ПустаяСтрока(UUIDИБ) Тогда
			ИмяИБИзClst = ИменаПоUUID.Получить(НРег(UUIDИБ));
			Если ИмяИБИзClst = Неопределено Тогда
				ИмяИБИзClst = "";
			КонецЕсли;
		КонецЕсли;
		
		Если Не ПустаяСтрока(Фильтр) Тогда
			СтрокаПоиска = НРег(ИмяИБИзClst + " " + UUIDИБ + " " + КаталогЖР.ПолноеИмя);
			Если СтрНайти(СтрокаПоиска, Фильтр) = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Представление = СформироватьПредставлениеКандидатаЖР(
			КаталогЖР.ПолноеИмя,
			ИмяИБИзClst,
			UUIDИБ);
		
		Кандидат = Новый Структура("Путь,Представление,UUID,ИмяИБ",
			КаталогЖР.ПолноеИмя, Представление, UUIDИБ, ИмяИБИзClst);
		Результат.Добавить(Кандидат);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьПредставлениеКандидатаЖР(ПутьКаталогаЖР, ИмяИБИзClst, UUIDИБ)
	
	КаталогФайл = Новый Файл(ПутьКаталогаЖР);
	ДатаКаталога = Неопределено;
	Попытка
		ДатаКаталога = КаталогФайл.ПолучитьВремяИзменения();
	Исключение
		ДатаКаталога = Неопределено;
	КонецПопытки;
	
	РазмерБайт = РазмерФайловЖРВКаталоге(ПутьКаталогаЖР);
	
	Если Не ПустаяСтрока(ИмяИБИзClst) Тогда
		ЗаголовокИБ = ИмяИБИзClst;
	ИначеЕсли Не ПустаяСтрока(UUIDИБ) Тогда
		ЗаголовокИБ = UUIDИБ;
	Иначе
		ЗаголовокИБ = ПутьКаталогаЖР;
	КонецЕсли;
	
	Части = Новый Массив;
	Части.Добавить(ЗаголовокИБ);
	Если ДатаКаталога <> Неопределено Тогда
		Части.Добавить(Формат(ДатаКаталога, "ДФ='dd.MM.yyyy HH:mm'"));
	КонецЕсли;
	Части.Добавить(ПредставлениеРазмера(РазмерБайт));
	Если ЗаголовокИБ <> ПутьКаталогаЖР Тогда
		Части.Добавить(ПутьКаталогаЖР);
	КонецЕсли;
	
	Возврат СтрСоединить(Части, " | ");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РазмерФайловЖРВКаталоге(ПутьКаталогаЖР)
	
	РазмерБайт = 0;
	ПутьLgf = ПутьКСловарюЖР(ПутьКаталогаЖР);
	Если ФайлСуществует(ПутьLgf) Тогда
		РазмерБайт = РазмерБайт + Новый Файл(ПутьLgf).Размер();
	КонецЕсли;
	
	ФайлыLgp = НайтиФайлы(ПутьКаталогаЖР, "*.lgp", Ложь);
	Для Каждого ФайлLgp Из ФайлыLgp Цикл
		Если ФайлLgp.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		РазмерБайт = РазмерБайт + ФайлLgp.Размер();
	КонецЦикла;
	
	Возврат РазмерБайт;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьИменаИБИзClst(КореньПоиска)
	
	ИменаПоUUID = Новый Соответствие;
	ФайлыClst = НайтиФайлы(КореньПоиска, "1CV8Clst.lst", Истина);
	
	Для Каждого ФайлClst Из ФайлыClst Цикл
		
		Попытка
			Чтение = Новый ЧтениеТекста(ФайлClst.ПолноеИмя, КодировкаТекста.UTF8);
			Текст = Чтение.Прочитать();
			Чтение.Закрыть();
		Исключение
			Продолжить;
		КонецПопытки;
		
		Если Текст = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьИменаИБИзТекстаClst(Текст, ИменаПоUUID);
		
	КонецЦикла;
	
	Возврат ИменаПоUUID;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьИменаИБИзТекстаClst(Знач Текст, ИменаПоUUID)
	
	// Фрагменты вида: {uuid,"RefName","Description",...
	Позиция = 1;
	Длина = СтрДлина(Текст);
	
	Пока Позиция <= Длина Цикл
		
		ПозицияUUID = НайтиUUIDВТекстеСПозиции(Текст, Позиция);
		Если ПозицияUUID = 0 Тогда
			Прервать;
		КонецЕсли;
		
		UUID = Сред(Текст, ПозицияUUID, 36);
		ПослеUUID = ПозицияUUID + 36;
		Если ПослеUUID + 2 > Длина Или Сред(Текст, ПослеUUID, 2) <> ",""" Тогда
			Позиция = ПозицияUUID + 1;
			Продолжить;
		КонецЕсли;
		
		НачалоИмени = ПослеUUID + 2;
		КонецИмени = СтрНайти(Текст, """", НаправлениеПоиска.СНачала, НачалоИмени);
		Если КонецИмени = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ИмяИБИзClst = Сред(Текст, НачалоИмени, КонецИмени - НачалоИмени);
		Если Не ПустаяСтрока(ИмяИБИзClst) Тогда
			ИменаПоUUID.Вставить(НРег(UUID), ИмяИБИзClst);
		КонецЕсли;
		
		Позиция = КонецИмени + 1;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НайтиUUIDВТекстеСПозиции(Знач Текст, Знач ПозицияСтарта)
	
	Длина = СтрДлина(Текст);
	Позиция = ПозицияСтарта;
	
	Пока Позиция <= Длина - 35 Цикл
		
		Фрагмент = Сред(Текст, Позиция, 36);
		Если ЭтоСтрокаUUID(Фрагмент) Тогда
			Возврат Позиция;
		КонецЕсли;
		Позиция = Позиция + 1;
		
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоСтрокаUUID(Знач Значение)
	
	Если СтрДлина(Значение) <> 36 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Сред(Значение, 9, 1) <> "-" Или Сред(Значение, 14, 1) <> "-"
		Или Сред(Значение, 19, 1) <> "-" Или Сред(Значение, 24, 1) <> "-" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = 1 По 36 Цикл
		Если Индекс = 9 Или Индекс = 14 Или Индекс = 19 Или Индекс = 24 Тогда
			Продолжить;
		КонецЕсли;
		Символ = НРег(Сред(Значение, Индекс, 1));
		Если СтрНайти("0123456789abcdef", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИзвлечьUUIDИзПутиЖР(Знач ПутьКЖР)
	
	Норм = СтрЗаменить(ПутьКЖР, "/", "\");
	Пока СтрЗаканчиваетсяНа(Норм, "\") Цикл
		Норм = Лев(Норм, СтрДлина(Норм) - 1);
	КонецЦикла;
	
	Части = СтрРазделить(Норм, "\", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	
	Если ВРег(Части[Части.ВГраница()]) <> ВРег(ИмяКаталогаЖР()) Тогда
		Возврат "";
	КонецЕсли;
	
	КандидатUUID = Части[Части.ВГраница() - 1];
	Если ЭтоСтрокаUUID(КандидатUUID) Тогда
		Возврат КандидатUUID;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СловарьLgf

&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьСловарьLgf(ПутьКФайлу)
	
	Результат = НовыйСловарьLgf();
	Чтение = ОткрытьЧтениеЖурнала(ПутьКФайлу);
	
	НомерСтроки = 0;
	БуферЗаписи = "";
	Глубина = 0;
	ВКавычках = Ложь;
	
	Пока Истина Цикл
		
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		Если НомерСтроки = 1 Тогда
			Результат.Версия = СокрЛП(СтрокаФайла);
			Продолжить;
		ИначеЕсли НомерСтроки = 2 Тогда
			Результат.GUID = СокрЛП(СтрокаФайла);
			Продолжить;
		КонецЕсли;
		
		Если Глубина = 0 И ПустаяСтрока(БуферЗаписи) И ПустаяСтрока(СтрокаФайла) Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках);
		
		Если Глубина = 0 И Не ПустаяСтрока(БуферЗаписи) Тогда
			ДобавитьЗаписьСловаряИзСтроки(Результат, БуферЗаписи);
			БуферЗаписи = "";
		КонецЕсли;
		
	КонецЦикла;
	
	Чтение.Закрыть();
	
	Если СтрНайти(Результат.Версия, МаркерФорматаЖР()) = 0 Тогда
		ВызватьИсключение "Файл не похож на словарь журнала регистрации: " + ПутьКФайлу;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НовыйСловарьLgf()
	
	Результат = Новый Структура;
	Результат.Вставить("Версия", "");
	Результат.Вставить("GUID", "");
	Результат.Вставить("ПоНомеру", Новый Соответствие);
	Результат.Вставить("ПоКлючу", Новый Соответствие);
	Результат.Вставить("МаксНомер", Новый Соответствие);
	Результат.Вставить("Количество", 0);
	
	Для ТипОбъекта = 1 По МаксимальныйТипОбъектаСловаря() Цикл
		Результат.ПоНомеру.Вставить(ТипОбъекта, Новый Соответствие);
		Результат.ПоКлючу.Вставить(ТипОбъекта, Новый Соответствие);
		Результат.МаксНомер.Вставить(ТипОбъекта, 0);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьЗаписьСловаряИзСтроки(Словарь, Знач СтрокаФайла)
	
	СтрокаФайла = УбратьХвостовуюЗапятую(СокрЛП(СтрокаФайла));
	Если Не ЭтоСкобочнаяЗапись(СтрокаФайла) Тогда
		Возврат;
	КонецЕсли;
	
	Токены = Токенизировать(ТелоСкобочнойЗаписи(СтрокаФайла));
	Если Токены.Количество() < 3 Тогда
		Возврат;
	КонецЕсли;
	
	ТипОбъекта = ЧислоИзТокена(Токены[0]);
	Номер = ЧислоИзТокена(Токены[Токены.ВГраница()]);
	Если ТипОбъекта < 1 Или ТипОбъекта > МаксимальныйТипОбъектаСловаря() Или Номер <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	Описание = Новый Структура("ТипОбъекта,Номер,Имя,UUID,Ключ", ТипОбъекта, Номер, "", "", "");
	Если ЭтоТипСUUID(ТипОбъекта) И Токены.Количество() >= 4 Тогда
		Описание.UUID = СнятьКавычки(Токены[1]);
		Описание.Имя = СнятьКавычки(Токены[2]);
		Описание.Ключ = НРег(Описание.UUID);
		Если ПустаяСтрока(Описание.Ключ) Тогда
			Описание.Ключ = НРег(Описание.Имя);
		КонецЕсли;
	Иначе
		Описание.Имя = СнятьКавычки(Токены[1]);
		Описание.Ключ = НРег(Описание.Имя);
	КонецЕсли;
	
	Если ПустаяСтрока(Описание.Ключ) Тогда
		Возврат;
	КонецЕсли;
	
	Словарь.ПоНомеру.Получить(ТипОбъекта).Вставить(Номер, Описание);
	Словарь.ПоКлючу.Получить(ТипОбъекта).Вставить(Описание.Ключ, Номер);
	Если Номер > Словарь.МаксНомер.Получить(ТипОбъекта) Тогда
		Словарь.МаксНомер.Вставить(ТипОбъекта, Номер);
	КонецЕсли;
	Словарь.Количество = Словарь.Количество + 1;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПостроитьКартыПеренумерации(СловарьИсточника, СловарьПриемника)
	
	Карты = Новый Соответствие;
	ДобавленныеСтроки = Новый Массив;
	НужнаПеренумерация = Ложь;
	
	Для ТипОбъекта = 1 По МаксимальныйТипОбъектаСловаря() Цикл
		
		Карта = Новый Соответствие;
		Карты.Вставить(ТипОбъекта, Карта);
		МаксНомер = СловарьПриемника.МаксНомер.Получить(ТипОбъекта);
		ИсточникПоНомеру = СловарьИсточника.ПоНомеру.Получить(ТипОбъекта);
		ПриемникПоКлючу = СловарьПриемника.ПоКлючу.Получить(ТипОбъекта);
		
		Для Каждого Пара Из ИсточникПоНомеру Цикл
			
			СтарыйНомер = Пара.Ключ;
			Описание = Пара.Значение;
			НовыйНомер = ПриемникПоКлючу.Получить(Описание.Ключ);
			
			Если НовыйНомер = Неопределено Тогда
				МаксНомер = МаксНомер + 1;
				НовыйНомер = МаксНомер;
				ДобавленныеСтроки.Добавить(СформироватьСтрокуСловаря(Описание, НовыйНомер));
				ПриемникПоКлючу.Вставить(Описание.Ключ, НовыйНомер);
			КонецЕсли;
			
			Карта.Вставить(СтарыйНомер, НовыйНомер);
			Если НовыйНомер <> СтарыйНомер Тогда
				НужнаПеренумерация = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		СловарьПриемника.МаксНомер.Вставить(ТипОбъекта, МаксНомер);
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("Карты", Карты);
	Результат.Вставить("ДобавленныеСтроки", ДобавленныеСтроки);
	Результат.Вставить("НужнаПеренумерация", НужнаПеренумерация);
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьСтрокуСловаря(Описание, Номер)
	
	НомерСтрокой = ФорматЧислаПротокола(Номер);
	ТипСтрокой = ФорматЧислаПротокола(Описание.ТипОбъекта);
	
	// Нативный lgf: UUID типов 1/5 без кавычек; имя — в кавычках.
	Если ЭтоТипСUUID(Описание.ТипОбъекта) Тогда
		Если ПустаяСтрока(Описание.UUID) Тогда
			ЧастьUUID = """""";
		Иначе
			ЧастьUUID = Описание.UUID;
		КонецЕсли;
		Возврат "{" + ТипСтрокой + "," + ЧастьUUID + ","""
			+ ЭкранироватьКавычки(Описание.Имя) + """," + НомерСтрокой + "},";
	КонецЕсли;
	
	// Порты 7/8: нативно без кавычек — {7,1560,1}; с кавычками платформа даёт «Ошибка формата потока».
	Если Описание.ТипОбъекта = ТипОбъектаГлавныеПорты()
		Или Описание.ТипОбъекта = ТипОбъектаДопПорты() Тогда
		Возврат "{" + ТипСтрокой + "," + Описание.Имя + "," + НомерСтрокой + "},";
	КонецЕсли;
	
	Возврат "{" + ТипСтрокой + ",""" + ЭкранироватьКавычки(Описание.Имя) + """," + НомерСтрокой + "},";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДописатьСтрокиВLgf(ПутьКФайлу, ДобавленныеСтроки)
	
	// Сырой UTF-8+BOM: ТекстовыйДокумент может переписать существующие строки словаря.
	Текст = ПрочитатьСыройТекстЖурналаUTF8(ПутьКФайлу);
	Разрыв = РазрывСтрокИзФрагмента(Текст);
	Если ПустаяСтрока(Разрыв) Тогда
		Разрыв = РазрывСтрокЗаголовкаLgp();
	КонецЕсли;
	
	СтрокиФайла = СтрРазделить(Текст, Разрыв, Истина);
	Пока СтрокиФайла.Количество() > 0
		И ПустаяСтрока(СокрЛП(СтрокиФайла[СтрокиФайла.ВГраница()])) Цикл
		СтрокиФайла.Удалить(СтрокиФайла.ВГраница());
	КонецЦикла;
	
	Если СтрокиФайла.Количество() > 0 Тогда
		ИндексПоследней = СтрокиФайла.ВГраница();
		Последняя = СокрЛП(СтрокиФайла[ИндексПоследней]);
		Если Не ПустаяСтрока(Последняя) И Не СтрЗаканчиваетсяНа(Последняя, ",") Тогда
			СтрокиФайла[ИндексПоследней] = СтрокиФайла[ИндексПоследней] + ",";
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого СтрокаСловаря Из ДобавленныеСтроки Цикл
		СтрокиФайла.Добавить(СтрокаСловаря);
	КонецЦикла;
	
	// Нативный формат: у последней записи словаря нет хвостовой запятой.
	УбратьХвостовуюЗапятуюПоследнейСтрокиМассива(СтрокиФайла);
	
	ЗаписатьСыройТекстЖурналаUTF8(ПутьКФайлу, СтрСоединить(СтрокиФайла, Разрыв));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УбратьХвостовуюЗапятуюПоследнейСтрокиМассива(СтрокиФайла)
	
	Индекс = СтрокиФайла.ВГраница();
	Пока Индекс >= 0 И ПустаяСтрока(СокрЛП(СтрокиФайла[Индекс])) Цикл
		Индекс = Индекс - 1;
	КонецЦикла;
	
	Если Индекс < 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрЗаканчиваетсяНа(СокрЛП(СтрокиФайла[Индекс]), ",") Тогда
		СтрокиФайла[Индекс] = УбратьХвостовуюЗапятую(СокрЛП(СтрокиФайла[Индекс]));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

