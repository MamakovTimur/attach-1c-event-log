Процедура ВыполнитьПрисоединениеНаСервереБезопасно()
	
	ВыполнитьПрисоединениеНаСервереКонтекста();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПрисоединение()
	
	МоментНачала = ТекущаяДата();
	ДобавитьВПротокол("=== Начало присоединения ===");
	
	ПроверитьКаталоги();
	
	Заблокированные = НайтиЗаблокированныеФайлыПриемника();
	Если Заблокированные.Количество() > 0 Тогда
		ТекстБлокировки = "Файлы приёмника заблокированы (вероятно, ragent/кластер). "
			+ "Скопируйте 1Cv8Log и работайте с копией. Заблокировано: "
			+ СтрСоединить(Заблокированные, ", ");
		ВызватьИсключение ТекстБлокировки;
	КонецЕсли;
	
	ПутьLgfИсточника = ПутьКСловарюЖР(КаталогИсточника);
	ПутьLgfПриемника = ПутьКСловарюЖР(КаталогПриемника);
	
	СловарьИсточника = ПрочитатьСловарьLgf(ПутьLgfИсточника);
	СловарьПриемника = ПрочитатьСловарьLgf(ПутьLgfПриемника);
	РезультатКарт = ПостроитьКартыПеренумерации(СловарьИсточника, СловарьПриемника);
	НужнаПеренумерация = РезультатКарт.НужнаПеренумерация;
	
	Если РежимОтладки Тогда
		ДобавитьВОтладочныйЛог("[METRIC] need_renumber=" + ?(НужнаПеренумерация, "true", "false"));
		ДобавитьВОтладочныйЛог("[METRIC] lgf_before_entries="
			+ ФорматЧислаПротокола(СловарьПриемника.Количество));
		ДобавитьВОтладочныйЛог("[METRIC] lgf_new_entries="
			+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	КонецЕсли;
	
	ЗаписейLgfДо = СловарьПриемника.Количество;
	
	Если СоздаватьРезервнуюКопию Тогда
		ПутьКопииКаталога = СоздатьПолнуюКопиюКаталогаПриемника();
		ДобавитьВПротокол("Полная резервная копия каталога приёмника: " + ПутьКопииКаталога);
	КонецЕсли;
	
	Если РезультатКарт.ДобавленныеСтроки.Количество() > 0 Тогда
		ДописатьСтрокиВLgf(ПутьLgfПриемника, РезультатКарт.ДобавленныеСтроки);
		ДобавитьВПротокол("В 1Cv8.lgf добавлено записей: "
			+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	Иначе
		ДобавитьВПротокол("Словарь приёмника уже содержит все объекты источника.");
	КонецЕсли;
	
	Если РежимОтладки Тогда
		Для Каждого СтрокаОтладки Из СтрокиОтладкиLgfПослеДописки(
			ПутьLgfПриемника, РезультатКарт.ДобавленныеСтроки.Количество(), ЗаписейLgfДо) Цикл
			ДобавитьВОтладочныйЛог(СтрокаОтладки);
		КонецЦикла;
	КонецЕсли;
	
	Обработано = 0;
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		
		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		#Если Клиент Тогда
		ОбработкаПрерыванияПользователя();
		Состояние("Присоединение " + СтрокаФайла.ИмяФайла);
		#КонецЕсли
		
		Если СтрокаФайла.Действие = РежимКонфликтаПропустить()
			И ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
			ДобавитьВПротокол("Пропущен (уже есть): " + СтрокаФайла.ИмяФайла);
			Если РежимОтладки Тогда
				ДобавитьВОтладочныйЛог("[FILE] " + СтрокаФайла.ИмяФайла + " action=skip");
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Объединять = (СтрокаФайла.Действие = РежимКонфликтаОбъединить()
			И ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника));
		
		СведенияФайла = Неопределено;
		МетрикиДо = Неопределено;
		МетрикиИсточника = Неопределено;
		Если РежимОтладки Тогда
			СведенияФайла = Новый Структура;
			МетрикиДо = СобратьМетрикиФайлаLgp(СтрокаФайла.ПолныйПутьПриемника);
			МетрикиИсточника = СобратьМетрикиФайлаLgp(СтрокаФайла.ПолныйПутьИсточника);
		КонецЕсли;
		
		ПрисоединитьФайлLgp(
			СтрокаФайла.ПолныйПутьИсточника,
			СтрокаФайла.ПолныйПутьПриемника,
			СловарьПриемника,
			РезультатКарт.Карты,
			Объединять,
			НужнаПеренумерация,
			СведенияФайла);
		
		Если РежимОтладки Тогда
			МетрикиПосле = СобратьМетрикиФайлаLgp(СтрокаФайла.ПолныйПутьПриемника);
			ЗаписатьОтладкуОперацииФайла(
				СтрокаФайла.ИмяФайла,
				Объединять,
				СведенияФайла,
				МетрикиИсточника,
				МетрикиДо,
				МетрикиПосле);
		КонецЕсли;
		
		Если Объединять Тогда
			ДобавитьВПротокол("Объединён: " + СтрокаФайла.ИмяФайла);
		Иначе
			ДобавитьВПротокол("Скопирован: " + СтрокаФайла.ИмяФайла);
		КонецЕсли;
		
		Обработано = Обработано + 1;
		
	КонецЦикла;
	
	УдалитьИндексыЖурнала(КаталогПриемника);
	ДобавитьВПротокол("Обработано файлов: " + ФорматЧислаПротокола(Обработано));
	ДобавитьВПротокол("Индексы *.lgx удалены - платформа построит их заново при открытии ЖР.");
	
	Если РежимОтладки Тогда
		ДобавитьВОтладочныйЛог("[METRIC] files_processed=" + ФорматЧислаПротокола(Обработано));
		ДобавитьВОтладочныйЛог("=== DEBUG SESSION attach END ===");
	КонецЕсли;
	
	Если ПроверятьЦелостность Тогда
		ДобавитьВПротокол("--- Контроль после записи ---");
		СловарьПосле = ПрочитатьСловарьLgf(ПутьLgfПриемника);
		ЗамечанияПосле = 0;
		Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
			Если Не СтрокаФайла.Пометка Или Не ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаФайла.Действие = РежимКонфликтаПропустить() Тогда
				Продолжить;
			КонецЕсли;
			Результат = ПроверитьЦелостностьФайлаLgp(
				СтрокаФайла.ПолныйПутьПриемника,
				СловарьПосле.GUID,
				СловарьПосле.Версия);
			Если Не Результат.Ок Тогда
				ЗамечанияПосле = ЗамечанияПосле + 1;
				ДобавитьВПротокол("  " + СтрокаФайла.ИмяФайла + ": " + Результат.Сообщение);
			КонецЕсли;
		КонецЦикла;
		Если ЗамечанияПосле = 0 Тогда
			ДобавитьВПротокол("Контроль после записи: замечаний нет — заголовки периодов согласованы с новым журналом.");
		Иначе
			ДобавитьВПротокол("Контроль после записи: замечаний "
				+ ФорматЧислаПротокола(ЗамечанияПосле)
				+ ". Часть периодов может не открыться — см. формулировки выше.");
		КонецЕсли;
	КонецЕсли;
	
	ДобавитьВПротокол("=== Конец присоединения. Длительность: "
		+ ПредставлениеДлительностиПротокола(ТекущаяДата() - МоментНачала) + " ===");
	ДобавитьВПротокол("Готово. Если работали с копией, остановите кластер и подмените каталог 1Cv8Log.");
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьПрисоединениеНаСервереКонтекста()
	
	МоментНачала = ТекущаяДата();
	ДобавитьВПротоколНаСервереКонтекста("=== Начало присоединения ===");
	
	ПроверитьКаталогиНаСервереКонтекста();
	
	Заблокированные = НайтиЗаблокированныеФайлыПриемникаНаСервереКонтекста();
	Если Заблокированные.Количество() > 0 Тогда
		ТекстБлокировки = "Файлы приёмника заблокированы (вероятно, ragent/кластер). "
			+ "Скопируйте 1Cv8Log и работайте с копией. Заблокировано: "
			+ СтрСоединить(Заблокированные, ", ");
		ВызватьИсключение ТекстБлокировки;
	КонецЕсли;
	
	ПутьLgfИсточника = ПутьКСловарюЖР(КаталогИсточника);
	ПутьLgfПриемника = ПутьКСловарюЖР(КаталогПриемника);
	
	СловарьИсточника = ПрочитатьСловарьLgf(ПутьLgfИсточника);
	СловарьПриемника = ПрочитатьСловарьLgf(ПутьLgfПриемника);
	РезультатКарт = ПостроитьКартыПеренумерации(СловарьИсточника, СловарьПриемника);
	НужнаПеренумерация = РезультатКарт.НужнаПеренумерация;
	
	Если РежимОтладки Тогда
		ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] need_renumber=" + ?(НужнаПеренумерация, "true", "false"));
		ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] lgf_before_entries="
			+ ФорматЧислаПротокола(СловарьПриемника.Количество));
		ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] lgf_new_entries="
			+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	КонецЕсли;
	
	ЗаписейLgfДо = СловарьПриемника.Количество;
	
	Если СоздаватьРезервнуюКопию Тогда
		ПутьКопииКаталога = СоздатьПолнуюКопиюКаталогаПриемникаНаСервереКонтекста();
		ДобавитьВПротоколНаСервереКонтекста("Полная резервная копия каталога приёмника: " + ПутьКопииКаталога);
	КонецЕсли;
	
	Если РезультатКарт.ДобавленныеСтроки.Количество() > 0 Тогда
		ДописатьСтрокиВLgf(ПутьLgfПриемника, РезультатКарт.ДобавленныеСтроки);
		ДобавитьВПротоколНаСервереКонтекста("В 1Cv8.lgf добавлено записей: "
			+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	Иначе
		ДобавитьВПротоколНаСервереКонтекста("Словарь приёмника уже содержит все объекты источника.");
	КонецЕсли;
	
	Если РежимОтладки Тогда
		Для Каждого СтрокаОтладки Из СтрокиОтладкиLgfПослеДописки(
			ПутьLgfПриемника, РезультатКарт.ДобавленныеСтроки.Количество(), ЗаписейLgfДо) Цикл
			ДобавитьВОтладочныйЛогНаСервереКонтекста(СтрокаОтладки);
		КонецЦикла;
	КонецЕсли;
	
	Обработано = 0;
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		
		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		#Если Клиент Тогда
		ОбработкаПрерыванияПользователя();
		Состояние("Присоединение " + СтрокаФайла.ИмяФайла);
		#КонецЕсли
		
		Если СтрокаФайла.Действие = РежимКонфликтаПропустить()
			И ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
			ДобавитьВПротоколНаСервереКонтекста("Пропущен (уже есть): " + СтрокаФайла.ИмяФайла);
			Если РежимОтладки Тогда
				ДобавитьВОтладочныйЛогНаСервереКонтекста("[FILE] " + СтрокаФайла.ИмяФайла + " action=skip");
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Объединять = (СтрокаФайла.Действие = РежимКонфликтаОбъединить()
			И ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника));
		
		СведенияФайла = Неопределено;
		МетрикиДо = Неопределено;
		МетрикиИсточника = Неопределено;
		Если РежимОтладки Тогда
			СведенияФайла = Новый Структура;
			МетрикиДо = СобратьМетрикиФайлаLgp(СтрокаФайла.ПолныйПутьПриемника);
			МетрикиИсточника = СобратьМетрикиФайлаLgp(СтрокаФайла.ПолныйПутьИсточника);
		КонецЕсли;
		
		ПрисоединитьФайлLgp(
			СтрокаФайла.ПолныйПутьИсточника,
			СтрокаФайла.ПолныйПутьПриемника,
			СловарьПриемника,
			РезультатКарт.Карты,
			Объединять,
			НужнаПеренумерация,
			СведенияФайла);
		
		Если РежимОтладки Тогда
			МетрикиПосле = СобратьМетрикиФайлаLgp(СтрокаФайла.ПолныйПутьПриемника);
			ЗаписатьОтладкуОперацииФайлаНаСервереКонтекста(
				СтрокаФайла.ИмяФайла,
				Объединять,
				СведенияФайла,
				МетрикиИсточника,
				МетрикиДо,
				МетрикиПосле);
		КонецЕсли;
		
		Если Объединять Тогда
			ДобавитьВПротоколНаСервереКонтекста("Объединён: " + СтрокаФайла.ИмяФайла);
		Иначе
			ДобавитьВПротоколНаСервереКонтекста("Скопирован: " + СтрокаФайла.ИмяФайла);
		КонецЕсли;
		
		Обработано = Обработано + 1;
		
	КонецЦикла;
	
	УдалитьИндексыЖурналаНаСервереКонтекста(КаталогПриемника);
	ДобавитьВПротоколНаСервереКонтекста("Обработано файлов: " + ФорматЧислаПротокола(Обработано));
	ДобавитьВПротоколНаСервереКонтекста("Индексы *.lgx удалены - платформа построит их заново при открытии ЖР.");
	
	Если РежимОтладки Тогда
		ДобавитьВОтладочныйЛогНаСервереКонтекста("[METRIC] files_processed=" + ФорматЧислаПротокола(Обработано));
		ДобавитьВОтладочныйЛогНаСервереКонтекста("=== DEBUG SESSION attach END ===");
	КонецЕсли;
	
	Если ПроверятьЦелостность Тогда
		ДобавитьВПротоколНаСервереКонтекста("--- Контроль после записи ---");
		СловарьПосле = ПрочитатьСловарьLgf(ПутьLgfПриемника);
		ЗамечанияПосле = 0;
		Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
			Если Не СтрокаФайла.Пометка Или Не ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаФайла.Действие = РежимКонфликтаПропустить() Тогда
				Продолжить;
			КонецЕсли;
			Результат = ПроверитьЦелостностьФайлаLgp(
				СтрокаФайла.ПолныйПутьПриемника,
				СловарьПосле.GUID,
				СловарьПосле.Версия);
			Если Не Результат.Ок Тогда
				ЗамечанияПосле = ЗамечанияПосле + 1;
				ДобавитьВПротоколНаСервереКонтекста("  " + СтрокаФайла.ИмяФайла + ": " + Результат.Сообщение);
			КонецЕсли;
		КонецЦикла;
		Если ЗамечанияПосле = 0 Тогда
			ДобавитьВПротоколНаСервереКонтекста(
				"Контроль после записи: замечаний нет — заголовки периодов согласованы с новым журналом.");
		Иначе
			ДобавитьВПротоколНаСервереКонтекста("Контроль после записи: замечаний "
				+ ФорматЧислаПротокола(ЗамечанияПосле)
				+ ". Часть периодов может не открыться — см. формулировки выше.");
		КонецЕсли;
	КонецЕсли;
	
	ДобавитьВПротоколНаСервереКонтекста("=== Конец присоединения. Длительность: "
		+ ПредставлениеДлительностиПротокола(ТекущаяДата() - МоментНачала) + " ===");
	ДобавитьВПротоколНаСервереКонтекста("Готово. Если работали с копией, остановите кластер и подмените каталог 1Cv8Log.");
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИндексыЖурнала(КаталогЖР)
	
	ФайлыИндекса = НайтиФайлы(КаталогЖР, "*.lgx", Ложь);
	Для Каждого ФайлИндекса Из ФайлыИндекса Цикл
		Попытка
			УдалитьФайлы(ФайлИндекса.ПолноеИмя);
		Исключение
			ДобавитьВПротокол("Не удалось удалить индекс " + ФайлИндекса.Имя + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьИндексыЖурналаНаСервереКонтекста(КаталогЖР)
	
	ФайлыИндекса = НайтиФайлы(КаталогЖР, "*.lgx", Ложь);
	Для Каждого ФайлИндекса Из ФайлыИндекса Цикл
		Попытка
			УдалитьФайлы(ФайлИндекса.ПолноеИмя);
		Исключение
			ДобавитьВПротоколНаСервереКонтекста("Не удалось удалить индекс " + ФайлИндекса.Имя + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция КоличествоОтмеченныхФайлов()
	
	Результат = 0;
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		Если СтрокаФайла.Пометка Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПометкиФайлов(Пометка)
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		СтрокаФайла.Пометка = Пометка;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьЦелостностьФайлаLgp(ПутьКФайлу, ОжидаемыйGUID, ОжидаемаяВерсия)
	
	Результат = Новый Структура("Ок,Сообщение", Истина, "");
	
	Попытка
		Чтение = ОткрытьЧтениеЖурнала(ПутьКФайлу);
	Исключение
		Результат.Ок = Ложь;
		Результат.Сообщение = "Что нашли: файл не удалось открыть ("
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + "). "
			+ "Чем грозит: период не попадёт в журнал. "
			+ "Что делать: проверьте права доступа и что файл не занят кластером.";
		Возврат Результат;
	КонецПопытки;
	
	Версия = "";
	GUID = "";
	НомерСтроки = 0;
	БуферЗаписи = "";
	Глубина = 0;
	ВКавычках = Ложь;
	ПрочитаноБайт = 0;
	ЛимитБайт = 2097152;
	Записей = 0;
	КонецФайла = Ложь;
	ДостигнутЛимитВыборки = Ложь;
	
	Пока Истина Цикл
		
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			КонецФайла = Истина;
			Прервать;
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		ПрочитаноБайт = ПрочитаноБайт + СтрДлина(СтрокаФайла) + 2;
		
		Если НомерСтроки = 1 Тогда
			Версия = СокрЛП(СтрокаФайла);
			Продолжить;
		ИначеЕсли НомерСтроки = 2 Тогда
			GUID = СокрЛП(СтрокаФайла);
			Продолжить;
		КонецЕсли;
		
		ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках);
		Если Глубина = 0 И Не ПустаяСтрока(БуферЗаписи) Тогда
			Записей = Записей + 1;
			БуферЗаписи = "";
		КонецЕсли;
		
		Если ПрочитаноБайт >= ЛимитБайт Тогда
			ДостигнутЛимитВыборки = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Чтение.Закрыть();
	
	Замечания = Новый Массив;
	Если СтрНайти(Версия, МаркерФорматаЖР()) = 0 Тогда
		Замечания.Добавить(
			"Что нашли: в начале файла нет метки старого журнала (1CV8LOG). "
			+ "Чем грозит: платформа не примет файл как журнал регистрации. "
			+ "Что делать: убедитесь, что это каталог 1Cv8Log старого текстового формата (не SQLite .lgd).");
	КонецЕсли;
	Если Не ПустаяСтрока(ОжидаемаяВерсия) И Версия <> ОжидаемаяВерсия Тогда
		Замечания.Добавить(
			"Что нашли: версия в заголовке файла периода отличается от словаря 1Cv8.lgf. "
			+ "Чем грозит: журнал может не показать этот период. "
			+ "Что делать: при «Присоединить» обработка выставит версию и идентификатор текущего журнала в заголовок.");
	КонецЕсли;
	Если ВРег(СокрЛП(GUID)) <> ВРег(СокрЛП(ОжидаемыйGUID)) Тогда
		Замечания.Добавить(
			"Что нашли: идентификатор журнала в файле периода (" + GUID
			+ ") не совпадает со словарём (" + ОжидаемыйGUID + "). "
			+ "Чем грозит: период может не открыться в журнале регистрации. "
			+ "Что делать: при «Присоединить» обработка подставит идентификатор приёмника в заголовок .lgp "
			+ "(полная перенумерация нужна только если номера объектов различаются — это видно в плане выше).");
	КонецЕсли;
	// Незакрытая скобка при обрыве на лимите ~2 МБ — не доказательство повреждения.
	Если КонецФайла И (Глубина <> 0 Или Не ПустаяСтрока(БуферЗаписи)) Тогда
		Замечания.Добавить(
			"Что нашли: файл оборван — запись в скобках не закрыта до конца файла. "
			+ "Чем грозит: платформа может не прочитать этот период. "
			+ "Что делать: возьмите целый файл .lgp из резервной копии старого кластера.");
	КонецЕсли;
	
	Если Замечания.Количество() > 0 Тогда
		Результат.Ок = Ложь;
		Результат.Сообщение = СтрСоединить(Замечания, " ");
	ИначеЕсли ДостигнутЛимитВыборки Тогда
		Результат.Сообщение = "ok (проверено начало до ~" + ПредставлениеРазмера(ЛимитБайт)
			+ "; дальше не читали — это не признак повреждения)";
	Иначе
		Результат.Сообщение = "ok, записей в выборке: " + ФорматЧислаПротокола(Записей);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СтрокиПредупрежденияРазныхИдентификаторовЖурнала(НужнаПеренумерацияФайлов)
	
	Строки = Новый Массив;
	Строки.Добавить(
		"Что нашли: старый и новый журнал — разные (разные идентификаторы GUID в 1Cv8.lgf).");
	Строки.Добавить(
		"Чем грозит: если скопировать файлы периодов «как есть», в них останется чужой заголовок — "
		+ "новый журнал может не показать старый период.");
	Если НужнаПеренумерацияФайлов Тогда
		Строки.Добавить(
			"Что сделает обработка: перенумерует ссылки в записях и запишет заголовок нового журнала.");
	Иначе
		Строки.Добавить(
			"Что сделает обработка: номера объектов совпадают — полная перенумерация не нужна; "
			+ "при копировании всё равно подставит идентификатор и версию нового журнала в заголовок .lgp.");
	КонецЕсли;
	
	Возврат Строки;
	
КонецФункции

&НаКлиенте
Функция НайтиЗаблокированныеФайлыПриемника()
	
	Результат = Новый Массив;
	
	ПутьLgf = ПутьКСловарюЖР(КаталогПриемника);
	Если ФайлСуществует(ПутьLgf) И ФайлЗаблокированДляЗаписи(ПутьLgf) Тогда
		Результат.Добавить(ИмяФайлаСловаряЖР());
	КонецЕсли;
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		
		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Если Не ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаФайла.Действие = РежимКонфликтаПропустить() Тогда
			Продолжить;
		КонецЕсли;
		
		Если ФайлЗаблокированДляЗаписи(СтрокаФайла.ПолныйПутьПриемника) Тогда
			Результат.Добавить(СтрокаФайла.ИмяФайла);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

