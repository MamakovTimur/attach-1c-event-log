&НаКлиентеНаСервереБезКонтекста
Функция СтрокиОтладкиОперацииФайла(ИмяФайла, Объединять, СведенияФайла, МетрикиИсточника, МетрикиДо, МетрикиПосле)

	Строки = Новый Массив;
	Строки.Добавить("--- [FILE] " + ИмяФайла + " ---");
	Строки.Добавить("[METRIC] merge=" + ?(Объединять, "true", "false"));

	Если СведенияФайла <> Неопределено И СведенияФайла.Свойство("Ветка") Тогда
		Строки.Добавить("[METRIC] branch=" + СведенияФайла.Ветка);
	КонецЕсли;

	Если СведенияФайла <> Неопределено И СведенияФайла.Свойство("Статистика") Тогда
		Статистика = СведенияФайла.Статистика;
		Строки.Добавить("[METRIC] export_records=" + ФорматЧислаПротокола(Статистика.Записей));
		Строки.Добавить("[METRIC] export_single=" + ФорматЧислаПротокола(Статистика.Однострочных));
		Строки.Добавить("[METRIC] export_multi=" + ФорматЧислаПротокола(Статистика.Многострочных));
	КонецЕсли;

	Строки.Добавить(СтрокаМетрикLgp("src", МетрикиИсточника));
	Строки.Добавить(СтрокаМетрикLgp("dst_before", МетрикиДо));
	Строки.Добавить(СтрокаМетрикLgp("dst_after", МетрикиПосле));

	Если МетрикиИсточника.Существует И МетрикиПосле.Существует
		И МетрикиПосле.Байт < МетрикиИсточника.Байт * 0.5
		И (Объединять Или МетрикиДо.Существует) Тогда
		Строки.Добавить("[WARN] dst_bytes_shrink="
			+ ФорматЧислаПротокола(МетрикиПосле.Байт - МетрикиИсточника.Байт));
	КонецЕсли;

	Если МетрикиИсточника.Существует И МетрикиПосле.Существует
		И МетрикиПосле.Записей < МетрикиИсточника.Записей * 0.5 Тогда
		Строки.Добавить("[WARN] dst_records_shrink="
			+ ФорматЧислаПротокола(МетрикиПосле.Записей - МетрикиИсточника.Записей));
	КонецЕсли;

	Возврат Строки;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СобратьМетрикиLgf(ПутьКФайлу)

	Результат = Новый Структура("Существует,Байт,Записей", Ложь, 0, 0);
	Файл = Новый Файл(ПутьКФайлу);
	Если Не Файл.Существует() Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Существует = Истина;
	Результат.Байт = Файл.Размер();
	Словарь = ПрочитатьСловарьLgf(ПутьКФайлу);
	Результат.Записей = Словарь.Количество;

	Возврат Результат;

КонецФункции

// Только размер — для dry-run / отладочного снимка анализа без полного чтения .lgp.
&НаКлиентеНаСервереБезКонтекста
Функция СобратьМетрикиФайлаLgpТолькоРазмер(ПутьКФайлу)

	Результат = Новый Структура("Существует,Байт", Ложь, 0);
	Файл = Новый Файл(ПутьКФайлу);
	Если Не Файл.Существует() Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Существует = Истина;
	Результат.Байт = Файл.Размер();
	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СобратьМетрикиФайлаLgp(ПутьКФайлу)

	Результат = Новый Структура("Существует,Байт,Записей,Однострочных,Многострочных,СтрокФайла", Ложь, 0, 0, 0, 0, 0);
	Файл = Новый Файл(ПутьКФайлу);
	Если Не Файл.Существует() Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Существует = Истина;
	Результат.Байт = Файл.Размер();
	Подсчет = ПодсчитатьЗаписиLgpВФайле(ПутьКФайлу);
	Результат.Записей = Подсчет.Записей;
	Результат.Однострочных = Подсчет.Однострочных;
	Результат.Многострочных = Подсчет.Многострочных;
	Результат.СтрокФайла = Подсчет.СтрокФайла;

	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПодсчитатьЗаписиLgpВФайле(ПутьКФайлу)

	Результат = Новый Структура("Записей,Однострочных,Многострочных,СтрокФайла", 0, 0, 0, 0);
	Чтение = ОткрытьЧтениеЖурнала(ПутьКФайлу);

	НомерСтроки = 0;
	БуферЗаписи = "";
	Глубина = 0;
	ВКавычках = Ложь;

	Пока Истина Цикл

		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;

		НомерСтроки = НомерСтроки + 1;
		Если НомерСтроки <= 2 И Глубина = 0 И ПустаяСтрока(БуферЗаписи) Тогда
			Продолжить;
		КонецЕсли;
		Если НомерСтроки = 3 И Глубина = 0 И ПустаяСтрока(БуферЗаписи) И ПустаяСтрока(СтрокаФайла) Тогда
			Продолжить;
		КонецЕсли;

		ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках);

		Если Глубина = 0 И Не ПустаяСтрока(БуферЗаписи) Тогда
			Если Не ПустаяСтрока(СокрЛП(БуферЗаписи)) И СокрЛП(БуферЗаписи) <> "," Тогда
				Результат.Записей = Результат.Записей + 1;
				Если СтрНайти(БуферЗаписи, Символы.ПС) > 0 Или СтрНайти(БуферЗаписи, Символы.ВК) > 0 Тогда
					Результат.Многострочных = Результат.Многострочных + 1;
				Иначе
					Результат.Однострочных = Результат.Однострочных + 1;
				КонецЕсли;
			КонецЕсли;
			БуферЗаписи = "";
		КонецЕсли;

	КонецЦикла;

	Чтение.Закрыть();
	Результат.СтрокФайла = НомерСтроки;

	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СтрокаМетрикLgp(Префикс, Метрики)

	Если Не Метрики.Существует Тогда
		Возврат "[METRIC] " + Префикс + "_exists=false";
	КонецЕсли;

	Возврат "[METRIC] " + Префикс
		+ "_bytes=" + ФорматЧислаПротокола(Метрики.Байт)
		+ " records=" + ФорматЧислаПротокола(Метрики.Записей)
		+ " single=" + ФорматЧислаПротокола(Метрики.Однострочных)
		+ " multi=" + ФорматЧислаПротокола(Метрики.Многострочных)
		+ " lines=" + ФорматЧислаПротокола(Метрики.СтрокФайла);

КонецФункции

