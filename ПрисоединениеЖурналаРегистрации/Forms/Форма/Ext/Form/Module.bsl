&НаКлиенте
Процедура ЗаписатьПротоколПланаПоФайлам()
	
	ДобавитьВПротокол("--- План по файлам .lgp ---");
	ДобавитьВПротокол("Найдено файлов .lgp: " + ФорматЧислаПротокола(ФайлыЖурнала.Количество()));
	
	ОбъёмБайт = 0;
	Скопировать = 0;
	Объединить = 0;
	Пропустить = 0;
	Заменить = 0;
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		
		ФайлИсточника = Новый Файл(СтрокаФайла.ПолныйПутьИсточника);
		Если ФайлИсточника.Существует() Тогда
