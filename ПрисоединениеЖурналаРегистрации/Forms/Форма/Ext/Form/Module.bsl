&НаКлиентеНаСервереБезКонтекста
Функция ОтпечатокЗаписиLgpИзТокенов(Токены)

	Части = Новый Массив;
	Для ИндексПоля = 0 По Токены.ВГраница() Цикл
		ЗначениеПоля = СокрЛП(Токены[ИндексПоля]);
		// Префикс длины исключает коллизии из-за разделителей внутри строковых данных.
		Части.Добавить(Формат(СтрДлина(ЗначениеПоля), "ЧГ=0") + ":" + ЗначениеПоля);
	КонецЦикла;

	Возврат СтрСоединить(Части, "|");

