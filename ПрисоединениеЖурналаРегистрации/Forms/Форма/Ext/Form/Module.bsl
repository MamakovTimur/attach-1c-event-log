КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоЗаписьСобытияLgpПоТокенам(Токены)
	
	Если Токены.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Не ПустаяСтрока(ДеньИзТокенаДатыLgp(Токены[ИндексПоляДатыЗаписиLgp()]));
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоЗаписьСловаряLgpПоТокенам(Токены)
	
	Если Токены.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Первый = СокрЛП(Токены[0]);
	Если ПустаяСтрока(ДеньИзТокенаДатыLgp(Первый)) Тогда
		Попытка
			ТипЧисло = Число(Первый);
		Исключение
			Возврат Ложь;
		КонецПопытки;
		Возврат ТипЧисло >= 1 И ТипЧисло <= 20;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОбнаружитьАрхивныйФорматЖРВТексте(ТекстФайла)
	
	Результат = Новый Структура("ЭтоАрхив,Сообщение", Ложь, "");
	Если СтрНайти(Лев(ТекстФайла, 64), МаркерФорматаЖР()) = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Части = РазделитьЗаголовокИТелоLgp(ТекстФайла);
	ЕстьСловарь = Ложь;
	ЕстьСобытия = Ложь;
	БуферЗаписи = "";
	Глубина = 0;
	ВКавычках = Ложь;
	
	СтрокиТела = СтрРазделить(Части.Тело, Символы.ПС, Истина);
	Для Каждого СтрокаФайла Из СтрокиТела Цикл
		ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках);
		Если Глубина = 0 И Не ПустаяСтрока(БуферЗаписи) Тогда
			Сжатая = СокрЛП(БуферЗаписи);
			Если СтрЗаканчиваетсяНа(Сжатая, ",") Тогда
				Сжатая = УбратьХвостовуюЗапятую(Сжатая);
			КонецЕсли;
			Если ЭтоСкобочнаяЗапись(Сжатая) Тогда
				Токены = Токенизировать(ТелоСкобочнойЗаписи(Сжатая));
				Если ЭтоЗаписьСобытияLgpПоТокенам(Токены) Тогда
					ЕстьСобытия = Истина;
				ИначеЕсли ЭтоЗаписьСловаряLgpПоТокенам(Токены) Тогда
					ЕстьСловарь = Истина;
				КонецЕсли;
			КонецЕсли;
			БуферЗаписи = "";
			Если ЕстьСловарь И ЕстьСобытия Тогда
				Результат.ЭтоАрхив = Истина;
				Результат.Сообщение =
					"Обнаружен архивный формат (словарь lgf и записи lgp в одном файле). "
					+ "Только чтение/предупреждение — запись такого архива не поддерживается.";
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОбнаружитьАрхивныйФорматЖРВФайле(ПутьКФайлу)
	
	Результат = Новый Структура("ЭтоАрхив,Сообщение", Ложь, "");
	Если Не ФайлСуществует(ПутьКФайлу) Тогда
		Возврат Результат;
	КонецЕсли;
	Попытка
		Текст = ПрочитатьСыройТекстЖурналаUTF8(ПутьКФайлу);
	Исключение
		Возврат Результат;
	КонецПопытки;
	Возврат ОбнаружитьАрхивныйФорматЖРВТексте(Текст);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СканироватьГраницуТранзакцийLgp(ПутьКФайлу)
	
	Результат = Новый Структура(
		"ОткрытаВКонце,ПервыйСтатус,ПоследнийСтатус,Предупреждения,ЧислоДней",
		Ложь, "", "", Новый Массив, 0);
	Если Не ФайлСуществует(ПутьКФайлу) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ГлубинаОткрытых = 0;
	Дни = Новый Соответствие;
	Чтение = ОткрытьЧтениеЖурнала(ПутьКФайлу);
	Для Номер = 1 По 3 Цикл
		Чтение.ПрочитатьСтроку();
	КонецЦикла;
	
	БуферЗаписи = "";
	Глубина = 0;
	ВКавычках = Ложь;
	
	Пока Истина Цикл
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если Глубина = 0 И ПустаяСтрока(БуферЗаписи) Тогда
			Сжатая = СокрЛП(СтрокаФайла);
			Если ПустаяСтрока(Сжатая) Или Не СтрНачинаетсяС(СокрЛ(Сжатая), "{") Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках);
		Если Глубина = 0 И Не ПустаяСтрока(БуферЗаписи) Тогда
			Сжатая = СокрЛП(БуферЗаписи);
			БуферЗаписи = "";
			Если СтрЗаканчиваетсяНа(Сжатая, ",") Тогда
				Сжатая = УбратьХвостовуюЗапятую(Сжатая);
			КонецЕсли;
			Если Не ЭтоСкобочнаяЗапись(Сжатая) Тогда
				Продолжить;
			КонецЕсли;
			Токены = Токенизировать(ТелоСкобочнойЗаписи(Сжатая));
			Если Не ЭтоЗаписьСобытияLgpПоТокенам(Токены) Тогда
				Продолжить;
			КонецЕсли;
			День = ДеньИзТокенаДатыLgp(Токены[ИндексПоляДатыЗаписиLgp()]);
			Если Не ПустаяСтрока(День) Тогда
				Дни.Вставить(День, Истина);
			КонецЕсли;
			Статус = "";
			Если Токены.ВГраница() >= ИндексПоляСтатусаТранзакцииLgp() Тогда
				Статус = ВРег(СокрЛП(Токены[ИндексПоляСтатусаТранзакцииLgp()]));
			КонецЕсли;
			Если ПустаяСтрока(Результат.ПервыйСтатус) Тогда
				Результат.ПервыйСтатус = Статус;
			КонецЕсли;
			Результат.ПоследнийСтатус = Статус;
			Если Статус = СтатусТранзакцииНезавершена() Тогда
				ГлубинаОткрытых = ГлубинаОткрытых + 1;
			ИначеЕсли Статус = СтатусТранзакцииЗафиксирована()
				Или Статус = СтатусТранзакцииОтменена() Тогда
				Если ГлубинаОткрытых > 0 Тогда
					ГлубинаОткрытых = ГлубинаОткрытых - 1;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	
	Результат.ОткрытаВКонце = ГлубинаОткрытых > 0;
	Результат.ЧислоДней = Дни.Количество();
	Если Результат.ОткрытаВКонце Тогда
		Результат.Предупреждения.Добавить(
			"В конце файла есть незакрытая транзакция (статус U без пары C/R). "
			+ "При склейке через границу файлов пара begin/commit может разорваться.");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СобратьОтпечаткиЗаписейLgp(ПутьКФайлу)
	
	Отпечатки = Новый Соответствие;
	Если Не ФайлСуществует(ПутьКФайлу) Тогда
		Возврат Отпечатки;
	КонецЕсли;
	
	Чтение = ОткрытьЧтениеЖурнала(ПутьКФайлу);
	Для Номер = 1 По 3 Цикл
		Чтение.ПрочитатьСтроку();
	КонецЦикла;
	
	БуферЗаписи = "";
	Глубина = 0;
	ВКавычках = Ложь;
	
	Пока Истина Цикл
		СтрокаФайла = Чтение.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если Глубина = 0 И ПустаяСтрока(БуферЗаписи) Тогда
			Сжатая = СокрЛП(СтрокаФайла);
			Если ПустаяСтрока(Сжатая) Или Не СтрНачинаетсяС(СокрЛ(Сжатая), "{") Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		ДобавитьСтрокуКЗаписи(СтрокаФайла, БуферЗаписи, Глубина, ВКавычках);
		Если Глубина = 0 И Не ПустаяСтрока(БуферЗаписи) Тогда
			Сжатая = СокрЛП(БуферЗаписи);
			БуферЗаписи = "";
			Если СтрЗаканчиваетсяНа(Сжатая, ",") Тогда
				Сжатая = УбратьХвостовуюЗапятую(Сжатая);
			КонецЕсли;
			Если Не ЭтоСкобочнаяЗапись(Сжатая) Тогда
				Продолжить;
			КонецЕсли;
			Токены = Токенизировать(ТелоСкобочнойЗаписи(Сжатая));
			Если ЭтоЗаписьСобытияLgpПоТокенам(Токены) Тогда
				Отпечатки.Вставить(ОтпечатокЗаписиLgpИзТокенов(Токены), Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	
	Возврат Отпечатки;
	
КонецФункции

&НаКлиенте
Процедура ЗаписатьПротоколКачестваСклейки()
	
	ДобавитьВПротокол("--- Качество склейки (Фаза 2) ---");
	ДобавитьВПротокол("Дедупликация записей: " + ?(ДедупликацияЗаписей, "включена", "выключена (по умолчанию)"));
	ДобавитьВПротокол("Разбивка источника по дням: " + ?(РазбиватьИсточникПоДням, "включена", "выключена"));
	
	Для Каждого СтрокаФайла Из ФайлыЖурнала Цикл
		
		Если Не СтрокаФайла.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Архив = ОбнаружитьАрхивныйФорматЖРВФайле(СтрокаФайла.ПолныйПутьИсточника);
		Если Архив.ЭтоАрхив Тогда
			ДобавитьВПротокол("ВНИМАНИЕ [" + СтрокаФайла.ИмяФайла + "]: " + Архив.Сообщение);
		КонецЕсли;
		
		СканИсточника = СканироватьГраницуТранзакцийLgp(СтрокаФайла.ПолныйПутьИсточника);
		Если СканИсточника.ЧислоДней > 1 Тогда
			ДобавитьВПротокол(СтрокаФайла.ИмяФайла + ": в источнике записей за "
				+ ФорматЧислаПротокола(СканИсточника.ЧислоДней)
				+ " дн. — при необходимости включите «Разбивать источник по дням».");
		КонецЕсли;
		Для Каждого ТекстПредупреждения Из СканИсточника.Предупреждения Цикл
			ДобавитьВПротокол("ВНИМАНИЕ [" + СтрокаФайла.ИмяФайла + " источник]: " + ТекстПредупреждения);
		КонецЦикла;
		
		КодДействия = ВнутреннийКодДействияФайла(СтрокаФайла.Действие);
		Если КодДействия = РежимКонфликтаОбъединить()
			И ФайлСуществует(СтрокаФайла.ПолныйПутьПриемника) Тогда
			СканПриемника = СканироватьГраницуТранзакцийLgp(СтрокаФайла.ПолныйПутьПриемника);
			Для Каждого ТекстПредупреждения Из СканПриемника.Предупреждения Цикл
				ДобавитьВПротокол("ВНИМАНИЕ [" + СтрокаФайла.ИмяФайла + " приёмник]: " + ТекстПредупреждения);
			КонецЦикла;
			Если СканПриемника.ОткрытаВКонце И Не ПустаяСтрока(СканИсточника.ПервыйСтатус)
				И СканИсточника.ПервыйСтатус <> СтатусТранзакцииНезавершена() Тогда
				ДобавитьВПротокол("ВНИМАНИЕ [" + СтрокаФайла.ИмяФайла
					+ "]: приёмник с незакрытой транзакцией, источник начинается со статуса «"
					+ СканИсточника.ПервыйСтатус + "» — проверьте журнал после присоединения.");
			КонецЕсли;
			Если Не ДедупликацияЗаписей Тогда
				ДобавитьВПротокол(СтрокаФайла.ИмяФайла
					+ ": при «Объединить» без дедупликации возможны повторы записей.");
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

