	ДобавитьВПротоколНаСервереКонтекста("Идентификатор старого журнала (GUID): " + СловарьИсточника.GUID);
	ДобавитьВПротоколНаСервереКонтекста("Идентификатор нового журнала (GUID): " + СловарьПриемника.GUID);
	Если ПустаяСтрока(СловарьПриемника.GUID) Тогда
		ДобавитьВПротоколНаСервереКонтекста(
