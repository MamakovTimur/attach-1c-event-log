	КонецЕсли;
	ДобавитьВПротоколНаСервереКонтекста("Источник: " + КаталогИсточника);
	ДобавитьВПротоколНаСервереКонтекста("Приёмник: " + КаталогПриемника);
	ДобавитьВПротоколНаСервереКонтекста("GUID словаря источника: " + СловарьИсточника.GUID);
	ДобавитьВПротоколНаСервереКонтекста("GUID словаря приёмника: " + СловарьПриемника.GUID);
	Если ВРег(СокрЛП(СловарьИсточника.GUID)) <> ВРег(СокрЛП(СловарьПриемника.GUID)) Тогда
		ДобавитьВПротоколНаСервереКонтекста("Внимание: GUID словарей различаются — при склейке в .lgp будет GUID приёмника.");
	КонецЕсли;
	
	ДобавитьВПротоколНаСервереКонтекста("Записей словаря источника: " + ФорматЧислаПротокола(СловарьИсточника.Количество));
	ДобавитьВПротоколНаСервереКонтекста("Записей словаря приёмника: " + ФорматЧислаПротокола(СловарьПриемника.Количество));
	ДобавитьВПротоколНаСервереКонтекста("Новых записей в словарь приёмника: "
		+ ФорматЧислаПротокола(РезультатКарт.ДобавленныеСтроки.Количество()));
	
	Если НужнаПеренумерация Тогда
		ДобавитьВПротоколНаСервереКонтекста("Номера объектов в .lgp не совпадают - будет выполнена перенумерация.");
	Иначе
		ДобавитьВПротоколНаСервереКонтекста("Номера объектов совпадают - файлы .lgp можно копировать без перенумерации.");
	КонецЕсли;
	
	ЗаписатьПротоколКартыПеренумерацииНаСервереКонтекста(РезультатКарт);
	ЗаписатьПротоколПланаПоФайламНаСервереКонтекста();
	
	Если ПроверятьЦелостность Тогда
		ЗаписатьПротоколЦелостностиНаСервереКонтекста(СловарьИсточника, СловарьПриемника);
	КонецЕсли;
	
	ЗаписатьПротоколБлокировокПриемникаНаСервереКонтекста();
	ДобавитьВПротоколНаСервереКонтекста("=== Конец dry-run. Для записи нажмите «Присоединить». ===");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПротоколКартыПеренумерации(РезультатКарт)
	
	Если Не РезультатКарт.НужнаПеренумерация Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьВПротокол("--- Карта перенумерации (отличия номеров, до 30) ---");
	Показано = 0;
	Лимит = 30;
	
	Для ТипОбъекта = 1 По МаксимальныйТипОбъектаСловаря() Цикл
		
		Карта = РезультатКарт.Карты.Получить(ТипОбъекта);
		Если Карта = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Пара Из Карта Цикл
			
			Если Пара.Ключ = Пара.Значение Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьВПротокол("  тип " + ФорматЧислаПротокола(ТипОбъекта) + ": "
				+ ФорматЧислаПротокола(Пара.Ключ) + " -> " + ФорматЧислаПротокола(Пара.Значение));
			Показано = Показано + 1;
			Если Показано >= Лимит Тогда
				ДобавитьВПротокол("  ... остальные отличия не показаны");
				Возврат;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

