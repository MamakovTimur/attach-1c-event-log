// Присоединение журнала регистрации (старый формат lgf/lgp).
// Логика склейки - в модуле формы: файлы ЖР читаются и пишутся на клиенте.

#Область ПрограммныйИнтерфейс

// Сведения для регистрации в справочнике дополнительных обработок БСП.
// Безопасный режим выключен: нужны операции с файлами ЖР.
//
// Возвращаемое значение:
//  Структура - параметры регистрации внешней обработки.
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Команда = Команды.Добавить();
	Команда.Представление = "Присоединение журнала регистрации";
	Команда.Идентификатор = "ОткрытьФорму";
	Команда.Использование = "ОткрытиеФормы";
	Команда.ПоказыватьОповещение = Ложь;
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Назначение", Новый Массив);
	ПараметрыРегистрации.Вставить("Наименование", "Присоединение журнала регистрации");
	ПараметрыРегистрации.Вставить("Версия", "1.3.15");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"Присоединяет файлы журнала регистрации старого формата (1Cv8.lgf, *.lgp) "
		+ "из каталога прежнего кластера к журналу текущего кластера. "
		+ "Словари объединяются, номера в записях lgp перенумеровываются. "
		+ "Режим «На сервере 1С»: файлы обрабатываются на сервере приложений (в т.ч. Linux).");
	ПараметрыРегистрации.Вставить("ВерсияБСП", "2.4.6.1");
	ПараметрыРегистрации.Вставить("Команды", Команды);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

#КонецОбласти
